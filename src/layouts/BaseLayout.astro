---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Soleil & Stone"
} = Astro.props;
---

<!doctype html>

<html
  lang="en"
  class="scroll-smooth"
>

<head>

  <meta
    charset="UTF-8"
  />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content={description}
  />

  <meta
    name="theme-color"
    content="#FFFFFF"
  />

  <title>
    {title}
  </title>


  <!-- =====================================================
       BRAND / FAVICON
       ===================================================== -->

  <link
    rel="icon"
    type="image/png"
    href="/brand/favicon.png"
  />

  <link
    rel="shortcut icon"
    type="image/png"
    href="/brand/favicon.png"
  />

  <link
    rel="apple-touch-icon"
    href="/brand/favicon.png"
  />


  <!-- =====================================================
       TAILWIND
       ===================================================== -->

  <script
    is:inline
    src="https://cdn.tailwindcss.com"
  ></script>

  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              cream: "#F9F8F3",
              card: "#FFFFFF",
              charcoal: "#22252A",
              slate: "#4A505A",
              gold: "#C5A059",
              goldlight: "#E5C98B",
              border: "#E8E5DA"
            }
          },

          fontFamily: {
            serif: [
              "Cinzel",
              "Georgia",
              "serif"
            ],

            sans: [
              "Plus Jakarta Sans",
              "Inter",
              "sans-serif"
            ]
          }
        }
      }
    };
  </script>


  <!-- =====================================================
       FONTS
       ===================================================== -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

</head>


<body
  class="
    bg-white
    text-brand-charcoal
    min-h-screen
    flex
    flex-col
    font-sans
    antialiased
    selection:bg-brand-gold
    selection:text-white
  "
>

  <Header />


  <main
    class="flex-grow"
  >
    <slot />
  </main>


  <Footer />


  <!-- =====================================================
       CLOUDFLARE WEB ANALYTICS

       Analytics is disabled when:

       localStorage:
       soleil_analytics_optout = "true"

       It is also disabled automatically on localhost.
       ===================================================== -->

  <script is:inline>
    (() => {

      const ANALYTICS_OPT_OUT_KEY =
        "soleil_analytics_optout";

      const isLocalhost =
        window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1";

      const hasOptedOut =
        localStorage.getItem(
          ANALYTICS_OPT_OUT_KEY
        ) === "true";


      if (
        isLocalhost ||
        hasOptedOut
      ) {
        console.info(
          "Soleil & Stone analytics disabled for this browser."
        );

        return;
      }


      const beacon =
        document.createElement(
          "script"
        );

      beacon.src =
        "https://static.cloudflareinsights.com/beacon.min.js";

      beacon.defer =
        true;

      beacon.setAttribute(
        "data-cf-beacon",
        JSON.stringify({
          token:
            "25f4f77c623a4a2ca7120f9843fc9735"
        })
      );


      document.body.appendChild(
        beacon
      );

    })();
  </script>

</body>

</html>
