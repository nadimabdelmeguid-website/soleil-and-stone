---
import Header
  from "../components/Header.astro";

import Footer
  from "../components/Footer.astro";

import "../styles/global.css";


interface Props {
  title: string;
  description?: string;
}


const {
  title,
  description = "Soleil & Stone"
} = Astro.props;
---

<!doctype html>

<html
  lang="en"
  class="scroll-smooth"
>

<head>

  <meta
    charset="UTF-8"
  />


  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />


  <meta
    name="description"
    content={description}
  />


  <title>
    {title}
  </title>


  <script
     is:inline
     src="https://cdn.tailwindcss.com"
  ></script>


  <script is:inline>

    tailwind.config = {

      theme: {

        extend: {

          colors: {

            brand: {

              cream:
                "#F9F8F3",

              card:
                "#FFFFFF",

              charcoal:
                "#22252A",

              slate:
                "#4A505A",

              gold:
                "#C5A059",

              goldlight:
                "#E5C98B",

              border:
                "#E8E5DA"

            }

          },


          fontFamily: {

            serif: [
              "Cinzel",
              "Georgia",
              "serif"
            ],

            sans: [
              "Plus Jakarta Sans",
              "Inter",
              "sans-serif"
            ]

          }

        }

      }

    };

  </script>


  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />


  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />


  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

</head>


<body
  class="
    bg-brand-cream
    text-brand-charcoal
    min-h-screen
    flex
    flex-col
    font-sans
    antialiased
    selection:bg-brand-gold
    selection:text-white
  "
>

  <Header />


  <main class="flex-grow">

    <slot />

  </main>


  <Footer />


  <script
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token":"25f4f77c623a4a2ca7120f9843fc9735"}'
  ></script>

</body>

</html>
