---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

interface Props {
  title: string;

  description?: string;

  /**
   * Optional social preview image.
   * Falls back to the Soleil & Stone default social card.
   */
  image?: string;

  /**
   * Accessible description for the social image.
   */
  imageAlt?: string;

  type?: "website" | "article";

  publishedTime?: string;

  modifiedTime?: string;

  canonicalURL?: string;

  articleSection?: string;
}

const {
  title,

  description =
    "Soleil & Stone",

  image =
    "/brand/social-default.png",

  imageAlt =
    "Soleil & Stone",

  type =
    "website",

  publishedTime,

  modifiedTime,

  canonicalURL,

  articleSection
} = Astro.props;


/* =====================================================
   SEO URLS
   ===================================================== */

const siteOrigin =
  Astro.site?.origin ??
  Astro.url.origin;


const canonical =
  canonicalURL
    ? new URL(
        canonicalURL,
        siteOrigin
      ).href
    : new URL(
        Astro.url.pathname,
        siteOrigin
      ).href;


const socialImage =
  new URL(
    image,
    siteOrigin
  ).href;


/* =====================================================
   STRUCTURED DATA
   ===================================================== */

const structuredData = {
  "@context":
    "https://schema.org",

  "@type":
    "WebSite",

  name:
    "Soleil & Stone",

  url:
    siteOrigin,

  description:
    "Field notes, communities and ventures at the intersection of hardware, commercialization and innovation ecosystems."
};
---

<!doctype html>

<html
  lang="en"
  class="scroll-smooth"
>

<head>

  <!-- =====================================================
       CORE SEO
       ===================================================== -->

  <meta
    charset="UTF-8"
  />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content={description}
  />

  <meta
    name="theme-color"
    content="#FFFFFF"
  />

  <meta
    name="robots"
    content="index, follow"
  />


  <title>
    {title}
  </title>



  <!-- =====================================================
       CANONICAL
       ===================================================== -->

  <link
    rel="canonical"
    href={canonical}
  />



  <!-- =====================================================
       OPEN GRAPH

       LinkedIn
       Facebook
       Slack
       iMessage
       ===================================================== -->

  <meta
    property="og:type"
    content={type}
  />

  <meta
    property="og:locale"
    content="en_US"
  />

  <meta
    property="og:site_name"
    content="Soleil & Stone"
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonical}
  />

  <meta
    property="og:image"
    content={socialImage}
  />

  <meta
    property="og:image:secure_url"
    content={socialImage}
  />

  <meta
    property="og:image:type"
    content="image/png"
  />

  <meta
    property="og:image:width"
    content="1200"
  />

  <meta
    property="og:image:height"
    content="630"
  />

  <meta
    property="og:image:alt"
    content={imageAlt}
  />



  <!-- =====================================================
       ARTICLE META
       ===================================================== -->

  {
    type === "article" &&
    publishedTime && (

      <meta
        property="article:published_time"
        content={publishedTime}
      />

    )
  }


  {
    type === "article" &&
    modifiedTime && (

      <meta
        property="article:modified_time"
        content={modifiedTime}
      />

    )
  }


  {
    type === "article" &&
    articleSection && (

      <meta
        property="article:section"
        content={articleSection}
      />

    )
  }



  <!-- =====================================================
       X / TWITTER
       ===================================================== -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={socialImage}
  />

  <meta
    name="twitter:image:alt"
    content={imageAlt}
  />



  <!-- =====================================================
       STRUCTURED DATA
       ===================================================== -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      structuredData
    )}
  ></script>



  <!-- =====================================================
       BRAND / FAVICON
       ===================================================== -->

  <link
    rel="icon"
    type="image/png"
    href="/brand/favicon.png"
  />

  <link
    rel="shortcut icon"
    type="image/png"
    href="/brand/favicon.png"
  />

  <link
    rel="apple-touch-icon"
    href="/brand/favicon.png"
  />



  <!-- =====================================================
       TAILWIND
       ===================================================== -->

  <script
    is:inline
    src="https://cdn.tailwindcss.com"
  ></script>


  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              cream:
                "#F9F8F3",

              card:
                "#FFFFFF",

              charcoal:
                "#22252A",

              slate:
                "#4A505A",

              gold:
                "#C5A059",

              goldlight:
                "#E5C98B",

              border:
                "#E8E5DA"
            }
          },

          fontFamily: {
            serif: [
              "Cinzel",
              "Georgia",
              "serif"
            ],

            sans: [
              "Plus Jakarta Sans",
              "Inter",
              "sans-serif"
            ]
          }
        }
      }
    };
  </script>



  <!-- =====================================================
       FONTS
       ===================================================== -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

</head>


<body
  class="
    bg-white
    text-brand-charcoal
    min-h-screen
    flex
    flex-col
    font-sans
    antialiased
    selection:bg-brand-gold
    selection:text-white
  "
>

  <Header />


  <main class="flex-grow">
    <slot />
  </main>


  <Footer />



  <!-- =====================================================
       CLOUDFLARE WEB ANALYTICS

       Disabled when:
       soleil_analytics_optout = "true"

       Also disabled automatically on localhost.
       ===================================================== -->

  <script is:inline>

    (() => {

      const ANALYTICS_OPT_OUT_KEY =
        "soleil_analytics_optout";


      const isLocalhost =
        window.location.hostname ===
          "localhost" ||
        window.location.hostname ===
          "127.0.0.1";


      const hasOptedOut =
        localStorage.getItem(
          ANALYTICS_OPT_OUT_KEY
        ) ===
        "true";


      if (
        isLocalhost ||
        hasOptedOut
      ) {

        console.info(
          "Soleil & Stone analytics disabled for this browser."
        );

        return;

      }


      const beacon =
        document.createElement(
          "script"
        );


      beacon.src =
        "https://static.cloudflareinsights.com/beacon.min.js";


      beacon.defer =
        true;


      beacon.setAttribute(
        "data-cf-beacon",
        JSON.stringify({
          token:
            "25f4f77c623a4a2ca7120f9843fc9735"
        })
      );


      document.body.appendChild(
        beacon
      );

    })();

  </script>

</body>

</html>
