---
import AuthorCard from "../components/AuthorCard.astro";
import { readingTime } from "../utils/readingTime";

const { post } = Astro.props;

const publishedDate =
  post.data.published.toLocaleDateString(
    "en-US",
    {
      month: "long",
      day: "numeric",
      year: "numeric"
    }
  );

const readTime =
  readingTime(post.body ?? "");
---

<article>

  <!-- =====================================================
       ARTICLE HERO
       ===================================================== -->

  <header
    class="
      max-w-4xl
      w-full
      mx-auto
      px-6
      pt-16
      pb-12
      text-center
    "
  >

    <!-- BACK LINK -->

    <a
      href="/field-notes/"
      class="
        inline-flex
        items-center
        gap-2
        text-[11px]
        uppercase
        tracking-[0.18em]
        text-brand-slate
        hover:text-brand-gold
        transition-colors
        mb-8
      "
    >
      ← Back to Field Notes
    </a>


    <!-- CATEGORY -->

    <div
      class="
        text-[10px]
        uppercase
        tracking-[0.2em]
        text-brand-gold
        font-semibold
        mb-5
      "
    >
      {post.data.category}
    </div>


    <!-- TITLE -->

    <h1
      class="
        font-serif
        text-4xl
        sm:text-5xl
        lg:text-[3.7rem]
        leading-[1.15]
        tracking-wide
        text-brand-charcoal
        mb-6
      "
    >
      {post.data.title}
    </h1>


    <!-- DESCRIPTION -->

    <p
      class="
        max-w-3xl
        mx-auto
        text-base
        sm:text-lg
        leading-relaxed
        text-brand-slate
        font-light
        mb-8
      "
    >
      {post.data.description}
    </p>


    <!-- META -->

    <div
      class="
        flex
        flex-wrap
        items-center
        justify-center
        gap-x-3
        gap-y-2
        text-[10px]
        uppercase
        tracking-[0.15em]
        text-brand-slate
      "
    >

      <span>
        {publishedDate}
      </span>

      <span
        class="
          text-brand-gold
        "
      >
        •
      </span>

      <span>
        {readTime} min read
      </span>

      <span
        class="
          text-brand-gold
        "
      >
        •
      </span>

      <span>
        By {post.data.author}
      </span>

    </div>

  </header>



  <!-- =====================================================
       ARTICLE BODY
       ===================================================== -->

  <section
    class="
      border-y
      border-brand-border
      bg-white
    "
  >

    <div
      class="
        max-w-3xl
        w-full
        mx-auto
        px-6
        py-14
        sm:py-16
      "
    >

      <div
        class="
          field-note-body
        "
      >
        <slot />
      </div>

    </div>

  </section>



  <!-- =====================================================
       AUTHOR
       ===================================================== -->

  <section
    class="
      max-w-4xl
      w-full
      mx-auto
      px-6
      py-14
    "
  >

    <AuthorCard />

  </section>



  <!-- =====================================================
       ARTICLE FOOTER CTA
       ===================================================== -->

  <section
    class="
      border-t
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        py-16
        flex
        flex-col
        sm:flex-row
        sm:items-center
        justify-between
        gap-8
      "
    >

      <div>

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Keep Exploring
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          More Notes From The Field
        </h2>

      </div>


      <div
        class="
          flex
          flex-wrap
          gap-3
        "
      >

        <a
          href="/field-notes/"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            border
            border-brand-charcoal
            text-brand-charcoal
            text-[11px]
            uppercase
            tracking-[0.16em]
            hover:border-brand-gold
            hover:text-brand-gold
            transition-colors
          "
        >
          All Field Notes
          <span>→</span>
        </a>


        <a
          href="/?type=hello#contact"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            bg-brand-charcoal
            text-white
            text-[11px]
            uppercase
            tracking-[0.16em]
            hover:bg-brand-gold
            transition-colors
          "
        >
          Connect
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</article>
