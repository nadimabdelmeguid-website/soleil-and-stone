---
import AuthorCard from "../components/AuthorCard.astro";
import { readingTime } from "../utils/readingTime";

const {
  post,
  recommendedPost
} = Astro.props;

const publishedDate =
  post.data.published.toLocaleDateString(
    "en-US",
    {
      month: "long",
      day: "numeric",
      year: "numeric"
    }
  );

const readTime =
  readingTime(post.body ?? "");

const recommendedDate =
  recommendedPost
    ? recommendedPost.data.published.toLocaleDateString(
        "en-US",
        {
          month: "short",
          day: "numeric",
          year: "numeric"
        }
      )
    : null;
---

<article>

  <!-- =====================================================
       ARTICLE HERO
       ===================================================== -->

  <header
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-12
        text-center
      "
    >

      <a
        href="/field-notes/"
        class="
          inline-flex
          items-center
          gap-2
          text-[11px]
          uppercase
          tracking-[0.18em]
          text-brand-slate
          hover:text-brand-gold
          transition-colors
          mb-8
        "
      >
        ← Back to Field Notes
      </a>


      <div
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
          mb-5
        "
      >
        {post.data.category}
      </div>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-[3.7rem]
          leading-[1.15]
          tracking-wide
          text-brand-charcoal
          mb-6
        "
      >
        {post.data.title}
      </h1>


      <p
        class="
          max-w-3xl
          mx-auto
          text-base
          sm:text-lg
          leading-relaxed
          text-brand-slate
          font-light
          mb-8
        "
      >
        {post.data.description}
      </p>


      <div
        class="
          flex
          flex-wrap
          items-center
          justify-center
          gap-x-3
          gap-y-2
          text-[10px]
          uppercase
          tracking-[0.15em]
          text-brand-slate
        "
      >

        <span>
          {publishedDate}
        </span>

        <span class="text-brand-gold">
          •
        </span>

        <span>
          {readTime} min read
        </span>

        <span class="text-brand-gold">
          •
        </span>

        <span>
          By {post.data.author}
        </span>

      </div>

    </div>

  </header>



  <!-- =====================================================
       ARTICLE BODY
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-3xl
        w-full
        mx-auto
        px-6
        py-14
        sm:py-16
      "
    >

      <div class="field-note-body">
        <slot />
      </div>

    </div>

  </section>



  <!-- =====================================================
       AUTHOR
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <AuthorCard />

    </div>

  </section>



  <!-- =====================================================
       KEEP EXPLORING
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        py-16
        flex
        flex-col
        sm:flex-row
        sm:items-center
        justify-between
        gap-8
      "
    >

      <div>

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Keep Exploring
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          More Notes From The Field
        </h2>

      </div>


      <div
        class="
          flex
          flex-wrap
          gap-3
        "
      >

        <a
          href="/field-notes/"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            border
            border-brand-charcoal
            text-brand-charcoal
            text-[11px]
            uppercase
            tracking-[0.16em]
            hover:border-brand-gold
            hover:text-brand-gold
            transition-colors
          "
        >
          All Field Notes
          <span>→</span>
        </a>


        <a
          href="/?type=hello#contact"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            bg-brand-charcoal
            text-white
            text-[11px]
            uppercase
            tracking-[0.16em]
            hover:bg-brand-gold
            transition-colors
          "
        >
          Connect
          <span>→</span>
        </a>

      </div>

    </div>

  </section>



  <!-- =====================================================
       RECOMMENDED NEXT
       ===================================================== -->

  {
    recommendedPost && (

      <section
        class="
          bg-brand-cream
          border-b
          border-brand-border
        "
      >

        <div
          class="
            max-w-4xl
            w-full
            mx-auto
            px-6
            py-16
          "
        >

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Recommended Next
          </span>


          <a
            href={`/field-notes/${recommendedPost.id}/`}
            class="
              group
              block
              mt-5
              p-7
              sm:p-8
              border
              border-brand-border
              bg-white
              hover:border-brand-gold/60
              transition-colors
            "
          >

            <div
              class="
                flex
                flex-wrap
                items-center
                gap-2
                text-[10px]
                uppercase
                tracking-[0.15em]
                mb-4
              "
            >

              <span
                class="
                  text-brand-gold
                  font-semibold
                "
              >
                {recommendedPost.data.category}
              </span>


              <span class="text-brand-border">
                •
              </span>


              <span class="text-brand-slate">
                {recommendedDate}
              </span>

            </div>


            <div
              class="
                flex
                flex-col
                sm:flex-row
                sm:items-end
                justify-between
                gap-6
              "
            >

              <div class="max-w-2xl">

                <h2
                  class="
                    font-serif
                    text-2xl
                    sm:text-3xl
                    text-brand-charcoal
                    leading-snug
                    mb-3
                    group-hover:text-brand-gold
                    transition-colors
                  "
                >
                  {recommendedPost.data.title}
                </h2>


                <p
                  class="
                    text-sm
                    text-brand-slate
                    leading-relaxed
                    font-light
                  "
                >
                  {recommendedPost.data.description}
                </p>

              </div>


              <span
                class="
                  text-brand-gold
                  text-2xl
                  transition-transform
                  duration-300
                  group-hover:translate-x-1
                  flex-shrink-0
                "
              >
                →
              </span>

            </div>

          </a>

        </div>

      </section>

    )
  }

</article>
