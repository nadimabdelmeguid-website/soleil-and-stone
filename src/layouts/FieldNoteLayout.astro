---
import AuthorCard
  from "../components/AuthorCard.astro";

import {
  readingTime
} from "../utils/readingTime";


const {
  post,
  recommendedPost,
  images = {
    cover: null,
    gallery: []
  }
} =
  Astro.props;


const publishedDate =
  post.data.published.toLocaleDateString(
    "en-US",
    {
      month:
        "long",

      day:
        "numeric",

      year:
        "numeric"
    }
  );


const readTime =
  post.data.readingMinutes ??
  readingTime(
    post.body ??
    ""
  );


const recommendedDate =
  recommendedPost
    ? recommendedPost.data.published.toLocaleDateString(
        "en-US",
        {
          month:
            "short",

          day:
            "numeric",

          year:
            "numeric"
        }
      )
    : null;
---

<article>

  <!-- =====================================================
       ARTICLE HERO
       ===================================================== -->

  <header
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-12
        text-center
      "
    >

      <a
        href="/field-notes/"
        class="
          inline-flex
          items-center
          gap-2
          text-[11px]
          uppercase
          tracking-[0.18em]
          text-brand-slate
          hover:text-brand-gold
          transition-colors
          mb-8
        "
      >
        ← Back to Field Notes
      </a>


      <div
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
          mb-5
        "
      >
        {post.data.category}
      </div>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-[3.7rem]
          leading-[1.15]
          tracking-wide
          text-brand-charcoal
          mb-6
        "
      >
        {post.data.title}
      </h1>


      <p
        class="
          max-w-3xl
          mx-auto
          text-base
          sm:text-lg
          leading-relaxed
          text-brand-slate
          font-light
          mb-8
        "
      >
        {post.data.description}
      </p>


      <div
        class="
          flex
          flex-wrap
          items-center
          justify-center
          gap-x-3
          gap-y-2
          text-[10px]
          uppercase
          tracking-[0.15em]
          text-brand-slate
        "
      >

        <span>
          {publishedDate}
        </span>

        <span class="text-brand-gold">
          •
        </span>

        <span>
          {readTime} min read
        </span>

        <span class="text-brand-gold">
          •
        </span>

        <span>
          By {post.data.author}
        </span>

      </div>

    </div>

  </header>



  <!-- =====================================================
       OPTIONAL COVER IMAGE
       ===================================================== -->

  {
    images.cover && (

      <section
        class="
          bg-white
          border-b
          border-brand-border
        "
      >

        <div
          class="
            max-w-5xl
            w-full
            mx-auto
            px-6
            py-10
            sm:py-12
          "
        >

          <figure>

            <img
              src={images.cover}
              alt={`${post.data.title} — Field Note`}
              loading="eager"
              fetchpriority="high"
              class="
                w-full
                aspect-[16/9]
                object-cover
                border
                border-brand-border
              "
            />

          </figure>

        </div>

      </section>

    )
  }



  <!-- =====================================================
       ARTICLE BODY
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-3xl
        w-full
        mx-auto
        px-6
        py-14
        sm:py-16
      "
    >

      <div
        class="field-note-body"
        data-field-note-body
      >
        <slot />
      </div>

    </div>

  </section>



  <!-- =====================================================
       AUTHOR
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <AuthorCard />

    </div>

  </section>



  <!-- =====================================================
       KEEP EXPLORING
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-4xl
        w-full
        mx-auto
        px-6
        py-16
        flex
        flex-col
        sm:flex-row
        sm:items-center
        justify-between
        gap-8
      "
    >

      <div>

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Keep Exploring
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          More Notes From The Field
        </h2>

      </div>


      <div
        class="
          flex
          flex-wrap
          gap-3
        "
      >

        <a
          href="/field-notes/"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            border
            border-brand-charcoal
            text-brand-charcoal
            text-[11px]
            uppercase
            tracking-[0.16em]
            hover:border-brand-gold
            hover:text-brand-gold
            transition-colors
          "
        >
          All Field Notes
          <span>→</span>
        </a>


        <a
          href="/contact/?reason=general"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            bg-brand-charcoal
            text-white
            text-[11px]
            uppercase
            tracking-[0.16em]
            hover:bg-brand-gold
            transition-colors
          "
        >
          Connect
          <span>→</span>
        </a>

      </div>

    </div>

  </section>



  <!-- =====================================================
       RECOMMENDED NEXT
       ===================================================== -->

  {
    recommendedPost && (

      <section
        class="
          bg-brand-cream
          border-b
          border-brand-border
        "
      >

        <div
          class="
            max-w-4xl
            w-full
            mx-auto
            px-6
            py-16
          "
        >

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Recommended Next
          </span>


          <a
            href={`/field-notes/${recommendedPost.id}/`}
            class="
              group
              block
              mt-5
              p-7
              sm:p-8
              border
              border-brand-border
              bg-white
              hover:border-brand-gold/60
              transition-colors
            "
          >

            <div
              class="
                flex
                flex-wrap
                items-center
                gap-2
                text-[10px]
                uppercase
                tracking-[0.15em]
                mb-4
              "
            >

              <span
                class="
                  text-brand-gold
                  font-semibold
                "
              >
                {recommendedPost.data.category}
              </span>


              <span class="text-brand-border">
                •
              </span>


              <span class="text-brand-slate">
                {recommendedDate}
              </span>

            </div>


            <div
              class="
                flex
                flex-col
                sm:flex-row
                sm:items-end
                justify-between
                gap-6
              "
            >

              <div class="max-w-2xl">

                <h2
                  class="
                    font-serif
                    text-2xl
                    sm:text-3xl
                    text-brand-charcoal
                    leading-snug
                    mb-3
                    group-hover:text-brand-gold
                    transition-colors
                  "
                >
                  {recommendedPost.data.title}
                </h2>


                <p
                  class="
                    text-sm
                    text-brand-slate
                    leading-relaxed
                    font-light
                  "
                >
                  {recommendedPost.data.description}
                </p>

              </div>


              <span
                class="
                  text-brand-gold
                  text-2xl
                  transition-transform
                  duration-300
                  group-hover:translate-x-1
                  flex-shrink-0
                "
              >
                →
              </span>

            </div>

          </a>

        </div>

      </section>

    )
  }

</article>



<!-- =====================================================
     AUTOMATIC INLINE FIELD NOTE IMAGES

     01.* → end of first H2 section
     02.* → end of second H2 section
     03.* → end of third H2 section
     etc.
     ===================================================== -->

{
  images.gallery.length > 0 && (

    <script
      is:inline
      define:vars={{
        galleryImages:
          images.gallery,

        fieldNoteTitle:
          post.data.title
      }}
    >

      (() => {

        const body =
          document.querySelector(
            "[data-field-note-body]"
          );


        if (
          !body ||
          body.dataset.imagesEnhanced ===
            "true"
        ) {
          return;
        }


        body.dataset.imagesEnhanced =
          "true";


        const headings =
          Array.from(
            body.querySelectorAll(
              ":scope > h2"
            )
          );


        galleryImages.forEach(
          (
            source,
            index
          ) => {

            const figure =
              document.createElement(
                "figure"
              );


            figure.className =
              "field-note-inline-image";


            const image =
              document.createElement(
                "img"
              );


            image.src =
              source;


            image.loading =
              "lazy";


            image.decoding =
              "async";


            const sectionHeading =
              headings[
                index
              ];


            const headingText =
              sectionHeading
                ?.textContent
                ?.trim();


            image.alt =
              headingText
                ? `${fieldNoteTitle} — ${headingText}`
                : `${fieldNoteTitle} — Field Note image ${index + 1}`;


            figure.appendChild(
              image
            );


            /*
             * Put image at the end of the corresponding
             * H2 section.
             */

            if (
              sectionHeading
            ) {

              const nextHeading =
                headings[
                  index + 1
                ];


              if (
                nextHeading
              ) {

                nextHeading.before(
                  figure
                );

              } else {

                body.appendChild(
                  figure
                );

              }

            } else {

              body.appendChild(
                figure
              );

            }

          }
        );

      })();

    </script>

  )
}



<!-- =====================================================
     FIELD NOTE TYPOGRAPHY
     ===================================================== -->

<style is:global>

  .field-note-body {
    color: #4A505A;
  }


  .field-note-body > p:first-child {
    font-size: 1.125rem;
    line-height: 1.85;
    color: #22252A;
  }


  @media (min-width: 640px) {

    .field-note-body > p:first-child {
      font-size: 1.2rem;
    }

  }


  .field-note-body p {
    margin-top: 1.35rem;
    font-size: 1rem;
    line-height: 1.85;
    font-weight: 300;
  }


  .field-note-body h2 {
    margin-top: 3.75rem;
    margin-bottom: 1.25rem;
    font-family:
      "Cinzel",
      Georgia,
      serif;
    font-size: 1.7rem;
    line-height: 1.3;
    color: #22252A;
    scroll-margin-top: 7rem;
  }


  @media (min-width: 640px) {

    .field-note-body h2 {
      font-size: 2rem;
    }

  }


  .field-note-body h3 {
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    font-family:
      "Cinzel",
      Georgia,
      serif;
    font-size: 1.3rem;
    line-height: 1.4;
    color: #22252A;
  }


  .field-note-body strong {
    color: #22252A;
    font-weight: 600;
  }


  .field-note-body em {
    color: #363A40;
  }


  .field-note-body a {
    color: #9F7D3D;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }


  .field-note-body a:hover {
    color: #C5A059;
  }


  .field-note-body ul,
  .field-note-body ol {
    margin-top: 1.75rem;
    margin-bottom: 1.75rem;
    display: grid;
    gap: 0.9rem;
  }


  .field-note-body ul {
    list-style: none;
    padding-left: 0;
  }


  .field-note-body ul > li {
    position: relative;
    padding:
      0.9rem
      0
      0.9rem
      1.5rem;
    border-top: 1px solid #E8E5DA;
    line-height: 1.75;
    font-weight: 300;
  }


  .field-note-body ul > li:last-child {
    border-bottom: 1px solid #E8E5DA;
  }


  .field-note-body ul > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: #C5A059;
  }


  .field-note-body ol {
    padding-left: 1.5rem;
  }


  .field-note-body ol > li {
    padding-left: 0.35rem;
    line-height: 1.75;
    font-weight: 300;
  }


  .field-note-body blockquote {
    margin:
      3rem
      0;
    padding:
      0.25rem
      0
      0.25rem
      1.5rem;
    border-left:
      2px solid
      #C5A059;
    font-family:
      "Cinzel",
      Georgia,
      serif;
    font-size: 1.35rem;
    line-height: 1.65;
    color: #22252A;
  }


  .field-note-body blockquote p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-weight: 400;
  }


  .field-note-body hr {
    margin:
      3.5rem
      0;
    border: 0;
    border-top:
      1px solid
      #E8E5DA;
  }


  .field-note-inline-image {
    margin:
      2.75rem
      0
      0;
  }


  .field-note-inline-image img {
    width: 100%;
    height: auto;
    display: block;
    border:
      1px solid
      #E8E5DA;
  }

</style>
