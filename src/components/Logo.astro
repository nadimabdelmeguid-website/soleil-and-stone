---
interface Props {
  variant?:
    | "horizontal"
    | "primary"
    | "wordmark"
    | "monochrome";

  className?: string;
  alt?: string;
  href?: string;
}

const {
  variant = "horizontal",
  className = "",
  alt = "Soleil & Stone",
  href = "/"
} = Astro.props;

const logos = {
  horizontal:
    "/brand/logo-horizontal.png",

  primary:
    "/brand/logo-primary.png",

  wordmark:
    "/brand/logo-wordmark.png",

  monochrome:
    "/brand/logo-monochrome.png"
};

const src =
  logos[variant];
---

<a
  href={href}
  class={`inline-flex items-center ${className}`}
  aria-label="Soleil & Stone home"
>
  <img
    src={src}
    alt={alt}
    class="
      block
      w-full
      h-auto
      object-contain
    "
  />
</a>
