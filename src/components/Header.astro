---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const path =
  Astro.url.pathname;

function isActive(
  href: string
) {
  if (href === "/") {
    return path === "/";
  }

  return path.startsWith(
    href
  );
}
---

<header
  class="
    max-w-6xl
    w-full
    mx-auto
    px-6
    py-7
    border-b
    border-brand-border
  "
>

  <div
    class="
      flex
      flex-col
      sm:flex-row
      items-center
      justify-between
      gap-6
    "
  >

    <!-- BRAND -->

    <Logo
      variant="horizontal"
      className="
        w-[220px]
        sm:w-[250px]
        md:w-[280px]
        flex-shrink-0
      "
    />


    <!-- NAVIGATION -->

    <nav
      class="
        flex
        items-center
        gap-5
        sm:gap-7
        text-[11px]
        sm:text-xs
        uppercase
        tracking-[0.16em]
        font-medium
        text-brand-slate
      "
      aria-label="Main navigation"
    >

      {
        site.navigation.map(
          (item) => (

            <a
              href={item.href}
              class:list={[
                "transition-colors hover:text-brand-gold",

                isActive(item.href)
                  ? "text-brand-gold"
                  : "text-brand-slate"
              ]}
            >
              {item.label}
            </a>

          )
        )
      }


      <a
        href="/#contact"
        class="
          px-4
          sm:px-5
          py-2.5
          border
          border-brand-charcoal
          text-brand-charcoal
          hover:bg-brand-charcoal
          hover:text-white
          transition-all
        "
      >
        Connect
      </a>

    </nav>

  </div>

</header>
