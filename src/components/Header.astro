---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const path =
  Astro.url.pathname;


function isActive(
  href: string
) {

  if (
    href === "/"
  ) {

    return path === "/";

  }


  return path.startsWith(
    href
  );

}
---

<header
  id="site-header"
  class="
    fixed
    top-0
    left-0
    right-0
    z-50
    w-full
    bg-brand-cream
    border-b
    border-brand-border
    transition-all
    duration-300
  "
>

  <div
    id="header-inner"
    class="
      max-w-6xl
      w-full
      mx-auto
      px-4
      sm:px-6
      py-4
      sm:py-6
      lg:py-7
      flex
      items-center
      justify-between
      gap-4
      transition-all
      duration-300
    "
  >

    <!-- =====================================================
         BRAND
         ===================================================== -->

    <Logo
      variant="horizontal"
      className="
        header-logo
        w-[185px]
        sm:w-[225px]
        md:w-[250px]
        lg:w-[280px]
        flex-shrink-0
        transition-all
        duration-300
      "
    />


    <!-- =====================================================
         DESKTOP NAVIGATION
         ===================================================== -->

    <nav
      class="
        hidden
        sm:flex
        items-center
        gap-5
        md:gap-7
        text-[11px]
        md:text-xs
        uppercase
        tracking-[0.14em]
        md:tracking-[0.16em]
        font-medium
        text-brand-slate
        transition-all
        duration-300
      "
      aria-label="Main navigation"
    >

      {
        site.navigation.map(
          (item) => (

            <a
              href={item.href}
              class:list={[
                "min-h-[44px]",
                "inline-flex",
                "items-center",
                "transition-colors",
                "hover:text-brand-gold",

                isActive(
                  item.href
                )
                  ? "text-brand-gold"
                  : "text-brand-slate"
              ]}
            >
              {item.label}
            </a>

          )
        )
      }


      <a
        href="/contact/"
        class="
          header-connect
          min-h-[44px]
          inline-flex
          items-center
          justify-center
          px-4
          md:px-5
          py-2.5
          border
          border-brand-charcoal
          text-brand-charcoal
          hover:bg-brand-charcoal
          hover:text-white
          transition-all
          duration-300
        "
      >
        Connect
      </a>

    </nav>



    <!-- =====================================================
         MOBILE MENU BUTTON
         ===================================================== -->

    <button
      id="mobile-menu-button"
      type="button"
      class="
        sm:hidden
        w-11
        h-11
        shrink-0
        inline-flex
        items-center
        justify-center
        border
        border-brand-border
        text-brand-charcoal
        hover:border-brand-gold
        hover:text-brand-gold
        transition-colors
      "
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >

      <span
        class="
          sr-only
        "
      >
        Menu
      </span>


      <svg
        id="mobile-menu-open-icon"
        class="
          w-5
          h-5
        "
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >

        <path
          d="M4 7h16"
        />

        <path
          d="M4 12h16"
        />

        <path
          d="M4 17h16"
        />

      </svg>


      <svg
        id="mobile-menu-close-icon"
        class="
          hidden
          w-5
          h-5
        "
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >

        <path
          d="M6 6l12 12"
        />

        <path
          d="M18 6L6 18"
        />

      </svg>

    </button>

  </div>



  <!-- =====================================================
       MOBILE NAVIGATION
       ===================================================== -->

  <div
    id="mobile-navigation"
    class="
      hidden
      sm:hidden
      border-t
      border-brand-border
      bg-brand-cream
    "
  >

    <nav
      class="
        max-w-6xl
        w-full
        mx-auto
        px-4
        py-4
        flex
        flex-col
      "
      aria-label="Mobile navigation"
    >

      {
        site.navigation.map(
          (item) => (

            <a
              href={item.href}
              class:list={[
                "mobile-nav-link",
                "min-h-[48px]",
                "flex",
                "items-center",
                "border-b",
                "border-brand-border",
                "text-[11px]",
                "uppercase",
                "tracking-[0.16em]",
                "font-medium",
                "transition-colors",
                "hover:text-brand-gold",

                isActive(
                  item.href
                )
                  ? "text-brand-gold"
                  : "text-brand-slate"
              ]}
            >
              {item.label}
            </a>

          )
        )
      }


      <a
        href="/contact/"
        class="
          mobile-nav-link
          min-h-[48px]
          mt-4
          px-5
          inline-flex
          items-center
          justify-center
          border
          border-brand-charcoal
          text-[11px]
          uppercase
          tracking-[0.16em]
          font-medium
          text-brand-charcoal
          hover:bg-brand-charcoal
          hover:text-white
          transition-colors
        "
      >
        Connect
      </a>

    </nav>

  </div>

</header>

<div
  id="site-header-spacer"
  aria-hidden="true"
></div>



<style>

  #site-header-spacer {
    height: var(--site-header-height, 0px);
  }


  /* =====================================================
     SCROLLED HEADER
     ===================================================== */

  #site-header.scrolled {
    box-shadow:
      0 8px 24px rgba(34, 37, 42, 0.08);
  }


  #site-header.scrolled
  #header-inner {
    padding-top:
      0.45rem;

    padding-bottom:
      0.45rem;
  }


  #site-header.scrolled
  .header-logo {
    width:
      175px;
  }


  #site-header.scrolled
  .header-connect {
    padding-top:
      0.45rem;

    padding-bottom:
      0.45rem;
  }



  /* =====================================================
     MOBILE
     ===================================================== */

  @media (
    max-width: 639px
  ) {

    #site-header.scrolled
    #header-inner {
      padding-top:
        0.35rem;

      padding-bottom:
        0.35rem;
    }


    #site-header.scrolled
    .header-logo {
      width:
        150px;
    }

  }



  /* =====================================================
     REDUCED MOTION
     ===================================================== */

  @media (
    prefers-reduced-motion:
      reduce
  ) {

    #site-header,
    #header-inner,
    .header-logo,
    .header-connect {
      transition:
        none;
    }

  }

</style>



<script is:inline>

  (() => {

    const header =
      document.getElementById(
        "site-header"
      );


    const menuButton =
      document.getElementById(
        "mobile-menu-button"
      );


    const mobileNavigation =
      document.getElementById(
        "mobile-navigation"
      );


    const openIcon =
      document.getElementById(
        "mobile-menu-open-icon"
      );


    const closeIcon =
      document.getElementById(
        "mobile-menu-close-icon"
      );


    const mobileLinks =
      document.querySelectorAll(
        ".mobile-nav-link"
      );



    /* =====================================================
       HEADER SCROLL STATE
       ===================================================== */

    const headerSpacer =
      document.getElementById(
        "site-header-spacer"
      );


    const syncHeaderHeight =
      () => {

        if (
          !header ||
          !headerSpacer
        ) {

          return;

        }


        const height =
          header.getBoundingClientRect().height;


        document.documentElement.style.setProperty(
          "--site-header-height",
          `${height}px`
        );

      };


    const updateHeader =
      () => {

        if (
          !header
        ) {

          return;

        }


        if (
          window.scrollY >
            40
        ) {

          header.classList.add(
            "scrolled"
          );

        } else {

          header.classList.remove(
            "scrolled"
          );

        }


        window.requestAnimationFrame(
          syncHeaderHeight
        );

      };


    updateHeader();


    window.addEventListener(
      "scroll",
      updateHeader,
      {
        passive:
          true
      }
    );


    window.addEventListener(
      "resize",
      syncHeaderHeight,
      {
        passive:
          true
      }
    );



    /* =====================================================
       MOBILE MENU
       ===================================================== */

    const setMenuState =
      (
        open
      ) => {

        if (
          !menuButton ||
          !mobileNavigation
        ) {

          return;

        }


        menuButton.setAttribute(
          "aria-expanded",
          open
            ? "true"
            : "false"
        );


        menuButton.setAttribute(
          "aria-label",
          open
            ? "Close navigation"
            : "Open navigation"
        );


        mobileNavigation.classList.toggle(
          "hidden",
          !open
        );


        openIcon
          ?.classList.toggle(
            "hidden",
            open
          );


        closeIcon
          ?.classList.toggle(
            "hidden",
            !open
          );

      };


    menuButton
      ?.addEventListener(
        "click",
        () => {

          const currentlyOpen =
            menuButton.getAttribute(
              "aria-expanded"
            ) ===
            "true";


          setMenuState(
            !currentlyOpen
          );

        }
      );



    /* =====================================================
       CLOSE AFTER NAVIGATION
       ===================================================== */

    mobileLinks.forEach(
      (
        link
      ) => {

        link.addEventListener(
          "click",
          () => {

            setMenuState(
              false
            );

          }
        );

      }
    );



    /* =====================================================
       ESCAPE KEY
       ===================================================== */

    document.addEventListener(
      "keydown",
      (
        event
      ) => {

        if (
          event.key ===
            "Escape"
        ) {

          setMenuState(
            false
          );

        }

      }
    );



    /* =====================================================
       RESET WHEN DESKTOP BREAKPOINT IS REACHED
       ===================================================== */

    const desktopMediaQuery =
      window.matchMedia(
        "(min-width: 640px)"
      );


    const handleBreakpoint =
      (
        event
      ) => {

        if (
          event.matches
        ) {

          setMenuState(
            false
          );

        }

      };


    desktopMediaQuery.addEventListener(
      "change",
      handleBreakpoint
    );

  })();

</script>
