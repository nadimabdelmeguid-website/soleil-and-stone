---
import { readingTime } from "../utils/readingTime";

const { post } = Astro.props;

const readTime =
  readingTime(post.body ?? "");

const publishedDate =
  post.data.published.toLocaleDateString(
    "en-US",
    {
      month: "short",
      day: "numeric",
      year: "numeric"
    }
  );
---

<article
  class="
    bg-white
    border
    border-brand-border
    p-7
    sm:p-8
    h-full
    flex
    flex-col
  "
>

  <div
    class="
      flex
      flex-wrap
      items-center
      gap-2
      text-[10px]
      uppercase
      tracking-[0.15em]
      mb-5
    "
  >

    <span
      class="
        text-brand-gold
        font-semibold
      "
    >
      {post.data.category}
    </span>

    <span
      class="
        text-brand-border
      "
    >
      •
    </span>

    <span
      class="
        text-brand-slate
      "
    >
      {publishedDate}
    </span>

    <span
      class="
        text-brand-border
      "
    >
      •
    </span>

    <span
      class="
        text-brand-slate
      "
    >
      {readTime} min read
    </span>

  </div>


  <h3
    class="
      font-serif
      text-xl
      sm:text-2xl
      text-brand-charcoal
      leading-snug
      mb-4
    "
  >
    {post.data.title}
  </h3>


  <p
    class="
      text-sm
      text-brand-slate
      leading-relaxed
      font-light
      mb-7
    "
  >
    {post.data.description}
  </p>


  <a
    href={`/field-notes/${post.id}/`}
    class="
      mt-auto
      inline-flex
      items-center
      gap-2
      text-xs
      uppercase
      tracking-widest
      font-semibold
      text-brand-charcoal
      hover:text-brand-gold
      transition-colors
    "
  >
    Read Field Note
    <span>→</span>
  </a>

</article>
