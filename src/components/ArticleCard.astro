---
import { readingTime } from "../utils/readingTime";

const {
  post
} = Astro.props;

const publishedDate =
  post.data.published.toLocaleDateString(
    "en-US",
    {
      month: "short",
      day: "numeric",
      year: "numeric"
    }
  );

const minutes =
  readingTime(
    post.body ?? ""
  );

const href =
  `/field-notes/${post.id}/`;
---

<article
  class="
    group
    h-full
    bg-white
    border
    border-brand-border
    overflow-hidden
    transition-all
    duration-300
    hover:-translate-y-1
    hover:shadow-[0_12px_30px_rgba(34,37,42,0.08)]
    hover:border-brand-gold/50
  "
>

  <a
    href={href}
    class="
      flex
      flex-col
      h-full
      p-7
      sm:p-8
    "
  >

    <!-- TOP META -->

    <div
      class="
        flex
        flex-wrap
        items-center
        gap-x-3
        gap-y-2
        mb-6
        text-[10px]
        uppercase
        tracking-[0.16em]
        font-medium
      "
    >

      <span
        class="
          text-brand-gold
        "
      >
        {post.data.category}
      </span>


      <span
        class="
          text-brand-border
        "
      >
        •
      </span>


      <span
        class="
          text-brand-slate
        "
      >
        {publishedDate}
      </span>


      <span
        class="
          text-brand-border
        "
      >
        •
      </span>


      <span
        class="
          text-brand-slate
        "
      >
        {minutes} min read
      </span>

    </div>


    <!-- TITLE -->

    <h3
      class="
        font-serif
        text-2xl
        sm:text-[1.7rem]
        leading-[1.35]
        text-brand-charcoal
        mb-5
        transition-colors
        duration-300
        group-hover:text-brand-gold
      "
    >
      {post.data.title}
    </h3>


    <!-- DESCRIPTION -->

    <p
      class="
        text-sm
        sm:text-[15px]
        text-brand-slate
        leading-7
        font-light
        mb-8
      "
    >
      {post.data.description}
    </p>


    <!-- READ MORE -->

    <div
      class="
        mt-auto
        pt-5
        border-t
        border-brand-border
        flex
        items-center
        justify-between
        gap-4
      "
    >

      <span
        class="
          text-[11px]
          uppercase
          tracking-[0.18em]
          font-semibold
          text-brand-charcoal
          transition-colors
          duration-300
          group-hover:text-brand-gold
        "
      >
        Read Field Note
      </span>


      <span
        class="
          text-lg
          text-brand-gold
          transition-transform
          duration-300
          group-hover:translate-x-1
        "
        aria-hidden="true"
      >
        →
      </span>

    </div>

  </a>

</article>
