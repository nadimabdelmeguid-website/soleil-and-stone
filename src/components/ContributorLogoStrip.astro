---
const {
  eyebrow = "Community Contributors",
  title = "Speakers & Sponsors",
  description = "",
  logos = [],
  emptyMessage = "Contributor logos will appear here as sponsors and speakers are linked in the CMS.",
  background = "cream"
} = Astro.props;
---

<section
  class:list={[
    "border-b",
    "border-brand-border",
    background === "white"
      ? "bg-white"
      : "bg-brand-cream"
  ]}
>
  <div class="max-w-6xl w-full mx-auto px-6 pt-5 pb-16">
    <div class="mb-8">
      <span class="text-[10px] uppercase tracking-[0.2em] text-brand-gold font-semibold">
        {eyebrow}
      </span>

      <h3 class="font-serif text-2xl sm:text-3xl font-normal text-brand-charcoal mt-2 mb-3">
        {title}
      </h3>

      {
        description && (
          <p class="text-sm sm:text-base text-brand-slate leading-relaxed font-light max-w-3xl">
            {description}
          </p>
        )
      }
    </div>

    {
      logos.length > 0 ? (
        <div class="contributor-logo-grid">
          {
            logos.map((logo) => (
              logo.url ? (
                <a
                  href={logo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contributor-logo-card"
                  aria-label={`Visit ${logo.name}`}
                  title={logo.name}
                >
                  <img
                    src={logo.image}
                    alt={`${logo.name} logo`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <div
                  class="contributor-logo-card"
                  title={logo.name}
                >
                  <img
                    src={logo.image}
                    alt={`${logo.name} logo`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )
            ))
          }
        </div>
      ) : (
        <div class="contributor-empty">
          <span class="contributor-empty-mark">+</span>
          <div>
            <strong>Contributor logos</strong>
            <p>{emptyMessage}</p>
          </div>
        </div>
      )
    }

    {
      logos.length > 0 && (
        <p class="mt-4 text-[10px] uppercase tracking-[0.15em] text-brand-slate">
          Select a logo to visit the organization's website.
        </p>
      )
    }
  </div>
</section>

<style>
  .contributor-logo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid #DDD8CB;
    background: #DDD8CB;
  }

  .contributor-logo-card {
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px;
    background: #fff;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .contributor-logo-card:hover {
    background: #F8F6F0;
  }

  .contributor-logo-card img {
    display: block;
    width: 100%;
    max-width: 160px;
    max-height: 62px;
    object-fit: contain;
  }

  .contributor-empty {
    min-height: 120px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px;
    border: 1px dashed #C8C1B3;
    background: rgba(255,255,255,.54);
    color: #4A505A;
  }

  .contributor-empty-mark {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #C5A059;
    color: #C5A059;
    font-family: "Cinzel", Georgia, serif;
    font-size: 22px;
  }

  .contributor-empty strong {
    display: block;
    color: #22252A;
    font-family: "Cinzel", Georgia, serif;
    font-size: 15px;
    font-weight: 400;
  }

  .contributor-empty p {
    margin-top: 4px;
    font-size: 12px;
    line-height: 1.6;
    font-weight: 300;
  }

  @media (min-width: 640px) {
    .contributor-logo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .contributor-logo-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
