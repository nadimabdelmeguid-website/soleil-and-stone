---
import { events } from "../data/events";
import { completedHostedEventCount } from "../utils/events";

const {
  community
} = Astro.props;

const eventCount =
  completedHostedEventCount(
    events,
    community.id,
    2026
  );

const hasLinkedInMetric =
  community.linkedinFollowers !== undefined &&
  community.linkedinFollowers !== null;

const metricColumns =
  hasLinkedInMetric
    ? "sm:grid-cols-3"
    : "sm:grid-cols-2";
---

<section
  class="
    max-w-6xl
    w-full
    mx-auto
    px-6
    py-16
    border-b
    border-brand-border
  "
>

  <div
    class="
      grid
      lg:grid-cols-12
      gap-10
      xl:gap-14
      items-start
    "
  >

    <!-- =================================================
         LEFT COLUMN
         ================================================= -->

    <div
      class="
        lg:col-span-5
      "
    >

      <span
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        {community.roleLabel}
      </span>


      <h2
        class="
          font-serif
          text-2xl
          sm:text-3xl
          lg:text-[2rem]
          leading-snug
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        {community.name}
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          sm:text-base
          leading-relaxed
          font-light
          mb-7
        "
      >
        {community.description}
      </p>


      <div
        class="
          flex
          flex-wrap
          gap-3
        "
      >

        <!-- PRIMARY -->

        <a
          href={community.primaryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="
            px-5
            py-2.5
            bg-brand-charcoal
            text-white
            text-xs
            uppercase
            tracking-widest
            hover:bg-brand-gold
            transition-colors
            inline-flex
            items-center
            gap-2
          "
        >
          {community.primaryLabel}
          <span>↗</span>
        </a>


        <!-- LINKEDIN -->

        {
          community.linkedinUrl && (
            <a
              href={community.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="
                px-5
                py-2.5
                border
                border-brand-border
                text-brand-slate
                text-xs
                uppercase
                tracking-widest
                hover:border-brand-gold
                hover:text-brand-gold
                transition-colors
                inline-flex
                items-center
                gap-2
              "
            >
              Follow on LinkedIn
              <span>↗</span>
            </a>
          )
        }


        <!-- SECONDARY -->

        <a
          href={community.secondaryUrl}
          class="
            px-5
            py-2.5
            border
            border-brand-charcoal
            text-brand-charcoal
            text-xs
            uppercase
            tracking-widest
            hover:border-brand-gold
            hover:text-brand-gold
            transition-colors
            inline-flex
            items-center
            gap-2
          "
        >
          {community.secondaryLabel}
          <span>→</span>
        </a>

      </div>

    </div>



    <!-- =================================================
         RIGHT COLUMN
         ================================================= -->

    <div
      class="
        lg:col-span-7
        bg-brand-card
        border
        border-brand-border
        shadow-sm
        p-6
        sm:p-8
      "
    >

      <!-- PILLARS -->

      <h3
        class="
          font-serif
          text-lg
          sm:text-xl
          text-brand-charcoal
          mb-4
          pb-3
          border-b
          border-brand-border
        "
      >
        {community.pillarsTitle}
      </h3>


      <ul
        class="
          space-y-5
          text-sm
          text-brand-slate
          font-light
        "
      >

        {
          community.pillars.map(
            (pillar) => (
              <li
                class="
                  flex
                  items-start
                  gap-3
                "
              >

                <span
                  class="
                    text-brand-gold
                    font-bold
                    mt-[1px]
                  "
                >
                  •
                </span>


                <p
                  class="
                    leading-relaxed
                  "
                >

                  <strong
                    class="
                      font-medium
                      text-brand-charcoal
                    "
                  >
                    {pillar.title}:
                  </strong>

                  {" "}

                  {pillar.text}

                </p>

              </li>
            )
          )
        }

      </ul>



      <!-- METRICS -->

      <div
        class="
          mt-8
          pt-6
          border-t
          border-brand-border
        "
      >

        <h4
          class="
            text-xs
            uppercase
            tracking-widest
            font-semibold
            text-brand-charcoal
            mb-4
          "
        >
          Community Metrics
        </h4>


        <div
          class:list={[
            "grid grid-cols-1 gap-4",
            metricColumns
          ]}
        >

          <!-- MEMBERS -->

          <div
            class="
              p-5
              bg-brand-cream
              border
              border-brand-border
              text-center
            "
          >

            <div
              class="
                font-serif
                text-2xl
                sm:text-3xl
                text-brand-gold
                font-semibold
              "
            >
              {community.members}
              {community.membersSuffix || ""}
            </div>


            <div
              class="
                text-[11px]
                text-brand-slate
                uppercase
                tracking-wider
                mt-2
              "
            >
              {community.membersLabel}
            </div>

          </div>


          <!-- LINKEDIN FOLLOWERS -->

          {
            hasLinkedInMetric && (
              <div
                class="
                  p-5
                  bg-brand-cream
                  border
                  border-brand-border
                  text-center
                "
              >

                <div
                  class="
                    font-serif
                    text-2xl
                    sm:text-3xl
                    text-brand-gold
                    font-semibold
                  "
                >
                  {community.linkedinFollowers}
                  {community.linkedinFollowersSuffix || ""}
                </div>


                <div
                  class="
                    text-[11px]
                    text-brand-slate
                    uppercase
                    tracking-wider
                    mt-2
                  "
                >
                  {community.linkedinFollowersLabel}
                </div>

              </div>
            )
          }


          <!-- EVENT COUNT -->

          <div
            class="
              p-5
              bg-brand-cream
              border
              border-brand-border
              text-center
            "
          >

            <div
              class="
                font-serif
                text-2xl
                sm:text-3xl
                text-brand-charcoal
                font-semibold
              "
            >
              {eventCount}
            </div>


            <div
              class="
                text-[11px]
                text-brand-slate
                uppercase
                tracking-wider
                mt-2
              "
            >
              Events Hosted in 2026
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>
