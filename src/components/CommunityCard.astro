<div
  class="
    flex
    items-start
    justify-between
    gap-3
  "
>

  <div>

    <div
      class="
        inline-flex
        px-2
        py-1
        bg-brand-gold/10
        text-[9px]
        uppercase
        tracking-[0.16em]
        text-brand-gold
        font-semibold
        mb-3
      "
    >
      {formatMonth(
        event.startDate
      )}
    </div>


    <a
      href={event.url}
      target="_blank"
      rel="noopener noreferrer"
      class="
        block
        font-serif
        text-lg
        text-brand-charcoal
        group-hover:text-brand-gold
        transition-colors
      "
    >
      Startup Mixer
    </a>

  </div>


  <a
    href={event.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${event.title}`}
    class="
      text-xs
      text-brand-slate
      hover:text-brand-gold
      transition-colors
    "
  >
    ↗
  </a>

</div>
