---
import {
  events
} from "../data/events";

import {
  isCompletedEvent
} from "../utils/eventMetrics";


const {
  community
} = Astro.props;


/*
 * Completed events led through this community.
 */

const communityEvents =
  events
    .filter(
      (event) =>
        event.communityId ===
          community.id &&
        isCompletedEvent(
          event
        ) &&
        (
          event.participation ===
            "hosted" ||
          event.participation ===
            "co-organized"
        )
    )
    .sort(
      (a, b) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime()
    );


const registrations =
  communityEvents.reduce(
    (
      total,
      event
    ) =>
      total +
      (
        event.registrations ??
        0
      ),
    0
  );


const speakers =
  communityEvents.flatMap(
    (event) =>
      event.speakers ??
      []
  );


const sponsors =
  Array.from(
    new Set(
      communityEvents.flatMap(
        (event) =>
          event.sponsors ??
          []
      )
    )
  );


function formatMonth(
  date: string
) {

  return new Date(
    `${date}T12:00:00`
  ).toLocaleDateString(
    "en-US",
    {
      month:
        "long",

      year:
        "numeric"
    }
  );

}


/*
 * Shorter Hardware Meetup title for
 * the programming cards.
 */

function hardwareTopic(
  title: string
) {

  if (
    title.includes(
      "|"
    )
  ) {

    return title
      .split("|")
      .slice(1)
      .join("|")
      .trim();

  }


  return title;

}
---

<section
  id={community.id}
  class="
    max-w-6xl
    w-full
    mx-auto
    px-6
    py-16
    border-b
    border-brand-border
  "
>

  <!-- =====================================================
       TOP
       ===================================================== -->

  <div
    class="
      grid
      lg:grid-cols-12
      gap-10
      items-start
    "
  >

    <!-- =================================================
         COMMUNITY INTRO
         ================================================= -->

    <div
      class="
        lg:col-span-5
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.18em]
          text-brand-gold
          font-semibold
        "
      >
        {community.role}
      </span>


      <h2
        class="
          font-serif
          text-3xl
          sm:text-4xl
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        {community.name}
      </h2>


      <p
        class="
          text-sm
          sm:text-base
          text-brand-slate
          leading-relaxed
          font-light
          mb-7
        "
      >
        {community.description}
      </p>



      <!-- BUTTONS -->

      <div
        class="
          flex
          flex-wrap
          gap-3
        "
      >

        <a
          href={community.primaryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            bg-brand-charcoal
            text-white
            text-[10px]
            uppercase
            tracking-[0.16em]
            font-semibold
            hover:bg-brand-gold
            transition-colors
          "
        >
          {community.primaryLabel}

          <span>
            ↗
          </span>
        </a>


        {
          community.secondaryUrl && (
            <a
              href={community.secondaryUrl}
              class="
                inline-flex
                items-center
                gap-2
                px-5
                py-3
                border
                border-brand-border
                text-brand-charcoal
                text-[10px]
                uppercase
                tracking-[0.16em]
                font-semibold
                hover:border-brand-gold
                hover:text-brand-gold
                transition-colors
              "
            >
              {community.secondaryLabel}

              <span>
                →
              </span>
            </a>
          )
        }

      </div>

    </div>



    <!-- =================================================
         FOCUS + METRICS
         ================================================= -->

    <div
      class="
        lg:col-span-7
        bg-brand-cream
        border
        border-brand-border
        p-7
      "
    >

      <!-- METRICS -->

      <div
        class="
          grid
          grid-cols-2
          sm:grid-cols-3
          gap-6
          pb-7
          border-b
          border-brand-border
        "
      >

        <div>

          <div
            class="
              font-serif
              text-2xl
              text-brand-charcoal
            "
          >
            {community.members}+
          </div>


          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mt-1
            "
          >
            Members
          </div>

        </div>


        <div>

          <div
            class="
              font-serif
              text-2xl
              text-brand-charcoal
            "
          >
            {communityEvents.length}
          </div>


          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mt-1
            "
          >
            Events Led
          </div>

        </div>


        <div>

          <div
            class="
              font-serif
              text-2xl
              text-brand-gold
            "
          >
            {
              registrations > 0
                ? `${registrations}+`
                : "—"
            }
          </div>


          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mt-1
            "
          >
            Registrations
          </div>

        </div>

      </div>



      <!-- FOCUS -->

      <div
        class="
          pt-7
        "
      >

        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.18em]
            text-brand-gold
            font-semibold
            mb-4
          "
        >
          Focus
        </div>


        <div
          class="
            grid
            sm:grid-cols-2
            gap-x-6
            gap-y-3
          "
        >

          {
            community.focus.map(
              (item) => (
                <div
                  class="
                    flex
                    items-start
                    gap-3
                    text-xs
                    text-brand-slate
                    leading-relaxed
                  "
                >

                  <span
                    class="
                      text-brand-gold
                      mt-[2px]
                    "
                  >
                    —
                  </span>

                  <span>
                    {item}
                  </span>

                </div>
              )
            )
          }

        </div>

      </div>

    </div>

  </div>



  <!-- =====================================================
       PROGRAMMING
       ===================================================== -->

  {
    communityEvents.length > 0 && (

      <div
        class="
          mt-10
        "
      >

        <div
          class="
            flex
            flex-col
            sm:flex-row
            sm:items-end
            justify-between
            gap-3
            mb-6
          "
        >

          <div>

            <span
              class="
                text-[9px]
                uppercase
                tracking-[0.18em]
                text-brand-gold
                font-semibold
              "
            >
              Track Record
            </span>


            <h3
              class="
                font-serif
                text-2xl
                text-brand-charcoal
                mt-1
              "
            >
              {
                community.id ===
                  "startup-mixer"
                  ? "Mixer History"
                  : "Recent Programming"
              }
            </h3>

          </div>


          {
            community.id ===
              "hardware-meetup" && (
              <p
                class="
                  text-xs
                  text-brand-slate
                  font-light
                "
              >
                Technical sessions with founders,
                engineers and industry practitioners.
              </p>
            )
          }

        </div>



        <!-- =================================================
             STARTUP MIXER HISTORY
             ================================================= -->

        {
          community.id ===
            "startup-mixer" && (

            <div
              class="
                grid
                sm:grid-cols-2
                lg:grid-cols-3
                gap-px
                bg-brand-border
                border
                border-brand-border
              "
            >

              {
                communityEvents.map(
                  (event) => (

                    <a
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="
                        group
                        bg-white
                        p-5
                        hover:bg-brand-cream
                        transition-colors
                      "
                    >

                      <div
                        class="
                          flex
                          items-start
                          justify-between
                          gap-4
                        "
                      >

                        <div>

                          <div
                            class="
                              font-serif
                              text-lg
                              text-brand-charcoal
                              group-hover:text-brand-gold
                              transition-colors
                            "
                          >
                            {formatMonth(
                              event.startDate
                            )}
                          </div>


                          <div
                            class="
                              text-[10px]
                              uppercase
                              tracking-[0.13em]
                              text-brand-slate
                              mt-1
                            "
                          >
                            San Diego County Startup Mixer
                          </div>

                        </div>


                        <span
                          class="
                            text-brand-slate
                            text-xs
                          "
                        >
                          ↗
                        </span>

                      </div>


                      {
                        typeof event.registrations ===
                          "number" && (

                          <div
                            class="
                              mt-5
                              pt-4
                              border-t
                              border-brand-border
                            "
                          >

                            <span
                              class="
                                font-serif
                                text-xl
                                text-brand-gold
                              "
                            >
                              {event.registrations}
                            </span>


                            <span
                              class="
                                text-[9px]
                                uppercase
                                tracking-[0.13em]
                                text-brand-slate
                                ml-2
                              "
                            >
                              registrations
                            </span>

                          </div>

                        )
                      }

                    </a>

                  )
                )
              }

            </div>

          )
        }



        <!-- =================================================
             HARDWARE PROGRAMMING
             ================================================= -->

        {
          community.id ===
            "hardware-meetup" && (

            <div
              class="
                grid
                lg:grid-cols-3
                gap-5
              "
            >

              {
                communityEvents.map(
                  (event) => (

                    <article
                      class="
                        bg-white
                        border
                        border-brand-border
                        p-6
                      "
                    >

                      <!-- MONTH -->

                      <div
                        class="
                          flex
                          items-center
                          justify-between
                          gap-3
                          mb-4
                        "
                      >

                        <span
                          class="
                            text-[9px]
                            uppercase
                            tracking-[0.15em]
                            text-brand-gold
                            font-semibold
                          "
                        >
                          {formatMonth(
                            event.startDate
                          )}
                        </span>


                        {
                          typeof event.registrations ===
                            "number" && (

                            <span
                              class="
                                text-[9px]
                                uppercase
                                tracking-[0.12em]
                                text-brand-slate
                              "
                            >
                              {event.registrations}
                              {" "}
                              registrations
                            </span>

                          )
                        }

                      </div>



                      <!-- TOPIC -->

                      <h4
                        class="
                          font-serif
                          text-xl
                          text-brand-charcoal
                          leading-snug
                          min-h-[52px]
                        "
                      >
                        {hardwareTopic(
                          event.title
                        )}
                      </h4>



                      <!-- SPONSOR -->

                      {
                        event.sponsors?.length > 0 && (

                          <div
                            class="
                              mt-5
                              pt-4
                              border-t
                              border-brand-border
                            "
                          >

                            <div
                              class="
                                text-[8px]
                                uppercase
                                tracking-[0.15em]
                                text-brand-slate
                                mb-1
                              "
                            >
                              Event Sponsor
                            </div>


                            <div
                              class="
                                text-xs
                                font-semibold
                                text-brand-charcoal
                              "
                            >
                              {event.sponsors.join(
                                ", "
                              )}
                            </div>

                          </div>

                        )
                      }



                      <!-- SPEAKERS -->

                      {
                        event.speakers?.length > 0 && (

                          <div
                            class="
                              mt-5
                            "
                          >

                            <div
                              class="
                                text-[8px]
                                uppercase
                                tracking-[0.15em]
                                text-brand-slate
                                mb-3
                              "
                            >
                              Speakers
                            </div>


                            <div
                              class="
                                space-y-3
                              "
                            >

                              {
                                event.speakers.map(
                                  (speaker) => (

                                    <div>

                                      <div
                                        class="
                                          text-xs
                                          font-semibold
                                          text-brand-charcoal
                                        "
                                      >
                                        {speaker.name}
                                      </div>


                                      <div
                                        class="
                                          text-[10px]
                                          text-brand-slate
                                          mt-0.5
                                        "
                                      >
                                        {speaker.company}

                                        {
                                          speaker.title
                                            ? ` · ${speaker.title}`
                                            : ""
                                        }
                                      </div>

                                    </div>

                                  )
                                )
                              }

                            </div>

                          </div>

                        )
                      }



                      <!-- LINK -->

                      <a
                        href={event.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="
                          inline-flex
                          items-center
                          gap-2
                          mt-6
                          text-[9px]
                          uppercase
                          tracking-[0.15em]
                          text-brand-charcoal
                          font-semibold
                          hover:text-brand-gold
                          transition-colors
                        "
                      >
                        View Event
                        <span>↗</span>
                      </a>

                    </article>

                  )
                )
              }

            </div>

          )
        }

      </div>

    )
  }

</section>
