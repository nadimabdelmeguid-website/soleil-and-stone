---
import {
  events
} from "../data/events";

import {
  getCommunityMetricsById
} from "../utils/eventMetrics";


const {
  community
} = Astro.props;


/* =========================================================
   AUTOMATED COMMUNITY-SPECIFIC METRICS
   ========================================================= */

const metrics =
  getCommunityMetricsById(
    events,
    community.id
  );


const communityEvents =
  metrics.events;


const registrations =
  metrics.registrations;


const speakers =
  metrics.speakers;


const sponsors =
  metrics.sponsors;


/* =========================================================
   DISPLAY HELPERS
   ========================================================= */

function formatMonth(
  date: string
) {

  return new Date(
    `${date}T12:00:00`
  ).toLocaleDateString(
    "en-US",
    {
      month:
        "long",

      year:
        "numeric"
    }
  );

}
---

<section
  id={community.id}
  class:list={[
    "border-b",
    "border-brand-border",

    community.id ===
      "hardware-meetup"
      ? "bg-brand-cream"
      : "bg-white"
  ]}
>

  <div
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
    "
  >

    <!-- =====================================================
         INTRO + SNAPSHOT
         ===================================================== -->

    <div
      class="
        grid
        lg:grid-cols-12
        gap-10
        items-start
      "
    >

      <!-- INTRO -->

      <div
        class="
          lg:col-span-5
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.18em]
            text-brand-gold
            font-semibold
          "
        >
          {community.role}
        </span>


        <h2
          class="
            font-serif
            text-3xl
            sm:text-4xl
            text-brand-charcoal
            mt-2
            mb-5
          "
        >
          {community.name}
        </h2>


        <p
          class="
            text-sm
            sm:text-base
            text-brand-slate
            leading-relaxed
            font-light
            mb-7
          "
        >
          {community.description}
        </p>


        <div
          class="
            flex
            flex-wrap
            gap-3
          "
        >

          <a
            href={community.primaryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="
              inline-flex
              items-center
              gap-2
              px-5
              py-3
              bg-brand-charcoal
              text-white
              text-[10px]
              uppercase
              tracking-[0.16em]
              font-semibold
              hover:bg-brand-gold
              transition-colors
            "
          >
            {community.primaryLabel}

            <span>
              ↗
            </span>
          </a>


          {
            community.secondaryUrl && (

              <a
                href={community.secondaryUrl}
                class="
                  inline-flex
                  items-center
                  gap-2
                  px-5
                  py-3
                  border
                  border-brand-border
                  text-brand-charcoal
                  text-[10px]
                  uppercase
                  tracking-[0.16em]
                  font-semibold
                  hover:border-brand-gold
                  hover:text-brand-gold
                  transition-colors
                "
              >
                {community.secondaryLabel}

                <span>
                  →
                </span>
              </a>

            )
          }

        </div>

      </div>



      <!-- SNAPSHOT -->

      <div
        class:list={[
          "lg:col-span-7",
          "border",
          "border-brand-border",
          "p-6",
          "sm:p-7",

          community.id ===
            "hardware-meetup"
            ? "bg-white"
            : "bg-brand-cream"
        ]}
      >

        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.18em]
            text-brand-gold
            font-semibold
            mb-5
          "
        >
          Community Snapshot
        </div>



        <!-- METRICS -->

        <div
          class="
            grid
            grid-cols-1
            sm:grid-cols-3
            gap-3
          "
        >

          <!-- MEMBERS -->

          <div
            class="
              bg-white
              border
              border-brand-border
              px-5
              py-5
            "
          >

            <div
              class="
                flex
                items-baseline
                gap-1
              "
            >

              <span
                class="
                  font-serif
                  text-3xl
                  text-brand-charcoal
                "
              >
                {community.members}
              </span>


              <span
                class="
                  font-serif
                  text-lg
                  text-brand-charcoal
                "
              >
                +
              </span>

            </div>


            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.15em]
                text-brand-slate
                mt-2
              "
            >
              Community Members
            </div>

          </div>



          <!-- EVENTS -->

          <div
            class="
              bg-white
              border
              border-brand-border
              px-5
              py-5
            "
          >

            <div
              class="
                font-serif
                text-3xl
                text-brand-charcoal
              "
            >
              {communityEvents.length}
            </div>


            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.15em]
                text-brand-slate
                mt-2
              "
            >
              Events Led
            </div>

          </div>



          <!-- REGISTRATIONS -->

          <div
            class="
              bg-white
              border
              border-brand-gold/40
              px-5
              py-5
            "
          >

            <div
              class="
                font-serif
                text-3xl
                text-brand-gold
              "
            >
              {
                registrations > 0
                  ? registrations
                  : "—"
              }
            </div>


            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.15em]
                text-brand-slate
                mt-2
              "
            >
              Registrations
            </div>

          </div>

        </div>



        <!-- HARDWARE SECONDARY METRICS -->

        {
          community.id ===
            "hardware-meetup" && (

            <div
              class="
                flex
                flex-wrap
                items-center
                gap-x-5
                gap-y-2
                mt-4
                text-[10px]
                text-brand-slate
              "
            >

              <span>
                <strong
                  class="
                    text-brand-charcoal
                  "
                >
                  {speakers.length}
                </strong>

                {" "}
                documented speakers
              </span>


              <span
                class="
                  text-brand-border
                "
              >
                •
              </span>


              <span>
                <strong
                  class="
                    text-brand-charcoal
                  "
                >
                  {sponsors.length}
                </strong>

                {" "}
                event sponsors
              </span>

            </div>

          )
        }



        <!-- FOCUS -->

        <div
          class="
            mt-7
            pt-6
            border-t
            border-brand-border
          "
        >

          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.18em]
              text-brand-gold
              font-semibold
              mb-4
            "
          >
            Focus
          </div>


          <div
            class="
              grid
              sm:grid-cols-2
              gap-x-8
              gap-y-3
            "
          >

            {
              community.focus.map(
                (item) => (

                  <div
                    class="
                      flex
                      items-start
                      gap-3
                      text-xs
                      text-brand-slate
                      leading-relaxed
                    "
                  >

                    <span
                      class="
                        text-brand-gold
                        mt-[1px]
                      "
                    >
                      —
                    </span>


                    <span>
                      {item}
                    </span>

                  </div>

                )
              )
            }

          </div>

        </div>

      </div>

    </div>



    <!-- =====================================================
         TRACK RECORD
         ===================================================== -->

    {
      communityEvents.length > 0 && (

        <div
          class="
            mt-12
          "
        >

          <div
            class="
              flex
              flex-col
              sm:flex-row
              sm:items-end
              justify-between
              gap-3
              mb-6
            "
          >

            <div>

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.18em]
                  text-brand-gold
                  font-semibold
                "
              >
                Track Record
              </span>


              <h3
                class="
                  font-serif
                  text-2xl
                  text-brand-charcoal
                  mt-1
                "
              >
                {
                  community.id ===
                    "startup-mixer"
                    ? "Mixer History"
                    : "Recent Programming"
                }
              </h3>

            </div>



            {
              community.id ===
                "startup-mixer" && (

                <p
                  class="
                    text-[9px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-slate
                  "
                >
                  Scroll to explore

                  <span
                    class="
                      ml-1
                    "
                  >
                    →
                  </span>
                </p>

              )
            }


            {
              community.id ===
                "hardware-meetup" && (

                <p
                  class="
                    text-xs
                    text-brand-slate
                    font-light
                    max-w-md
                    sm:text-right
                  "
                >
                  Technical conversations with founders,
                  engineers, designers and industry practitioners.
                </p>

              )
            }

          </div>



          <!-- =================================================
               MIXER HORIZONTAL HISTORY
               ================================================= -->

          {
            community.id ===
              "startup-mixer" && (

              <div
                class="
                  mixer-scroll
                  flex
                  flex-nowrap
                  gap-4
                  overflow-x-auto
                  pb-4
                  snap-x
                  snap-mandatory
                "
              >

                {
                  communityEvents.map(
                    (event) => (

                      <a
                        href={event.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="
                          group
                          flex-none
                          w-[230px]
                          sm:w-[250px]
                          bg-white
                          border
                          border-brand-border
                          p-5
                          snap-start
                          hover:border-brand-gold
                          transition-colors
                        "
                      >

                        <div
                          class="
                            flex
                            items-start
                            justify-between
                            gap-3
                          "
                        >

                          <div>

                            <div
                              class="
                                inline-flex
                                px-2
                                py-1
                                bg-brand-gold/10
                                text-[9px]
                                uppercase
                                tracking-[0.16em]
                                text-brand-gold
                                font-semibold
                                mb-3
                              "
                            >
                              {formatMonth(
                                event.startDate
                              )}
                            </div>


                            <div
                              class="
                                font-serif
                                text-lg
                                text-brand-charcoal
                                group-hover:text-brand-gold
                                transition-colors
                              "
                            >
                              Startup Mixer
                            </div>

                          </div>


                          <span
                            class="
                              text-xs
                              text-brand-slate
                            "
                          >
                            ↗
                          </span>

                        </div>


                        {
                          typeof event.registrations ===
                            "number" && (

                            <div
                              class="
                                mt-5
                                pt-4
                                border-t
                                border-brand-border
                              "
                            >

                              <span
                                class="
                                  font-serif
                                  text-xl
                                  text-brand-gold
                                "
                              >
                                {event.registrations}
                              </span>


                              <span
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.13em]
                                  text-brand-slate
                                  ml-2
                                "
                              >
                                registrations
                              </span>

                            </div>

                          )
                        }

                      </a>

                    )
                  )
                }

              </div>

            )
          }



          <!-- =================================================
               HARDWARE PROGRAMMING
               ================================================= -->

          {
            community.id ===
              "hardware-meetup" && (

              <div
                class="
                  grid
                  lg:grid-cols-3
                  gap-5
                "
              >

                {
                  communityEvents.map(
                    (event) => (

                      <article
                        class="
                          bg-white
                          border
                          border-brand-border
                          p-6
                          flex
                          flex-col
                          shadow-[0_1px_0_rgba(34,37,42,0.02)]
                        "
                      >

                        <!-- MONTH + REGISTRATIONS -->

                        <div
                          class="
                            flex
                            items-center
                            justify-between
                            gap-3
                            mb-4
                          "
                        >

                          <span
                            class="
                              inline-flex
                              px-2
                              py-1
                              bg-brand-gold/10
                              text-[9px]
                              uppercase
                              tracking-[0.15em]
                              text-brand-gold
                              font-semibold
                            "
                          >
                            {formatMonth(
                              event.startDate
                            )}
                          </span>


                          {
                            typeof event.registrations ===
                              "number" && (

                              <span
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.12em]
                                  text-brand-slate
                                "
                              >
                                {event.registrations}
                                {" "}
                                registrations
                              </span>

                            )
                          }

                        </div>



                        <!-- TITLE -->

                        <h4
                          class="
                            font-serif
                            text-xl
                            text-brand-charcoal
                            leading-snug
                          "
                        >
                          {event.title}
                        </h4>



                        <!-- SPONSOR -->

                        {
                          event.sponsors?.length > 0 && (

                            <div
                              class="
                                mt-5
                                p-3
                                bg-brand-cream
                                border
                                border-brand-border
                              "
                            >

                              <div
                                class="
                                  text-[8px]
                                  uppercase
                                  tracking-[0.15em]
                                  text-brand-slate
                                  mb-1
                                "
                              >
                                Sponsor
                              </div>


                              <div
                                class="
                                  text-xs
                                  font-semibold
                                  text-brand-charcoal
                                "
                              >
                                {event.sponsors.join(
                                  ", "
                                )}
                              </div>

                            </div>

                          )
                        }



                        <!-- SPEAKERS -->

                        {
                          event.speakers?.length > 0 && (

                            <div
                              class="
                                mt-5
                              "
                            >

                              <div
                                class="
                                  text-[8px]
                                  uppercase
                                  tracking-[0.15em]
                                  text-brand-slate
                                  mb-3
                                "
                              >
                                Speakers
                              </div>


                              <div
                                class="
                                  space-y-3
                                "
                              >

                                {
                                  event.speakers.map(
                                    (speaker) => (

                                      <div>

                                        <div
                                          class="
                                            text-xs
                                            font-semibold
                                            text-brand-charcoal
                                          "
                                        >
                                          {speaker.name}
                                        </div>


                                        <div
                                          class="
                                            text-[10px]
                                            text-brand-slate
                                            mt-0.5
                                            leading-relaxed
                                          "
                                        >
                                          {speaker.company}

                                          {
                                            speaker.title
                                              ? ` · ${speaker.title}`
                                              : ""
                                          }
                                        </div>

                                      </div>

                                    )
                                  )
                                }

                              </div>

                            </div>

                          )
                        }



                        <!-- LINK -->

                        <div
                          class="
                            mt-auto
                            pt-6
                          "
                        >

                          <a
                            href={event.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="
                              inline-flex
                              items-center
                              gap-2
                              text-[9px]
                              uppercase
                              tracking-[0.15em]
                              text-brand-charcoal
                              font-semibold
                              hover:text-brand-gold
                              transition-colors
                            "
                          >
                            View Event

                            <span>
                              ↗
                            </span>
                          </a>

                        </div>

                      </article>

                    )
                  )
                }

              </div>

            )
          }

        </div>

      )
    }

  </div>

</section>



<style>

  .mixer-scroll {
    scrollbar-width:
      thin;

    scrollbar-color:
      #C5A059
      #E8E5DA;
  }


  .mixer-scroll::-webkit-scrollbar {
    height:
      5px;
  }


  .mixer-scroll::-webkit-scrollbar-track {
    background:
      #E8E5DA;
  }


  .mixer-scroll::-webkit-scrollbar-thumb {
    background:
      #C5A059;
  }

</style>
