---
import {
  events
} from "../data/events.cms";

import {
  getCommunityMetricsById
} from "../utils/eventMetrics";

import {
  getEventRecapUrl
} from "../utils/eventRecaps";


const {
  community
} = Astro.props;


/* =========================================================
   AUTOMATED COMMUNITY-SPECIFIC METRICS
   ========================================================= */

const metrics =
  getCommunityMetricsById(
    events,
    community.id
  );


const communityEvents =
  metrics.events;


const registrations =
  metrics.registrations;


const speakers =
  metrics.speakers;


const sponsors =
  metrics.sponsors;


/* =========================================================
   DISPLAY HELPERS
   ========================================================= */

function formatMonth(
  date: string
) {

  return new Date(
    `${date}T12:00:00`
  ).toLocaleDateString(
    "en-US",
    {
      month:
        "long",

      year:
        "numeric"
    }
  );

}


function findCommunityCardImage(
  eventId: string
) {

  const event =
    events.find(
      (candidate) =>
        candidate.id ===
        eventId
    );


  return (
    event?.communityImage ||
    event?.image ||
    undefined
  );

}

---

<section
  id={community.id}
  class:list={[
    "border-b",
    "border-brand-border",

    community.id ===
      "hardware-meetup"
      ? "bg-brand-cream"
      : "bg-white"
  ]}
>

  <div
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
    "
  >

    <!-- =====================================================
         INTRO + SNAPSHOT
         ===================================================== -->

    <div
      class="
        grid
        lg:grid-cols-12
        gap-10
        items-start
      "
    >

      <!-- INTRO -->

      <div
        class="
          lg:col-span-5
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.18em]
            text-brand-gold
            font-semibold
          "
        >
          {community.role}
        </span>


        <h2
          class="
            font-serif
            text-3xl
            sm:text-4xl
            text-brand-charcoal
            mt-2
            mb-5
          "
        >
          {community.name}
        </h2>


        <p
          class="
            text-sm
            sm:text-base
            text-brand-slate
            leading-relaxed
            font-light
            mb-7
          "
        >
          {community.description}
        </p>


        <div
          class="
            flex
            flex-wrap
            gap-3
          "
        >

          <a
            href={community.primaryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="
              inline-flex
              items-center
              gap-2
              px-5
              py-3
              bg-brand-charcoal
              text-white
              text-[10px]
              uppercase
              tracking-[0.16em]
              font-semibold
              hover:bg-brand-gold
              transition-colors
            "
          >
            {community.primaryLabel}

            <span>
              ↗
            </span>
          </a>


          {
            community.secondaryUrl && (

              <a
                href={community.secondaryUrl}
                class="
                  inline-flex
                  items-center
                  gap-2
                  px-5
                  py-3
                  border
                  border-brand-border
                  text-brand-charcoal
                  text-[10px]
                  uppercase
                  tracking-[0.16em]
                  font-semibold
                  hover:border-brand-gold
                  hover:text-brand-gold
                  transition-colors
                "
              >
                {community.secondaryLabel}

                <span>
                  →
                </span>
              </a>

            )
          }

        </div>

      </div>



      <!-- SNAPSHOT -->

      <div
        class:list={[
          "lg:col-span-7",
          "border",
          "border-brand-border",
          "p-6",
          "sm:p-7",

          community.id ===
            "hardware-meetup"
            ? "bg-white"
            : "bg-brand-cream"
        ]}
      >

        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.18em]
            text-brand-gold
            font-semibold
            mb-5
          "
        >
          Community Snapshot
        </div>



        <!-- METRICS -->

        <div
          class="
            grid
            grid-cols-1
            sm:grid-cols-3
            gap-3
          "
        >

          <!-- MEMBERS -->

          <div
            class="
              bg-white
              border
              border-brand-border
              px-5
              py-5
            "
          >

            <div
              class="
                flex
                items-baseline
                gap-1
              "
            >

              <span
                class="
                  font-serif
                  text-3xl
                  text-brand-charcoal
                "
              >
                {community.members}
              </span>


              <span
                class="
                  font-serif
                  text-lg
                  text-brand-charcoal
                "
              >
                +
              </span>

            </div>


            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.15em]
                text-brand-slate
                mt-2
              "
            >
              Community Members
            </div>

          </div>



          <!-- EVENTS -->

          <div
            class="
              bg-white
              border
              border-brand-border
              px-5
              py-5
            "
          >

            <div
              class="
                font-serif
                text-3xl
                text-brand-charcoal
              "
            >
              {communityEvents.length}
            </div>


            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.15em]
                text-brand-slate
                mt-2
              "
            >
              Events Led
            </div>

          </div>



          <!-- REGISTRATIONS -->

          <div
            class="
              bg-white
              border
              border-brand-gold/40
              px-5
              py-5
            "
          >

            <div
              class="
                font-serif
                text-3xl
                text-brand-gold
              "
            >
              {
                registrations > 0
                  ? registrations
                  : "—"
              }
            </div>


            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.15em]
                text-brand-slate
                mt-2
              "
            >
              Registrations
            </div>

          </div>

        </div>



        <!-- HARDWARE SECONDARY METRICS -->

        {
          community.id ===
            "hardware-meetup" && (

            <div
              class="
                flex
                flex-wrap
                items-center
                gap-x-5
                gap-y-2
                mt-4
                text-[10px]
                text-brand-slate
              "
            >

              <span>

                <strong
                  class="
                    text-brand-charcoal
                  "
                >
                  {speakers.length}
                </strong>

                {" "}
                documented speakers

              </span>


              <span
                class="
                  text-brand-border
                "
              >
                •
              </span>


              <span>

                <strong
                  class="
                    text-brand-charcoal
                  "
                >
                  {sponsors.length}
                </strong>

                {" "}
                event sponsors

              </span>

            </div>

          )
        }



        <!-- FOCUS -->

        <div
          class="
            mt-7
            pt-6
            border-t
            border-brand-border
          "
        >

          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.18em]
              text-brand-gold
              font-semibold
              mb-4
            "
          >
            Focus
          </div>


          <div
            class="
              grid
              sm:grid-cols-2
              gap-x-8
              gap-y-3
            "
          >

            {
              community.focus.map(
                (item) => (

                  <div
                    class="
                      flex
                      items-start
                      gap-3
                      text-xs
                      text-brand-slate
                      leading-relaxed
                    "
                  >

                    <span
                      class="
                        text-brand-gold
                        mt-[1px]
                      "
                    >
                      —
                    </span>


                    <span>
                      {item}
                    </span>

                  </div>

                )
              )
            }

          </div>

        </div>

      </div>

    </div>



    <!-- =====================================================
         TRACK RECORD
         ===================================================== -->

    {
      communityEvents.length > 0 && (

        <div
          class="
            mt-12
          "
        >

          <!-- SECTION HEADER -->

          <div
            class="
              flex
              flex-col
              sm:flex-row
              sm:items-end
              justify-between
              gap-3
              mb-6
            "
          >

            <div>

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.18em]
                  text-brand-gold
                  font-semibold
                "
              >
                Track Record
              </span>


              <h3
                class="
                  font-serif
                  text-2xl
                  text-brand-charcoal
                  mt-1
                "
              >
                {
                  community.id ===
                    "startup-mixer"
                    ? "Mixer History"
                    : "Recent Programming"
                }
              </h3>

            </div>



            {
              community.id ===
                "startup-mixer" && (

                <p
                  class="
                    text-[9px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-slate
                  "
                >
                  Scroll to explore

                  <span
                    class="
                      ml-1
                    "
                  >
                    →
                  </span>

                </p>

              )
            }


            {
              community.id ===
                "hardware-meetup" && (

                <p
                  class="
                    text-xs
                    text-brand-slate
                    font-light
                    max-w-md
                    sm:text-right
                  "
                >
                  Technical conversations with founders,
                  engineers, designers and industry practitioners.
                </p>

              )
            }

          </div>



          <!-- =================================================
               MIXER HISTORY
               ================================================= -->

          {
            community.id ===
              "startup-mixer" && (

              <div
                class="
                  mixer-scroll
                  flex
                  flex-nowrap
                  gap-4
                  overflow-x-auto
                  pb-4
                  snap-x
                  snap-mandatory
                "
              >

                {
                  communityEvents.map(
                    (event) => {

                      const cardImage =
                        findCommunityCardImage(
                          event.id
                        );


                      const recapUrl =
                        getEventRecapUrl(
                          event.id
                        );


                      return (

                        <article
                          class="
                            group
                            flex-none
                            w-[230px]
                            sm:w-[250px]
                            bg-white
                            border
                            border-brand-border
                            snap-start
                            overflow-hidden
                            flex
                            flex-col
                            hover:border-brand-gold
                            transition-colors
                          "
                        >

                          <!-- OPTIONAL IMAGE -->

                          {
                            cardImage && (

                              <a
                                href={event.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="
                                  block
                                  overflow-hidden
                                  border-b
                                  border-brand-border
                                "
                              >

                                <img
                                  src={cardImage}
                                  alt={`${event.title} event`}
                                  loading="lazy"
                                  decoding="async"
                                  class="
                                    block
                                    w-full
                                    aspect-[16/9]
                                    object-cover
                                    transition-transform
                                    duration-300
                                    group-hover:scale-[1.02]
                                  "
                                />

                              </a>

                            )
                          }



                          <!-- CARD BODY -->

                          <div
                            class="
                              p-5
                              flex
                              flex-col
                              flex-1
                            "
                          >

                            <!-- TITLE + DATE -->

                            <div
                              class="
                                flex
                                items-start
                                justify-between
                                gap-3
                              "
                            >

                              <a
                                href={event.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="
                                  flex
                                  flex-wrap
                                  items-baseline
                                  gap-x-2
                                  gap-y-1
                                  min-w-0
                                  text-brand-charcoal
                                  group-hover:text-brand-gold
                                  transition-colors
                                "
                              >

                                <span
                                  class="
                                    font-serif
                                    text-lg
                                    leading-snug
                                    whitespace-nowrap
                                  "
                                >
                                  Startup Mixer
                                </span>


                                <span
                                  class="
                                    font-sans
                                    text-[9px]
                                    uppercase
                                    tracking-[0.14em]
                                    text-brand-gold
                                    font-semibold
                                    whitespace-nowrap
                                  "
                                >
                                  — {formatMonth(
                                    event.startDate
                                  )}
                                </span>

                              </a>


                              <a
                                href={event.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`View ${event.title}`}
                                class="
                                  shrink-0
                                  text-xs
                                  text-brand-slate
                                  hover:text-brand-gold
                                  transition-colors
                                  mt-1
                                "
                              >
                                ↗
                              </a>

                            </div>



                            <!-- RECAP -->

                            {
                              recapUrl && (

                                <div
                                  class="
                                    mt-auto
                                    pt-5
                                  "
                                >

                                  <div
                                    class="
                                      pt-4
                                      border-t
                                      border-brand-border
                                    "
                                  >

                                    <a
                                      href={recapUrl}
                                      class="
                                        inline-flex
                                        items-center
                                        gap-2
                                        text-[9px]
                                        uppercase
                                        tracking-[0.15em]
                                        text-brand-gold
                                        font-semibold
                                        hover:text-brand-charcoal
                                        transition-colors
                                      "
                                    >
                                      Read Recap

                                      <span>
                                        →
                                      </span>

                                    </a>

                                  </div>

                                </div>

                              )
                            }

                          </div>

                        </article>

                      );

                    }
                  )
                }

              </div>

            )
          }



          <!-- =================================================
               HARDWARE PROGRAMMING
               MOBILE = ONE-CARD SWIPE
               DESKTOP = ORIGINAL THREE-COLUMN GRID
               ================================================= -->

          {
            community.id ===
              "hardware-meetup" && (

              <div
                class="
                  hardware-programming-shell
                "
              >

                <div
                  class="
                    hardware-programming-scroll
                    flex
                    overflow-x-auto
                    snap-x
                    snap-mandatory
                  "
                  aria-label="Recent hardware meetup programming"
                >

                  {
                    communityEvents.map(
                      (event) => {

                        const cardImage =
                          findCommunityCardImage(
                            event.id
                          );


                        const recapUrl =
                          getEventRecapUrl(
                            event.id
                          );


                        return (

                          <article
                            class="
                              hardware-programming-card
                              snap-start
                              bg-white
                              border
                              border-brand-border
                              flex
                              flex-col
                              overflow-hidden
                              shadow-[0_1px_0_rgba(34,37,42,0.02)]
                            "
                          >

                            <!-- OPTIONAL IMAGE -->

                            {
                              cardImage && (

                                <a
                                  href={event.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="
                                    group/hardware-image
                                    block
                                    overflow-hidden
                                    border-b
                                    border-brand-border
                                  "
                                >

                                  <img
                                    src={cardImage}
                                    alt={`${event.title} event`}
                                    loading="lazy"
                                    decoding="async"
                                    class="
                                      block
                                      w-full
                                      aspect-[16/9]
                                      object-cover
                                      transition-transform
                                      duration-300
                                      group-hover/hardware-image:scale-[1.02]
                                    "
                                  />

                                </a>

                              )
                            }



                            <!-- CARD BODY -->

                            <div
                              class="
                                p-5
                                sm:p-6
                                flex
                                flex-col
                                flex-1
                              "
                            >

                              <!-- DATE + REGISTRATIONS -->

                              <div
                                class="
                                  flex
                                  flex-wrap
                                  items-center
                                  justify-between
                                  gap-3
                                  mb-4
                                "
                              >

                                <span
                                  class="
                                    inline-flex
                                    px-2
                                    py-1
                                    bg-brand-gold/10
                                    text-[9px]
                                    uppercase
                                    tracking-[0.15em]
                                    text-brand-gold
                                    font-semibold
                                  "
                                >
                                  {formatMonth(
                                    event.startDate
                                  )}
                                </span>


                                {
                                  typeof event.registrations ===
                                    "number" && (

                                    <span
                                      class="
                                        text-[9px]
                                        uppercase
                                        tracking-[0.12em]
                                        text-brand-slate
                                      "
                                    >
                                      {event.registrations}
                                      {" "}
                                      registrations
                                    </span>

                                  )
                                }

                              </div>



                              <!-- TITLE -->

                              <h4
                                class="
                                  font-serif
                                  text-lg
                                  sm:text-xl
                                  text-brand-charcoal
                                  leading-snug
                                "
                              >
                                {event.title}
                              </h4>



                              <!-- SPONSOR -->

                              {
                                event.sponsors?.length > 0 && (

                                  <div
                                    class="
                                      mt-5
                                      p-3
                                      bg-brand-cream
                                      border
                                      border-brand-border
                                    "
                                  >

                                    <div
                                      class="
                                        text-[8px]
                                        uppercase
                                        tracking-[0.15em]
                                        text-brand-slate
                                        mb-1
                                      "
                                    >
                                      Sponsor
                                    </div>


                                    <div
                                      class="
                                        text-xs
                                        font-semibold
                                        text-brand-charcoal
                                      "
                                    >
                                      {
                                        event.sponsors.join(
                                          ", "
                                        )
                                      }
                                    </div>

                                  </div>

                                )
                              }



                              <!-- SPEAKERS -->

                              {
                                event.speakers?.length > 0 && (

                                  <div
                                    class="
                                      mt-5
                                    "
                                  >

                                    <div
                                      class="
                                        text-[8px]
                                        uppercase
                                        tracking-[0.15em]
                                        text-brand-slate
                                        mb-3
                                      "
                                    >
                                      Speakers
                                    </div>


                                    <div
                                      class="
                                        space-y-3
                                      "
                                    >

                                      {
                                        event.speakers.map(
                                          (speaker) => (

                                            <div>

                                              <div
                                                class="
                                                  text-xs
                                                  font-semibold
                                                  text-brand-charcoal
                                                "
                                              >
                                                {speaker.name}
                                              </div>


                                              <div
                                                class="
                                                  text-[10px]
                                                  text-brand-slate
                                                  mt-0.5
                                                  leading-relaxed
                                                "
                                              >
                                                {speaker.company}

                                                {
                                                  speaker.title
                                                    ? ` · ${speaker.title}`
                                                    : ""
                                                }
                                              </div>

                                            </div>

                                          )
                                        )
                                      }

                                    </div>

                                  </div>

                                )
                              }



                              <!-- CTAS -->

                              <div
                                class="
                                  mt-auto
                                  pt-6
                                "
                              >

                                <div
                                  class="
                                    flex
                                    flex-wrap
                                    items-center
                                    gap-x-5
                                    gap-y-3
                                  "
                                >

                                  <a
                                    href={event.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="
                                      inline-flex
                                      items-center
                                      gap-2
                                      text-[9px]
                                      uppercase
                                      tracking-[0.15em]
                                      text-brand-charcoal
                                      font-semibold
                                      hover:text-brand-gold
                                      transition-colors
                                    "
                                  >
                                    View Event

                                    <span>
                                      ↗
                                    </span>

                                  </a>


                                  {
                                    recapUrl && (

                                      <a
                                        href={recapUrl}
                                        class="
                                          inline-flex
                                          items-center
                                          gap-2
                                          text-[9px]
                                          uppercase
                                          tracking-[0.15em]
                                          text-brand-gold
                                          font-semibold
                                          hover:text-brand-charcoal
                                          transition-colors
                                        "
                                      >
                                        Read Recap

                                        <span>
                                          →
                                        </span>

                                      </a>

                                    )
                                  }

                                </div>

                              </div>

                            </div>

                          </article>

                        );

                      }
                    )
                  }

                </div>


                <p
                  class="
                    hardware-programming-hint
                    lg:hidden
                    mt-4
                    text-[9px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-slate
                    text-center
                  "
                >
                  Swipe to explore

                  <span
                    class="
                      ml-1
                    "
                  >
                    →
                  </span>
                </p>

              </div>

            )
          }


        </div>

      )
    }

  </div>

</section>



<style>

  /* =========================================================
     STARTUP MIXER MANUAL SCROLL
     ========================================================= */

  .mixer-scroll {
    scrollbar-width:
      thin;

    scrollbar-color:
      #C5A059
      #E8E5DA;
  }


  .mixer-scroll::-webkit-scrollbar {
    height:
      5px;
  }


  .mixer-scroll::-webkit-scrollbar-track {
    background:
      #E8E5DA;
  }


  .mixer-scroll::-webkit-scrollbar-thumb {
    background:
      #C5A059;
  }



  /* =========================================================
     HARDWARE PROGRAMMING — MOBILE SWIPE / DESKTOP GRID
     ========================================================= */

  .hardware-programming-shell {
    width:
      100%;
  }


  /*
   * MOBILE / TABLET
   *
   * One full card is visible at a time.
   * Each swipe snaps to the next card.
   */

  .hardware-programming-scroll {
    width:
      100%;

    gap:
      0;

    overscroll-behavior-inline:
      contain;

    scroll-behavior:
      smooth;

    scrollbar-width:
      thin;

    scrollbar-color:
      #C5A059
      #E8E5DA;

    -webkit-overflow-scrolling:
      touch;

    touch-action:
      pan-x pan-y;
  }


  .hardware-programming-scroll::-webkit-scrollbar {
    height:
      5px;
  }


  .hardware-programming-scroll::-webkit-scrollbar-track {
    background:
      #E8E5DA;
  }


  .hardware-programming-scroll::-webkit-scrollbar-thumb {
    background:
      #C5A059;
  }


  .hardware-programming-card {
    width:
      100%;

    min-width:
      100%;

    flex:
      0 0 100%;

    scroll-snap-align:
      start;

    scroll-snap-stop:
      always;
  }


  .hardware-programming-hint {
    user-select:
      none;
  }



  /* =========================================================
     DESKTOP

     Restore the original Recent Programming layout:
     three equal cards across the page with the original
     card proportions and spacing.

     If the number of cards later becomes too large, this
     desktop section can be converted to a horizontal
     scroller like Mixer History without changing mobile.
     ========================================================= */

  @media (
    min-width: 1024px
  ) {

    .hardware-programming-scroll {
      display:
        grid;

      grid-template-columns:
        repeat(
          3,
          minmax(
            0,
            1fr
          )
        );

      gap:
        1.25rem;

      overflow:
        visible;

      scroll-snap-type:
        none;

      scrollbar-width:
        none;

      touch-action:
        auto;
    }


    .hardware-programming-scroll::-webkit-scrollbar {
      display:
