---
import {
  events
} from "../data/events";

import {
  isCompletedEvent
} from "../utils/eventMetrics";


const {
  community
} = Astro.props;


const communityEvents =
  events
    .filter(
      (event) =>
        event.communityId ===
          community.id &&
        isCompletedEvent(
          event
        ) &&
        (
          event.participation ===
            "hosted" ||
          event.participation ===
            "co-organized"
        )
    )
    .sort(
      (a, b) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime()
    );


const recentProgramming =
  communityEvents.slice(
    0,
    3
  );


const registrations =
  communityEvents.reduce(
    (
      total,
      event
    ) =>
      total +
      (
        event.registrations ??
        0
      ),
    0
  );


const speakers =
  communityEvents.flatMap(
    (event) =>
      event.speakers ??
      []
  );


const sponsors =
  Array.from(
    new Set(
      communityEvents
        .flatMap(
          (event) =>
            event.sponsors ??
            []
        )
    )
  );
---

<section
  id={community.id}
  class="
    max-w-6xl
    w-full
    mx-auto
    px-6
    py-16
    border-b
    border-brand-border
  "
>

  <div
    class="
      grid
      lg:grid-cols-12
      gap-10
      items-start
    "
  >

    <!-- =================================================
         COMMUNITY OVERVIEW
         ================================================= -->

    <div
      class="
        lg:col-span-6
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.18em]
          text-brand-gold
          font-semibold
        "
      >
        {community.role}
      </span>


      <h2
        class="
          font-serif
          text-3xl
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        {community.name}
      </h2>


      {
        community.description && (
          <p
            class="
              text-sm
              sm:text-base
              text-brand-slate
              leading-relaxed
              font-light
              mb-7
            "
          >
            {community.description}
          </p>
        )
      }


      <div
        class="
          flex
          flex-wrap
          gap-3
        "
      >

        <a
          href={community.primaryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="
            inline-flex
            items-center
            gap-2
            px-5
            py-3
            bg-brand-charcoal
            text-white
            text-[10px]
            uppercase
            tracking-[0.16em]
            font-semibold
            hover:bg-brand-gold
            transition-colors
          "
        >
          {community.primaryLabel}

          <span>
            ↗
          </span>
        </a>


        {
          community.secondaryUrl && (
            <a
              href={community.secondaryUrl}
              class="
                inline-flex
                items-center
                gap-2
                px-5
                py-3
                border
                border-brand-border
                text-brand-charcoal
                text-[10px]
                uppercase
                tracking-[0.16em]
                font-semibold
                hover:border-brand-gold
                hover:text-brand-gold
                transition-colors
              "
            >
              {community.secondaryLabel}

              <span>
                →
              </span>
            </a>
          )
        }

      </div>

    </div>



    <!-- =================================================
         COMMUNITY IMPACT
         ================================================= -->

    <div
      class="
        lg:col-span-6
        bg-brand-cream
        border
        border-brand-border
        p-7
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.18em]
          text-brand-gold
          font-semibold
        "
      >
        Community Activity
      </span>


      <!-- METRICS -->

      <div
        class="
          grid
          grid-cols-2
          sm:grid-cols-3
          gap-6
          mt-6
          pb-7
          border-b
          border-brand-border
        "
      >

        <div>

          <div
            class="
              font-serif
              text-2xl
              text-brand-charcoal
            "
          >
            {community.members}+
          </div>


          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mt-1
            "
          >
            Members
          </div>

        </div>


        <div>

          <div
            class="
              font-serif
              text-2xl
              text-brand-charcoal
            "
          >
            {communityEvents.length}
          </div>


          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mt-1
            "
          >
            Events Led
          </div>

        </div>


        <div>

          <div
            class="
              font-serif
              text-2xl
              text-brand-gold
            "
          >
            {registrations > 0
              ? `${registrations}+`
              : "—"}
          </div>


          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mt-1
            "
          >
            Registrations
          </div>

        </div>

      </div>



      <!-- PILLARS -->

      {
        community.pillars?.length > 0 && (
          <div
            class="
              py-7
              border-b
              border-brand-border
            "
          >

            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.16em]
                text-brand-slate
                mb-4
              "
            >
              Focus
            </div>


            <div
              class="
                flex
                flex-wrap
                gap-2
              "
            >

              {
                community.pillars.map(
                  (pillar) => (
                    <span
                      class="
                        px-3
                        py-2
                        bg-white
                        border
                        border-brand-border
                        text-[10px]
                        text-brand-slate
                      "
                    >
                      {pillar}
                    </span>
                  )
                )
              }

            </div>

          </div>
        )
      }



      <!-- RECENT PROGRAMMING -->

      {
        recentProgramming.length > 0 && (
          <div
            class="
              pt-7
            "
          >

            <div
              class="
                text-[9px]
                uppercase
                tracking-[0.16em]
                text-brand-slate
                mb-5
              "
            >
              Recent Programming
            </div>


            <div
              class="
                space-y-5
              "
            >

              {
                recentProgramming.map(
                  (event) => (
                    <div>

                      <div
                        class="
                          flex
                          flex-wrap
                          items-center
                          gap-2
                          mb-1
                        "
                      >

                        <a
                          href={event.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="
                            text-sm
                            font-semibold
                            text-brand-charcoal
                            hover:text-brand-gold
                            transition-colors
                          "
                        >
                          {event.title}
                        </a>


                        {
                          event.registrations && (
                            <span
                              class="
                                text-[9px]
                                uppercase
                                tracking-[0.12em]
                                text-brand-gold
                              "
                            >
                              {event.registrations}
                              {" "}
                              registrations
                            </span>
                          )
                        }

                      </div>


                      {
                        event.sponsors?.length > 0 && (
                          <p
                            class="
                              text-xs
                              text-brand-slate
                              font-light
                              mt-2
                            "
                          >
                            <span
                              class="
                                font-semibold
                                text-brand-charcoal
                              "
                            >
                              Sponsored by:
                            </span>

                            {" "}

                            {event.sponsors.join(", ")}
                          </p>
                        )
                      }


                      {
                        event.speakers?.length > 0 && (
                          <p
                            class="
                              text-xs
                              text-brand-slate
                              font-light
                              mt-1
                              leading-relaxed
                            "
                          >
                            <span
                              class="
                                font-semibold
                                text-brand-charcoal
                              "
                            >
                              Speakers:
                            </span>

                            {" "}

                            {
                              event.speakers
                                .map(
                                  (speaker) =>
                                    `${speaker.name} — ${speaker.company}`
                                )
                                .join(" · ")
                            }
                          </p>
                        )
                      }

                    </div>
                  )
                )
              }

            </div>

          </div>
        )
      }


      {
        speakers.length > 0 && (
          <p
            class="
              text-[10px]
              text-brand-slate
              font-light
              mt-6
              pt-5
              border-t
              border-brand-border
            "
          >
            {speakers.length} documented industry speakers
            {
              sponsors.length > 0
                ? ` · ${sponsors.length} documented event sponsors`
                : ""
            }
          </p>
        )
      }

    </div>

  </div>

</section>
