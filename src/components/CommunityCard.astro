<div
  class="
    flex
    items-start
    justify-between
    gap-3
  "
>

  <a
    href={event.url}
    target="_blank"
    rel="noopener noreferrer"
    class="
      block
      font-serif
      text-lg
      text-brand-charcoal
      leading-snug
      group-hover:text-brand-gold
      transition-colors
    "
  >
    Startup Mixer

    <span
      class="
        ml-2
        font-sans
        text-[9px]
        uppercase
        tracking-[0.14em]
        text-brand-gold
        font-semibold
        whitespace-nowrap
      "
    >
      — {formatMonth(event.startDate)}
    </span>
  </a>


  <a
    href={event.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${event.title}`}
    class="
      text-xs
      text-brand-slate
      hover:text-brand-gold
      transition-colors
      shrink-0
      mt-1
    "
  >
    ↗
  </a>

</div>
