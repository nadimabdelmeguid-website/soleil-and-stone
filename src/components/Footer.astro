---
import { site } from "../data/site";

const currentYear = new Date().getFullYear();
const siteName = site.name ?? "SOLEIL & STONE";
const siteLocation = site.location ?? "San Diego, CA";
const linkedIn =
  site.linkedin ??
  "https://www.linkedin.com/in/nadim-abdel-meguid-aa5229108/";
const email =
  site.email ??
  "mailto:nadimabdelmeguid@gmail.com";

/*
 * Add your newsletter provider form endpoint here later.
 * Examples: Buttondown, Beehiiv, ConvertKit, Mailchimp.
 */
const newsletterAction = "";
---

<footer
  class="
    border-t
    border-brand-border
    bg-brand-charcoal
    text-white
  "
>
  <div
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      pt-14
      pb-8
    "
  >
    <div
      class="
        grid
        grid-cols-1
        md:grid-cols-2
        lg:grid-cols-12
        gap-10
        lg:gap-8
      "
    >
      <!-- BRAND -->
      <div class="lg:col-span-4">
        <a
          href="/"
          class="
            inline-flex
            items-center
            gap-4
            group
          "
        >
          <svg
            class="
              w-11
              h-11
              text-brand-gold
              shrink-0
            "
            viewBox="0 0 100 100"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <line x1="50" y1="12" x2="50" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="33" y1="18" x2="38" y2="23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="67" y1="18" x2="62" y2="23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="22" y1="32" x2="28" y2="34" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="78" y1="32" x2="72" y2="34" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="50" cy="34" r="13" fill="currentColor"/>
            <polygon points="50,26 20,56 50,56" fill="#D5C29C"/>
            <polygon points="50,26 50,56 80,56" fill="currentColor"/>
            <line x1="50" y1="26" x2="50" y2="56" stroke="#363A40" stroke-width="1"/>
            <line x1="28" y1="60" x2="72" y2="60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="36" y1="64" x2="64" y2="64" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="42" y1="68" x2="58" y2="68" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
          </svg>

          <div>
            <div
              class="
                font-serif
                text-lg
                tracking-[0.18em]
                text-white
                group-hover:text-brand-gold
                transition-colors
              "
            >
              {siteName}
            </div>

            <div
              class="
                mt-1
                text-[9px]
                uppercase
                tracking-[0.16em]
                text-white/45
              "
            >
              {siteLocation}
            </div>
          </div>
        </a>

        <p
          class="
            mt-6
            max-w-sm
            text-sm
            leading-relaxed
            font-light
            text-white/60
          "
        >
          Field notes, communities and ventures at the intersection
          of hardware, commercialization and innovation ecosystems.
        </p>

        <div
          class="
            flex
            flex-wrap
            items-center
            gap-x-4
            gap-y-2
            mt-5
            text-xs
            text-white/70
          "
        >
          <a
            href={email}
            class="hover:text-brand-gold transition-colors"
          >
            Email
          </a>

          <span class="text-white/25" aria-hidden="true">·</span>

          <a
            href={linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-gold transition-colors"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>

      <!-- EXPLORE -->
      <div class="lg:col-span-2">
        <h2
          class="
            text-[10px]
            uppercase
            tracking-[0.18em]
            font-semibold
            text-white
          "
        >
          Explore
        </h2>

        <nav
          class="
            mt-5
            flex
            flex-col
            gap-3.5
            text-sm
            font-light
            text-white/60
          "
        >
          <a href="/" class="hover:text-brand-gold transition-colors">
            Home
          </a>
          <a href="/community/" class="hover:text-brand-gold transition-colors">
            Community
          </a>
          <a href="/about/" class="hover:text-brand-gold transition-colors">
            About
          </a>
          <a href="/contact/" class="hover:text-brand-gold transition-colors">
            Contact
          </a>
        </nav>
      </div>

      <!-- CONTENT -->
      <div class="lg:col-span-2">
        <h2
          class="
            text-[10px]
            uppercase
            tracking-[0.18em]
            font-semibold
            text-white
          "
        >
          Content
        </h2>

        <nav
          class="
            mt-5
            flex
            flex-col
            gap-3.5
            text-sm
            font-light
            text-white/60
          "
        >
          <a href="/field-notes/" class="hover:text-brand-gold transition-colors">
            Field Notes
          </a>
          <a href="/fieldwork/" class="hover:text-brand-gold transition-colors">
            Fieldwork
          </a>
          <a href="/event-recaps/" class="hover:text-brand-gold transition-colors">
            Event Recaps
          </a>
        </nav>
      </div>

      <!-- NEWSLETTER -->
      <div class="lg:col-span-4">
        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.18em]
            text-brand-gold
            font-semibold
          "
        >
          Newsletter
        </span>

        <h2
          class="
            font-serif
            text-xl
            text-white
            mt-2
          "
        >
          Notes From The Field
        </h2>

        <p
          class="
            text-xs
            leading-relaxed
            font-light
            text-white/55
            mt-3
            max-w-sm
          "
        >
          Occasional notes on hardware, commercialization,
          communities and what I’m learning in the field.
        </p>

        <form
          id="footer-newsletter-form"
          action={newsletterAction || undefined}
          method="post"
          class="
            mt-6
            flex
            w-full
            max-w-md
          "
        >
          <label for="footer-newsletter-email" class="sr-only">
            Email address
          </label>

          <input
            id="footer-newsletter-email"
            type="email"
            name="email"
            autocomplete="email"
            required
            placeholder="Your email"
            class="
              min-w-0
              flex-1
              border
              border-white/20
              border-r-0
              bg-transparent
              px-4
              py-3
              text-xs
              text-white
              placeholder:text-white/35
              outline-none
              focus:border-brand-gold
            "
          />

          <button
            type="submit"
            class="
              shrink-0
              bg-brand-gold
              px-4
              sm:px-5
              py-3
              text-[10px]
              uppercase
              tracking-[0.14em]
              font-semibold
              text-white
              hover:opacity-85
              transition-opacity
            "
          >
            Subscribe
          </button>
        </form>


      </div>
    </div>

    <!-- BOTTOM BAR -->
    <div
      class="
        mt-12
        pt-6
        border-t
        border-white/10
        flex
        flex-col
        sm:flex-row
        items-start
        sm:items-center
        justify-between
        gap-4
      "
    >
      <p class="text-[10px] font-light text-white/40">
        © {currentYear} Soleil & Stone. All rights reserved.
      </p>

      <a
        href={linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="
          w-9
          h-9
          rounded-full
          border
          border-white/10
          flex
          items-center
          justify-center
          text-white/45
          hover:text-brand-gold
          hover:border-brand-gold
          transition-colors
        "
      >
        <svg
          class="w-4 h-4 fill-current"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.72a1.47 1.47 0 1 0 0 2.94 1.47 1.47 0 0 0 0-2.94Z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

{
  !newsletterAction && (
    <script is:inline>
      {`
        (() => {
          const form =
            document.getElementById("footer-newsletter-form");

          if (!form) return;

          form.addEventListener("submit", (event) => {
            event.preventDefault();

            const button =
              form.querySelector('button[type="submit"]');

            if (!button) return;

            const originalText =
              button.textContent;

            button.textContent =
              "Coming Soon";

            window.setTimeout(() => {
              button.textContent =
                originalText;
            }, 1600);
          });
        })();
      `}
    </script>
  )
}
