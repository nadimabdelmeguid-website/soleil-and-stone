---
import Logo from "./Logo.astro";

import {
  site
} from "../data/site";


const year =
  new Date()
    .getFullYear();
---

<footer
  class="
    border-t
    border-brand-border
    bg-white
  "
>

  <div
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-10
    "
  >

    <div
      class="
        grid
        md:grid-cols-12
        gap-8
        items-start
      "
    >

      <!-- BRAND -->

      <div
        class="
          md:col-span-5
        "
      >

        <Logo
          variant="wordmark"
          width="190"
        />


        <p
          class="
            text-xs
            text-brand-slate
            font-light
            mt-4
          "
        >
          {site.location}
        </p>


        <p
          class="
            text-xs
            text-brand-slate
            font-light
            leading-relaxed
            max-w-sm
            mt-3
          "
        >
          Hardware, commercialization,
          innovation ecosystems, and
          observations from the field.
        </p>

      </div>



      <!-- SITE -->

      <div
        class="
          md:col-span-3
        "
      >

        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.16em]
            text-brand-gold
            font-semibold
            mb-4
          "
        >
          Explore
        </div>


        <div
          class="
            flex
            flex-col
            gap-3
          "
        >

          <a
            href="/community/"
            class="
              text-xs
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            Community
          </a>


          <a
            href="/field-notes/"
            class="
              text-xs
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            Field Notes
          </a>


          <a
            href="/about/"
            class="
              text-xs
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            About
          </a>


          <a
            href="/fieldwork/"
            class="
              text-xs
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            Industry Fieldwork
          </a>

        </div>

      </div>



      <!-- CONNECT -->

      <div
        class="
          md:col-span-4
          md:text-right
        "
      >

        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.16em]
            text-brand-gold
            font-semibold
            mb-4
          "
        >
          Connect
        </div>


        <div
          class="
            flex
            md:justify-end
            gap-3
          "
        >

          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="
              w-9
              h-9
              flex
              items-center
              justify-center
              border
              border-brand-border
              text-brand-charcoal
              hover:text-brand-gold
              hover:border-brand-gold
              transition-colors
            "
          >

            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M6.5 8.5H3.2V19h3.3V8.5ZM4.85 3A1.93 1.93 0 1 0 4.85 6.86 1.93 1.93 0 0 0 4.85 3ZM19 13.02c0-3.16-1.69-4.63-3.94-4.63-1.81 0-2.63 1-3.09 1.7V8.5H8.68V19h3.29v-5.2c0-1.37.26-2.7 1.96-2.7 1.68 0 1.7 1.57 1.7 2.79V19H19v-5.98Z"
              />
            </svg>

          </a>


          <a
            href={site.email}
            aria-label="Email"
            class="
              w-9
              h-9
              flex
              items-center
              justify-center
              border
              border-brand-border
              text-brand-charcoal
              hover:text-brand-gold
              hover:border-brand-gold
              transition-colors
            "
          >

            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="1"
              />

              <path
                d="m4 7 8 6 8-6"
              />
            </svg>

          </a>

        </div>

      </div>

    </div>



    <div
      class="
        mt-10
        pt-6
        border-t
        border-brand-border
        text-[10px]
        text-brand-slate
        font-light
      "
    >
      © {year} Soleil & Stone.
      All rights reserved.
    </div>

  </div>

</footer>
