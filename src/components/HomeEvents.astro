---
import {
  events
} from "../data/events";


const visibleEvents =
  events
    .filter(
      (event) =>
        event.showOnHome
    )
    .sort(
      (a, b) =>
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime()
    );
---

<section
  class="
    border-y
    border-brand-border
    bg-brand-cream
  "
>

  <div
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
    "
  >

    <!-- =================================================
         HEADER
         ================================================= -->

    <div
      class="
        flex
        flex-col
        lg:flex-row
        lg:items-end
        justify-between
        gap-6
        mb-10
      "
    >

      <div>

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community & Fieldwork
        </span>


        <h2
          class="
            font-serif
            text-3xl
            sm:text-4xl
            text-brand-charcoal
            mt-2
          "
        >
          Community Hub & Calendar
        </h2>

      </div>


      <!-- LEGEND -->

      <div
        class="
          flex
          flex-wrap
          items-center
          gap-x-5
          gap-y-2
          text-[10px]
          uppercase
          tracking-[0.14em]
          text-brand-slate
        "
      >

        <!-- HOST -->

        <div
          class="
            flex
            items-center
            gap-2
          "
        >

          <span
            class="
              w-2.5
              h-2.5
              rounded-full
              bg-brand-gold
            "
          ></span>

          <span>
            Hosted / Co-Organized
          </span>

        </div>


        <!-- EXHIBIT -->

        <div
          class="
            flex
            items-center
            gap-2
          "
        >

          <span
            class="
              w-2.5
              h-2.5
              rounded-full
              bg-brand-charcoal
            "
          ></span>

          <span>
            Exhibitor
          </span>

        </div>


        <!-- ATTEND -->

        <div
          class="
            flex
            items-center
            gap-2
          "
        >

          <span
            class="
              w-2.5
              h-2.5
              rounded-full
              bg-brand-slate
            "
          ></span>

          <span>
            Attending
          </span>

        </div>

      </div>

    </div>



    <!-- =================================================
         CALENDAR + EVENTS GRID
         ================================================= -->

    <div
      class="
        grid
        lg:grid-cols-12
        gap-8
        items-start
      "
    >

      <!-- =================================================
           CALENDAR
           ================================================= -->

      <div
        class="
          lg:col-span-5
          bg-white
          border
          border-brand-border
          p-5
          sm:p-6
        "
      >

        <!-- MONTH NAV -->

        <div
          class="
            flex
            items-center
            justify-between
            mb-6
          "
        >

          <button
            id="calendar-prev"
            type="button"
            aria-label="Previous month"
            class="
              w-9
              h-9
              border
              border-brand-border
              text-brand-charcoal
              hover:border-brand-gold
              hover:text-brand-gold
              transition-colors
            "
          >
            ←
          </button>


          <h3
            id="calendar-month-title"
            class="
              font-serif
              text-xl
              text-brand-charcoal
              text-center
            "
          >
          </h3>


          <button
            id="calendar-next"
            type="button"
            aria-label="Next month"
            class="
              w-9
              h-9
              border
              border-brand-border
              text-brand-charcoal
              hover:border-brand-gold
              hover:text-brand-gold
              transition-colors
            "
          >
            →
          </button>

        </div>


        <!-- WEEKDAYS -->

        <div
          class="
            grid
            grid-cols-7
            mb-2
          "
        >

          {
            [
              "S",
              "M",
              "T",
              "W",
              "T",
              "F",
              "S"
            ].map(
              (day) => (
                <div
                  class="
                    text-center
                    text-[9px]
                    uppercase
                    tracking-widest
                    text-brand-slate
                    py-2
                  "
                >
                  {day}
                </div>
              )
            )
          }

        </div>


        <!-- CALENDAR GRID -->

        <div
          id="calendar-grid"
          class="
            grid
            grid-cols-7
            gap-1
          "
        >
        </div>


        <!-- PRIORITY NOTE -->

        <p
          class="
            mt-5
            text-[10px]
            text-brand-slate
            font-light
            leading-relaxed
          "
        >
          When activities overlap, the calendar prioritizes
          hosted or co-organized events first, exhibitor
          appearances second, and attended events third.
        </p>

      </div>



      <!-- =================================================
           MONTH EVENTS
           ================================================= -->

      <div
        class="
          lg:col-span-7
        "
      >

        <div
          class="
            flex
            items-center
            justify-between
            gap-4
            mb-5
          "
        >

          <div>

            <span
              class="
                text-[10px]
                uppercase
                tracking-[0.18em]
                text-brand-gold
                font-semibold
              "
            >
              Selected Month
            </span>


            <h3
              id="event-month-title"
              class="
                font-serif
                text-2xl
                text-brand-charcoal
                mt-1
              "
            >
            </h3>

          </div>


          <span
            id="month-summary"
            class="
              text-[10px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              text-right
            "
          >
          </span>

        </div>


        <div
          id="event-container"
          class="
            max-h-[540px]
            overflow-y-auto
            pr-2
            space-y-5
            custom-scrollbar
          "
        >
        </div>

      </div>

    </div>



    <!-- =================================================
         CTA
         ================================================= -->

    <div
      class="
        mt-10
        pt-8
        border-t
        border-brand-border
        flex
        flex-col
        sm:flex-row
        sm:items-center
        justify-between
        gap-5
      "
    >

      <p
        class="
          text-sm
          text-brand-slate
          font-light
        "
      >
        A running record of community building,
        technical events and industry fieldwork.
      </p>


      <div
        class="
          flex
          flex-wrap
          gap-x-6
          gap-y-3
        "
      >

        <a
          href="/fieldwork/"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            text-brand-charcoal
            font-semibold
            hover:text-brand-gold
            transition-colors
          "
        >
          View Fieldwork Archive

          <span>
            →
          </span>
        </a>


        <a
          href="/?type=partnership#contact"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            text-brand-slate
            font-semibold
            hover:text-brand-gold
            transition-colors
          "
        >
          Partner On An Event

          <span>
            →
          </span>
        </a>

      </div>

    </div>

  </div>

</section>



<script
  is:inline
  define:vars={{
    calendarEvents:
      visibleEvents.map(
        (event) => ({
          id:
            event.id,

          title:
            event.title,

          role:
            event.role,

          participation:
            event.participation,

          communityId:
            event.communityId,

          startDate:
            event.startDate,

          endDate:
            event.endDate,

          venue:
            event.venue,

          city:
            event.city,

          description:
            event.description,

          url:
            event.url,

          buttonLabel:
            event.buttonLabel,

          typeLabel:
            event.typeLabel,

          registrations:
            event.registrations,

          sponsors:
            event.sponsors,

          partners:
            event.partners,

          speakers:
            event.speakers
        })
      )
  }}
>

  (() => {

    /* ===================================================
       DOM
       =================================================== */

    const calendarGrid =
      document.getElementById(
        "calendar-grid"
      );


    const calendarTitle =
      document.getElementById(
        "calendar-month-title"
      );


    const eventMonthTitle =
      document.getElementById(
        "event-month-title"
      );


    const eventContainer =
      document.getElementById(
        "event-container"
      );


    const monthSummary =
      document.getElementById(
        "month-summary"
      );


    const prevButton =
      document.getElementById(
        "calendar-prev"
      );


    const nextButton =
      document.getElementById(
        "calendar-next"
      );


    if (
      !calendarGrid ||
      !eventContainer
    ) {

      return;

    }



    /* ===================================================
       DATE HELPERS
       =================================================== */

    function parseEventDate(
      value
    ) {

      return new Date(
        `${value}T12:00:00`
      );

    }


    function isPastEvent(
      event
    ) {

      const end =
        parseEventDate(
          event.endDate ||
          event.startDate
        );


      end.setHours(
        23,
        59,
        59,
        999
      );


      return end <
        new Date();

    }


    function formatEventDate(
      event
    ) {

      const start =
        parseEventDate(
          event.startDate
        );


      const end =
        event.endDate
          ? parseEventDate(
              event.endDate
            )
          : null;


      const startText =
        start.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric",

            year:
              "numeric"
          }
        );


      if (
        !end
      ) {

        return startText;

      }


      if (
        start.getFullYear() ===
          end.getFullYear() &&
        start.getMonth() ===
          end.getMonth()
      ) {

        return `${start.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric"
          }
        )}–${end.getDate()}, ${end.getFullYear()}`;

      }


      return `${startText} – ${end.toLocaleDateString(
        "en-US",
        {
          month:
            "short",

          day:
            "numeric",

          year:
            "numeric"
        }
      )}`;

    }



    /* ===================================================
       PARTICIPATION
       =================================================== */

    function getParticipation(
      event
    ) {

      return (
        event.participation ||
        "attending"
      );

    }


    /*
     * Priority:
     *
     * 3 = host / co-organize
     * 2 = exhibit
     * 1 = attend
     */

    function getPriority(
      event
    ) {

      const participation =
        getParticipation(
          event
        );


      if (
        participation ===
          "hosted" ||
        participation ===
          "co-organized"
      ) {

        return 3;

      }


      if (
        participation ===
        "exhibitor"
      ) {

        return 2;

      }


      return 1;

    }


    function getEventColor(
      event
    ) {

      const participation =
        getParticipation(
          event
        );


      if (
        participation ===
          "hosted" ||
        participation ===
          "co-organized"
      ) {

        return "#C5A059";

      }


      if (
        participation ===
        "exhibitor"
      ) {

        return "#22252A";

      }


      return "#4A505A";

    }



    /* ===================================================
       INITIAL MONTH
       =================================================== */

    function getInitialCalendarDate() {

      const upcoming =
        calendarEvents
          .filter(
            (event) =>
              !isPastEvent(
                event
              )
          )
          .sort(
            (a, b) =>
              parseEventDate(
                a.startDate
              ) -
              parseEventDate(
                b.startDate
              )
          );


      if (
        upcoming.length
      ) {

        return parseEventDate(
          upcoming[0].startDate
        );

      }


      if (
        calendarEvents.length
      ) {

        const latest =
          [...calendarEvents]
            .sort(
              (a, b) =>
                parseEventDate(
                  b.startDate
                ) -
                parseEventDate(
                  a.startDate
                )
            )[0];


        return parseEventDate(
          latest.startDate
        );

      }


      return new Date();

    }


    let currentDate =
      getInitialCalendarDate();



    /* ===================================================
       MONTH FILTERING
       =================================================== */

    function eventTouchesMonth(
      event,
      year,
      month
    ) {

      const eventStart =
        parseEventDate(
          event.startDate
        );


      const eventEnd =
        parseEventDate(
          event.endDate ||
          event.startDate
        );


      const monthStart =
        new Date(
          year,
          month,
          1,
          0,
          0,
          0,
          0
        );


      const monthEnd =
        new Date(
          year,
          month + 1,
          0,
          23,
          59,
          59,
          999
        );


      return (
        eventStart <=
          monthEnd &&
        eventEnd >=
          monthStart
      );

    }


    function eventsForMonth(
      year,
      month
    ) {

      return calendarEvents
        .filter(
          (event) =>
            eventTouchesMonth(
              event,
              year,
              month
            )
        )
        .sort(
          (a, b) => {

            const aPast =
              isPastEvent(
                a
              );


            const bPast =
              isPastEvent(
                b
              );


            /*
             * Upcoming/current first.
             */

            if (
              aPast !==
              bPast
            ) {

              return aPast
                ? 1
                : -1;

            }


            const dateDifference =
              parseEventDate(
                a.startDate
              ) -
              parseEventDate(
                b.startDate
              );


            /*
             * Same start date:
             * host → exhibit → attend
             */

            if (
              dateDifference === 0
            ) {

              return (
                getPriority(
                  b
                ) -
                getPriority(
                  a
                )
              );

            }


            return dateDifference;

          }
        );

    }



    /* ===================================================
       EVENTS ON A SPECIFIC DAY
       =================================================== */

    function eventsForDate(
      date
    ) {

      return calendarEvents
        .filter(
          (event) => {

            const start =
              parseEventDate(
                event.startDate
              );


            const end =
              parseEventDate(
                event.endDate ||
                event.startDate
              );


            return (
              date >=
                start &&
              date <=
                end
            );

          }
        )
        .sort(
          (a, b) => {

            const priorityDifference =
              getPriority(
                b
              ) -
              getPriority(
                a
              );


            if (
              priorityDifference !==
              0
            ) {

              return priorityDifference;

            }


            return (
              parseEventDate(
                a.startDate
              ) -
              parseEventDate(
                b.startDate
              )
            );

          }
        );

    }


    function primaryEventForDate(
      date
    ) {

      const matches =
        eventsForDate(
          date
        );


      return (
        matches[0] ||
        null
      );

    }



    /* ===================================================
       CALENDAR
       =================================================== */

    function renderCalendar() {

      const year =
        currentDate.getFullYear();


      const month =
        currentDate.getMonth();


      const monthName =
        currentDate.toLocaleDateString(
          "en-US",
          {
            month:
              "long",

            year:
              "numeric"
          }
        );


      if (
        calendarTitle
      ) {

        calendarTitle.textContent =
          monthName;

      }


      if (
        eventMonthTitle
      ) {

        eventMonthTitle.textContent =
          monthName;

      }


      calendarGrid.innerHTML =
        "";


      const firstDay =
        new Date(
          year,
          month,
          1
        );


      const lastDay =
        new Date(
          year,
          month + 1,
          0
        );


      const startingWeekday =
        firstDay.getDay();


      const daysInMonth =
        lastDay.getDate();


      /*
       * Leading blank cells.
       */

      for (
        let i = 0;
        i < startingWeekday;
        i++
      ) {

        const blank =
          document.createElement(
            "div"
          );


        blank.className =
          "aspect-square";


        calendarGrid.appendChild(
          blank
        );

      }


      for (
        let day = 1;
        day <=
          daysInMonth;
        day++
      ) {

        const date =
          new Date(
            year,
            month,
            day,
            12
          );


        const primaryEvent =
          primaryEventForDate(
            date
          );


        const allEvents =
          eventsForDate(
            date
          );


        const element =
          document.createElement(
            primaryEvent
              ? "button"
              : "div"
          );


        element.className =
          [
            "relative",
            "aspect-square",
            "flex",
            "items-center",
            "justify-center",
            "text-xs",
            "border",
            "transition-all",
            "duration-200",

            primaryEvent
              ? "cursor-pointer hover:scale-[1.04]"
              : "border-transparent text-brand-slate"
          ].join(
            " "
          );


        const dayNumber =
          document.createElement(
            "span"
          );


        dayNumber.textContent =
          String(
            day
          );


        dayNumber.className =
          primaryEvent
            ? "relative z-10 font-semibold"
            : "";


        element.appendChild(
          dayNumber
        );


        if (
          primaryEvent
        ) {

          const color =
            getEventColor(
              primaryEvent
            );


          element.style.backgroundColor =
            color;


          element.style.borderColor =
            color;


          element.style.color =
            "#FFFFFF";


          element.dataset.calendarEvent =
            primaryEvent.id;


          /*
           * Indicate additional events
           * on the same date.
           */

          if (
            allEvents.length >
            1
          ) {

            const count =
              document.createElement(
                "span"
              );


            count.textContent =
              `+${allEvents.length - 1}`;


            count.className =
              [
                "absolute",
                "top-1",
                "right-1",
                "text-[7px]",
                "font-semibold",
                "leading-none"
              ].join(
                " "
              );


            element.appendChild(
              count
            );

          }


          element.addEventListener(
            "click",
            () => {

              scrollToEvent(
                primaryEvent.id
              );

            }
          );

        }


        calendarGrid.appendChild(
          element
        );

      }

    }



    /* ===================================================
       EVENT CARD HELPERS
       =================================================== */

    function escapeHtml(
      value
    ) {

      if (
        value === null ||
        value === undefined
      ) {

        return "";

      }


      return String(
        value
      )
        .replace(
          /&/g,
          "&amp;"
        )
        .replace(
          /</g,
          "&lt;"
        )
        .replace(
          />/g,
          "&gt;"
        )
        .replace(
          /"/g,
          "&quot;"
        )
        .replace(
          /'/g,
          "&#039;"
        );

    }


    function speakerHtml(
      speakers
    ) {

      if (
        !Array.isArray(
          speakers
        ) ||
        speakers.length === 0
      ) {

        return "";

      }


      const rows =
        speakers
          .map(
            (speaker) => {

              const name =
                escapeHtml(
                  speaker.name
                );


              const company =
                escapeHtml(
                  speaker.company
                );


              const title =
                speaker.title
                  ? ` · ${escapeHtml(
                      speaker.title
                    )}`
                  : "";


              return `
                <li
                  class="
                    text-xs
                    text-brand-slate
                    leading-relaxed
                  "
                >
                  <span
                    class="
                      font-semibold
                      text-brand-charcoal
                    "
                  >
                    ${name}
                  </span>

                  ${title}

                  · ${company}
                </li>
              `;

            }
          )
          .join(
            ""
          );


      return `
        <div
          class="
            mt-5
            pt-5
            border-t
            border-brand-border
          "
        >

          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              mb-3
            "
          >
            Speakers
          </div>

          <ul
            class="
              space-y-2
            "
          >
            ${rows}
          </ul>

        </div>
      `;

    }


    function sponsorHtml(
      sponsors
    ) {

      if (
        !Array.isArray(
          sponsors
        ) ||
        sponsors.length === 0
      ) {

        return "";

      }


      return `
        <p
          class="
            text-xs
            text-brand-slate
            mt-4
          "
        >
          <span
            class="
              font-semibold
              text-brand-charcoal
            "
          >
            Sponsored by:
          </span>

          ${escapeHtml(
            sponsors.join(
              ", "
            )
          )}
        </p>
      `;

    }


    function partnerHtml(
      partners
    ) {

      if (
        !Array.isArray(
          partners
        ) ||
        partners.length === 0
      ) {

        return "";

      }


      return `
        <p
          class="
            text-xs
            text-brand-slate
            mt-3
            leading-relaxed
          "
        >
          <span
            class="
              font-semibold
              text-brand-charcoal
            "
          >
            Event collaborators:
          </span>

          ${escapeHtml(
            partners.join(
              ", "
            )
          )}
        </p>
      `;

    }



    /* ===================================================
       MONTH EVENT CARDS
       =================================================== */

    function renderMonthEvents() {

      const year =
        currentDate.getFullYear();


      const month =
        currentDate.getMonth();


      const monthEvents =
        eventsForMonth(
          year,
          month
        );


      eventContainer.innerHTML =
        "";


      if (
        !monthEvents.length
      ) {

        const empty =
          document.createElement(
            "div"
          );


        empty.className =
          [
            "bg-white",
            "border",
            "border-brand-border",
            "p-8",
            "text-center",
            "text-sm",
            "text-brand-slate"
          ].join(
            " "
          );


        empty.textContent =
          `No events listed for ${currentDate.toLocaleDateString(
            "en-US",
            {
              month:
                "long",

              year:
                "numeric"
            }
          )}.`;


        eventContainer.appendChild(
          empty
        );


        if (
          monthSummary
        ) {

          monthSummary.textContent =
            "No events";

        }


        return;

      }


      const upcomingCount =
        monthEvents.filter(
          (event) =>
            !isPastEvent(
              event
            )
        ).length;


      const pastCount =
        monthEvents.length -
        upcomingCount;


      if (
        monthSummary
      ) {

        const parts =
          [];


        if (
          upcomingCount
        ) {

          parts.push(
            `${upcomingCount} upcoming`
          );

        }


        if (
          pastCount
        ) {

          parts.push(
            `${pastCount} past`
          );

        }


        monthSummary.textContent =
          parts.join(
            " · "
          );

      }


      monthEvents.forEach(
        (event) => {

          const card =
            document.createElement(
              "article"
            );


          card.id =
            `event-${event.id}`;


          card.className =
            [
              "event-card",
              "bg-white",
              "border",
              "border-brand-border",
              "p-6",
              "transition-all",
              "duration-300",

              isPastEvent(
                event
              )
                ? "opacity-90"
                : ""
            ].join(
              " "
            );


          const participation =
            getParticipation(
              event
            );


          const color =
            getEventColor(
              event
            );


          const registrationHtml =
            typeof event.registrations ===
              "number"
              ? `
                <span
                  class="
                    text-brand-border
                  "
                >
                  •
                </span>

                <span
                  class="
                    text-brand-gold
                    font-semibold
                  "
                >
                  ${event.registrations}+ registrations
                </span>
              `
              : "";


          const location =
            [
              event.venue,
              event.city
            ]
              .filter(
                Boolean
              )
              .map(
                escapeHtml
              )
              .join(
                " · "
              );


          const label =
            event.typeLabel ||
            (
              participation ===
                "exhibitor"
                ? "Exhibitor"
                : (
                    participation ===
                      "hosted" ||
                    participation ===
                      "co-organized"
                  )
                    ? "Hosted Event"
                    : "Attending Event"
            );


          card.innerHTML =
            `
              <div
                class="
                  flex
                  flex-wrap
                  items-center
                  gap-2
                  text-[10px]
                  uppercase
                  tracking-[0.15em]
                  mb-3
                "
              >

                <span
                  class="
                    font-semibold
                  "
                  style="
                    color:
                    ${color}
                  "
                >
                  ${escapeHtml(
                    label
                  )}
                </span>


                <span
                  class="
                    text-brand-border
                  "
                >
                  •
                </span>


                <span
                  class="
                    text-brand-slate
                  "
                >
                  ${escapeHtml(
                    formatEventDate(
                      event
                    )
                  )}
                </span>


                ${registrationHtml}


                ${
                  isPastEvent(
                    event
                  )
                    ? `
                      <span
                        class="
                          text-brand-border
                        "
                      >
                        •
                      </span>

                      <span
                        class="
                          text-brand-slate
                        "
                      >
                        Past Event
                      </span>
                    `
                    : ""
                }

              </div>


              <h4
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  leading-snug
                  mb-3
                "
              >
                ${escapeHtml(
                  event.title
                )}
              </h4>


              ${
                location
                  ? `
                    <p
                      class="
                        text-xs
                        text-brand-slate
                        mb-3
                      "
                    >
                      ${location}
                    </p>
                  `
                  : ""
              }


              ${
                event.description
                  ? `
                    <p
                      class="
                        text-sm
                        text-brand-slate
                        font-light
                        leading-relaxed
                      "
                    >
                      ${escapeHtml(
                        event.description
                      )}
                    </p>
                  `
                  : ""
              }


              ${sponsorHtml(
                event.sponsors
              )}


              ${partnerHtml(
                event.partners
              )}


              ${speakerHtml(
                event.speakers
              )}


              <a
                href="${escapeHtml(
                  event.url
                )}"
                target="_blank"
                rel="noopener noreferrer"
                class="
                  inline-flex
                  items-center
                  gap-2
                  mt-5
                  text-[10px]
                  uppercase
                  tracking-[0.16em]
                  font-semibold
                  text-brand-charcoal
                  hover:text-brand-gold
                  transition-colors
                "
              >
                ${escapeHtml(
                  event.buttonLabel ||
                  "View Event"
                )}

                <span>
                  ↗
                </span>
              </a>
            `;


          eventContainer.appendChild(
            card
          );

        }
      );

    }



    /* ===================================================
       CLICK → EVENT CARD
       =================================================== */

    function scrollToEvent(
      id
    ) {

      const card =
        document.getElementById(
          `event-${id}`
        );


      if (
        !card
      ) {

        return;

      }


      const containerRect =
        eventContainer
          .getBoundingClientRect();


      const cardRect =
        card
          .getBoundingClientRect();


      const top =
        (
          cardRect.top -
          containerRect.top
        ) +
        eventContainer.scrollTop;


      eventContainer.scrollTo({
        top:
          Math.max(
            0,
            top - 8
          ),

        behavior:
          "smooth"
      });


      card.classList.add(
        "ring-2",
        "ring-brand-gold"
      );


      window.setTimeout(
        () => {

          card.classList.remove(
            "ring-2",
            "ring-brand-gold"
          );

        },
        1400
      );

    }



    /* ===================================================
       FULL RENDER
       =================================================== */

    function renderAll() {

      renderCalendar();

      renderMonthEvents();

      eventContainer.scrollTop =
        0;

    }



    /* ===================================================
       MONTH NAVIGATION
       =================================================== */

    prevButton?.addEventListener(
      "click",
      () => {

        currentDate =
          new Date(
            currentDate.getFullYear(),
            currentDate.getMonth() - 1,
            1
          );


        renderAll();

      }
    );


    nextButton?.addEventListener(
      "click",
      () => {

        currentDate =
          new Date(
            currentDate.getFullYear(),
            currentDate.getMonth() + 1,
            1
          );


        renderAll();

      }
    );



    renderAll();

  })();

</script>
