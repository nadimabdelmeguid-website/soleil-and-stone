---
import { events } from "../data/events";
import { parseDate } from "../utils/events";

const visibleEvents = events
  .filter((event) => event.showOnHome)
  .sort(
    (a, b) =>
      parseDate(a.startDate).getTime() -
      parseDate(b.startDate).getTime()
  );

function formatDate(
  startDate: string,
  endDate?: string
) {
  const start = parseDate(startDate);
  const end = parseDate(endDate || startDate);

  if (startDate === (endDate || startDate)) {
    return start.toLocaleDateString(
      "en-US",
      {
        month: "short",
        day: "numeric",
        year: "numeric"
      }
    );
  }

  const sameMonth =
    start.getFullYear() === end.getFullYear() &&
    start.getMonth() === end.getMonth();

  if (sameMonth) {
    return `${start.toLocaleDateString(
      "en-US",
      {
        month: "short",
        day: "numeric"
      }
    )} – ${end.getDate()}, ${end.getFullYear()}`;
  }

  return `${start.toLocaleDateString(
    "en-US",
    {
      month: "short",
      day: "numeric"
    }
  )} – ${end.toLocaleDateString(
    "en-US",
    {
      month: "short",
      day: "numeric",
      year: "numeric"
    }
  )}`;
}
---

<section
  id="community"
  class="
    max-w-6xl
    w-full
    mx-auto
    px-6
    py-20
    border-b
    border-brand-border
  "
>

  <!-- SECTION HEADER -->

  <div
    class="
      flex
      flex-col
      sm:flex-row
      sm:items-end
      justify-between
      mb-12
      gap-4
    "
  >

    <div>

      <span
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        San Diego Ecosystem & Travel
      </span>

      <h2
        class="
          font-serif
          text-3xl
          font-normal
          text-brand-charcoal
          mt-1
        "
      >
        Community Hub & Calendar
      </h2>

    </div>

    <p
      class="
        text-brand-slate
        text-sm
        max-w-md
        font-light
      "
    >
      Upcoming ecosystem gatherings,
      hosted community events,
      and trade shows I'm attending.
    </p>

  </div>


  <!-- CALENDAR + MONTH EVENTS -->

  <div
    class="
      grid
      lg:grid-cols-12
      gap-8
      mb-12
    "
  >

    <!-- LEFT: CALENDAR -->

    <div
      class="
        lg:col-span-5
        p-6
        bg-brand-card
        border
        border-brand-border
        shadow-sm
        flex
        flex-col
        justify-between
      "
    >

      <div>

        <div
          class="
            flex
            items-center
            justify-between
            border-b
            border-brand-border
            pb-4
            mb-4
          "
        >

          <button
            id="calendar-prev"
            type="button"
            class="
              text-brand-slate
              hover:text-brand-gold
              transition-colors
              font-bold
              px-2
              py-1
              border
              border-brand-border
              text-xs
            "
            aria-label="Previous month"
          >
            ←
          </button>

          <span
            id="calendar-title"
            class="
              font-serif
              text-lg
              font-normal
              text-brand-charcoal
            "
          ></span>

          <button
            id="calendar-next"
            type="button"
            class="
              text-brand-slate
              hover:text-brand-gold
              transition-colors
              font-bold
              px-2
              py-1
              border
              border-brand-border
              text-xs
            "
            aria-label="Next month"
          >
            →
          </button>

        </div>

        <div
          class="
            grid
            grid-cols-7
            gap-1
            text-center
            text-[10px]
            font-semibold
            text-brand-slate
            uppercase
            tracking-wider
            mb-2
          "
        >
          <div>S</div>
          <div>M</div>
          <div>T</div>
          <div>W</div>
          <div>T</div>
          <div>F</div>
          <div>S</div>
        </div>

        <div
          id="calendar-grid"
          class="
            grid
            grid-cols-7
            gap-1
            text-center
            text-xs
            text-brand-slate
          "
        ></div>

      </div>


      <!-- MONTH SUMMARY -->

      <div
        class="
          mt-8
          pt-4
          border-t
          border-brand-border
        "
      >

        <div
          class="
            text-[10px]
            uppercase
            tracking-wider
            font-medium
            text-brand-charcoal
            mb-3
          "
        >
          This Month
        </div>

        <div
          id="month-summary"
          class="
            text-[11px]
            text-brand-slate
            leading-relaxed
          "
        ></div>

      </div>


      <!-- Legend -->

      <div
        class="
          mt-6
          pt-4
          border-t
          border-brand-border
          flex
          items-center
          justify-between
          text-[11px]
          text-brand-slate
        "
      >

        <div class="flex items-center gap-2">
          <span
            class="
              w-2.5
              h-2.5
              bg-brand-gold
              inline-block
            "
          ></span>
          Hosted Event
        </div>

        <div class="flex items-center gap-2">
          <span
            class="
              w-2.5
              h-2.5
              bg-brand-slate
              inline-block
            "
          ></span>
          Attending Event
        </div>

      </div>

    </div>


    <!-- RIGHT: EVENTS FOR SELECTED MONTH ONLY -->

    <div
      id="event-container"
      class="
        lg:col-span-7
        max-h-[540px]
        overflow-y-auto
        pr-2
        space-y-6
        custom-scrollbar
      "
    ></div>

  </div>


  <!-- PARTNERSHIP CTA -->

  <div
    class="
      p-6
      bg-brand-gold/5
      border
      border-brand-gold/20
      flex
      flex-col
      sm:flex-row
      items-center
      justify-between
      gap-4
    "
  >

    <p
      class="
        text-xs
        text-brand-slate
        font-light
      "
    >

      <strong
        class="
          font-medium
          text-brand-charcoal
        "
      >
        Want to collaborate or host?
      </strong>

      Open to partnerships with local venues,
      hardware builders,
      and regional startup ecosystem partners.

    </p>

    <a
      href="/?type=partnership#contact"
      class="
        text-xs
        uppercase
        tracking-widest
        font-medium
        text-brand-gold
        hover:underline
        whitespace-nowrap
      "
    >
      Get Involved →
    </a>

  </div>

</section>


<script
  is:inline
  define:vars={{
    calendarEvents: visibleEvents.map(
      (event) => ({
        id: event.id,
        title: event.title,
        role: event.role,
        typeLabel: event.typeLabel || null,
        startDate: event.startDate,
        endDate: event.endDate || event.startDate,
        venue: event.venue || null,
        city: event.city || null,
        description: event.description || null,
        url: event.url || null,
        buttonLabel: event.buttonLabel || null
      })
    )
  }}
>

  const parseEventDate = (value) =>
    new Date(`${value}T12:00:00`);


  const today = new Date();


  function formatEventDate(
    startDate,
    endDate
  ) {
    const start =
      parseEventDate(startDate);

    const end =
      parseEventDate(
        endDate || startDate
      );

    if (
      startDate ===
      (endDate || startDate)
    ) {
      return start.toLocaleDateString(
        "en-US",
        {
          month: "short",
          day: "numeric",
          year: "numeric"
        }
      );
    }

    const sameMonth =
      start.getFullYear() ===
        end.getFullYear() &&
      start.getMonth() ===
        end.getMonth();

    if (sameMonth) {
      return `${start.toLocaleDateString(
        "en-US",
        {
          month: "short",
          day: "numeric"
        }
      )} – ${end.getDate()}, ${end.getFullYear()}`;
    }

    return `${start.toLocaleDateString(
      "en-US",
      {
        month: "short",
        day: "numeric"
      }
    )} – ${end.toLocaleDateString(
      "en-US",
      {
        month: "short",
        day: "numeric",
        year: "numeric"
      }
    )}`;
  }


  function getInitialCalendarDate() {

    const hasCurrentMonthEvent =
      calendarEvents.some(
        (event) =>
          eventTouchesMonth(
            event,
            today.getFullYear(),
            today.getMonth()
          )
      );

    if (hasCurrentMonthEvent) {
      return new Date(
        today.getFullYear(),
        today.getMonth(),
        1
      );
    }

    const nextEvent =
      calendarEvents.find(
        (event) =>
          parseEventDate(
            event.endDate
          ) >= today
      );

    if (nextEvent) {
      const date =
        parseEventDate(
          nextEvent.startDate
        );

      return new Date(
        date.getFullYear(),
        date.getMonth(),
        1
      );
    }

    return new Date(
      today.getFullYear(),
      today.getMonth(),
      1
    );
  }


  function eventTouchesMonth(
    event,
    year,
    month
  ) {

    const monthStart =
      new Date(
        year,
        month,
        1,
        0,
        0,
        0,
        0
      );

    const monthEnd =
      new Date(
        year,
        month + 1,
        0,
        23,
        59,
        59,
        999
      );

    const eventStart =
      parseEventDate(
        event.startDate
      );

    eventStart.setHours(
      0,
      0,
      0,
      0
    );

    const eventEnd =
      parseEventDate(
        event.endDate
      );

    eventEnd.setHours(
      23,
      59,
      59,
      999
    );

    return (
      eventStart <= monthEnd &&
      eventEnd >= monthStart
    );
  }


  function eventsForMonth(
    year,
    month
  ) {

    const events =
      calendarEvents.filter(
        (event) =>
          eventTouchesMonth(
            event,
            year,
            month
          )
      );

    /*
     * Upcoming/current first.
     * Past events from selected month last.
     */
    return events.sort(
      (a, b) => {

        const aEnd =
          parseEventDate(
            a.endDate
          );

        aEnd.setHours(
          23,
          59,
          59,
          999
        );

        const bEnd =
          parseEventDate(
            b.endDate
          );

        bEnd.setHours(
          23,
          59,
          59,
          999
        );

        const aPast =
          aEnd < today;

        const bPast =
          bEnd < today;


        if (
          aPast !== bPast
        ) {
          return aPast ? 1 : -1;
        }


        return (
          parseEventDate(
            a.startDate
          ) -
          parseEventDate(
            b.startDate
          )
        );

      }
    );

  }


  function eventForDate(date) {

    const time =
      date.getTime();

    return calendarEvents.find(
      (event) => {

        const start =
          parseEventDate(
            event.startDate
          );

        start.setHours(
          0,
          0,
          0,
          0
        );

        const end =
          parseEventDate(
            event.endDate
          );

        end.setHours(
          23,
          59,
          59,
          999
        );

        return (
          time >=
            start.getTime() &&
          time <=
            end.getTime()
        );

      }
    );

  }


  function isPastEvent(
    event
  ) {

    const end =
      parseEventDate(
        event.endDate
      );

    end.setHours(
      23,
      59,
      59,
      999
    );

    return end < today;
  }


  let calendarCursor =
    getInitialCalendarDate();


  const calendarTitle =
    document.getElementById(
      "calendar-title"
    );

  const calendarGrid =
    document.getElementById(
      "calendar-grid"
    );

  const eventContainer =
    document.getElementById(
      "event-container"
    );

  const monthSummary =
    document.getElementById(
      "month-summary"
    );


  function renderCalendar() {

    const year =
      calendarCursor.getFullYear();

    const month =
      calendarCursor.getMonth();


    calendarTitle.textContent =
      calendarCursor
        .toLocaleDateString(
          "en-US",
          {
            month: "long",
            year: "numeric"
          }
        );


    const firstDay =
      new Date(
        year,
        month,
        1
      );


    const gridStart =
      new Date(
        year,
        month,
        1 - firstDay.getDay()
      );


    let html = "";


    for (
      let i = 0;
      i < 42;
      i++
    ) {

      const day =
        new Date(
          gridStart
        );

      day.setDate(
        gridStart.getDate() + i
      );

      day.setHours(
        12,
        0,
        0,
        0
      );


      const event =
        eventForDate(day);

      const inCurrentMonth =
        day.getMonth() ===
        month;


      let classes = `
        min-h-[32px]
        flex
        items-center
        justify-center
        transition-all
      `;


      if (!inCurrentMonth) {
        classes +=
          " opacity-30";
      }


      if (
        event &&
        inCurrentMonth
      ) {

        classes +=
          " cursor-pointer font-semibold text-white";

        classes +=
          event.role === "hosted"
            ? " bg-[#C5A059]"
            : " bg-[#4A505A]";

      }


      if (
        event &&
        inCurrentMonth
      ) {

        html += `

          <button
            type="button"
            data-calendar-event="${event.id}"
            class="${classes}"
            title="${event.title}"
          >
            ${day.getDate()}
          </button>

        `;

      } else {

        html += `

          <div
            class="${classes}"
          >
            ${day.getDate()}
          </div>

        `;

      }

    }


    calendarGrid.innerHTML =
      html;

  }


  function renderMonthEvents() {

    const year =
      calendarCursor.getFullYear();

    const month =
      calendarCursor.getMonth();

    const monthEvents =
      eventsForMonth(
        year,
        month
      );


    if (!monthEvents.length) {

      eventContainer.innerHTML = `

        <div
          class="
            p-8
            bg-brand-card
            border
            border-brand-border
            text-brand-slate
            text-sm
            font-light
          "
        >
          No events listed for
          ${calendarCursor.toLocaleDateString(
            "en-US",
            {
              month: "long",
              year: "numeric"
            }
          )}.
        </div>

      `;

      monthSummary.textContent =
        "No events this month.";

      return;

    }


    const upcomingCount =
      monthEvents.filter(
        (event) =>
          !isPastEvent(event)
      ).length;

    const pastCount =
      monthEvents.filter(
        (event) =>
          isPastEvent(event)
      ).length;


    const summaryParts = [];

    if (upcomingCount) {
      summaryParts.push(
        `${upcomingCount} upcoming`
      );
    }

    if (pastCount) {
      summaryParts.push(
        `${pastCount} past`
      );
    }

    monthSummary.textContent =
      summaryParts.join(" · ");


    eventContainer.innerHTML =
      monthEvents
        .map(
          (event) => {

            const past =
              isPastEvent(event);

            const typeLabel =
              past
                ? "Past Event"
                : (
                    event.typeLabel ||
                    (
                      event.role ===
                      "hosted"
                        ? "Hosted Community Event"
                        : "Attending Event"
                    )
                  );

            const accentClass =
              event.role === "hosted"
                ? "text-brand-gold"
                : "text-brand-slate";

            const buttonClass =
              event.role === "hosted"
                ? "bg-brand-charcoal text-white hover:bg-brand-gold"
                : "border border-brand-border text-brand-charcoal hover:border-brand-gold";

            return `

              <article
                id="event-${event.id}"
                class="
                  event-card
                  p-6
                  sm:p-8
                  bg-brand-card
                  border
                  border-brand-border
                  shadow-sm
                  transition-all
                  duration-300
                  ${past ? "opacity-90" : ""}
                "
              >

                <div
                  class="
                    flex
                    items-center
                    justify-between
                    gap-4
                    mb-4
                  "
                >

                  <span
                    class="
                      text-[10px]
                      uppercase
                      tracking-[0.2em]
                      font-semibold
                      ${accentClass}
                    "
                  >
                    ${typeLabel}
                  </span>


                  <span
                    class="
                      text-[10px]
                      font-mono
                      border
                      border-brand-border
                      px-2
                      py-1
                      text-brand-slate
                      whitespace-nowrap
                    "
                  >
                    ${formatEventDate(
                      event.startDate,
                      event.endDate
                    )}
                  </span>

                </div>


                <h3
                  class="
                    font-serif
                    text-xl
                    sm:text-2xl
                    text-brand-charcoal
                    mb-3
                  "
                >
                  ${event.title}
                </h3>


                ${
                  event.description
                    ? `
                      <p
                        class="
                          text-brand-slate
                          text-sm
                          leading-relaxed
                          font-light
                          mb-5
                        "
                      >
                        ${event.description}
                      </p>
                    `
                    : ""
                }


                <div
                  class="
                    pt-4
                    border-t
                    border-brand-border
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-center
                    justify-between
                    gap-4
                  "
                >

                  <div
                    class="
                      text-xs
                      text-brand-slate
                    "
                  >

                    ${
                      event.venue
                        ? `
                          <div
                            class="
                              font-medium
                              text-brand-charcoal
                            "
                          >
                            ${event.venue}
                          </div>
                        `
                        : ""
                    }

                    ${
                      event.city
                        ? `
                          <div>
                            ${event.city}
                          </div>
                        `
                        : ""
                    }

                  </div>


                  ${
                    event.url
                      ? `
                        <a
                          href="${event.url}"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="
                            px-5
                            py-2.5
                            text-xs
                            uppercase
                            tracking-widest
                            transition-colors
                            text-center
                            ${buttonClass}
                          "
                        >
                          ${event.buttonLabel ||
                          "Event Information"}
                          ↗
                        </a>
                      `
                      : ""
                  }

                </div>

              </article>

            `;

          }
        )
        .join("");


    eventContainer.scrollTop = 0;

  }


  function renderAll() {

    renderCalendar();

    renderMonthEvents();

  }


  function scrollToEvent(
    eventId
  ) {

    const card =
      document.getElementById(
        `event-${eventId}`
      );

    if (!card) {
      return;
    }


    const cardTop =
      card.offsetTop -
      eventContainer.offsetTop;


    eventContainer.scrollTo({
      top:
        cardTop - 8,

      behavior:
        "smooth"
    });


    card.classList.add(
      "ring-2",
      "ring-brand-gold"
    );


    window.setTimeout(
      () => {

        card.classList.remove(
          "ring-2",
          "ring-brand-gold"
        );

      },
      1600
    );

  }


  document
    .getElementById(
      "calendar-prev"
    )
    ?.addEventListener(
      "click",
      () => {

        calendarCursor =
          new Date(
            calendarCursor.getFullYear(),
            calendarCursor.getMonth() - 1,
            1
          );

        renderAll();

      }
    );


  document
    .getElementById(
      "calendar-next"
    )
    ?.addEventListener(
      "click",
      () => {

        calendarCursor =
          new Date(
            calendarCursor.getFullYear(),
            calendarCursor.getMonth() + 1,
            1
          );

        renderAll();

      }
    );


  calendarGrid
    ?.addEventListener(
      "click",
      (event) => {

        const button =
          event.target.closest(
            "[data-calendar-event]"
          );

        if (!button) {
          return;
        }

        scrollToEvent(
          button.dataset.calendarEvent
        );

      }
    );


  renderAll();

</script>
