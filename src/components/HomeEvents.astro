---
import {
  events
} from "../data/events";


const visibleEvents =
  events
    .filter(
      (event) =>
        event.showOnHome
    )
    .sort(
      (a, b) =>
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime()
    );
---

<section
  class="
    border-y
    border-brand-border
    bg-brand-cream
  "
>

  <div
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-14
    "
  >

    <!-- =================================================
         HEADER
         ================================================= -->

    <div
      class="
        flex
        flex-col
        lg:flex-row
        lg:items-end
        justify-between
        gap-5
        mb-8
      "
    >

      <div>

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community & Fieldwork
        </span>


        <h2
          class="
            font-serif
            text-3xl
            sm:text-4xl
            text-brand-charcoal
            mt-2
          "
        >
          Community Hub & Calendar
        </h2>

      </div>


      <!-- LEGEND -->

      <div
        class="
          flex
          flex-wrap
          items-center
          gap-x-5
          gap-y-2
          text-[9px]
          uppercase
          tracking-[0.14em]
          text-brand-slate
        "
      >

        <div
          class="
            flex
            items-center
            gap-2
          "
        >
          <span
            class="
              w-2
              h-2
              rounded-full
              bg-brand-gold
            "
          ></span>

          Hosted / Co-Organized
        </div>


        <div
          class="
            flex
            items-center
            gap-2
          "
        >
          <span
            class="
              w-2
              h-2
              rounded-full
              bg-brand-charcoal
            "
          ></span>

          Exhibitor
        </div>


        <div
          class="
            flex
            items-center
            gap-2
          "
        >
          <span
            class="
              w-2
              h-2
              rounded-full
              bg-brand-slate
            "
          ></span>

          Attending
        </div>

      </div>

    </div>



    <!-- =================================================
         CALENDAR AREA
         ================================================= -->

    <div
      class="
        grid
        lg:grid-cols-12
        gap-6
        items-center
      "
    >

      <!-- =================================================
           CALENDAR
           ================================================= -->

      <div
        class="
          lg:col-span-5
          bg-white
          border
          border-brand-border
          p-5
          self-center
        "
      >

        <!-- MONTH NAV -->

        <div
          class="
            flex
            items-center
            justify-between
            mb-5
          "
        >

          <button
            id="calendar-prev"
            type="button"
            aria-label="Previous month"
            class="
              w-8
              h-8
              border
              border-brand-border
              text-brand-charcoal
              hover:border-brand-gold
              hover:text-brand-gold
              transition-colors
            "
          >
            ←
          </button>


          <h3
            id="calendar-month-title"
            class="
              font-serif
              text-lg
              text-brand-charcoal
              text-center
            "
          >
          </h3>


          <button
            id="calendar-next"
            type="button"
            aria-label="Next month"
            class="
              w-8
              h-8
              border
              border-brand-border
              text-brand-charcoal
              hover:border-brand-gold
              hover:text-brand-gold
              transition-colors
            "
          >
            →
          </button>

        </div>


        <!-- WEEKDAYS -->

        <div
          class="
            grid
            grid-cols-7
            mb-1
          "
        >

          {
            [
              "S",
              "M",
              "T",
              "W",
              "T",
              "F",
              "S"
            ].map(
              (day) => (
                <div
                  class="
                    text-center
                    text-[8px]
                    uppercase
                    tracking-widest
                    text-brand-slate
                    py-1.5
                  "
                >
                  {day}
                </div>
              )
            )
          }

        </div>


        <div
          id="calendar-grid"
          class="
            grid
            grid-cols-7
            gap-1
          "
        >
        </div>

      </div>



      <!-- =================================================
           EVENT LIST
           ================================================= -->

      <div
        class="
          lg:col-span-7
        "
      >

        <div
          class="
            flex
            items-end
            justify-between
            gap-4
            mb-4
          "
        >

          <div>

            <span
              class="
                text-[9px]
                uppercase
                tracking-[0.18em]
                text-brand-gold
                font-semibold
              "
            >
              Selected Month
            </span>


            <h3
              id="event-month-title"
              class="
                font-serif
                text-xl
                text-brand-charcoal
                mt-1
              "
            >
            </h3>

          </div>


          <span
            id="month-summary"
            class="
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              text-right
            "
          >
          </span>

        </div>


        <div
          id="event-container"
          class="
            max-h-[405px]
            overflow-y-auto
            pr-2
            space-y-3
            custom-scrollbar
          "
        >
        </div>

      </div>

    </div>



    <!-- =================================================
         BOTTOM LINKS
         ================================================= -->

    <div
      class="
        mt-7
        pt-6
        border-t
        border-brand-border
        flex
        flex-wrap
        items-center
        justify-end
        gap-x-6
        gap-y-2
      "
    >

      <a
        href="/fieldwork/"
        class="
          inline-flex
          items-center
          gap-2
          text-[10px]
          uppercase
          tracking-[0.15em]
          text-brand-charcoal
          font-semibold
          hover:text-brand-gold
          transition-colors
        "
      >
        Fieldwork Archive
        <span>→</span>
      </a>


      <a
        href="/?type=partnership#contact"
        class="
          inline-flex
          items-center
          gap-2
          text-[10px]
          uppercase
          tracking-[0.15em]
          text-brand-slate
          font-semibold
          hover:text-brand-gold
          transition-colors
        "
      >
        Partner On An Event
        <span>→</span>
      </a>

    </div>

  </div>

</section>



<script
  is:inline
  define:vars={{
    calendarEvents:
      visibleEvents.map(
        (event) => ({
          id:
            event.id,

          title:
            event.title,

          participation:
            event.participation,

          startDate:
            event.startDate,

          endDate:
            event.endDate,

          venue:
            event.venue,

          city:
            event.city,

          description:
            event.description,

          url:
            event.url,

          buttonLabel:
            event.buttonLabel,

          typeLabel:
            event.typeLabel,

          registrations:
            event.registrations,

          sponsors:
            event.sponsors,

          partners:
            event.partners,

          speakers:
            event.speakers
        })
      )
  }}
>

  (() => {

    const calendarGrid =
      document.getElementById(
        "calendar-grid"
      );


    const calendarTitle =
      document.getElementById(
        "calendar-month-title"
      );


    const eventMonthTitle =
      document.getElementById(
        "event-month-title"
      );


    const eventContainer =
      document.getElementById(
        "event-container"
      );


    const monthSummary =
      document.getElementById(
        "month-summary"
      );


    const prevButton =
      document.getElementById(
        "calendar-prev"
      );


    const nextButton =
      document.getElementById(
        "calendar-next"
      );


    if (
      !calendarGrid ||
      !eventContainer
    ) {

      return;

    }



    /* ===================================================
       HELPERS
       =================================================== */

    function parseEventDate(
      value
    ) {

      return new Date(
        `${value}T12:00:00`
      );

    }


    function isPastEvent(
      event
    ) {

      const end =
        parseEventDate(
          event.endDate ||
          event.startDate
        );


      end.setHours(
        23,
        59,
        59,
        999
      );


      return end <
        new Date();

    }


    function formatEventDate(
      event
    ) {

      const start =
        parseEventDate(
          event.startDate
        );


      const end =
        event.endDate
          ? parseEventDate(
              event.endDate
            )
          : null;


      if (
        !end
      ) {

        return start.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric",

            year:
              "numeric"
          }
        );

      }


      if (
        start.getFullYear() ===
          end.getFullYear() &&
        start.getMonth() ===
          end.getMonth()
      ) {

        return `${start.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric"
          }
        )}–${end.getDate()}, ${end.getFullYear()}`;

      }


      return `${start.toLocaleDateString(
        "en-US",
        {
          month:
            "short",

          day:
            "numeric",

          year:
            "numeric"
        }
      )} – ${end.toLocaleDateString(
        "en-US",
        {
          month:
            "short",

          day:
            "numeric",

          year:
            "numeric"
        }
      )}`;

    }


    function getPriority(
      event
    ) {

      if (
        event.participation ===
          "hosted" ||
        event.participation ===
          "co-organized"
      ) {

        return 3;

      }


      if (
        event.participation ===
        "exhibitor"
      ) {

        return 2;

      }


      return 1;

    }


    function getEventColor(
      event
    ) {

      if (
        event.participation ===
          "hosted" ||
        event.participation ===
          "co-organized"
      ) {

        return "#C5A059";

      }


      if (
        event.participation ===
        "exhibitor"
      ) {

        return "#22252A";

      }


      return "#4A505A";

    }


    function escapeHtml(
      value
    ) {

      if (
        value === null ||
        value === undefined
      ) {

        return "";

      }


      return String(
        value
      )
        .replace(
          /&/g,
          "&amp;"
        )
        .replace(
          /</g,
          "&lt;"
        )
        .replace(
          />/g,
          "&gt;"
        )
        .replace(
          /"/g,
          "&quot;"
        )
        .replace(
          /'/g,
          "&#039;"
        );

    }



    /* ===================================================
       INITIAL MONTH
       =================================================== */

    function getInitialCalendarDate() {

      const upcoming =
        calendarEvents
          .filter(
            (event) =>
              !isPastEvent(
                event
              )
          )
          .sort(
            (a, b) =>
              parseEventDate(
                a.startDate
              ) -
              parseEventDate(
                b.startDate
              )
          );


      if (
        upcoming.length
      ) {

        return parseEventDate(
          upcoming[0].startDate
        );

      }


      if (
        calendarEvents.length
      ) {

        return parseEventDate(
          [...calendarEvents]
            .sort(
              (a, b) =>
                parseEventDate(
                  b.startDate
                ) -
                parseEventDate(
                  a.startDate
                )
            )[0]
            .startDate
        );

      }


      return new Date();

    }


    let currentDate =
      getInitialCalendarDate();



    /* ===================================================
       MONTH HELPERS
       =================================================== */

    function eventTouchesMonth(
      event,
      year,
      month
    ) {

      const start =
        parseEventDate(
          event.startDate
        );


      const end =
        parseEventDate(
          event.endDate ||
          event.startDate
        );


      const monthStart =
        new Date(
          year,
          month,
          1
        );


      const monthEnd =
        new Date(
          year,
          month + 1,
          0,
          23,
          59,
          59,
          999
        );


      return (
        start <=
          monthEnd &&
        end >=
          monthStart
      );

    }


    function eventsForMonth(
      year,
      month
    ) {

      return calendarEvents
        .filter(
          (event) =>
            eventTouchesMonth(
              event,
              year,
              month
            )
        )
        .sort(
          (a, b) => {

            const aPast =
              isPastEvent(
                a
              );


            const bPast =
              isPastEvent(
                b
              );


            if (
              aPast !==
              bPast
            ) {

              return aPast
                ? 1
                : -1;

            }


            const dateDifference =
              parseEventDate(
                a.startDate
              ) -
              parseEventDate(
                b.startDate
              );


            if (
              dateDifference ===
              0
            ) {

              return (
                getPriority(
                  b
                ) -
                getPriority(
                  a
                )
              );

            }


            return dateDifference;

          }
        );

    }


    function eventsForDate(
      date
    ) {

      return calendarEvents
        .filter(
          (event) => {

            const start =
              parseEventDate(
                event.startDate
              );


            const end =
              parseEventDate(
                event.endDate ||
                event.startDate
              );


            return (
              date >=
                start &&
              date <=
                end
            );

          }
        )
        .sort(
          (a, b) =>
            getPriority(
              b
            ) -
            getPriority(
              a
            )
        );

    }



    /* ===================================================
       CALENDAR
       =================================================== */

    function renderCalendar() {

      const year =
        currentDate.getFullYear();


      const month =
        currentDate.getMonth();


      const monthName =
        currentDate.toLocaleDateString(
          "en-US",
          {
            month:
              "long",

            year:
              "numeric"
          }
        );


      calendarTitle.textContent =
        monthName;


      eventMonthTitle.textContent =
        monthName;


      calendarGrid.innerHTML =
        "";


      const firstDay =
        new Date(
          year,
          month,
          1
        );


      const daysInMonth =
        new Date(
          year,
          month + 1,
          0
        ).getDate();


      for (
        let i = 0;
        i < firstDay.getDay();
        i++
      ) {

        const blank =
          document.createElement(
            "div"
          );


        blank.className =
          "aspect-square";


        calendarGrid.appendChild(
          blank
        );

      }


      for (
        let day = 1;
        day <=
          daysInMonth;
        day++
      ) {

        const date =
          new Date(
            year,
            month,
            day,
            12
          );


        const matches =
          eventsForDate(
            date
          );


        const primaryEvent =
          matches[0] ||
          null;


        const element =
          document.createElement(
            primaryEvent
              ? "button"
              : "div"
          );


        element.className =
          [
            "relative",
            "aspect-square",
            "flex",
            "items-center",
            "justify-center",
            "text-[11px]",
            "border",

            primaryEvent
              ? "cursor-pointer transition-transform hover:scale-[1.04]"
              : "border-transparent text-brand-slate"
          ].join(
            " "
          );


        element.textContent =
          String(
            day
          );


        if (
          primaryEvent
        ) {

          const color =
            getEventColor(
              primaryEvent
            );


          element.style.backgroundColor =
            color;


          element.style.borderColor =
            color;


          element.style.color =
            "#FFFFFF";


          if (
            matches.length >
            1
          ) {

            const count =
              document.createElement(
                "span"
              );


            count.textContent =
              `+${matches.length - 1}`;


            count.className =
              "absolute top-1 right-1 text-[6px] font-semibold";


            element.appendChild(
              count
            );

          }


          element.addEventListener(
            "click",
            () => {

              scrollToEvent(
                primaryEvent.id
              );

            }
          );

        }


        calendarGrid.appendChild(
          element
        );

      }

    }



    /* ===================================================
       COMPACT EVENT CARDS
       =================================================== */

    function renderMonthEvents() {

      const year =
        currentDate.getFullYear();


      const month =
        currentDate.getMonth();


      const monthEvents =
        eventsForMonth(
          year,
          month
        );


      eventContainer.innerHTML =
        "";


      if (
        monthEvents.length === 0
      ) {

        eventContainer.innerHTML =
          `
            <div
              class="
                bg-white
                border
                border-brand-border
                p-6
                text-center
                text-xs
                text-brand-slate
              "
            >
              No events listed for this month.
            </div>
          `;


        monthSummary.textContent =
          "No events";


        return;

      }


      const upcoming =
        monthEvents.filter(
          (event) =>
            !isPastEvent(
              event
            )
        ).length;


      const past =
        monthEvents.length -
        upcoming;


      const summary =
        [];


      if (
        upcoming
      ) {

        summary.push(
          `${upcoming} upcoming`
        );

      }


      if (
        past
      ) {

        summary.push(
          `${past} past`
        );

      }


      monthSummary.textContent =
        summary.join(
          " · "
        );


      monthEvents.forEach(
        (event) => {

          const card =
            document.createElement(
              "article"
            );


          card.id =
            `event-${event.id}`;


          card.className =
            [
              "event-card",
              "bg-white",
              "border",
              "border-brand-border",
              "p-4",
              "transition-all",

              isPastEvent(
                event
              )
                ? "opacity-90"
                : ""
            ].join(
              " "
            );


          const color =
            getEventColor(
              event
            );


          const location =
            [
              event.venue,
              event.city
            ]
              .filter(
                Boolean
              )
              .map(
                escapeHtml
              )
              .join(
                " · "
              );


          const registrations =
            typeof event.registrations ===
              "number"
              ? `
                <span class="text-brand-gold font-semibold">
                  ${event.registrations} registrations
                </span>
              `
              : "";


          const sponsors =
            event.sponsors?.length
              ? `
                <span>
                  Sponsor:
                  <strong class="text-brand-charcoal">
                    ${escapeHtml(
                      event.sponsors.join(
                        ", "
                      )
                    )}
                  </strong>
                </span>
              `
              : "";


          const speakers =
            event.speakers?.length
              ? `
                <span>
                  ${event.speakers.length}
                  ${
                    event.speakers.length ===
                    1
                      ? "speaker"
                      : "speakers"
                  }
                </span>
              `
              : "";


          card.innerHTML =
            `
              <div
                class="
                  flex
                  flex-wrap
                  items-center
                  gap-x-2
                  gap-y-1
                  text-[8px]
                  uppercase
                  tracking-[0.13em]
                  mb-2
                "
              >

                <span
                  class="font-semibold"
                  style="color:${color}"
                >
                  ${escapeHtml(
                    event.typeLabel ||
                    "Professional Event"
                  )}
                </span>

                <span class="text-brand-border">
                  •
                </span>

                <span class="text-brand-slate">
                  ${escapeHtml(
                    formatEventDate(
                      event
                    )
                  )}
                </span>

                ${
                  registrations
                    ? `
                      <span class="text-brand-border">
                        •
                      </span>
                      ${registrations}
                    `
                    : ""
                }

              </div>


              <h4
                class="
                  font-serif
                  text-base
                  sm:text-lg
                  text-brand-charcoal
                  leading-snug
                  mb-1.5
                "
              >
                ${escapeHtml(
                  event.title
                )}
              </h4>


              ${
                location
                  ? `
                    <p
                      class="
                        text-[10px]
                        text-brand-slate
                        mb-2
                      "
                    >
                      ${location}
                    </p>
                  `
                  : ""
              }


              ${
                event.description
                  ? `
                    <p
                      class="
                        text-xs
                        text-brand-slate
                        font-light
                        leading-relaxed
                        line-clamp-2
                      "
                    >
                      ${escapeHtml(
                        event.description
                      )}
                    </p>
                  `
                  : ""
              }


              ${
                sponsors ||
                speakers
                  ? `
                    <div
                      class="
                        flex
                        flex-wrap
                        gap-x-4
                        gap-y-1
                        mt-2.5
                        text-[10px]
                        text-brand-slate
                      "
                    >
                      ${sponsors}
                      ${speakers}
                    </div>
                  `
                  : ""
              }


              <a
                href="${escapeHtml(
                  event.url
                )}"
                target="_blank"
                rel="noopener noreferrer"
                class="
                  inline-flex
                  items-center
                  gap-1.5
                  mt-3
                  text-[9px]
                  uppercase
                  tracking-[0.14em]
                  font-semibold
                  text-brand-charcoal
                  hover:text-brand-gold
                  transition-colors
                "
              >
                ${escapeHtml(
                  event.buttonLabel ||
                  "View Event"
                )}

                ↗
              </a>
            `;


          eventContainer.appendChild(
            card
          );

        }
      );

    }



    /* ===================================================
       CARD SCROLL
       =================================================== */

    function scrollToEvent(
      id
    ) {

      const card =
        document.getElementById(
          `event-${id}`
        );


      if (
        !card
      ) {

        return;

      }


      const containerRect =
        eventContainer
          .getBoundingClientRect();


      const cardRect =
        card
          .getBoundingClientRect();


      eventContainer.scrollTo({
        top:
          eventContainer.scrollTop +
          cardRect.top -
          containerRect.top -
          4,

        behavior:
          "smooth"
      });


      card.classList.add(
        "ring-1",
        "ring-brand-gold"
      );


      setTimeout(
        () => {

          card.classList.remove(
            "ring-1",
            "ring-brand-gold"
          );

        },
        1200
      );

    }



    function renderAll() {

      renderCalendar();

      renderMonthEvents();

      eventContainer.scrollTop =
        0;

    }



    prevButton?.addEventListener(
      "click",
      () => {

        currentDate =
          new Date(
            currentDate.getFullYear(),
            currentDate.getMonth() - 1,
            1
          );


        renderAll();

      }
    );


    nextButton?.addEventListener(
      "click",
      () => {

        currentDate =
          new Date(
            currentDate.getFullYear(),
            currentDate.getMonth() + 1,
            1
          );


        renderAll();

      }
    );


    renderAll();

  })();

</script>
