---
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ??
  "https://szdhkttphzvtmljuhcqs.supabase.co";

const supabasePublishableKey =
  import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ??
  "sb_publishable_iN7aDql5whleXHRCRVNS-w_Awl-iQez";
---

<!doctype html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="robots"
    content="noindex, nofollow"
  />

  <meta
    name="theme-color"
    content="#22252A"
  />

  <title>
    Soleil & Stone | Admin Login
  </title>


  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />


  <style>

    :root {
      --cream: #F4F1E8;
      --charcoal: #22252A;
      --slate: #4A505A;
      --gold: #C5A059;
      --border: #DDD8CB;
      --danger: #A94B4B;
      --success: #477A5A;

      --shadow:
        0 18px 60px
        rgba(
          34,
          37,
          42,
          0.08
        );
    }


    * {
      box-sizing: border-box;
    }


    html,
    body {
      margin: 0;
      min-height: 100%;
      background: var(--cream);
    }


    body {
      color: var(--charcoal);

      font-family:
        "Plus Jakarta Sans",
        Inter,
        sans-serif;

      -webkit-font-smoothing: antialiased;
    }


    button,
    input {
      font: inherit;
    }


    button {
      cursor: pointer;
    }


    .hidden {
      display: none !important;
    }



    /* =====================================================
       SCREEN
       ===================================================== */

    .screen {
      min-height: 100vh;

      display: grid;

      place-items: center;

      padding: 28px;

      background:
        radial-gradient(
          circle at top left,
          rgba(
            197,
            160,
            89,
            0.14
          ),
          transparent 34%
        ),
        var(--cream);
    }



    /* =====================================================
       CARD
       ===================================================== */

    .card {
      width:
        min(
          100%,
          500px
        );

      background: #FFFFFF;

      border:
        1px solid
        var(--border);

      padding: 40px;

      box-shadow: var(--shadow);
    }



    /* =====================================================
       LOGO
       ===================================================== */

    .logo-link {
      display: inline-flex;

      margin-bottom: 28px;

      text-decoration: none;
    }


    .logo {
      display: block;

      width: 112px;

      height: auto;
    }



    /* =====================================================
       TYPOGRAPHY
       ===================================================== */

    .eyebrow {
      margin:
        0 0 9px;

      color: var(--gold);

      font-size: 10px;

      font-weight: 600;

      letter-spacing: 0.2em;

      text-transform: uppercase;
    }


    h1 {
      margin: 0;

      font-family:
        "Cinzel",
        Georgia,
        serif;

      font-size:
        clamp(
          30px,
          7vw,
          42px
        );

      font-weight: 400;

      line-height: 1.2;
    }


    .copy {
      margin:
        18px 0 28px;

      color: var(--slate);

      font-size: 14px;

      line-height: 1.75;

      font-weight: 300;
    }



    /* =====================================================
       FORM
       ===================================================== */

    .field + .field {
      margin-top: 16px;
    }


    label {
      display: block;

      margin-bottom: 8px;

      font-size: 10px;

      font-weight: 600;

      letter-spacing: 0.13em;

      text-transform: uppercase;
    }


    input {
      width: 100%;

      min-height: 50px;

      border:
        1px solid
        var(--border);

      border-radius: 0;

      background: #FFFFFF;

      color: var(--charcoal);

      padding:
        0 14px;

      outline: none;

      transition:
        border-color 160ms ease,
        box-shadow 160ms ease;
    }


    input:focus {
      border-color: var(--gold);

      box-shadow:
        0 0 0 3px
        rgba(
          197,
          160,
          89,
          0.12
        );
    }


    .code-input {
      font-size: 26px;

      letter-spacing: 0.22em;

      text-align: center;

      font-weight: 500;
    }



    /* =====================================================
       BUTTONS
       ===================================================== */

    .button {
      width: 100%;

      min-height: 50px;

      margin-top: 18px;

      border:
        1px solid
        var(--charcoal);

      border-radius: 0;

      background:
        var(--charcoal);

      color: #FFFFFF;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding:
        0 16px;

      font-size: 10px;

      font-weight: 600;

      letter-spacing: 0.16em;

      text-transform: uppercase;

      transition:
        background 160ms ease,
        border-color 160ms ease,
        opacity 160ms ease;
    }


    .button:hover {
      background: var(--gold);

      border-color: var(--gold);
    }


    .button:disabled {
      cursor: not-allowed;

      opacity: 0.5;
    }


    .secondary {
      margin-top: 10px;

      border-color:
        var(--border);

      background: #FFFFFF;

      color:
        var(--charcoal);
    }


    .secondary:hover {
      background: #FFFFFF;

      border-color:
        var(--gold);

      color:
        var(--gold);
    }



    /* =====================================================
       MESSAGES
       ===================================================== */

    .message {
      margin:
        16px 0 0;

      font-size: 12px;

      line-height: 1.6;
    }


    .message.success {
      color: var(--success);
    }


    .message.error {
      color: var(--danger);
    }


    .email-summary {
      margin:
        0 0 18px;

      padding:
        12px 14px;

      border:
        1px solid
        var(--border);

      background:
        var(--cream);

      color:
        var(--slate);

      font-size: 12px;

      line-height: 1.6;
    }


    .small-note {
      margin:
        14px 0 0;

      color:
        var(--slate);

      font-size: 10px;

      line-height: 1.6;
    }



    /* =====================================================
       MOBILE
       ===================================================== */

    @media (
      max-width: 640px
    ) {

      .screen {
        padding: 18px;
      }


      .card {
        padding:
          28px 22px;
      }


      input {
        font-size: 16px;
      }


      .code-input {
        font-size: 23px;

        letter-spacing: 0.16em;
      }

    }

  </style>

</head>


<body>

  <main class="screen">

    <section class="card">

      <a
        href="/"
        class="logo-link"
        aria-label="Soleil & Stone home"
      >

        <img
          src="/brand/logo-primary.png"
          alt="Soleil & Stone"
          class="logo"
        />

      </a>


      <p class="eyebrow">
        Private Administration
      </p>


      <h1>
        Content Manager
      </h1>



      <!-- =================================================
           REQUEST CODE
           ================================================= -->

      <div id="request-step">

        <p class="copy">
          Enter your authorized email address.
          We’ll send you a secure one-time code
          to access the Soleil & Stone admin.
        </p>


        <form id="request-form">

          <div class="field">

            <label for="email">
              Email
            </label>


            <input
              id="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              required
            />

          </div>


          <button
            id="request-button"
            class="button"
            type="submit"
          >
            Send secure code
          </button>

        </form>

      </div>



      <!-- =================================================
           VERIFY CODE
           ================================================= -->

      <div
        id="verify-step"
        class="hidden"
      >

        <p class="copy">
          Check your inbox and enter the secure
          code from the Soleil & Stone email.
        </p>


        <p
          id="email-summary"
          class="email-summary"
        ></p>


        <form id="verify-form">

          <div class="field">

            <label for="code">
              Verification code
            </label>


            <input
              id="code"
              class="code-input"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6,8}"
              minlength="6"
              maxlength="8"
              placeholder="00000000"
              required
            />

          </div>


          <button
            id="verify-button"
            class="button"
            type="submit"
          >
            Open Admin
          </button>


          <button
            id="change-email-button"
            class="
              button
              secondary
            "
            type="button"
          >
            Use another email
          </button>

        </form>


        <p class="small-note">
          Codes are single-use.
          If the code expires, request a new one.
        </p>

      </div>



      <!-- =================================================
           STATUS
           ================================================= -->

      <p
        id="message"
        class="
          message
          hidden
        "
        aria-live="polite"
      ></p>

    </section>

  </main>



  <script
    type="module"
    define:vars={{
      supabaseUrl,
      supabasePublishableKey
    }}
  >

    import {
      createClient
    } from
      "https://esm.sh/@supabase/supabase-js@2";


    const supabase =
      createClient(
        supabaseUrl,
        supabasePublishableKey,
        {
          auth: {

            persistSession:
              true,

            autoRefreshToken:
              true,

            detectSessionInUrl:
              false

          }
        }
      );



    /* =====================================================
       ELEMENTS
       ===================================================== */

    const requestStep =
      document.getElementById(
        "request-step"
      );


    const verifyStep =
      document.getElementById(
        "verify-step"
      );


    const requestForm =
      document.getElementById(
        "request-form"
      );


    const verifyForm =
      document.getElementById(
        "verify-form"
      );


    const emailInput =
      document.getElementById(
        "email"
      );


    const codeInput =
      document.getElementById(
        "code"
      );


    const requestButton =
      document.getElementById(
        "request-button"
      );


    const verifyButton =
      document.getElementById(
        "verify-button"
      );


    const changeEmailButton =
      document.getElementById(
        "change-email-button"
      );


    const emailSummary =
      document.getElementById(
        "email-summary"
      );


    const message =
      document.getElementById(
        "message"
      );



    /* =====================================================
       STATE
       ===================================================== */

    let pendingEmail =
      sessionStorage.getItem(
        "soleil_admin_pending_email"
      ) ||
      "";



    /* =====================================================
       HELPERS
       ===================================================== */

    function setMessage(
      text = "",
      type = "success"
    ) {

      message.textContent =
        text;


      message.className =
        text
          ? `message ${type}`
          : "message hidden";

    }



    function setButtonLoading(
      button,
      loading,
      loadingText,
      normalText
    ) {

      button.disabled =
        loading;


      button.textContent =
        loading
          ? loadingText
          : normalText;

    }



    function showVerifyStep() {

      requestStep
        .classList
        .add(
          "hidden"
        );


      verifyStep
        .classList
        .remove(
          "hidden"
        );


      emailSummary.textContent =
        `Code sent to ${pendingEmail}`;


      codeInput.value =
        "";


      codeInput.focus();

    }



    function showRequestStep() {

      verifyStep
        .classList
        .add(
          "hidden"
        );


      requestStep
        .classList
        .remove(
          "hidden"
        );


      if (
        pendingEmail
      ) {

        emailInput.value =
          pendingEmail;

      }


      setMessage();

    }



    /* =====================================================
       EXISTING SESSION
       ===================================================== */

    const {
      data: {
        session
      }
    } =
      await supabase.auth.getSession();


    if (
      session?.user
    ) {

      window.location.replace(
        "/admin/"
      );

    }



    if (
      pendingEmail
    ) {

      emailInput.value =
        pendingEmail;

    }



    /* =====================================================
       REQUEST CODE
       ===================================================== */

    requestForm.addEventListener(
      "submit",
      async (
        event
      ) => {

        event.preventDefault();


        pendingEmail =
          emailInput
            .value
            .trim()
            .toLowerCase();


        sessionStorage.setItem(
          "soleil_admin_pending_email",
          pendingEmail
        );


        setButtonLoading(
          requestButton,
          true,
          "Sending...",
          "Send secure code"
        );


        setMessage();


        try {

          const {
            error
          } =
            await supabase.auth.signInWithOtp(
              {
                email:
                  pendingEmail,

                options: {

                  shouldCreateUser:
                    false

                }
              }
            );


          if (
            error
          ) {

            throw error;

          }


          showVerifyStep();


          setMessage(
            "Your secure code is on the way."
          );

        } catch (
          error
        ) {

          const rawMessage =
            error?.message ||
            "Could not send the secure code.";


          const friendlyMessage =
            rawMessage
              .toLowerCase()
              .includes(
                "rate limit"
              )
                ? "Too many login emails were requested recently. Please wait a moment and try again."
                : rawMessage;


          setMessage(
            friendlyMessage,
            "error"
          );

        } finally {

          setButtonLoading(
            requestButton,
            false,
            "Sending...",
            "Send secure code"
          );

        }

      }
    );



    /* =====================================================
       VERIFY CODE
       ===================================================== */

    verifyForm.addEventListener(
      "submit",
      async (
        event
      ) => {

        event.preventDefault();


        const token =
          codeInput
            .value
            .replace(
              /\D/g,
              ""
            )
            .slice(
              0,
              8
            );


        if (
          token.length !== 6 &&
          token.length !== 8
        ) {

          setMessage(
            "Enter the complete verification code from your email.",
            "error"
          );


          return;

        }


        setButtonLoading(
          verifyButton,
          true,
          "Verifying...",
          "Open Admin"
        );


        setMessage();


        try {

          const {
            data,
            error
          } =
            await supabase.auth.verifyOtp(
              {
                email:
                  pendingEmail,

                token,

                type:
                  "email"
              }
            );


          if (
            error
          ) {

            throw error;

          }


          if (
            !data?.session
          ) {

            throw new Error(
              "Login succeeded but no browser session was created."
            );

          }


          sessionStorage.removeItem(
            "soleil_admin_pending_email"
          );


          window.location.replace(
            "/admin/"
          );

        } catch (
          error
        ) {

          const rawMessage =
            error?.message ||
            "That code could not be verified.";


          const friendlyMessage =
            rawMessage
              .toLowerCase()
              .includes(
                "expired"
              ) ||
            rawMessage
              .toLowerCase()
              .includes(
                "invalid"
              )
                ? "That code is invalid or has expired. Request a new code and enter the complete code from the latest email."
                : rawMessage;


          setMessage(
            friendlyMessage,
            "error"
          );

        } finally {

          setButtonLoading(
            verifyButton,
            false,
            "Verifying...",
            "Open Admin"
          );

        }

      }
    );



    /* =====================================================
       CODE INPUT
       ===================================================== */

    codeInput.addEventListener(
      "input",
      () => {

        codeInput.value =
          codeInput
            .value
            .replace(
              /\D/g,
              ""
            )
            .slice(
              0,
              8
            );

      }
    );



    /* =====================================================
       CHANGE EMAIL
       ===================================================== */

    changeEmailButton.addEventListener(
      "click",
      () => {

        pendingEmail =
          "";


        sessionStorage.removeItem(
          "soleil_admin_pending_email"
        );


        showRequestStep();


        emailInput.focus();

      }
    );

  </script>

</body>

</html>
