      function executeVentureCommandAction(action,ventureId) {
        if(action==="command:new-venture"){openVentureModal();return true;}
        if(action==="command:all-ventures"){openPortfolio();return true;}
        if(action==="command:export-portfolio"){exportVenturePortfolio();return true;}
        if(action==="command:new-task"){
          const venture=ventureById(ventureId)||currentVenture();
          if(venture){openVentureModal(venture.id,"execution",true);}
          return true;
        }
        if(action==="command:files"){
          const venture=ventureById(ventureId)||currentVenture();
          if(venture)openVentureFiles("venture",venture.id);
          return true;
        }
        if(action==="command:public"){
          const venture=ventureById(ventureId)||currentVenture();
          if(venture)openVentureModal(venture.id,"public");
          return true;
        }
        if(action==="command:export-venture"){
          const venture=ventureById(ventureId)||currentVenture();
          if(venture)exportVenture(venture);
          return true;
        }
        return false;
      }


      function executeVentureSearchResult(action,id,ventureId) {
        $("#venture-universal-results")?.classList.add("hidden");
        closeModal("venture-command");

        if(executeVentureCommandAction(action,ventureId))return;
        if (action === "venture") { enterVenture(ventureId); return; }
        if (action === "task") {
          enterVenture(ventureId,"venture-execution");
          window.setTimeout(() => openVentureTaskEditor(id),0);
          return;
        }
        if (action === "milestone") {
          enterVenture(ventureId,"venture-milestones");
          window.setTimeout(() => openVentureMilestoneEditor(id),0);
          return;
        }
        if (action === "workspace_item") {
          const item = state.ventureWorkspaceItems.find((entry) => String(entry.id) === String(id));
          if (!item) return;
          enterVenture(ventureId);
          window.setTimeout(() => {
            openVentureModule(item.module_key);
            openVentureWorkspaceItem(item.id);
          },0);
          return;
        }
        if (action === "attachment") {
          const file = state.ventureAttachments.find((entry) => String(entry.id) === String(id));
          if (!file) return;
          openVentureFiles(file.entity_type,file.entity_id);
          return;
        }
      }


      function commandItems(query = "") {
        const current = currentVenture();
        const commands = [
          { type:"Action", id:"new-venture", ventureId:"", title:"Create new venture", ventureName:"Portfolio", action:"command:new-venture" },
          { type:"Action", id:"all-ventures", ventureId:"", title:"Open All Ventures", ventureName:"Portfolio", action:"command:all-ventures" },
          { type:"Action", id:"export-portfolio", ventureId:"", title:"Export portfolio backup", ventureName:"JSON + file manifest", action:"command:export-portfolio" }
        ];
        if (current) {
          commands.push(
            { type:"Action", id:"new-task", ventureId:current.id, title:`New task for ${current.name}`, ventureName:current.name, action:"command:new-task" },
            { type:"Action", id:"files", ventureId:current.id, title:`Private files for ${current.name}`, ventureName:current.name, action:"command:files" },
            { type:"Action", id:"public", ventureId:current.id, title:`Edit public overview for ${current.name}`, ventureName:current.name, action:"command:public" },
            { type:"Action", id:"export-venture", ventureId:current.id, title:`Export ${current.name}`, ventureName:"JSON + file manifest", action:"command:export-venture" }
          );
        }
        const q=String(query||"").trim().toLowerCase();
        const filteredCommands=q ? commands.filter((item)=>[item.title,item.ventureName].join(" ").toLowerCase().includes(q)) : commands;
        return [...filteredCommands,...filteredVentureSearchEntries(q)].slice(0,24);
      }


