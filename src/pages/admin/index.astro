      async function saveVentureTask() {
        const ventureId = $("#venture-record-id").value;
        const taskId = $("#venture-task-id").value;
        const title = $("#venture-task-title").value.trim();
        if (!ventureId) throw new Error("Save the venture before adding tasks.");
        if (!title) throw new Error("Task title is required.");

        const startDate = $("#venture-task-start").value || null;
        const dueDate = $("#venture-task-due").value || null;
        if (startDate && dueDate && dueDate < startDate) {
          throw new Error("Due date cannot be before the start date.");
        }

        const taskStatus = $("#venture-task-status").value;
        const payload = {
          venture_id: ventureId,
          title,
          description: $("#venture-task-description").value.trim() || null,
          start_date: startDate,
          due_date: dueDate,
          task_status: taskStatus,
          priority: $("#venture-task-priority").value,
          is_done: taskStatus === "done",
          checklist: checklistFromEditor(),
          recurrence_frequency: $("#venture-task-recurrence").value || "none",
          recurrence_interval: Math.max(1,Number($("#venture-task-recurrence-interval").value || 1)),
          related_workspace_item_id: $("#venture-task-related-card").value || null,
          related_milestone_id: $("#venture-task-related-milestone").value || null,
          sort_order: Number($("#venture-task-order").value || 0)
        };

        const response = taskId
          ? await supabase.from("venture_tasks").update(payload).eq("id", taskId)
          : await supabase.from("venture_tasks").insert(payload);

        if (response.error) throw response.error;
        $("#venture-task-editor").classList.add("hidden");
        resetVentureTaskEditor();
        await Promise.all([loadVentureTasks(),loadVentureActivity()]);
        showToast(taskId ? "Task updated." : "Task added.");
      }


      function shiftRecurringDate(value,frequency,interval=1) {
        if(!value)return null;
        const date=new Date(`${value}T12:00:00`);
        if(Number.isNaN(date.getTime()))return value;
        if(frequency==="weekly")date.setDate(date.getDate()+7*interval);
        if(frequency==="monthly")date.setMonth(date.getMonth()+interval);
        if(frequency==="quarterly")date.setMonth(date.getMonth()+3*interval);
        if(frequency==="yearly")date.setFullYear(date.getFullYear()+interval);
        return localDateKey(date);
      }

      async function createNextRecurringTask(task) {
        if(!task || !task.recurrence_frequency || task.recurrence_frequency==="none")return;
        const already=state.ventureTasks.some((item)=>String(item.recurrence_parent_id||"")===String(task.id));
        if(already)return;
        const checklist=taskChecklist(task).map((item)=>({text:item.text,done:false}));
        const {error}=await supabase.from("venture_tasks").insert({
          venture_id:task.venture_id,title:task.title,description:task.description,
          start_date:shiftRecurringDate(task.start_date,task.recurrence_frequency,task.recurrence_interval||1),
          due_date:shiftRecurringDate(task.due_date,task.recurrence_frequency,task.recurrence_interval||1),
          task_status:"todo",priority:task.priority,is_done:false,sort_order:task.sort_order||0,checklist,
          recurrence_frequency:task.recurrence_frequency,recurrence_interval:task.recurrence_interval||1,
          recurrence_parent_id:task.id,related_workspace_item_id:task.related_workspace_item_id||null,
          related_milestone_id:task.related_milestone_id||null
        });
        if(error)throw error;
      }

      async function toggleVentureTask(taskId) {
        const task=state.ventureTasks.find((item)=>String(item.id)===String(taskId));
        if(!task)return;
        const nextStatus=isVentureTaskDone(task) ? "todo":"done";
        const {error}=await supabase.from("venture_tasks").update({task_status:nextStatus,is_done:nextStatus==="done"}).eq("id",taskId);
        if(error)throw error;
        if(nextStatus==="done")await createNextRecurringTask(task);
        await Promise.all([loadVentureTasks(),loadVentureActivity()]);
      }

      async function toggleTaskChecklist(taskId,index) {
        const task=state.ventureTasks.find((item)=>String(item.id)===String(taskId));
        if(!task)return;
        const checklist=taskChecklist(task).map((item,i)=>i===Number(index)?{...item,done:!item.done}:item);
        const {error}=await supabase.from("venture_tasks").update({checklist}).eq("id",task.id);
        if(error)throw error;
        await Promise.all([loadVentureTasks(),loadVentureActivity()]);
      }

