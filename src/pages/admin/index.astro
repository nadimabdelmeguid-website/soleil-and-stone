      async function uploadRepeatLogo(
        card,
        file,
        kind
      ) {
        if (!file || !card) return;

        try {
          const communityEvent =
            isCommunityLogoEvent();

          const targets =
            kind === "sponsor"
              ? communityEvent
                ? ["sponsors", "community", "global"]
                : ["sponsors", "global"]
              : communityEvent
                ? ["community", "global"]
                : ["global"];

          const media =
            await uploadMediaFile(
              file,
              {
                targets,
                mediaKind: "logo",
                altText:
                  file.name.replace(
                    /\.[^.]+$/,
                    ""
                  )
              }
            );

          await loadMedia();
          refreshMediaSelectors();
          refreshEventRepeaterMediaSelectors();

          const select =
            card.querySelector(
              kind === "sponsor"
                ? ".sponsor-logo"
                : ".speaker-company-logo"
            );

          if (select) {
            select.value = media.id;

            const preview =
              select.closest(".form-field")
                ?.querySelector(".logo-preview");

            if (preview) {
              preview.innerHTML =
                logoPreviewMarkup(media.id);
            }
          }

          showToast("Logo uploaded and selected.");

        } catch (error) {
          console.error(error);
          showToast(
            error?.message ||
            "Could not upload logo.",
            "error"
          );
        }
      }


      async function ensureMediaTargets(
        mediaId,
        targets = []
      ) {
        if (!mediaId || !targets.length) return;

        const media =
          state.media.find(
            (item) =>
              String(item.id) ===
              String(mediaId)
          );

        if (!media) return;

        const current =
          Array.isArray(media.publish_targets)
            ? media.publish_targets
            : [];

        const next =
          Array.from(
            new Set([
              ...current,
              ...targets
            ])
          );

        if (
          next.length === current.length &&
          next.every(
            (value) =>
              current.includes(value)
          )
        ) {
          return;
        }

        const {
          error
        } =
          await supabase
            .from("media")
            .update({
              publish_targets: next
            })
            .eq(
              "id",
              mediaId
            );

        if (error) throw error;
      }


      async function saveSpeakerCard(
        card,
        communityEvent
      ) {
        const name =
          card.querySelector(".speaker-name")
            ?.value.trim() ||
          "";

        if (!name) {
          return null;
        }

        const company =
          card.querySelector(".speaker-company")
            ?.value.trim() ||
          null;

        const payload = {
          name,
          title:
            card.querySelector(".speaker-title")
              ?.value.trim() ||
            null,
          company,
          company_url:
            card.querySelector(".speaker-company-url")
              ?.value.trim() ||
            null,
          company_logo_media_id:
            card.querySelector(".speaker-company-logo")
              ?.value ||
            null,
          status:
            "active"
        };

        let id =
          card.dataset.recordId ||
          "";

        if (!id) {
          const existing =
            state.people.find(
              (person) =>
                String(person.name || "")
                  .trim()
                  .toLowerCase() ===
                  name.toLowerCase() &&
                String(person.company || "")
                  .trim()
                  .toLowerCase() ===
                  String(company || "")
                    .trim()
                    .toLowerCase()
            );

          id = existing?.id || "";
        }

        if (id) {
          const {
            error
          } =
            await supabase
              .from("people")
              .update(payload)
              .eq("id", id);

          if (error) throw error;

        } else {
          const {
            data,
            error
          } =
            await supabase
              .from("people")
              .insert(payload)
              .select("id")
              .single();

          if (error) throw error;

          id = data.id;
        }

        if (
          communityEvent &&
          payload.company_logo_media_id
        ) {
          await ensureMediaTargets(
            payload.company_logo_media_id,
            ["community"]
          );
        }

        return id;
      }


      async function saveSponsorCard(
        card,
        communityEvent
      ) {
        const name =
          card.querySelector(".sponsor-name")
            ?.value.trim() ||
          "";

        if (!name) {
          return null;
        }

        const payload = {
          name,
          website_url:
            card.querySelector(".sponsor-url")
              ?.value.trim() ||
            null,
          logo_media_id:
            card.querySelector(".sponsor-logo")
              ?.value ||
            null,
          status:
            "active"
        };

        let id =
          card.dataset.recordId ||
          "";

        if (!id) {
          const existing =
            state.organizations.find(
              (organization) =>
                String(organization.name || "")
                  .trim()
                  .toLowerCase() ===
                name.toLowerCase()
            );

          id = existing?.id || "";
        }

        if (id) {
          const {
            error
          } =
            await supabase
              .from("organizations")
              .update(payload)
              .eq("id", id);

          if (error) throw error;

        } else {
          let insertPayload = {
            ...payload,
            slug: slugify(name)
          };

          let {
            data,
            error
          } =
            await supabase
              .from("organizations")
              .insert(insertPayload)
              .select("id")
              .single();

          if (
            error?.code === "23505"
          ) {
            insertPayload.slug =
              `${slugify(name)}-${crypto.randomUUID().slice(0, 6)}`;

            const retry =
              await supabase
                .from("organizations")
                .insert(insertPayload)
                .select("id")
                .single();

            data = retry.data;
            error = retry.error;
          }

          if (error) throw error;

          id = data.id;
        }

        if (payload.logo_media_id) {
          await ensureMediaTargets(
            payload.logo_media_id,
            communityEvent
              ? ["sponsors", "community"]
              : ["sponsors"]
          );
        }

        return id;
      }


      async function replaceEventRelationshipLinks(
        eventId,
        speakerIds,
        sponsorIds
      ) {
        const deleteSpeakers =
          await supabase
            .from("event_speakers")
            .delete()
            .eq("event_id", eventId);

        if (deleteSpeakers.error) {
          throw deleteSpeakers.error;
        }

        if (speakerIds.length) {
          const addSpeakers =
            await supabase
              .from("event_speakers")
              .insert(
                speakerIds.map(
                  (personId, index) => ({
                    event_id:
                      eventId,
                    person_id:
                      personId,
                    sort_order:
                      index
                  })
                )
              );

          if (addSpeakers.error) {
            throw addSpeakers.error;
          }
        }

        const deleteSponsors =
          await supabase
            .from("event_sponsors")
            .delete()
            .eq("event_id", eventId);

        if (deleteSponsors.error) {
          throw deleteSponsors.error;
        }

        if (sponsorIds.length) {
          const addSponsors =
            await supabase
              .from("event_sponsors")
              .insert(
                sponsorIds.map(
                  (
                    organizationId,
                    index
                  ) => ({
                    event_id:
                      eventId,
                    organization_id:
                      organizationId,
                    sort_order:
                      index
                  })
                )
              );

          if (addSponsors.error) {
            throw addSponsors.error;
          }
        }
      }


