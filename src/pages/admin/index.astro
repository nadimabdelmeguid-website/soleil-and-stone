          bio: $("#person-bio").value.trim() || null,
          photo_media_id: $("#person-photo-media").value || null,
          status: $("#person-status").value
        };
        const response = existingId
          ? await supabase.from("people").update(payload).eq("id", existingId)
          : await supabase.from("people").insert(payload);
        if (response.error) throw response.error;
        closeModal("person");
