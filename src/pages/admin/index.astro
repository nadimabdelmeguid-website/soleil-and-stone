                    Scheduled publication date & time
                  </label>
                  <input
                    id="field-note-published-at"
                    class="input"
                    type="datetime-local"
                  />
                  <p class="field-help">
                    The note stays private until this exact date and time, then becomes public automatically.
                  </p>
                </div>

                <div class="form-field">
                  <label class="label" for="field-note-hero-media">
                    Hero image
