      document.addEventListener("dragover",(event)=>{
        const target=event.target.closest?.("[data-file-drop]");
        if(!target)return;
        event.preventDefault();
        target.classList.add("dragging");
      });

      document.addEventListener("dragleave",(event)=>{
        const target=event.target.closest?.("[data-file-drop]");
        target?.classList.remove("dragging");
      });

      document.addEventListener("drop",async(event)=>{
        const targetEl=event.target.closest?.("[data-file-drop]");
        if(!targetEl)return;
        event.preventDefault();
        targetEl.classList.remove("dragging");
        const files=Array.from(event.dataTransfer?.files||[]);
        if(!files.length)return;
        const target=ventureFileTarget(targetEl.dataset.attachmentType,targetEl.dataset.attachmentId);
        if(!target)return;
        try{
          const count=await uploadFilesToVentureTarget(files,target,{});
          showToast(`${count} private file${count===1?"":"s"} attached to ${target.label}.`);
        }catch(error){
          console.error(error);
          showToast(error?.message||"Could not attach dropped files.","error");
        }
      });

      document.addEventListener("keydown",(event)=>{
        const typing=["INPUT","TEXTAREA","SELECT"].includes(document.activeElement?.tagName) || document.activeElement?.isContentEditable;
        if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==="k"){
          event.preventDefault();openCommandPalette();return;
        }
        if(event.key==="Escape"&&!$("#venture-command-modal")?.classList.contains("hidden")){
          closeModal("venture-command");return;
        }
        if(typing)return;
        if(event.key==="/"){
          event.preventDefault();openPortfolio();window.setTimeout(()=>$("#venture-universal-search")?.focus(),0);return;
        }
        if(event.key.toLowerCase()==="n"){event.preventDefault();openVentureModal();return;}
        if(event.key.toLowerCase()==="t"){
          const venture=currentVenture();if(venture){event.preventDefault();openVentureModal(venture.id,"execution",true);}return;
        }
        if(event.key.toLowerCase()==="f"){
          const venture=currentVenture();if(venture){event.preventDefault();openVentureFiles("venture",venture.id);}return;
        }
      });


