      document.addEventListener(
        "click",
        (
          event
        ) => {

          const markdownButton =
            event.target.closest(
              "[data-markdown-action]"
            );

          if (
            markdownButton
          ) {
            const toolbar =
              markdownButton.closest(
                "[data-markdown-target]"
              );

            applyMarkdown(
              document.getElementById(
                toolbar?.dataset.markdownTarget || ""
              ),
              markdownButton.dataset.markdownAction
            );

            return;
          }


          const eventButton =
            event.target.closest(
              "[data-edit-event]"
            );

          if (
            eventButton
          ) {
            openEventModal(
              eventButton.dataset.editEvent
            );
          }


          const noteButton =
            event.target.closest(
              "[data-edit-field-note]"
            );

          if (
            noteButton
          ) {
            openFieldNoteModal(
              noteButton.dataset.editFieldNote
            );
          }


          const recapButton =
            event.target.closest(
              "[data-edit-recap]"
            );

          if (
            recapButton
          ) {
            openRecapModal(
              recapButton.dataset.editRecap
            );
          }


          const communityButton =
            event.target.closest(
              "[data-edit-community]"
            );

          if (
            communityButton
          ) {
            openCommunityModal(
              communityButton.dataset.editCommunity
            );
