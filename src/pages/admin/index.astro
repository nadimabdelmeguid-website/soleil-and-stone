      function renderVentureContextExecution() {
        const venture = currentVenture();
        const summary = $("#venture-context-task-summary");
        const container = $("#venture-context-task-list");
        if (!venture || !summary || !container) return;

        const stats = ventureTaskStats(venture.id);
        const tasks = [...stats.tasks].sort((a, b) => {
          if (isVentureTaskDone(a) !== isVentureTaskDone(b)) return isVentureTaskDone(a) ? 1 : -1;
          return String(a.due_date || "9999-12-31").localeCompare(String(b.due_date || "9999-12-31"));
        });
        const waiting = tasks.filter((item) => ventureTaskStatus(item) === "waiting").length;

        summary.innerHTML = `
          <div class="stat-card"><div class="stat-value">${stats.open}</div><div class="stat-label">Open</div></div>
          <div class="stat-card"><div class="stat-value">${stats.progress}%</div><div class="stat-label">Completed</div></div>
          <div class="stat-card"><div class="stat-value">${stats.overdue}</div><div class="stat-label">Overdue</div></div>
          <div class="stat-card"><div class="stat-value">${waiting}</div><div class="stat-label">Waiting</div></div>
        `;

        container.innerHTML = tasks.length
          ? tasks.map((task) => {
              const done = isVentureTaskDone(task);
              const status = ventureTaskStatus(task);
              const overdue = !done && task.due_date && task.due_date < localDateKey();
              return `
                <div class="venture-task-row ${done ? "is-done" : ""} ${overdue ? "is-overdue" : ""}" data-file-drop data-attachment-type="task" data-attachment-id="${escapeHtml(task.id)}">
                  <button class="venture-check" type="button" data-toggle-venture-task="${escapeHtml(task.id)}">${done ? "✓" : "○"}</button>
                  <div>
                    <h4 class="venture-task-row-title">${escapeHtml(task.title)}</h4>
                    <div class="venture-task-row-meta">
                      <span class="status-pill ${status === "done" ? "active" : status === "in-progress" ? "scheduled" : status === "waiting" ? "paused" : "idea"}">${escapeHtml(ventureTaskStatusLabel(status))}</span>
                      <span>${escapeHtml(ventureTaskPriorityLabel(task.priority))} priority</span>
                      <span>•</span><span>${escapeHtml(taskTimeline(task))}</span>
                    </div>
                    ${task.description ? `<p class="row-description">${escapeHtml(task.description)}</p>` : ""}
                    ${relatedTaskMarkup(task)}
                    ${checklistMarkup(task)}
                  </div>
                  <div class="venture-task-actions">
                    <button class="secondary-button" type="button" data-manage-venture-files data-attachment-type="task" data-attachment-id="${escapeHtml(task.id)}">Files · ${attachmentCount("task", task.id)}</button>
                    <button class="secondary-button" type="button" data-context-edit-task="${escapeHtml(task.id)}">Edit</button>
                  </div>
                </div>
              `;
            }).join("")
          : `<div class="empty-state"><strong>No tasks yet</strong>Add the first action for ${escapeHtml(venture.name)}.</div>`;
      }


