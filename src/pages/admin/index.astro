      function updateFeatureTypeFilterVisibility() {
        const config = featurePlacementConfig[state.featurePlacement] || featurePlacementConfig.home;
        const allowed = new Set(config.allowedTypes);

        $$("[data-feature-type]").forEach((button) => {
          const type = button.dataset.featureType;
          const visible = type === "all" || allowed.has(type);
          button.classList.toggle("hidden", !visible);
        });

        if (state.featureTypeFilter !== "all" && !allowed.has(state.featureTypeFilter)) {
          state.featureTypeFilter = "all";
        }

        $$("[data-feature-type]").forEach((button) => {
          button.classList.toggle("active", button.dataset.featureType === state.featureTypeFilter);
        });
      }


      function renderFeatures() {
        const placement = state.featurePlacement;
        const config = featurePlacementConfig[placement] || featurePlacementConfig.home;
        const assignments = currentFeatureAssignments(placement);
        const currentIds = new Set(assignments.map((item) => `${item.content_type}:${item.content_id}`));
        const search = $("#feature-search")?.value?.trim().toLowerCase() || "";

        $$("[data-feature-placement]").forEach((button) => {
          button.classList.toggle("active", button.dataset.featurePlacement === placement);
        });

        $("#feature-placement-title").textContent = config.title;
        $("#feature-placement-description").textContent = config.description;
        $("#feature-placement-count").textContent = assignments.length;

        updateFeatureTypeFilterVisibility();

        const currentContainer = $("#feature-current-list");
        currentContainer.innerHTML = assignments.length
          ? assignments.map((assignment, index) => featureCardMarkup(assignment, index, assignments.length)).join("")
          : `<div class="feature-empty"><strong>Nothing featured here yet.</strong><br />Add content from the library on the right.</div>`;

        const available = featureCandidatesForPlacement(placement)
          .filter(({ type, item }) => !currentIds.has(`${type}:${item.id}`))
          .filter(({ type }) => state.featureTypeFilter === "all" || type === state.featureTypeFilter)
          .filter(({ item }) => {
            if (!search) return true;
            return [item.title, item.excerpt, item.description, item.category]
              .filter(Boolean)
              .some((value) => String(value).toLowerCase().includes(search));
          })
          .sort((a, b) => {
            const aDate = a.item.start_date || a.item.published_at || a.item.updated_at || 0;
            const bDate = b.item.start_date || b.item.published_at || b.item.updated_at || 0;
            return new Date(bDate).getTime() - new Date(aDate).getTime();
          });

        const availableContainer = $("#feature-available-list");
        availableContainer.innerHTML = available.length
          ? available.map(({ type, item }) => availableFeatureCardMarkup(type, item)).join("")
          : `<div class="feature-empty">No matching content is available for this placement.</div>`;
      }


      async function syncLegacyFeatureFlag(placement, contentType, contentId, enabled) {
        if (placement === "home" && contentType === "field_note") {
          const { error } = await supabase
            .from("field_notes")
            .update({ featured: enabled })
            .eq("id", contentId);
          if (error) throw error;
          return;
        }

        if (placement === "fieldwork" && contentType === "event") {
          const { error } = await supabase
            .from("events")
            .update({ featured: enabled })
            .eq("id", contentId);
          if (error) throw error;
        }
      }


      async function setFeaturePlacement(placement, contentType, contentId, enabled) {
        const existing = state.featuredContent.find((item) =>
          item.placement === placement &&
          item.content_type === contentType &&
          String(item.content_id) === String(contentId)
        );

        if (enabled) {
          if (!existing) {
            const current = currentFeatureAssignments(placement);
            const nextOrder = current.length
              ? Math.max(...current.map((item) => Number(item.sort_order) || 0)) + 10
              : 10;

            const { error } = await supabase
              .from("featured_content")
              .insert({
                placement,
                content_type: contentType,
                content_id: String(contentId),
                sort_order: nextOrder,
                active: true
              });
            if (error) throw error;
          } else if (existing.active === false) {
            const { error } = await supabase
              .from("featured_content")
              .update({ active: true, updated_at: new Date().toISOString() })
              .eq("id", existing.id);
            if (error) throw error;
          }
        } else if (existing) {
          const { error } = await supabase
            .from("featured_content")
            .delete()
            .eq("id", existing.id);
          if (error) throw error;
        }

        await syncLegacyFeatureFlag(placement, contentType, contentId, enabled);
        await Promise.all([loadFeaturedContent(), loadEvents(), loadFieldNotes()]);
        refreshCounts();
        renderFeatures();
      }


      async function addFeature(contentType, contentId) {
        await setFeaturePlacement(state.featurePlacement, contentType, contentId, true);
        showToast(`Featured on ${featurePlacementConfig[state.featurePlacement]?.title || "this page"}.`);
      }


      async function removeFeature(assignmentId) {
        const assignment = state.featuredContent.find((item) => item.id === assignmentId);
        if (!assignment) return;

        const { error } = await supabase
          .from("featured_content")
          .delete()
          .eq("id", assignmentId);
        if (error) throw error;

        await syncLegacyFeatureFlag(assignment.placement, assignment.content_type, assignment.content_id, false);
        await Promise.all([loadFeaturedContent(), loadEvents(), loadFieldNotes()]);
        refreshCounts();
        renderFeatures();
        showToast("Feature removed. The content itself was not changed.");
      }


      async function moveFeature(assignmentId, direction) {
        const items = currentFeatureAssignments();
        const index = items.findIndex((item) => item.id === assignmentId);
        if (index < 0) return;

        const targetIndex = direction === "up" ? index - 1 : index + 1;
        if (targetIndex < 0 || targetIndex >= items.length) return;

        [items[index], items[targetIndex]] = [items[targetIndex], items[index]];

        const updates = items.map((item, itemIndex) =>
          supabase
            .from("featured_content")
            .update({
              sort_order: (itemIndex + 1) * 10,
              updated_at: new Date().toISOString()
            })
            .eq("id", item.id)
        );

        const results = await Promise.all(updates);
        const failed = results.find((result) => result.error);
        if (failed?.error) throw failed.error;

        await loadFeaturedContent();
        renderFeatures();
      }


      function editFeaturedContent(type, id) {
        if (type === "event") {
          openEventModal(id);
          return;
        }

        if (type === "field_note") {
          openFieldNoteModal(id);
          return;
        }

        if (type === "event_recap") {
          openRecapModal(id);
        }
      }


      async function syncEditorFeaturePlacement(placement, contentType, contentId, enabled) {
        const existing = state.featuredContent.some((item) =>
          item.placement === placement &&
          item.content_type === contentType &&
          String(item.content_id) === String(contentId)
        );

        if (Boolean(enabled) === existing) return;

        if (enabled) {
          const current = currentFeatureAssignments(placement);
          const nextOrder = current.length
            ? Math.max(...current.map((item) => Number(item.sort_order) || 0)) + 10
            : 10;
          const { error } = await supabase.from("featured_content").insert({
            placement,
            content_type: contentType,
            content_id: String(contentId),
            sort_order: nextOrder,
            active: true
          });
          if (error) throw error;
        } else {
          const match = state.featuredContent.find((item) =>
            item.placement === placement &&
            item.content_type === contentType &&
            String(item.content_id) === String(contentId)
          );
          if (match) {
            const { error } = await supabase.from("featured_content").delete().eq("id", match.id);
            if (error) throw error;
          }
        }

        await loadFeaturedContent();
      }


