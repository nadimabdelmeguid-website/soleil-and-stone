      function renderVenturesDashboard() {
        const stats = $("#ventures-dashboard-stats");
        const weekList = $("#ventures-this-week-list");
        const blockersList = $("#ventures-blockers-list");
        const attentionList = $("#ventures-attention-list");
        const milestonesList = $("#ventures-milestones-list");
        if (!stats || !weekList || !blockersList || !attentionList || !milestonesList) return;

        const activeVentures = state.ventures.filter((venture) =>
          !["paused", "archived"].includes(venture.venture_status) && !venture.archived_at
        );
        const openTasks = state.ventureTasks.filter((task) => !task.archived_at && !isVentureTaskDone(task));
        const doneTasks = state.ventureTasks.filter((task) => !task.archived_at && isVentureTaskDone(task));
        const waiting = openTasks.filter((task) => ventureTaskStatus(task) === "waiting");
        const actionable = openTasks.filter((task) => ventureTaskStatus(task) !== "waiting");
        const today = localDateKey();
        const in7Days = dateKeyPlusDays(7);
        const overdue = actionable
          .filter((task) => task.due_date && task.due_date < today)
          .sort((a,b) => String(a.due_date).localeCompare(String(b.due_date)));

        const thisWeek = actionable
          .filter((task) => (task.due_date && task.due_date >= today && task.due_date <= in7Days) || (!task.due_date && task.priority === "high"))
          .sort((a,b) => {
            const priority = { high:0, medium:1, low:2 };
            return (priority[a.priority] ?? 1) - (priority[b.priority] ?? 1)
              || String(a.due_date || "9999-12-31").localeCompare(String(b.due_date || "9999-12-31"));
          });

        const completion = doneTasks.length + openTasks.length
          ? Math.round((doneTasks.length / (doneTasks.length + openTasks.length)) * 100)
          : 0;

        const activeFiles = state.ventureAttachments.filter((file) => !file.archived_at);

        stats.innerHTML = `
          <div class="stat-card"><div class="stat-value">${activeVentures.length}</div><div class="stat-label">Active Ventures</div><div class="stat-meta">${state.ventures.length} total</div></div>
          <div class="stat-card"><div class="stat-value">${actionable.length}</div><div class="stat-label">Actionable Tasks</div><div class="stat-meta">${completion}% completed overall</div></div>
          <div class="stat-card"><div class="stat-value">${waiting.length}</div><div class="stat-label">Waiting / Blocked</div><div class="stat-meta">${overdue.length} overdue actionable</div></div>
          <div class="stat-card"><div class="stat-value">${activeFiles.length}</div><div class="stat-label">Private Files</div><div class="stat-meta">Across all ventures</div></div>
        `;

        weekList.innerHTML = thisWeek.length
          ? thisWeek.slice(0,7).map(ventureFocusRow).join("")
          : '<div class="empty-state"><strong>Nothing urgent this week</strong>High-priority undated tasks also appear here.</div>';

        blockersList.innerHTML = waiting.length
          ? waiting.slice(0,7).map(ventureFocusRow).join("")
          : '<div class="empty-state"><strong>No blockers</strong>No venture tasks are currently marked Waiting.</div>';

        const attention = [
          ...overdue.slice(0,4).map((task) => ({
            title: task.title,
            meta: `${ventureById(task.venture_id)?.name || "Venture"} · overdue ${task.due_date ? formatDate(task.due_date) : ""}`,
            ventureId: task.venture_id,
            section: "venture-execution",
            icon: "!"
          }))
        ];

        activeVentures.forEach((venture) => {
          if (attention.length >= 8) return;
          const openForVenture = openTasks.filter((task) => String(task.venture_id) === String(venture.id));
          if (!openForVenture.length && !venture.next_milestone) {
            attention.push({ title: venture.name, meta: "No open task and no current focus", ventureId: venture.id, icon: "→" });
            return;
          }
          const last = venture.last_update_at || venture.updated_at;
          const staleDays = daysSinceDate(last);
          if (staleDays !== null && staleDays >= 60) {
            attention.push({ title: venture.name, meta: `No meaningful update for ${staleDays} days`, ventureId: venture.id, icon: "◷" });
          }
        });

        attentionList.innerHTML = attention.length
          ? attention.slice(0,8).map(ventureAttentionRow).join("")
          : '<div class="empty-state"><strong>Portfolio is current</strong>No overdue, stale or next-action gaps detected.</div>';

        const plannedMilestones = state.ventureMilestones
          .filter((item) => !item.archived_at && item.status === "planned")
          .filter((item) => activeVentures.some((venture) => String(venture.id) === String(item.venture_id)))
          .sort((a,b) => String(a.milestone_date || "9999-12-31").localeCompare(String(b.milestone_date || "9999-12-31")))
          .slice(0,7);

        const fallbackFocus = activeVentures
          .filter((venture) => venture.next_milestone && !plannedMilestones.some((item) => String(item.venture_id) === String(venture.id)))
          .slice(0,Math.max(0,7-plannedMilestones.length));

        milestonesList.innerHTML = [
          ...plannedMilestones.map((item) => {
            const venture = ventureById(item.venture_id);
            return ventureAttentionRow({
              title:item.title,
              meta:`${venture?.name || "Venture"}${item.milestone_date ? ` · ${formatDate(item.milestone_date)}` : " · No date"}`,
              ventureId:item.venture_id,
              section:"venture-milestones",
              icon:"◇"
            });
          }),
          ...fallbackFocus.map((venture) => ventureAttentionRow({
            title:venture.next_milestone,
            meta:`${venture.name} · Current focus`,
            ventureId:venture.id,
            icon:"→"
          }))
        ].join("") || '<div class="empty-state"><strong>No milestones yet</strong>Add a milestone or current focus to a venture.</div>';

        renderVentureActivity();
        renderVentureDocumentCenter();
        renderVentureArchiveCenter();
      }

      function ventureSearchEntries() {
        const entries = [];

        state.ventures.filter((item) => !item.archived_at).forEach((venture) => entries.push({
          type:"Venture", id:venture.id, ventureId:venture.id, title:venture.name,
          text:[venture.tagline,venture.description,venture.sector,venture.role,venture.location,venture.next_milestone,venture.last_update].filter(Boolean).join(" "),
          action:"venture"
        }));

        state.ventureTasks.filter((item) => !item.archived_at).forEach((task) => entries.push({
          type:"Task", id:task.id, ventureId:task.venture_id, title:task.title,
          text:[task.description,task.priority,task.task_status,task.due_date].filter(Boolean).join(" "),
          action:"task"
        }));

        state.ventureMilestones.filter((item) => !item.archived_at).forEach((item) => entries.push({
          type:"Milestone", id:item.id, ventureId:item.venture_id, title:item.title,
          text:[item.notes,item.status,item.milestone_date].filter(Boolean).join(" "),
          action:"milestone"
        }));

        state.ventureWorkspaceItems.filter((item) => !item.archived_at).forEach((item) => entries.push({
          type:"Card", id:item.id, ventureId:item.venture_id, title:item.title,
          text:[item.module_key,item.item_type,item.status,item.summary,item.notes,item.source_url].filter(Boolean).join(" "),
          action:"workspace_item"
        }));

        state.ventureAttachments.filter((item) => !item.archived_at).forEach((item) => entries.push({
          type:"Private File", id:item.id, ventureId:item.venture_id, title:item.display_name || item.original_name || "File",
          text:[item.original_name,item.category,item.source_label,...(Array.isArray(item.tags)?item.tags:[])].filter(Boolean).join(" "),
          action:"attachment"
        }));

        return entries;
      }


      function filteredVentureSearchEntries(query) {
        const q = String(query || "").trim().toLowerCase();
        if (!q) return [];
        return ventureSearchEntries()
          .map((entry) => {
            const venture = ventureById(entry.ventureId);
            const haystack = [entry.title,entry.type,entry.text,venture?.name].filter(Boolean).join(" ").toLowerCase();
            const score = String(entry.title || "").toLowerCase().startsWith(q) ? 0 : haystack.includes(q) ? 1 : 99;
            return { ...entry, ventureName:venture?.name || "Venture", score };
          })
          .filter((entry) => entry.score < 99)
          .sort((a,b) => a.score-b.score || a.title.localeCompare(b.title))
          .slice(0,20);
      }


      function searchResultMarkup(entry, command = false) {
        return `
          <button class="${command ? "venture-command-result" : "venture-search-result"}" type="button"
            data-venture-search-action="${escapeHtml(entry.action)}"
            data-venture-search-id="${escapeHtml(entry.id)}"
            data-venture-search-venture="${escapeHtml(entry.ventureId)}">
            <span>
              <span class="venture-search-result-title">${escapeHtml(entry.title)}</span>
              <span class="venture-search-result-meta">${escapeHtml(entry.ventureName || "Venture")}</span>
            </span>
            <span class="venture-search-type">${escapeHtml(entry.type)}</span>
          </button>
        `;
      }


      function renderUniversalVentureSearch() {
        const input = $("#venture-universal-search");
        const container = $("#venture-universal-results");
        if (!input || !container) return;
        const items = filteredVentureSearchEntries(input.value);
        container.classList.toggle("hidden", !input.value.trim());
        container.innerHTML = input.value.trim()
          ? (items.length ? items.map((item) => searchResultMarkup(item)).join("") : '<div class="empty-state"><strong>No matches</strong>Try another venture, task or filename.</div>')
