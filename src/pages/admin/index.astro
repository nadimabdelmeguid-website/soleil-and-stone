      async function saveFieldNote() {

        const existingId =
          $("#field-note-record-id").value;

        const title =
          $("#field-note-title").value.trim();

        const status =
          $("#field-note-status").value;

        let publishedAt =
          $("#field-note-published-at").value;


        if (
          status === "published" &&
          !publishedAt
        ) {
          publishedAt =
            new Date().toISOString();
        } else if (
          publishedAt
        ) {
          publishedAt =
            new Date(
              publishedAt
            ).toISOString();
        } else {
          publishedAt =
            null;
        }


        const payload = {
          title,
          excerpt:
            $("#field-note-excerpt").value.trim() || null,
          category:
            $("#field-note-category").value.trim() || null,
          content_markdown:
            $("#field-note-content").value,
          hero_media_id:
            $("#field-note-hero-media").value || null,
          featured:
            $("#field-note-featured").checked,
          published_at:
            publishedAt,
          status
        };


        let response;


        if (
          existingId
        ) {

          response =
            await supabase
              .from("field_notes")
              .update(payload)
              .eq("id", existingId);

        } else {

          const id =
            `note-${crypto.randomUUID()}`;


          response =
            await supabase
              .from("field_notes")
              .insert({
                id,
                slug:
                  `${slugify(title)}-${crypto.randomUUID().slice(0, 6)}`,
                ...payload
              });

        }


        if (
          response.error
        ) {
          throw response.error;
        }


        closeModal("field-note");
        showToast(existingId ? "Field Note updated." : "Field Note created.");
        await loadFieldNotes();
        refreshCounts();
        renderRecentContent();

      }


