        if(!rail||!prev||!next)return;
        const max=Math.max(0,rail.scrollWidth-rail.clientWidth);
        prev.disabled=rail.scrollLeft<=4;
        next.disabled=rail.scrollLeft>=max-4;
      }

      function scrollVentureDashboardRail(direction=1) {
        const rail=$("#venture-dashboard-rail");
        if(!rail)return;
        const card=rail.querySelector(".venture-dashboard-card");
        const gap=16;
        const amount=(card?.getBoundingClientRect().width||400)+gap;
        rail.scrollBy({left:direction*amount,behavior:"smooth"});
      }

