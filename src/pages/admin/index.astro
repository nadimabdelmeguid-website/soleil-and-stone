      async function saveVenturePublicOverview(venture) {
        if (!venture?.id) return;
        const highlights = $("#venture-public-highlights").value.split("\n").map((value) => value.trim()).filter(Boolean);
        const publicImageUrl=$("#venture-public-image-url").value.trim() || null;
        if(publicImageUrl && (publicImageUrl.includes("venture-private-files") || publicImageUrl.includes("/storage/v1/object/sign/"))){
          throw new Error("Private signed-storage links cannot be used as public venture images. Choose a deliberately public image instead.");
        }
        const payload = {
          venture_id: venture.id,
          is_visible: $("#venture-public-visible").checked,
          public_title: $("#venture-public-title").value.trim() || venture.name,
          public_tagline: $("#venture-public-tagline").value.trim() || null,
          public_status: $("#venture-public-status").value.trim() || null,
          public_role: $("#venture-public-role").value.trim() || null,
          public_sector: $("#venture-public-sector").value.trim() || null,
          public_location: $("#venture-public-location").value.trim() || null,
          public_summary: $("#venture-public-summary").value.trim() || null,
          public_highlights: highlights,
          public_image_url: publicImageUrl,
          public_website_url: $("#venture-public-website-url").value.trim() || null,
          sort_order: Number($("#venture-sort-order").value || 0)
        };
        const { error } = await supabase.from("venture_public_overviews").upsert(payload, { onConflict: "venture_id" });
        if (error) throw error;
      }


      function ventureFileTarget(entityType, entityId) {
        if (entityType === "venture") {
          const item = state.ventures.find((entry) => String(entry.id) === String(entityId));
          return item ? { ventureId: item.id, entityType, entityId: item.id, label: item.name } : null;
        }
        if (entityType === "task") {
          const item = state.ventureTasks.find((entry) => String(entry.id) === String(entityId));
          return item ? { ventureId: item.venture_id, entityType, entityId: item.id, label: item.title } : null;
        }
        if (entityType === "milestone") {
          const item = state.ventureMilestones.find((entry) => String(entry.id) === String(entityId));
          return item ? { ventureId: item.venture_id, entityType, entityId: item.id, label: item.title } : null;
        }
        if (entityType === "workspace_item") {
          const item = state.ventureWorkspaceItems.find((entry) => String(entry.id) === String(entityId));
          return item ? { ventureId: item.venture_id, entityType, entityId: item.id, label: item.title } : null;
        }
        return null;
      }


      function readableFileSize(bytes) {
        const value = Number(bytes || 0);
        if (!value) return "Size unavailable";
        if (value < 1024) return `${value} B`;
        if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
        return `${(value / (1024 * 1024)).toFixed(1)} MB`;
      }


      function updateVenturePrivateFilesButton() {
        const button = $("#venture-private-files-button");
        if (!button) return;
        const ventureId = $("#venture-record-id")?.value;
        button.disabled = !ventureId;
        button.textContent = ventureId ? `Manage Private Files · ${attachmentCount("venture", ventureId)}` : "Save Venture Before Adding Files";
      }


      async function renderVentureFilesModal() {
        const target = state.ventureFileTarget;
        const container = $("#venture-files-list");
        if (!target || !container) return;
        const files = attachmentsFor(target.entityType, target.entityId);
        $("#venture-files-count").textContent = `${files.length} file${files.length === 1 ? "" : "s"}`;
        if (!files.length) {
          container.innerHTML = '<div class="empty-state"><strong>No private files yet</strong>Add documents, spreadsheets, PDFs or pictures for this item.</div>';
          return;
        }
        container.innerHTML = files.map((file) => {
          const isImage = String(file.mime_type || "").startsWith("image/");
          return `
            <div class="venture-file-row">
              <div class="venture-file-thumb" data-venture-file-thumb="${escapeHtml(file.id)}">${isImage ? "▧" : "↗"}</div>
              <div>
                <p class="venture-file-name">${escapeHtml(file.display_name || file.original_name || "File")}</p>
                <div class="venture-file-meta">${escapeHtml(file.mime_type || "File")} · ${escapeHtml(readableFileSize(file.file_size))}${file.category ? ` · ${escapeHtml(file.category)}` : ""}${file.document_date ? ` · ${escapeHtml(formatDate(file.document_date))}` : ""}</div>
                ${Array.isArray(file.tags) && file.tags.length ? `<div class="venture-file-meta">Tags: ${file.tags.map((tag)=>escapeHtml(tag)).join(", ")}</div>` : ""}
                ${file.source_label ? `<div class="venture-file-meta">Source: ${escapeHtml(file.source_label)}</div>` : ""}
                ${file.caption ? `<div class="row-description" style="margin-top:6px;">${escapeHtml(file.caption)}</div>` : ""}
              </div>
              <div class="venture-file-actions">
                <button class="secondary-button" type="button" data-open-venture-file="${escapeHtml(file.id)}">Open</button>
                <button class="secondary-button" type="button" data-edit-venture-file="${escapeHtml(file.id)}">Details</button>
                <button class="danger-button" type="button" data-delete-venture-file="${escapeHtml(file.id)}">Archive</button>
              </div>
            </div>
          `;
        }).join("");

        await Promise.all(files.filter((file) => String(file.mime_type || "").startsWith("image/")).map(async (file) => {
          const { data, error } = await supabase.storage.from("venture-private-files").createSignedUrl(file.storage_path, 300);
          if (error || !data?.signedUrl) return;
          const thumb = document.querySelector(`[data-venture-file-thumb="${CSS.escape(String(file.id))}"]`);
          if (thumb) thumb.innerHTML = `<img src="${escapeHtml(data.signedUrl)}" alt="" />`;
        }));
      }


      function openVentureFiles(entityType, entityId) {
        const target = ventureFileTarget(entityType, entityId);
        if (!target) { showToast("Could not resolve the file target.", "error"); return; }
        state.ventureFileTarget = target;
        state.venturePendingFiles = [];
        $("#venture-files-target-label").textContent = target.label || "Venture item";
        $("#venture-files-input").value = "";
        $("#venture-file-category").value = "";
        $("#venture-file-document-date").value = "";
        $("#venture-file-tags").value = "";
        $("#venture-file-source").value = "";
        $("#venture-files-modal").removeAttribute("hidden");
        $("#venture-files-modal").classList.remove("hidden");
        document.body.style.overflow = "hidden";
        renderVentureFilesModal();
      }


      function safeVentureFileName(name) {
        return String(name || "file").normalize("NFKD").replace(/[^a-zA-Z0-9._-]+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "").slice(-120) || "file";
      }


      function ventureFileUploadMetadata() {
        return {
          category: $("#venture-file-category")?.value.trim() || null,
          document_date: $("#venture-file-document-date")?.value || null,
          tags: ($("#venture-file-tags")?.value || "").split(",").map((tag)=>tag.trim()).filter(Boolean),
          source_label: $("#venture-file-source")?.value.trim() || null
        };
      }


      async function uploadFilesToVentureTarget(files,target,metadata={}) {
        const selected=Array.from(files || []);
        if (!target) throw new Error("No venture item is selected.");
        if (!selected.length) throw new Error("Choose at least one file.");
        if (!state.user?.id) throw new Error("Your admin session is not available.");

        for (const file of selected) {
          if (file.size > 50 * 1024 * 1024) throw new Error(`${file.name} is larger than the 50 MB private-file limit.`);
          const storagePath=`${state.user.id}/${target.ventureId}/${target.entityType}/${target.entityId}/${crypto.randomUUID()}-${safeVentureFileName(file.name)}`;
          const {error:uploadError}=await supabase.storage.from("venture-private-files").upload(storagePath,file,{cacheControl:"3600",upsert:false,contentType:file.type||undefined});
          if(uploadError) throw uploadError;
          const {error:recordError}=await supabase.from("venture_attachments").insert({
            venture_id:target.ventureId,
            entity_type:target.entityType,
            entity_id:target.entityId,
            display_name:file.name,
            original_name:file.name,
            mime_type:file.type||null,
            file_size:file.size,
            storage_path:storagePath,
            category:metadata.category||null,
            document_date:metadata.document_date||null,
            tags:Array.isArray(metadata.tags)?metadata.tags:[],
            source_label:metadata.source_label||null
          });
          if(recordError){
            await supabase.storage.from("venture-private-files").remove([storagePath]);
            throw recordError;
          }
        }
        await Promise.all([loadVentureAttachments(),loadVentureActivity()]);
        return selected.length;
      }


      async function uploadVentureFiles() {
        const target=state.ventureFileTarget;
        const inputFiles=Array.from($("#venture-files-input")?.files||[]);
        const files=state.venturePendingFiles.length ? state.venturePendingFiles : inputFiles;
        const count=await uploadFilesToVentureTarget(files,target,ventureFileUploadMetadata());
        state.venturePendingFiles=[];
        $("#venture-files-input").value="";
        await renderVentureFilesModal();
        showToast(count===1 ? "Private file uploaded." : `${count} private files uploaded.`);
      }

      function openVentureFileDetails(fileId) {
        const file=state.ventureAttachments.find((item)=>String(item.id)===String(fileId));
        if(!file)return;
        $("#venture-file-details-id").value=file.id;
        $("#venture-file-details-title").textContent=file.display_name||file.original_name||"File Details";
        $("#venture-file-details-name").value=file.display_name||file.original_name||"";
        $("#venture-file-details-caption").value=file.caption||"";
        $("#venture-file-details-category").value=file.category||"";
        $("#venture-file-details-date").value=file.document_date||"";
        $("#venture-file-details-tags").value=Array.isArray(file.tags)?file.tags.join(", "):"";
        $("#venture-file-details-source").value=file.source_label||"";
        $("#venture-file-details-modal").removeAttribute("hidden");
        $("#venture-file-details-modal").classList.remove("hidden");
        document.body.style.overflow="hidden";
      }

      async function saveVentureFileDetails() {
        const id=$("#venture-file-details-id").value;
        if(!id)throw new Error("No private file is selected.");
        const payload={
          display_name:$("#venture-file-details-name").value.trim()||"File",
          caption:$("#venture-file-details-caption").value.trim()||null,
          category:$("#venture-file-details-category").value.trim()||null,
          document_date:$("#venture-file-details-date").value||null,
          tags:$("#venture-file-details-tags").value.split(",").map((tag)=>tag.trim()).filter(Boolean),
          source_label:$("#venture-file-details-source").value.trim()||null
        };
        const {error}=await supabase.from("venture_attachments").update(payload).eq("id",id);
        if(error)throw error;
        closeModal("venture-file-details");
        await Promise.all([loadVentureAttachments(),loadVentureActivity()]);
        if(!$("#venture-files-modal").classList.contains("hidden"))await renderVentureFilesModal();
        showToast("Private file details updated.");
      }


      async function openVentureAttachment(fileId) {
        const file = state.ventureAttachments.find((item) => String(item.id) === String(fileId));
        if (!file) return;
        const { data, error } = await supabase.storage.from("venture-private-files").createSignedUrl(file.storage_path, 300);
        if (error) throw error;
        if (!data?.signedUrl) throw new Error("Could not create a private file link.");
        window.open(data.signedUrl, "_blank", "noopener,noreferrer");
      }


      async function deleteVentureAttachment(fileId) {
        const file=state.ventureAttachments.find((item)=>String(item.id)===String(fileId));
        if(!file)return;
        if(!window.confirm(`Archive "${file.display_name || file.original_name || "this file"}"? The stored file will be retained.`))return;
        const {error}=await supabase.from("venture_attachments").update({archived_at:new Date().toISOString()}).eq("id",file.id);
        if(error)throw error;
        await Promise.all([loadVentureAttachments(),loadVentureActivity()]);
        await renderVentureFilesModal();
        showToast("Private file archived.");
      }

      async function loadVentureWorkspaceItems() {
        const { data, error } = await supabase
          .from("venture_workspace_items")
          .select("*")
          .order("sort_order", { ascending: true })
          .order("updated_at", { ascending: false });

        if (error) {
          showToast(`Could not load venture workspace items: ${error.message}`, "error");
          return;
        }

        state.ventureWorkspaceItems = data || [];
        queueVentureUiRefresh({
          portfolio: true,
          current: true,
          sidebar: true,
          modal: true
        });
      }


      async function loadVentures() {
        const { data, error } = await supabase
          .from("ventures")
          .select("*")
          .order("sort_order", { ascending: true })
          .order("updated_at", { ascending: false });

        if (error) {
          showToast(`Could not load ventures: ${error.message}`, "error");
          return;
        }

        state.ventures = data || [];
        queueVentureUiRefresh({
          portfolio: true,
          current: true,
          sidebar: true,
          modal: true
        });
      }


      async function loadVentureTasks() {
        const { data, error } = await supabase
          .from("venture_tasks")
          .select("*")
          .order("sort_order", { ascending: true })
          .order("due_date", { ascending: true, nullsFirst: false });

        if (error) {
          showToast(`Could not load venture tasks: ${error.message}`, "error");
          return;
        }

        state.ventureTasks = data || [];
        queueVentureUiRefresh({
          portfolio: true,
          current: true,
          sidebar: true,
          modal: true
        });
      }


      function tasksForVenture(ventureId) {
        return state.ventureTasks.filter((task) => !task.archived_at && String(task.venture_id) === String(ventureId));
      }


      function milestonesForVenture(ventureId) {
        return state.ventureMilestones
          .filter((item) => !item.archived_at)
          .filter((item) => String(item.venture_id) === String(ventureId))
          .sort((a, b) => {
            if (a.status === "completed" && b.status !== "completed") return 1;
            if (b.status === "completed" && a.status !== "completed") return -1;
            return String(a.milestone_date || "9999-12-31").localeCompare(String(b.milestone_date || "9999-12-31"));
          });
      }


      function isVentureTaskDone(task) {
        return task?.task_status === "done" || Boolean(task?.is_done);
      }


      function ventureTaskStatus(task) {
        if (task?.task_status) return task.task_status;
        return task?.is_done ? "done" : "todo";
      }


      function ventureTaskStatusLabel(status) {
        return ({
          todo: "To do",
          "in-progress": "In progress",
          waiting: "Waiting",
          done: "Done"
        })[status] || "To do";
      }


      function ventureTaskPriorityLabel(priority) {
        return ({
          low: "Low",
          medium: "Medium",
          high: "High"
        })[priority] || "Medium";
      }


      function taskTimeline(task) {
        if (task.start_date && task.due_date) return `${formatDate(task.start_date)} → ${formatDate(task.due_date)}`;
        if (task.due_date) return `Due ${formatDate(task.due_date)}`;
        if (task.start_date) return `Starts ${formatDate(task.start_date)}`;
        return "No due date";
      }


      function localDateKey(date = new Date()) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      }


      function dateKeyPlusDays(days) {
        const date = new Date();
        date.setHours(12, 0, 0, 0);
        date.setDate(date.getDate() + days);
        return localDateKey(date);
      }


      function ventureStatusLabel(status) {
        return ({
          idea: "Idea",
          validation: "Validation",
          building: "Building",
          pilot: "Pilot",
          active: "Active",
          paused: "Paused",
          archived: "Archived"
        })[status] || status || "Idea";
      }


      function ventureTaskStats(ventureId) {
        const tasks = tasksForVenture(ventureId);
        const done = tasks.filter(isVentureTaskDone).length;
        const open = tasks.length - done;
        const today = localDateKey();
        const overdue = tasks.filter((task) => !isVentureTaskDone(task) && task.due_date && task.due_date < today).length;
        const progress = tasks.length ? Math.round((done / tasks.length) * 100) : 0;
        return { tasks, done, open, overdue, progress };
      }


      function updateVentureLiveSummary() {
        const summary = $("#venture-live-summary");
        if (!summary) return;
        const ventureId = $("#venture-record-id")?.value;
        if (!ventureId) {
          summary.innerHTML = `
            <p class="eyebrow">Execution Snapshot</p>
            <span class="venture-summary-number">0%</span>
            <p class="panel-copy">Save the venture, then add tasks and milestones.</p>
          `;
          return;
        }

        const stats = ventureTaskStats(ventureId);
        const plannedMilestones = milestonesForVenture(ventureId).filter((item) => item.status === "planned").length;
        summary.innerHTML = `
          <p class="eyebrow">Execution Snapshot</p>
          <span class="venture-summary-number">${stats.progress}%</span>
          <p class="panel-copy">${stats.done} of ${stats.tasks.length} tasks complete · ${stats.open} open · ${plannedMilestones} planned milestone${plannedMilestones === 1 ? "" : "s"}.</p>
          <div class="venture-progress-track" style="margin-top:12px;"><div class="venture-progress-fill" style="width:${stats.progress}%"></div></div>
        `;
      }


      function setVentureTab(tabName = "overview") {
        const hasRecord = Boolean($("#venture-record-id")?.value);
        const protectedTab = ["public", "execution", "milestones"].includes(tabName);
        const next = protectedTab && !hasRecord ? "overview" : tabName;

        $$("#venture-tabs [data-venture-tab]").forEach((button) => {
          button.classList.toggle("active", button.dataset.ventureTab === next);
          button.disabled = !hasRecord && ["public", "execution", "milestones"].includes(button.dataset.ventureTab);
        });

        $$("[data-venture-tab-panel]").forEach((panel) => {
          panel.classList.toggle("hidden", panel.dataset.ventureTabPanel !== next);
        });
      }


      function refreshVentureModalHeader(item = null) {
        const meta = $("#venture-modal-header-meta");
        if (!meta) return;
        const status = item?.venture_status || $("#venture-status")?.value || "idea";
        meta.innerHTML = `
          <span class="status-pill ${escapeHtml(status)}">${escapeHtml(ventureStatusLabel(status))}</span>
          <span class="ventures-private-badge">Admin only</span>
          ${item?.public_ready ? '<span class="status-pill active">Presentation ready</span>' : ""}
        `;
      }


      function taskChecklist(task) {
        return Array.isArray(task?.checklist) ? task.checklist : [];
      }

      function checklistToEditor(task) {
        return taskChecklist(task).map((item)=>`${item.done ? "[x]" : "[ ]"} ${item.text || ""}`).join("\n");
      }

      function checklistFromEditor() {
        return ($("#venture-task-checklist")?.value || "")
          .split("\n").map((line)=>line.trim()).filter(Boolean)
          .map((line)=>({done:/^\[x\]/i.test(line),text:line.replace(/^\[(?:x| )\]\s*/i,"").trim()}))
          .filter((item)=>item.text);
      }

      function checklistMarkup(task) {
        const items=taskChecklist(task);
        if(!items.length)return "";
        return `<div class="venture-checklist-preview">${items.slice(0,8).map((item,index)=>`
          <button class="venture-checklist-chip ${item.done ? "done":""}" type="button" data-toggle-task-checklist="${escapeHtml(task.id)}" data-checklist-index="${index}">${item.done ? "✓":"○"} ${escapeHtml(item.text)}</button>
        `).join("")}${items.length>8 ? `<span class="venture-checklist-chip">+${items.length-8}</span>`:""}</div>`;
      }

      function relatedTaskMarkup(task) {
        const card=task.related_workspace_item_id ? state.ventureWorkspaceItems.find((item)=>String(item.id)===String(task.related_workspace_item_id)) : null;
        const milestone=task.related_milestone_id ? state.ventureMilestones.find((item)=>String(item.id)===String(task.related_milestone_id)) : null;
        if(!card&&!milestone)return "";
        return `<div class="row-meta" style="margin-top:7px;">${card ? `<span>Card: ${escapeHtml(card.title)}</span>`:""}${card&&milestone ? "<span>•</span>":""}${milestone ? `<span>Milestone: ${escapeHtml(milestone.title)}</span>`:""}</div>`;
      }

      function refreshVentureTaskRelationSelectors(ventureId) {
        const cardSelect=$("#venture-task-related-card");
        const milestoneSelect=$("#venture-task-related-milestone");
        if(cardSelect){
          const cards=state.ventureWorkspaceItems.filter((item)=>!item.archived_at&&String(item.venture_id)===String(ventureId));
          cardSelect.innerHTML='<option value="">None</option>'+cards.map((item)=>`<option value="${escapeHtml(item.id)}">${escapeHtml(item.title)}</option>`).join("");
        }
        if(milestoneSelect){
          const milestones=state.ventureMilestones.filter((item)=>!item.archived_at&&String(item.venture_id)===String(ventureId));
          milestoneSelect.innerHTML='<option value="">None</option>'+milestones.map((item)=>`<option value="${escapeHtml(item.id)}">${escapeHtml(item.title)}</option>`).join("");
        }
      }

      function renderVentureTasks() {
        const container = $("#venture-tasks-list");
        const ventureId = $("#venture-record-id")?.value;
        if (!container) return;

        if (!ventureId) {
          container.innerHTML = `<div class="empty-state"><strong>Save the venture first</strong>Tasks become available after the venture record exists.</div>`;
          updateVentureLiveSummary();
          return;
        }

        const today = localDateKey();
        const tasks = [...tasksForVenture(ventureId)].sort((a, b) => {
          const aDone = isVentureTaskDone(a);
          const bDone = isVentureTaskDone(b);
          if (aDone !== bDone) return aDone ? 1 : -1;
          const priorityOrder = { high: 0, medium: 1, low: 2 };
          const priorityDelta = (priorityOrder[a.priority] ?? 1) - (priorityOrder[b.priority] ?? 1);
          if (priorityDelta) return priorityDelta;
          const dueDelta = String(a.due_date || "9999-12-31").localeCompare(String(b.due_date || "9999-12-31"));
          if (dueDelta) return dueDelta;
          return Number(a.sort_order || 0) - Number(b.sort_order || 0);
        });

        const done = tasks.filter(isVentureTaskDone).length;
        const progress = tasks.length ? Math.round((done / tasks.length) * 100) : 0;
        $("#venture-task-progress").textContent = tasks.length
          ? `${done} of ${tasks.length} completed · ${progress}%`
          : "No tasks yet. Add the first concrete next action.";

        container.innerHTML = tasks.length
          ? tasks.map((task) => {
              const status = ventureTaskStatus(task);
              const doneTask = isVentureTaskDone(task);
              const overdue = !doneTask && task.due_date && task.due_date < today;
              return `
                <div class="venture-task-row ${doneTask ? "is-done" : ""} ${overdue ? "is-overdue" : ""}" data-file-drop data-attachment-type="task" data-attachment-id="${escapeHtml(task.id)}">
                  <button class="venture-check" type="button" data-toggle-venture-task="${escapeHtml(task.id)}" aria-label="${doneTask ? "Mark task open" : "Mark task done"}">${doneTask ? "✓" : "○"}</button>
                  <div>
                    <h4 class="venture-task-row-title">${escapeHtml(task.title)}</h4>
                    <div class="venture-task-row-meta">
                      <span class="status-pill ${status === "done" ? "active" : status === "in-progress" ? "scheduled" : status === "waiting" ? "paused" : "idea"}">${escapeHtml(ventureTaskStatusLabel(status))}</span>
                      <span class="${task.priority === "high" ? "venture-priority-high" : ""}">${escapeHtml(ventureTaskPriorityLabel(task.priority))} priority</span>
                      <span>•</span>
                      <span>${escapeHtml(taskTimeline(task))}</span>
                      ${overdue ? '<span class="venture-priority-high">• Overdue</span>' : ""}
                    </div>
                    ${task.description ? `<p class="row-description">${escapeHtml(task.description)}</p>` : ""}
                    ${relatedTaskMarkup(task)}
                    ${checklistMarkup(task)}
                  </div>
                  <div class="venture-task-actions">
                    <button class="secondary-button" type="button" data-manage-venture-files data-attachment-type="task" data-attachment-id="${escapeHtml(task.id)}">Files · ${attachmentCount("task", task.id)}</button>
                    <button class="secondary-button" type="button" data-edit-venture-task="${escapeHtml(task.id)}">Edit</button>
                  </div>
                </div>
              `;
            }).join("")
          : `<div class="empty-state"><strong>No tasks yet</strong>Add the first concrete next action for this venture.</div>`;

        updateVentureLiveSummary();
      }


      function resetVentureTaskEditor() {
        $("#venture-task-id").value = "";
        $("#venture-task-title").value = "";
        $("#venture-task-start").value = "";
        $("#venture-task-due").value = "";
        $("#venture-task-description").value = "";
        $("#venture-task-checklist").value = "";
        $("#venture-task-recurrence").value = "none";
        $("#venture-task-recurrence-interval").value = "1";
        $("#venture-task-related-card").innerHTML = '<option value="">None</option>';
        $("#venture-task-related-milestone").innerHTML = '<option value="">None</option>';
        $("#venture-task-order").value = "0";
        $("#venture-task-status").value = "todo";
        $("#venture-task-priority").value = "medium";
        $("#venture-task-editor-title").textContent = "New Task";
        $("#delete-venture-task-button").classList.add("hidden");
      }


