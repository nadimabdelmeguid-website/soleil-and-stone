            type="hidden"
          />

          <div class="form-section import-section">
            <div class="form-section-header">
              <h3 class="form-section-title">
                Import From Event URL
              </h3>
              <p class="form-section-copy">
                Paste the public event page first. We will use it to prefill as much as possible.
                Nothing is saved until you click Save Event, and once saved the event record no longer
                depends on the source page.
              </p>
            </div>

            <div class="form-section-body">
              <div class="import-url-row">
                <input
                  id="event-url"
                  class="input"
                  type="url"
                  placeholder="https://luma.com/...  ·  https://eventship.com/...  ·  https://meetup.com/..."
                />
                <button
                  id="import-event-url-button"
                  class="primary-button"
                  type="button"
                >
                  Import details
                </button>
              </div>

              <div
                id="event-import-status"
                class="import-status hidden"
              ></div>
            </div>
          </div>


          <div class="form-section">
            <div class="form-section-header">
              <h3 class="form-section-title">
                Event Details
              </h3>
              <p class="form-section-copy">
                Review the imported information and edit anything before saving.
              </p>
            </div>

            <div class="form-section-body">
              <div class="form-grid">
                <div class="form-field full">
                  <label
                    class="label"
                    for="event-title"
                  >
                    Title
                  </label>
                  <input
                    id="event-title"
                    class="input"
                    type="text"
                    required
                  />
                </div>

                <div class="form-field">
                  <label
                    class="label"
                    for="event-start-date"
                  >
                    Start date
                  </label>
                  <input
                    id="event-start-date"
                    class="input"
                    type="date"
                    required
                  />
                </div>

                <div class="form-field">
                  <label
                    class="label"
                    for="event-end-date"
                  >
                    End date
                  </label>
                  <input
                    id="event-end-date"
                    class="input"
                    type="date"
                  />
                </div>

                <div class="form-field">
                  <label
                    class="label"
                    for="event-participation"
                  >
                    My participation
                  </label>
                  <select
                    id="event-participation"
                    class="select"
                  >
                    <option value="">
                      Select
                    </option>
                    <option value="hosted">
                      Hosted
                    </option>
                    <option value="co-organized">
                      Co-organized
                    </option>
                    <option value="attending">
                      Attending
                    </option>
                    <option value="exhibitor">
                      Exhibitor
                    </option>
                  </select>
                  <p class="field-help">
                    Hosted and co-organized events unlock registration, speaker, sponsor and community-track-record fields.
                  </p>
                </div>

                <div class="form-field">
                  <label class="label" for="event-community">
                    Community
                  </label>
                  <select id="event-community" class="select">
                    <option value="">No community</option>
                  </select>
                </div>

                <div class="form-field">
                  <label
                    class="label"
                    for="event-type"
                  >
                    Event type
                  </label>
                  <select
                    id="event-type"
                    class="select"
                  >
                    <option value="">
                      Select event type
                    </option>
                    <option value="meetup">Meetup / Community Event</option>
                    <option value="mixer">Mixer / Networking Event</option>
                    <option value="trade-show">Trade Show / Expo</option>
                    <option value="conference">Conference / Summit</option>
                    <option value="workshop">Workshop / Panel</option>
                    <option value="demo-day">Demo Day / Pitch Event</option>
