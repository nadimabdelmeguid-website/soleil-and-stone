      async function saveEvent() {

        const existingId =
          $("#event-record-id").value;

        const title =
          $("#event-title")
            .value
            .trim();

        const startDate =
          $("#event-start-date").value;


        const payload = {
          title,
          start_date:
            startDate,
          end_date:
            $("#event-end-date").value ||
            null,
          event_type:
            $("#event-type").value.trim() ||
            null,
          community_id:
            $("#event-community").value ||
            null,
          participation:
            $("#event-participation").value ||
            null,
          role:
            $("#event-role").value ||
            null,
          type_label:
            $("#event-type-label").value.trim() ||
            null,
          registrations:
            $("#event-registrations").value === ""
              ? null
              : Number(
                  $("#event-registrations").value
                ),
          description:
            $("#event-description").value.trim() ||
            null,
          venue:
            $("#event-venue").value.trim() ||
            null,
          city:
            $("#event-city").value.trim() ||
            null,
          region:
            $("#event-region").value.trim() ||
            null,
          country:
            $("#event-country").value.trim() ||
            "USA",
          address:
            $("#event-address").value.trim() ||
            null,
          url:
            $("#event-url").value.trim() ||
            null,
          button_label:
            $("#event-button-label").value.trim() ||
            null,
          image_url:
            $("#event-image-url").value.trim() ||
            null,
          partners:
            linesToArray($("#event-partners").value),
          organizers:
            linesToArray($("#event-organizers").value),
          status:
            $("#event-status").value,
          cover_media_id:
            $("#event-cover-media").value ||
            null,
          show_on_home:
            $("#event-show-home").checked,
          featured:
            $("#event-featured").checked
        };


        let response;
        let savedEventId = existingId;


        if (
          existingId
        ) {

          response =
            await supabase
              .from(
                "events"
              )
              .update(
                payload
              )
              .eq(
                "id",
                existingId
              );

        } else {

          const id =
            `evt-${crypto.randomUUID()}`;

          savedEventId = id;

          const slugBase =
            slugify(
              title
            );

          const year =
            startDate
              ? startDate.slice(
                  0,
                  4
                )
              : new Date().getFullYear();


          response =
            await supabase
              .from(
                "events"
              )
              .insert(
                {
                  id,
                  slug:
                    `${slugBase}-${year}-${crypto.randomUUID().slice(0, 6)}`,
                  ...payload
                }
              );

        }


        if (
          response.error
        ) {
          throw response.error;
        }


        const speakerIds =
          selectedValues($("#event-speakers"));

        const sponsorIds =
          selectedValues($("#event-sponsors"));

        const deleteSpeakers =
          await supabase
            .from("event_speakers")
            .delete()
            .eq("event_id", savedEventId);

        if (deleteSpeakers.error) throw deleteSpeakers.error;

        if (speakerIds.length) {
          const addSpeakers =
            await supabase
              .from("event_speakers")
              .insert(
                speakerIds.map((personId, index) => ({
                  event_id: savedEventId,
                  person_id: personId,
                  sort_order: index
                }))
              );
          if (addSpeakers.error) throw addSpeakers.error;
        }

        const deleteSponsors =
          await supabase
            .from("event_sponsors")
            .delete()
            .eq("event_id", savedEventId);

        if (deleteSponsors.error) throw deleteSponsors.error;

        if (sponsorIds.length) {
          const addSponsors =
            await supabase
              .from("event_sponsors")
              .insert(
                sponsorIds.map((organizationId, index) => ({
                  event_id: savedEventId,
                  organization_id: organizationId,
                  sort_order: index
                }))
              );
          if (addSponsors.error) throw addSponsors.error;
        }


        closeModal(
          "event"
        );

        showToast(
          existingId
            ? "Event updated."
            : "Event created."
        );

        await loadAllContent();

      }


      async function archiveCurrentEvent() {

        const eventId =
          $("#event-record-id").value;


        if (
          !eventId
        ) {
          return;
        }


        const confirmed =
          window.confirm(
            "Archive this event? It will remain editable and can be restored later."
          );


        if (
          !confirmed
        ) {
          return;
        }


        const {
          error
        } =
          await supabase
            .from(
              "events"
            )
            .update(
              {
                status:
                  "archived"
              }
            )
            .eq(
              "id",
              eventId
            );


        if (
          error
        ) {
          throw error;
        }


        closeModal(
          "event"
        );

        showToast(
          "Event archived. You can still edit or restore it later."
        );

        await loadEvents();
        refreshCounts();

      }


