        })[type] || type;
      }


      function featureRecord(type, id) {
        if (type === "event") {
          return state.events.find((item) => String(item.id) === String(id));
        }

        if (type === "field_note") {
          return state.fieldNotes.find((item) => String(item.id) === String(id));
        }

        if (type === "event_recap") {
          return state.recaps.find((item) => String(item.id) === String(id));
        }

        return null;
