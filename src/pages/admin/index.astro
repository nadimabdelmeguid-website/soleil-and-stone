      async function saveCommunity() {
        const existingId = $("#community-record-id").value;
        const name = $("#community-name").value.trim();
        const id = existingId || slugify($("#community-id").value || name) || `community-${crypto.randomUUID().slice(0, 8)}`;
        const payload = {
          slug: slugify($("#community-slug").value || name) || id,
          name,
          role: $("#community-role").value.trim() || null,
          description: $("#community-description").value.trim() || null,
          focus: parseFocus($("#community-focus").value),
          members: $("#community-members").value === "" ? 0 : Number($("#community-members").value),
          primary_url: $("#community-primary-url").value.trim() || null,
          primary_label: $("#community-primary-label").value.trim() || null,
          secondary_url: $("#community-secondary-url").value.trim() || null,
          secondary_label: $("#community-secondary-label").value.trim() || null,
          status: $("#community-status").value,
          sort_order: Number($("#community-sort-order").value || 0),
          linkedin_url: $("#community-linkedin-url").value.trim() || null,
          linkedin_followers: $("#community-followers").value === "" ? null : Number($("#community-followers").value),
          pillars_title: $("#community-pillars-title").value.trim() || null
        };
        const response = existingId
          ? await supabase.from("communities").update(payload).eq("id", existingId)
          : await supabase.from("communities").insert({ id, ...payload });
        if (response.error) throw response.error;
        closeModal("community");
        showToast(existingId ? "Community updated." : "Community created.");
        await loadAllContent();
      }


