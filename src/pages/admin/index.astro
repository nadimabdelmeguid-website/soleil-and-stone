      function evidenceFor(contentType, contentId) {
        return state.evidence.filter((item) => item.content_type === contentType && String(item.content_id || "") === String(contentId || ""));
      }

      function eventEvidenceGaps(event) {
        if (!["hosted","co-organized"].includes(event.participation)) return [];
        const evidence = evidenceFor("event", event.id);
        const types = new Set(evidence.filter((item) => item.status !== "archived").map((item) => item.evidence_type));
        const gaps = [];
        if (!event.url && !types.has("event-page")) gaps.push("event page");
        if (!event.cover_media_id && !event.image_url && !types.has("photo")) gaps.push("photos");
        if (event.registrations == null && !types.has("metric")) gaps.push("registration/attendance proof");
        if (!types.has("confirmation") && !types.has("document")) gaps.push("supporting confirmation");
        return gaps;
      }

