            );

          if (
            personButton
          ) {
            openPersonModal(
              personButton.dataset.editPerson
            );
          }


          const copyMediaButton =
            event.target.closest(
              "[data-copy-media-url]"
            );

          if (
            copyMediaButton
          ) {
            const url =
              copyMediaButton.dataset.copyMediaUrl || "";

            navigator.clipboard
              .writeText(url)
              .then(() => {
                showToast("Media URL copied.");
              })
              .catch(() => {
                window.prompt("Copy this media URL:", url);
              });

            return;
          }


          const toggleMediaButton =
            event.target.closest(
              "[data-toggle-media]"
            );

          if (
            toggleMediaButton
          ) {
            toggleMediaStatus(
              toggleMediaButton.dataset.toggleMedia
            ).catch((error) => {
              console.error(error);
              showToast(
                error?.message || "Could not update media.",
                "error"
              );
            });

            return;
          }


          const recentButton =
            event.target.closest(
              "[data-recent-section]"
            );

          if (
            recentButton
          ) {
            openSection(
              recentButton.dataset.recentSection
            );
          }


          const closeButton =
            event.target.closest(
              "[data-close-modal]"
            );

          if (
            closeButton
          ) {
            closeModal(
              closeButton.dataset.closeModal
            );
          }

        }
      );


