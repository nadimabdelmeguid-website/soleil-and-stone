      function filteredVentures() {
        const search = $("#ventures-search")?.value.trim().toLowerCase() || "";
        let items = state.ventures.filter((item) => {
          const matchesStage = state.ventureStageFilter === "all" || item.venture_status === state.ventureStageFilter;
          const matchesSearch = !search || [
            item.name,
            item.tagline,
            item.description,
            item.sector,
            item.role,
            item.location,
            item.next_milestone,
            item.last_update,
            item.venture_status
          ]
            .filter(Boolean)
            .some((value) => String(value).toLowerCase().includes(search));
          return matchesStage && matchesSearch;
        });

        const stageOrder = { idea: 0, validation: 1, building: 2, pilot: 3, active: 4, paused: 5, archived: 6 };
        items = [...items].sort((a, b) => {
          if (state.ventureSort === "updated") {
            return String(b.updated_at || "").localeCompare(String(a.updated_at || ""));
          }
          if (state.ventureSort === "name") {
            return String(a.name || "").localeCompare(String(b.name || ""));
          }
          if (state.ventureSort === "stage") {
            const stageDelta = (stageOrder[a.venture_status] ?? 99) - (stageOrder[b.venture_status] ?? 99);
            return stageDelta || String(a.name || "").localeCompare(String(b.name || ""));
          }
          return Number(a.sort_order || 0) - Number(b.sort_order || 0)
            || String(b.updated_at || "").localeCompare(String(a.updated_at || ""));
        });

        return items;
      }


