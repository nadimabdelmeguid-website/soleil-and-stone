    <!-- =====================================================
         ADMIN LOGIC
         ===================================================== -->

    <script
      type="module"
      define:vars={{ supabaseUrl, supabasePublishableKey }}
    >
      import {
        createClient
      } from "https://esm.sh/@supabase/supabase-js@2";


      const supabase =
        createClient(
          supabaseUrl,
          supabasePublishableKey,
          {
            auth: {
              persistSession:
                true,

              autoRefreshToken:
                true,

              detectSessionInUrl:
                true
            }
          }
        );


      const state = {
        user:
          null,

        events:
          [],

        fieldNotes:
          [],

        recaps:
          [],

        media:
          [],

        eventFilter:
          "all",

        selectedMediaFile:
          null
      };


      const $ =
        (
          selector
        ) =>
          document.querySelector(
            selector
          );


      const $$ =
        (
          selector
        ) =>
          Array.from(
            document.querySelectorAll(
              selector
            )
          );


      /* =====================================================
         UTILITIES
         ===================================================== */

      function escapeHtml(
        value = ""
      ) {

        return String(
          value
        )
          .replaceAll(
            "&",
            "&amp;"
          )
          .replaceAll(
            "<",
            "&lt;"
          )
          .replaceAll(
            ">",
            "&gt;"
          )
          .replaceAll(
            '"',
            "&quot;"
          )
          .replaceAll(
            "'",
            "&#039;"
          );

      }


      function slugify(
        value
      ) {

        return String(
          value || "content"
        )
          .normalize(
            "NFD"
          )
          .replace(
            /[\u0300-\u036f]/g,
            ""
          )
          .toLowerCase()
          .replace(
            /[^a-z0-9]+/g,
            "-"
          )
          .replace(
            /^-+|-+$/g,
            ""
          )
          .slice(
            0,
            90
          );

      }


      function formatDate(
        value
      ) {

        if (
          !value
        ) {
          return "No date";
        }


        const date =
          new Date(
            `${value}T12:00:00`
          );


        return date.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric",

            year:
              "numeric"
          }
        );

      }


      function toLocalDateTimeInput(
        value
      ) {

        if (
          !value
        ) {
          return "";
        }


        const date =
          new Date(
            value
          );


        const offset =
          date.getTimezoneOffset();


        const local =
          new Date(
            date.getTime() -
            offset *
              60_000
          );


        return local
          .toISOString()
          .slice(
            0,
            16
          );

      }


      function showToast(
        message,
        type = "success"
      ) {

        const toast =
          $("#toast");


        toast.textContent =
          message;

        toast.className =
          `toast ${type}`;


        window.clearTimeout(
          showToast.timeout
        );


        showToast.timeout =
          window.setTimeout(
            () => {

              toast.classList.add(
                "hidden"
              );

            },
            3600
          );

      }


      function setButtonLoading(
        button,
        loading,
        loadingText,
        normalText
      ) {

        if (
          !button
        ) {
          return;
        }


        button.disabled =
          loading;

        button.textContent =
          loading
            ? loadingText
            : normalText;

      }


      function getEventTimeState(
        event
      ) {

        const today =
          new Date();

        today.setHours(
          0,
          0,
          0,
          0
        );


        const end =
          new Date(
            `${event.end_date || event.start_date}T23:59:59`
          );


        return end < today
          ? "past"
          : "upcoming";

      }


      /* =====================================================
         AUTH
         ===================================================== */

      async function sendLoginLink(
        email
      ) {

        const {
          error
        } =
          await supabase.auth.signInWithOtp(
            {
              email,

              options: {
                emailRedirectTo:
                  `${window.location.origin}/admin/`
              }
            }
          );


        if (
          error
        ) {
          throw error;
        }

      }


      async function bootstrapAdminMembership(
        user
      ) {

        const email =
          user?.email;


        if (
          !user?.id ||
          !email
        ) {
          return false;
        }


        const {
          error:
            upsertError
        } =
          await supabase
            .from(
              "admin_users"
            )
            .upsert(
              {
                user_id:
                  user.id,

                email,

                display_name:
                  user.user_metadata?.full_name ||
                  "Nadim"
              },
              {
                onConflict:
                  "user_id"
              }
            );


        if (
          upsertError
        ) {
          console.warn(
            "Admin bootstrap denied:",
            upsertError.message
          );

          return false;
        }


        const {
          data,
          error
        } =
          await supabase
            .from(
              "admin_users"
            )
            .select(
              "user_id,email,display_name"
            )
            .eq(
              "user_id",
              user.id
            )
            .maybeSingle();


        return Boolean(
          !error &&
          data?.user_id
        );

      }


      async function handleSession(
        session
      ) {

        if (
          !session?.user
        ) {
          showAuth();
          return;
        }


        const allowed =
          await bootstrapAdminMembership(
            session.user
          );


        if (
          !allowed
        ) {

          await supabase.auth.signOut();

          showAuth(
            "This account is not authorized to access the Soleil & Stone admin."
          );

          return;
        }


        state.user =
          session.user;


        showAdmin();


        await loadAllContent();

      }


      function showAuth(
        errorMessage = ""
      ) {

        $("#auth-screen")
          .classList.remove(
            "hidden"
          );

        $("#admin-app")
          .classList.add(
            "hidden"
          );


        if (
          errorMessage
        ) {

          const message =
            $("#login-message");

          message.textContent =
            errorMessage;

          message.className =
            "form-message error";

        }

      }


      function showAdmin() {

        $("#auth-screen")
          .classList.add(
            "hidden"
          );

        $("#admin-app")
          .classList.remove(
            "hidden"
          );

        $("#sidebar-email").textContent =
          state.user?.email ||
          "";

      }


      /* =====================================================
         DATA LOADING
         ===================================================== */

      async function loadAllContent() {

        await Promise.all(
          [
            loadEvents(),
            loadFieldNotes(),
            loadRecaps(),
            loadMedia()
          ]
        );


        refreshCounts();
        renderRecentContent();
        refreshMediaSelectors();
        refreshRecapEventSelector();

      }


      async function loadEvents() {

        const {
          data,
          error
        } =
          await supabase
            .from(
              "events"
            )
            .select(
              "*"
            )
            .order(
              "start_date",
              {
                ascending:
                  false
              }
            );


        if (
          error
        ) {

          showToast(
            `Could not load events: ${error.message}`,
            "error"
          );

          return;
        }


        state.events =
          data || [];

        renderEvents();

      }


      async function loadFieldNotes() {

        const {
          data,
          error
        } =
          await supabase
            .from(
              "field_notes"
            )
            .select(
              "*"
            )
            .order(
              "updated_at",
              {
                ascending:
                  false
              }
            );


        if (
          error
        ) {

          showToast(
            `Could not load Field Notes: ${error.message}`,
            "error"
          );

          return;
        }


        state.fieldNotes =
          data || [];

        renderFieldNotes();

      }


      async function loadRecaps() {

        const {
          data,
          error
        } =
          await supabase
            .from(
              "event_recaps"
            )
            .select(
              "*"
            )
            .order(
              "updated_at",
              {
                ascending:
                  false
              }
            );


        if (
          error
        ) {

          showToast(
            `Could not load recaps: ${error.message}`,
            "error"
          );

          return;
        }


        state.recaps =
          data || [];

        renderRecaps();

      }


      async function loadMedia() {

        const {
          data,
          error
        } =
          await supabase
            .from(
              "media"
            )
            .select(
              "*"
            )
            .order(
              "created_at",
              {
                ascending:
                  false
              }
            );


        if (
          error
        ) {

          showToast(
            `Could not load media: ${error.message}`,
            "error"
          );

          return;
        }


        state.media =
          data || [];

        renderMedia();

      }


      /* =====================================================
         DASHBOARD
         ===================================================== */

      function refreshCounts() {

        const values = {
          events:
            state.events.length,

          fieldNotes:
            state.fieldNotes.length,

          recaps:
            state.recaps.length,

          media:
            state.media.length
        };


        $("#stat-events").textContent =
          values.events;

        $("#stat-field-notes").textContent =
          values.fieldNotes;

        $("#stat-recaps").textContent =
          values.recaps;

        $("#stat-media").textContent =
          values.media;

        $("#nav-events-count").textContent =
          values.events;

        $("#nav-field-notes-count").textContent =
          values.fieldNotes;

        $("#nav-recaps-count").textContent =
          values.recaps;

        $("#nav-media-count").textContent =
          values.media;

      }


      function renderRecentContent() {

        const items = [
          ...state.events.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Event",
              contentSection:
                "events"
            })
          ),

          ...state.fieldNotes.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Field Note",
              contentSection:
                "field-notes"
            })
          ),

          ...state.recaps.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Recap",
              contentSection:
                "recaps"
            })
          )
        ]
          .sort(
            (
              a,
              b
            ) =>
              new Date(
                b.updated_at ||
                b.created_at ||
                0
              ).getTime() -
              new Date(
                a.updated_at ||
                a.created_at ||
                0
              ).getTime()
          )
          .slice(
            0,
            6
          );


        const container =
          $("#recent-content-list");


        if (
          items.length === 0
        ) {

          container.innerHTML =
            `
              <div class="empty-state">
                <strong>Your CMS is ready</strong>
                Add your first item here, then we will migrate the existing website content into the same system.
              </div>
            `;

          return;
        }


        container.innerHTML =
          items
            .map(
              (
                item
              ) => `
                <div class="content-row">
                  <div>
                    <h3 class="row-title">
                      ${escapeHtml(item.title || item.file_name || "Untitled")}
                    </h3>
                    <div class="row-meta">
                      <span>${escapeHtml(item.contentType)}</span>
                      <span>•</span>
                      <span class="status-pill ${escapeHtml(item.status || "published")}">
                        ${escapeHtml(item.status || "published")}
                      </span>
                    </div>
                  </div>
                  <div class="row-actions">
                    <button
                      class="secondary-button"
                      type="button"
                      data-recent-section="${escapeHtml(item.contentSection)}"
                    >
                      Open
                    </button>
                  </div>
                </div>
              `
            )
            .join(
              ""
            );

      }


      /* =====================================================
         EVENTS
         ===================================================== */

      function getFilteredEvents() {

        const search =
          $("#events-search")
            .value
            .trim()
            .toLowerCase();


        return state.events.filter(
          (
            event
          ) => {

            const matchesSearch =
              !search ||
              [
                event.title,
                event.city,
                event.venue,
                event.description
              ]
                .filter(
                  Boolean
                )
                .some(
                  (
                    value
                  ) =>
                    String(
                      value
                    )
                      .toLowerCase()
                      .includes(
                        search
                      )
                );


            if (
              !matchesSearch
            ) {
              return false;
            }


            if (
              state.eventFilter ===
                "all"
            ) {
              return true;
            }


            if (
              state.eventFilter ===
                "draft" ||
              state.eventFilter ===
                "archived"
            ) {

              return event.status ===
                state.eventFilter;

            }


            if (
              event.status ===
                "archived"
            ) {
              return false;
            }


            return getEventTimeState(
              event
            ) ===
              state.eventFilter;

          }
        );

      }


      function renderEvents() {

        const container =
          $("#events-list");

        const events =
          getFilteredEvents();


        if (
          events.length === 0
        ) {

          container.innerHTML =
            `
              <div class="empty-state">
                <strong>No events found</strong>
                Add an event or change the current filter.
              </div>
            `;

          return;
        }


        container.innerHTML =
          events
            .map(
              (
                event
              ) => {

                const timeState =
                  getEventTimeState(
                    event
                  );


                return `
                  <div class="content-row">
                    <div>
                      <h3 class="row-title">
                        ${escapeHtml(event.title)}
                      </h3>

                      <div class="row-meta">
                        <span>${escapeHtml(formatDate(event.start_date))}</span>
                        ${event.city ? `<span>•</span><span>${escapeHtml(event.city)}</span>` : ""}
                        <span>•</span>
                        <span>${escapeHtml(timeState)}</span>
                        <span class="status-pill ${escapeHtml(event.status)}">
                          ${escapeHtml(event.status)}
                        </span>
                      </div>
                    </div>

                    <div class="row-actions">
                      <button
                        class="secondary-button"
                        type="button"
                        data-edit-event="${escapeHtml(event.id)}"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                `;

              }
            )
            .join(
              ""
            );

      }


      function resetEventForm() {

        $("#event-form").reset();
        $("#event-record-id").value = "";
        $("#event-country").value = "USA";
        $("#event-status").value = "draft";
        $("#event-modal-title").textContent = "Add Event";
        $("#archive-event-button").classList.add("hidden");

      }


      function openEventModal(
        eventId = ""
      ) {

        resetEventForm();


        if (
          eventId
        ) {

          const event =
            state.events.find(
              (
                item
              ) =>
                item.id ===
                eventId
            );


          if (
            !event
          ) {
            return;
          }


          $("#event-modal-title").textContent =
            "Edit Event";

          $("#event-record-id").value =
            event.id;

          $("#event-title").value =
            event.title || "";

          $("#event-start-date").value =
            event.start_date || "";

          $("#event-end-date").value =
            event.end_date || "";

          $("#event-type").value =
            event.event_type || "";

          $("#event-participation").value =
            event.participation || "";

          $("#event-role").value =
            event.role || "";

          $("#event-registrations").value =
            event.registrations ?? "";

          $("#event-description").value =
            event.description || "";

          $("#event-venue").value =
            event.venue || "";

          $("#event-city").value =
            event.city || "";

          $("#event-region").value =
            event.region || "";

          $("#event-country").value =
            event.country || "USA";

          $("#event-url").value =
            event.url || "";

          $("#event-status").value =
            event.status || "draft";

          $("#event-cover-media").value =
            event.cover_media_id || "";

          $("#event-show-home").checked =
            Boolean(
              event.show_on_home
            );

          $("#event-featured").checked =
            Boolean(
              event.featured
            );

          $("#archive-event-button").classList.remove("hidden");

        }


        $("#event-modal").classList.remove("hidden");
        document.body.style.overflow = "hidden";

      }


      async function saveEvent() {

        const existingId =
          $("#event-record-id").value;

        const title =
          $("#event-title")
            .value
            .trim();

        const startDate =
          $("#event-start-date").value;


        const payload = {
          title,
          start_date:
            startDate,
          end_date:
            $("#event-end-date").value ||
            null,
          event_type:
            $("#event-type").value.trim() ||
            null,
          participation:
            $("#event-participation").value ||
            null,
          role:
            $("#event-role").value.trim() ||
            null,
          registrations:
            $("#event-registrations").value === ""
              ? null
              : Number(
                  $("#event-registrations").value
                ),
          description:
            $("#event-description").value.trim() ||
            null,
          venue:
            $("#event-venue").value.trim() ||
            null,
          city:
            $("#event-city").value.trim() ||
            null,
          region:
            $("#event-region").value.trim() ||
            null,
          country:
            $("#event-country").value.trim() ||
            "USA",
          url:
            $("#event-url").value.trim() ||
            null,
          status:
            $("#event-status").value,
          cover_media_id:
            $("#event-cover-media").value ||
            null,
          show_on_home:
            $("#event-show-home").checked,
          featured:
            $("#event-featured").checked
        };


        let response;


        if (
          existingId
        ) {

          response =
            await supabase
              .from(
                "events"
              )
              .update(
                payload
              )
              .eq(
                "id",
                existingId
              );

        } else {

          const id =
            `evt-${crypto.randomUUID()}`;

          const slugBase =
            slugify(
              title
            );

          const year =
            startDate
              ? startDate.slice(
                  0,
                  4
                )
              : new Date().getFullYear();


          response =
            await supabase
              .from(
                "events"
              )
              .insert(
                {
                  id,
                  slug:
                    `${slugBase}-${year}-${crypto.randomUUID().slice(0, 6)}`,
                  ...payload
                }
              );

        }


        if (
          response.error
        ) {
          throw response.error;
        }


        closeModal(
          "event"
        );

        showToast(
          existingId
            ? "Event updated."
            : "Event created."
        );

        await loadEvents();
        refreshCounts();
        renderRecentContent();
        refreshRecapEventSelector();

      }


      async function archiveCurrentEvent() {

        const eventId =
          $("#event-record-id").value;


        if (
          !eventId
        ) {
          return;
        }


        const confirmed =
          window.confirm(
            "Archive this event? It will remain editable and can be restored later."
          );


        if (
          !confirmed
        ) {
          return;
        }


        const {
          error
        } =
          await supabase
            .from(
              "events"
            )
            .update(
              {
                status:
                  "archived"
              }
            )
            .eq(
              "id",
              eventId
            );


        if (
          error
        ) {
          throw error;
        }


        closeModal(
          "event"
        );

        showToast(
          "Event archived. You can still edit or restore it later."
        );

        await loadEvents();
        refreshCounts();

      }


      /* =====================================================
         FIELD NOTES
         ===================================================== */

      function renderFieldNotes() {

        const search =
          $("#field-notes-search")
            ?.value
            .trim()
            .toLowerCase() ||
