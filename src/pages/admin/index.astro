      document.addEventListener(
        "keydown",
        (
          event
        ) => {

          if (
            event.key !== "Escape"
          ) {
            return;
          }


          [
            "event",
            "field-note",
            "recap",
            "community",
            "organization",
            "person"
          ].forEach(
            closeModal
          );

          $("#sidebar").classList.remove("open");

        }
      );


      /* =====================================================
         INITIALIZE
         ===================================================== */

      const {
        data: {
          session
        }
      } =
        await supabase.auth.getSession();


      await handleSession(
        session
      );


      supabase.auth.onAuthStateChange(
        async (
          event,
          session
        ) => {

          if (
            event === "SIGNED_IN" ||
            event === "INITIAL_SESSION"
          ) {
            await handleSession(session);
          }

          if (
            event === "SIGNED_OUT"
          ) {
            state.user = null;
            showAuth();
          }

        }
      );
