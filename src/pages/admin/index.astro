      async function saveVenture() {
        const existingId = $("#venture-record-id").value;
        const name = $("#venture-name").value.trim();
        if (!name) throw new Error("Venture name is required.");

        const payload = {
          name,
          slug: name.trim().toLowerCase() === "soleil & stone" ? "soleil-and-stone" : slugify(name),
          tagline: $("#venture-tagline").value.trim() || null,
          description: $("#venture-description").value.trim() || null,
          venture_status: $("#venture-status").value,
          template_key: $("#venture-template").value || "blank",
          role: $("#venture-role").value.trim() || null,
          sector: $("#venture-sector").value.trim() || null,
          location: $("#venture-location").value.trim() || null,
          website_url: $("#venture-website").value.trim() || null,
          next_milestone: $("#venture-next-milestone").value.trim() || null,
          last_update: $("#venture-last-update").value.trim() || null,
          last_update_at: $("#venture-last-update-at").value || null,
          public_ready: $("#venture-public-ready").checked,
          notes: $("#venture-notes").value.trim() || null,
          sort_order: Number($("#venture-sort-order").value || 0)
        };

        let response;
        if (existingId) {
          response = await supabase.from("ventures").update(payload).eq("id", existingId).select("*").single();
        } else {
          response = await supabase.from("ventures").insert(payload).select("*").single();
        }

        if (response.error) throw response.error;

        const saved = response.data;
        $("#venture-record-id").value = saved.id;
        $("#venture-modal-title").textContent = saved.name;
        $("#save-venture-button").textContent = "Save Changes";

        await saveVenturePublicOverview(saved);
        await Promise.all([loadVentures(), loadVentureTasks(), loadVentureMilestones(), loadVenturePublicOverviews(), loadVentureActivity()]);
        const fresh = state.ventures.find((item) => String(item.id) === String(saved.id)) || saved;
        refreshVentureModalHeader(fresh);
        renderVentureTasks();
        renderVentureMilestones();
        updateVentureLiveSummary();
        updateVenturePrivateFilesButton();
        const activeTab = $("#venture-tabs .venture-tab.active")?.dataset.ventureTab || "overview";
        setVentureTab(activeTab);

        showToast(existingId ? "Venture updated." : "Venture created. You can now add tasks and milestones.");
      }


