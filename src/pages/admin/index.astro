      async function saveVentureWorkspaceItem() {
        const venture = currentVenture();
        if (!venture || !state.currentVentureModule) throw new Error("No venture module is selected.");

        const id = $("#venture-workspace-item-id").value;
        const title = $("#venture-workspace-item-title").value.trim();
        if (!title) throw new Error("Title is required.");

        const payload = {
          venture_id: venture.id,
          module_key: state.currentVentureModule,
          item_type: $("#venture-workspace-item-type").value,
          title,
          status: $("#venture-workspace-item-status").value,
          summary: $("#venture-workspace-item-summary").value.trim() || null,
          notes: $("#venture-workspace-item-notes").value.trim() || null,
          source_url: $("#venture-workspace-item-url").value.trim() || null,
          sort_order: Number($("#venture-workspace-item-order").value || 0)
        };

        const response = id
          ? await supabase.from("venture_workspace_items").update(payload).eq("id", id)
          : await supabase.from("venture_workspace_items").insert(payload);

        if (response.error) throw response.error;
        closeModal("venture-workspace-item");
        await Promise.all([loadVentureWorkspaceItems(),loadVentureActivity()]);
        renderVentureModule();
        showToast(id ? "Workspace item updated." : "Workspace item added.");
      }


      async function deleteVentureWorkspaceItem() {
        const id=$("#venture-workspace-item-id").value;
        if(!id||!window.confirm("Archive this workspace item?"))return;
        const {error}=await supabase.from("venture_workspace_items").update({archived_at:new Date().toISOString()}).eq("id",id);
        if(error)throw error;
        closeModal("venture-workspace-item");
        await Promise.all([loadVentureWorkspaceItems(),loadVentureActivity()]);
        renderVentureModule();
        showToast("Workspace item archived.");
      }


