      async function saveEvent() {
        const existingId =
          $("#event-record-id").value;

        const title =
          $("#event-title")
            .value
            .trim();

        const startDate =
          $("#event-start-date").value;

        const participation =
          $("#event-participation").value ||
          null;

        const led =
          isLedParticipation(
            participation ||
            ""
          );

        const communityId =
          $("#event-community").value ||
          null;

        const hardware =
          led &&
          communityId ===
            "hardware-meetup";

        const communityLogoEvent =
          led &&
          ["hardware-meetup", "startup-mixer"].includes(
            communityId || ""
          );

        const industry =
          isTradeShowEventContext();

        const payload = {
          title,
          start_date:
            startDate,
          end_date:
            $("#event-end-date").value ||
            null,
          event_type:
            $("#event-type").value ||
            null,
          community_id:
            communityId,
          participation,
          role:
            led
              ? "hosted"
              : "attending",
          type_label:
            $("#event-type-label").value ||
            null,
          registrations:
            led &&
            $("#event-registrations").value !== ""
              ? Number(
                  $("#event-registrations").value
                )
              : null,
          description:
            $("#event-description").value.trim() ||
            null,
          venue:
            $("#event-venue").value.trim() ||
            null,
          city:
            $("#event-city").value.trim() ||
            null,
          region:
            $("#event-region").value.trim() ||
            null,
          country:
            $("#event-country").value.trim() ||
            "USA",
          address:
            $("#event-address").value.trim() ||
            null,
          url:
            $("#event-url").value.trim() ||
            null,
          button_label:
            $("#event-button-label").value.trim() ||
            null,
          image_url:
            $("#event-image-url").value.trim() ||
            null,
          partners:
            led
              ? linesToArray(
                  $("#event-partners").value
                )
              : [],
          organizers:
            led
              ? linesToArray(
                  $("#event-organizers").value
                )
              : [],
          status:
            $("#event-status").value,
          cover_media_id:
            $("#event-cover-media").value ||
            null,
          community_track_media_id:
            communityLogoEvent
              ? $("#event-community-track-media").value ||
                null
              : null,
          industry_logo_media_id:
            industry
              ? $("#event-industry-logo-media").value ||
                null
              : null,
          show_on_home:
            $("#event-show-home").checked,
          featured:
            $("#event-featured").checked
        };

        let response;
        let savedEventId =
          existingId;

        if (
          existingId
        ) {
          response =
            await supabase
              .from("events")
              .update(payload)
              .eq(
                "id",
                existingId
              );

        } else {
          const id =
            `evt-${crypto.randomUUID()}`;

          savedEventId =
            id;

          const slugBase =
            slugify(title);

          const year =
            startDate
              ? startDate.slice(0, 4)
              : new Date().getFullYear();

          response =
            await supabase
              .from("events")
              .insert({
                id,
                slug:
                  `${slugBase}-${year}-${crypto.randomUUID().slice(0, 6)}`,
                ...payload
              });
        }

        if (
          response.error
        ) {
          throw response.error;
        }

        await syncEditorFeaturePlacement(
          "fieldwork",
          "event",
          savedEventId,
          payload.featured
        );

        let speakerIds = [];
        let sponsorIds = [];

        if (
          led
        ) {
          for (
            const card of
              $$("#event-speaker-list .event-speaker-card")
          ) {
            const id =
              await saveSpeakerCard(
                card,
                communityLogoEvent
              );

            if (id) {
              speakerIds.push(id);
            }
          }

          for (
            const card of
              $$("#event-sponsor-list .event-sponsor-card")
          ) {
            const id =
              await saveSponsorCard(
                card,
                communityLogoEvent
              );

            if (id) {
              sponsorIds.push(id);
            }
          }
        }

        await replaceEventRelationshipLinks(
          savedEventId,
          speakerIds,
          sponsorIds
        );

        if (
          communityLogoEvent &&
          payload.community_track_media_id
        ) {
          await ensureMediaTargets(
            payload.community_track_media_id,
            ["community"]
          );
        }

        if (
          industry &&
          payload.industry_logo_media_id
        ) {
          await ensureMediaTargets(
            payload.industry_logo_media_id,
            ["fieldwork"]
          );
        }

        closeModal("event");

        showToast(
          existingId
            ? "Event updated."
            : "Event created."
        );

        await loadAllContent();
      }


      async function archiveCurrentEvent() {
        const eventId =
          $("#event-record-id").value;

        if (!eventId) {
          return;
        }

        const confirmed =
          window.confirm(
            "Archive this event? It will remain editable and can be restored later."
          );

        if (!confirmed) {
          return;
        }

        const {
          error
        } =
          await supabase
            .from("events")
            .update({
              status:
                "archived"
            })
            .eq(
              "id",
              eventId
