      function safeFileName(
        fileName
      ) {

        const extension =
          fileName.includes(".")
            ? fileName.split(".").pop().toLowerCase()
            : "bin";

        const basename =
          fileName
            .replace(/\.[^.]+$/, "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "")
            .slice(0, 80) || "media";


        return `${basename}.${extension}`;

      }


      async function uploadSelectedMedia() {

        const file =
          state.selectedMediaFile;


        if (
          !file
        ) {
          return;
        }


        const button =
          $("#upload-media-button");


        setButtonLoading(
          button,
          true,
          "Uploading...",
          "Upload"
        );


        try {

          const cleanName =
            safeFileName(
              file.name
            );

          const storagePath =
            `uploads/${new Date().getFullYear()}/${crypto.randomUUID()}-${cleanName}`;


          const {
            error:
              uploadError
          } =
            await supabase.storage
              .from("cms-media")
              .upload(
                storagePath,
                file,
                {
                  cacheControl:
                    "3600",
                  upsert:
                    false
                }
              );


          if (
            uploadError
          ) {
            throw uploadError;
          }


          const {
            data:
              publicUrlData
          } =
            supabase.storage
              .from("cms-media")
              .getPublicUrl(
                storagePath
              );


          const {
            error:
              recordError
          } =
            await supabase
              .from("media")
              .insert({
                storage_path:
                  storagePath,
                public_url:
                  publicUrlData.publicUrl,
                file_name:
                  file.name,
                mime_type:
                  file.type || null,
                file_size:
                  file.size,
                alt_text:
                  $("#media-alt-text").value.trim() || null,
                credit:
                  $("#media-credit").value.trim() || null,
                media_kind:
                  $("#media-kind").value,
                status:
                  "active",
                created_by:
                  state.user?.id || null
              });


          if (
            recordError
          ) {
            throw recordError;
          }


          state.selectedMediaFile =
            null;

          $("#media-file-input").value = "";
          $("#media-alt-text").value = "";
          $("#media-credit").value = "";
          $("#drop-zone").classList.remove("dragging");
          $("#drop-zone strong").textContent = "Drop image here";
          $("#drop-zone span").textContent = "PNG, JPG, WebP, SVG or AVIF";


          showToast(
            "Media uploaded."
          );

          await loadMedia();
          refreshCounts();
          refreshMediaSelectors();

        } catch (
          error
        ) {

          console.error(
            error
          );

          showToast(
            error?.message ||
            "Upload failed.",
            "error"
          );

        } finally {

          setButtonLoading(
            button,
            false,
            "Uploading...",
            "Upload"
          );

          button.disabled =
            !state.selectedMediaFile;

        }

      }


      function setSelectedMediaFile(
