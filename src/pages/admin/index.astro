                      <div class="form-field full">
                        <label class="label" for="field-note-seo-title">
                          SEO title
                        </label>
                        <input
                          id="field-note-seo-title"
                          class="input"
                          type="text"
                          maxlength="70"
                          placeholder="Defaults to the Field Note title"
                        />
                        <div id="field-note-seo-title-count" class="seo-counter">0 / 60 recommended</div>
                      </div>

                      <div class="form-field full">
                        <label class="label" for="field-note-seo-description">
                          SEO description
                        </label>
                        <textarea
                          id="field-note-seo-description"
                          class="textarea"
                          maxlength="180"
                          style="min-height: 86px;"
                          placeholder="Defaults to the short description"
                        ></textarea>
                        <div id="field-note-seo-description-count" class="seo-counter">0 / 160 recommended</div>
                      </div>
                    </div>
                  </div>
                </details>

                <div class="form-field full">
                  <label class="checkbox-label">
                    <input
                      id="field-note-featured"
                      type="checkbox"
                    />
                    Feature on homepage
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <span></span>
          <div class="modal-footer-right">
            <button
              class="secondary-button"
              type="button"
              data-close-modal="field-note"
            >
