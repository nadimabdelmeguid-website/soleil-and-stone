          seo_description:
            $("#field-note-seo-description").value.trim() || null,
          published_at:
            publishedAt,
          status
        };


        let response;


        if (
          existingId
        ) {

          response =
            await supabase
              .from("field_notes")
              .update(payload)
              .eq("id", existingId);

        } else {

          const id =
            `note-${crypto.randomUUID()}`;


