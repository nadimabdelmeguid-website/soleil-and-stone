        margin-top: 9px;
        padding: 7px 10px;
        border: 1px solid rgba(182, 132, 48, 0.32);
        background: rgba(196, 151, 72, 0.09);
        color: #76551f;
        font-size: 9px;
        line-height: 1.45;
      }

      .content-completeness-alert::before {
        content: "!";
        display: inline-flex;
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        align-items: center;
        justify-content: center;
        border: 1px solid currentColor;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 700;
        line-height: 1;
      }

      .content-completeness-alert strong {
        font-weight: 700;
      }

      .recent-content-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 16px 24px;
        border-top: 1px solid var(--border);
        background: rgba(244, 241, 232, 0.34);
      }

      .recent-content-page-summary {
        color: var(--slate);
        font-size: 9px;
        letter-spacing: 0.04em;
      }

      .recent-content-page-buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
      }

      .recent-page-button {
        min-width: 34px;
        min-height: 34px;
        padding: 0 10px;
        border: 1px solid var(--border);
        background: #fff;
        color: var(--charcoal);
        cursor: pointer;
        font-family: inherit;
        font-size: 9px;
      }

      .recent-page-button:hover:not(:disabled),
      .recent-page-button.active {
        border-color: var(--gold);
        background: var(--cream);
      }

      .recent-page-button.active {
        color: var(--charcoal);
        font-weight: 700;
      }

      .recent-page-button:disabled {
        opacity: 0.42;
        cursor: default;
      }

      .recent-page-ellipsis {
        display: inline-flex;
        min-width: 24px;
        min-height: 34px;
        align-items: center;
        justify-content: center;
        color: var(--slate);
        font-size: 10px;
      }

      .repeater-block {
        padding: 22px 0;
        border-bottom: 1px solid var(--border);
      }

      .repeater-block:first-child {
        padding-top: 0;
      }

      .repeater-block:last-of-type {
        border-bottom: 0;
      }

      .repeater-heading {
        align-items: center;
        margin-bottom: 16px;
      }

      .repeater-heading .secondary-button {
        flex: 0 0 auto;
      }

      .repeat-list {
        gap: 14px;
      }

      .repeat-card {
        position: relative;
        padding: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        background: #fff;
        box-shadow: 0 8px 24px rgba(31, 35, 40, 0.035);
      }

      .repeat-card-header {
        min-height: 50px;
        padding: 0 16px 0 18px;
        margin: 0;
        border-bottom: 1px solid var(--border);
        background: rgba(244, 241, 232, 0.46);
      }

      .repeat-card-title {
        font-family: "Cinzel", Georgia, serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.08em;
      }

      .repeat-remove-button {
        min-height: 30px;
        border: 0;
        background: transparent;
        padding: 0 4px;
        color: #9a4d43;
        cursor: pointer;
        font-family: inherit;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .repeat-remove-button:hover {
        color: #6f2e27;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .repeat-card-grid {
        padding: 18px;
        gap: 14px 16px;
      }

      .repeat-card .form-field {
        gap: 6px;
      }

      .repeat-card .label {
        font-size: 8px;
        letter-spacing: 0.13em;
      }

      .repeat-card .input,
      .repeat-card .select {
        width: 100%;
        min-height: 42px;
      }

      .logo-control {
        grid-template-columns: minmax(220px, 1fr) auto;
        max-width: 760px;
      }

      .logo-preview {
        width: fit-content;
        min-width: 180px;
        min-height: 44px;
        padding: 6px 9px;
        border: 1px solid var(--border);
        background: var(--cream);
      }

      .logo-preview img {
        width: 64px;
        height: 38px;
        border: 0;
        padding: 0;
        background: transparent;
      }

      .repeat-empty {
        border-radius: 0;
        background: rgba(244, 241, 232, 0.38);
        text-align: center;
      }

      @media (max-width: 760px) {
        .recent-content-header {
          align-items: stretch;
        }

        .recent-content-filters {
          justify-content: flex-start;
        }

        .recent-content-pagination {
          align-items: flex-start;
          flex-direction: column;
        }

        .recent-content-page-buttons {
          justify-content: flex-start;
        }

        .repeat-card-grid {
          grid-template-columns: 1fr;
        }

        .repeat-card-grid .full {
          grid-column: auto;
        }

        .logo-control {
          grid-template-columns: 1fr;
        }
      }

      .hosted-secondary-fields {
        margin-top: 26px;
        padding-top: 24px;
        border-top: 1px solid var(--border);
      }

      @media (max-width: 720px) {
        .import-url-row,
        .repeat-card-grid,
        .logo-control {
          grid-template-columns: 1fr;
        }

        .repeater-heading {
          align-items: stretch;
          flex-direction: column;
        }
      }

      .standalone-image-control {
        display: grid;
        gap: 12px;
      }

      .standalone-image-preview {
        display: flex;
        min-height: 126px;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px dashed var(--border);
        background: rgba(244, 241, 232, 0.36);
        color: var(--slate);
        font-size: 11px;
      }

      .standalone-image-preview.has-image {
        justify-content: flex-start;
        padding: 10px;
        border-style: solid;
        background: #fff;
      }

      .standalone-image-preview img {
        display: block;
        width: min(340px, 100%);
        max-height: 210px;
        object-fit: cover;
        border: 1px solid var(--border);
      }

      .image-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .article-picture-list {
        display: grid;
        gap: 12px;
      }

      .article-picture-card {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 12px;
        border: 1px solid var(--border);
        background: #fff;
      }

      .article-picture-thumb {
        width: 110px;
        height: 76px;
        object-fit: cover;
        border: 1px solid var(--border);
        background: var(--cream);
      }

      .article-picture-copy strong {
        display: block;
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 600;
        color: var(--charcoal);
      }

      .article-picture-copy span {
        display: block;
        overflow: hidden;
        color: var(--slate);
        font-size: 10px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .article-picture-add {
        display: flex;
        min-height: 62px;
        align-items: center;
        justify-content: flex-start;
        padding: 10px 0 0;
      }

      .seo-settings {
        border: 1px solid var(--border);
        background: rgba(244, 241, 232, 0.28);
      }

      .seo-settings summary {
        padding: 16px 18px;
        cursor: pointer;
        list-style: none;
        color: var(--charcoal);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .seo-settings summary::-webkit-details-marker {
        display: none;
      }

      .seo-settings summary::after {
        content: "+";
        float: right;
        color: var(--gold);
        font-size: 16px;
        line-height: 1;
      }

      .seo-settings[open] summary::after {
        content: "−";
      }

      .seo-settings-body {
        padding: 0 18px 18px;
      }

      .seo-counter {
        margin-top: 5px;
        color: var(--slate);
        font-size: 9px;
        text-align: right;
      }

      @media (max-width: 720px) {
        .article-picture-card {
          grid-template-columns: 82px minmax(0, 1fr);
        }

        .article-picture-thumb {
          width: 82px;
          height: 62px;
        }

        .article-picture-card .repeat-remove-button {
          grid-column: 1 / -1;
          justify-self: start;
        }
      }



      /* =====================================================
         FEATURES MANAGER
         ===================================================== */

      .feature-intro {
        margin-bottom: 26px;
      }

      .feature-intro-header {
        align-items: flex-start;
        gap: 24px;
      }

      .feature-total-badge {
        min-width: 120px;
        border: 1px solid var(--border);
        background: var(--cream);
        padding: 14px 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        text-align: center;
      }

      .feature-total-badge strong {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 34px;
        line-height: 1;
        font-weight: 400;
        color: var(--gold-dark);
      }

      .feature-total-badge span {
        font-size: 11px;
        letter-spacing: .11em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .feature-placement-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0 24px 18px;
      }

      .feature-placement-tab {
        appearance: none;
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
        padding: 10px 14px;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
        transition: border-color .18s ease, background .18s ease, color .18s ease;
      }

      .feature-placement-tab:hover {
        border-color: var(--gold);
      }

      .feature-placement-tab.active {
        background: var(--ink);
        border-color: var(--ink);
        color: #fff;
      }

      .feature-placement-copy {
        border-top: 1px solid var(--border);
        padding: 16px 24px 18px;
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
      }

      .feature-placement-copy strong {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 20px;
        font-weight: 400;
      }

      .feature-placement-copy span {
        color: var(--muted);
        font-size: 14px;
      }

      .feature-manager-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
      }

      .feature-column {
        min-width: 0;
      }

      .feature-column-header {
        padding: 22px 24px;
        border-bottom: 1px solid var(--border);
      }

      .feature-library-toolbar {
        padding: 18px 24px;
        border-bottom: 1px solid var(--border);
        display: grid;
        gap: 12px;
      }

      .feature-type-filters {
        margin: 0;
      }

      .feature-list {
        display: grid;
      }

      .feature-card {
        padding: 18px 20px;
        border-bottom: 1px solid var(--border);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        background: #fff;
      }

      .feature-card:last-child {
        border-bottom: 0;
      }

      .feature-card-main {
        min-width: 0;
      }

      .feature-card-kicker {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
      }

      .feature-position {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--gold);
        color: var(--gold-dark);
        font-size: 12px;
        font-weight: 700;
        flex: 0 0 auto;
      }

      .feature-type-badge,
      .feature-status-badge {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 4px 8px;
        border: 1px solid var(--border);
        font-size: 10px;
        letter-spacing: .09em;
        text-transform: uppercase;
      }

      .feature-status-badge {
        color: var(--muted);
        background: var(--cream);
      }

      .feature-card-title {
        margin: 0;
        font-size: 16px;
        line-height: 1.35;
        font-weight: 600;
        color: var(--ink);
      }

      .feature-card-meta {
        margin-top: 6px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.45;
      }

      .feature-card-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 7px;
        flex-wrap: wrap;
      }

      .feature-icon-button {
        min-width: 34px;
        height: 34px;
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
        cursor: pointer;
        font: inherit;
        font-size: 14px;
      }

      .feature-icon-button:hover:not(:disabled) {
        border-color: var(--gold);
      }

      .feature-icon-button:disabled {
        opacity: .3;
        cursor: default;
      }

      .feature-add-button {
        min-width: 82px;
      }

      .compact-button {
        min-height: 34px;
        padding: 7px 11px;
        font-size: 11px;
      }

      .feature-empty {
        padding: 34px 24px;
        text-align: center;
        color: var(--muted);
        font-size: 14px;
      }

      @media (max-width: 1040px) {
        .feature-manager-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .recent-content-secondary-filters {
          padding: 14px 18px;
        }

        .recent-filter-group {
          width: 100%;
          align-items: flex-start;
          flex-direction: column;
        }

        .feature-card {
          grid-template-columns: 1fr;
        }

        .feature-card-actions {
          justify-content: flex-start;
        }

        .feature-total-badge {
          display: none;
        }
      }

      .venture-private-files { display:grid; gap:10px; }
      .venture-file-row { display:grid; grid-template-columns:52px minmax(0,1fr) auto; gap:12px; align-items:center; padding:12px; border:1px solid var(--border); background:white; }
      .venture-file-thumb { width:52px; height:52px; display:grid; place-items:center; overflow:hidden; border:1px solid var(--border); background:rgba(244,241,232,.55); font-size:18px; }
      .venture-file-thumb img { width:100%; height:100%; object-fit:cover; }
      .venture-file-name { margin:0; font-size:13px; font-weight:650; overflow-wrap:anywhere; }
      .venture-file-meta { margin-top:4px; color:var(--slate); font-size:10px; }
      .venture-file-actions { display:flex; gap:7px; flex-wrap:wrap; justify-content:flex-end; }
      .venture-file-upload { display:grid; gap:10px; padding:16px; border:1px dashed var(--border); background:rgba(244,241,232,.36); }
      .venture-public-boundary { padding:14px 16px; border-left:3px solid var(--gold); background:rgba(197,160,89,.08); color:var(--slate); font-size:11px; line-height:1.6; }
      @media (max-width:640px) {
        .venture-file-row { grid-template-columns:44px minmax(0,1fr); }
        .venture-file-thumb { width:44px; height:44px; }
        .venture-file-actions { grid-column:2; justify-content:flex-start; }
      }

      .venture-admin-tools { margin-bottom:20px; overflow:visible; }
      .venture-admin-tools-inner { padding:16px; display:grid; grid-template-columns:minmax(260px,1fr) auto; gap:12px; align-items:start; }
      .venture-universal-search-wrap { position:relative; }
      .venture-universal-results { position:absolute; z-index:30; top:calc(100% + 6px); left:0; right:0; max-height:420px; overflow:auto; background:white; border:1px solid var(--border); box-shadow:0 18px 40px rgba(20,28,38,.12); }
      .venture-search-result { width:100%; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; text-align:left; padding:12px 14px; border:0; border-bottom:1px solid var(--border); background:white; cursor:pointer; }
      .venture-search-result:hover,.venture-search-result:focus { background:rgba(197,160,89,.08); outline:none; }
      .venture-search-result:last-child { border-bottom:0; }
      .venture-search-result-title { font-size:12px; font-weight:700; color:var(--ink); }
      .venture-search-result-meta { margin-top:3px; font-size:10px; color:var(--slate); }
      .venture-search-type { align-self:start; font-size:9px; text-transform:uppercase; letter-spacing:.12em; color:var(--gold-dark); }
      .venture-dashboard-rail-wrap { position:relative; margin-bottom:20px; }
      .venture-dashboard-rail-header { display:flex; align-items:center; justify-content:flex-end; gap:8px; margin-bottom:10px; }
      .venture-dashboard-rail-nav { width:38px; height:38px; display:grid; place-items:center; border:1px solid var(--border); background:white; color:var(--ink); cursor:pointer; font-size:18px; line-height:1; }
      .venture-dashboard-rail-nav:hover:not(:disabled) { border-color:var(--gold); background:rgba(197,160,89,.08); }
      .venture-dashboard-rail-nav:disabled { opacity:.35; cursor:default; }
      .venture-dashboard-rail {
        display:flex;
        gap:16px;
        overflow-x:auto;
        overflow-y:hidden;
        scroll-snap-type:x proximity;
        scroll-behavior:smooth;
        overscroll-behavior-inline:contain;
        scrollbar-width:thin;
        scrollbar-color:var(--gold) transparent;
        padding:0 0 10px;
      }
      .venture-dashboard-rail::-webkit-scrollbar { height:8px; }
      .venture-dashboard-rail::-webkit-scrollbar-track { background:transparent; }
      .venture-dashboard-rail::-webkit-scrollbar-thumb { background:rgba(197,160,89,.65); border-radius:999px; }
      .venture-dashboard-card {
        contain: layout paint;
        flex:0 0 clamp(360px,31vw,470px);
        min-width:0;
        scroll-snap-align:start;
        min-height:292px;
        max-height:420px;
        display:flex;
        flex-direction:column;
      }
      .venture-dashboard-card .venture-focus-list,
      .venture-dashboard-card .venture-document-list,
      .venture-dashboard-card .venture-activity-list {
        min-height:0;
        overflow:auto;
        flex:1;
      }
      .venture-dashboard-card .venture-document-toolbar { flex:0 0 auto; }
      .venture-utility-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-bottom:20px; }
      .venture-document-toolbar { display:flex; gap:8px; flex-wrap:wrap; padding:14px 16px 0; }
      .venture-document-list,.venture-activity-list { padding:0 16px 16px; display:grid; gap:8px; }
      .venture-document-row,.venture-activity-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; align-items:center; padding:11px 0; border-bottom:1px solid var(--border); }
      .venture-document-row:last-child,.venture-activity-row:last-child { border-bottom:0; }
      .venture-attention-chip { display:inline-flex; align-items:center; gap:5px; padding:3px 7px; border:1px solid var(--border); font-size:9px; text-transform:uppercase; letter-spacing:.08em; }
      .venture-command-palette { width:min(760px,calc(100vw - 32px)); max-height:min(720px,calc(100vh - 40px)); }
      .venture-command-results { display:grid; gap:4px; max-height:480px; overflow:auto; margin-top:12px; }
      .venture-command-result { width:100%; padding:12px 14px; border:1px solid var(--border); background:white; text-align:left; cursor:pointer; }
      .venture-command-result:hover,.venture-command-result:focus { border-color:var(--gold); background:rgba(197,160,89,.06); outline:none; }
      .venture-public-compare { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px; }
      .venture-public-compare-card { border:1px solid var(--border); padding:14px; background:rgba(244,241,232,.36); }
      .venture-public-preview-card { border:1px solid var(--border); padding:18px; background:white; min-height:180px; }
      .venture-file-upload.dragging,[data-file-drop].dragging { outline:2px dashed var(--gold); outline-offset:3px; background:rgba(197,160,89,.08); }
      .venture-checklist-preview { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }
      .venture-checklist-chip { border:1px solid var(--border); background:white; padding:4px 7px; font-size:9px; cursor:pointer; }
      .venture-checklist-chip.done { text-decoration:line-through; opacity:.6; }
      .venture-mobile-actions { display:none; position:fixed; z-index:45; left:12px; right:12px; bottom:12px; grid-template-columns:repeat(3,1fr); gap:7px; padding:8px; border:1px solid var(--border); background:rgba(255,255,255,.96); box-shadow:0 14px 35px rgba(20,28,38,.15); }
      .venture-mobile-actions button { min-height:42px; }
      @media (max-width:900px) {
        .venture-dashboard-card { flex-basis:min(84vw,420px); }
        .venture-utility-grid { grid-template-columns:1fr; }
        .venture-public-compare { grid-template-columns:1fr; }
      }
      @media (max-width:720px) {
        .venture-admin-tools-inner { grid-template-columns:1fr; }
        .venture-mobile-actions { display:grid; }
        body { padding-bottom:72px; }
      }

    </style>
  </head>

  <body>
    <!-- =====================================================
         AUTH SCREEN
         ===================================================== -->

    <section
      id="auth-screen"
      class="auth-screen"
    >
      <div class="auth-card">
        <a
          href="/"
          class="auth-logo-link"
          aria-label="Soleil & Stone home"
        >
          <img
            src="/brand/logo-primary.png"
            alt="Soleil & Stone"
            class="auth-logo"
          />
        </a>

        <p class="eyebrow">
          Private Administration
        </p>

        <h1 class="auth-title">
          Content Manager
        </h1>

        <p class="auth-copy">
          Manage events, Field Notes, recaps, photos, logos and community content without editing the website code.
        </p>

        <div id="login-form" data-supabase-url={supabaseUrl} data-supabase-key={supabasePublishableKey}>
          <button
            id="google-login-button"
            class="primary-button auth-submit"
            type="button"
          >
            Continue with Google
          </button>
          <p class="auth-code-help" style="margin-top:12px;">
            Access is restricted to the authorized Soleil & Stone administrator.
          </p>
        </div>

        <p
          id="login-message"
          class="form-message hidden"
          aria-live="polite"
        ></p>
      </div>
    </section>





    

    <!-- =====================================================
         ADMIN APP
         ===================================================== -->

    <div
      id="admin-app"
      class="admin-app hidden"
    >
      <div class="admin-shell portfolio-mode">
        <aside
          id="sidebar"
          class="sidebar"
        >
          <a
            class="admin-brand"
            href="/admin/"
            aria-label="Return to portfolio dashboard"
          >
            <div id="sidebar-venture-name" class="admin-brand-name">
              SOLEIL & STONE
            </div>

            <div id="sidebar-venture-subtitle" class="admin-brand-subtitle">
              Venture Workspace
            </div>
          </a>

          <button id="back-to-portfolio" class="sidebar-back" type="button">
            ← All Ventures
          </button>

          <nav id="website-sidebar-nav" class="sidebar-nav">
            <div class="sidebar-group-label">Soleil & Stone</div>
            <button
              class="nav-button"
              type="button"
              data-section="dashboard"
            >
              <span>Dashboard</span>
            </button>
            <div class="sidebar-group-label">Website & Content</div>

            <button
              class="nav-button"
              type="button"
              data-section="features"
            >
              <span>Features</span>
              <span
                id="nav-features-count"
                class="nav-count"
              >
                0
              </span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="events"
            >
              <span>Events</span>
              <span
                id="nav-events-count"
                class="nav-count"
              >
                0
              </span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="field-notes"
            >
              <span>Field Notes</span>
              <span
                id="nav-field-notes-count"
                class="nav-count"
              >
                0
              </span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="recaps"
            >
              <span>Event Recaps</span>
              <span
                id="nav-recaps-count"
                class="nav-count"
              >
                0
              </span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="media"
            >
              <span>Media Library</span>
              <span
                id="nav-media-count"
                class="nav-count"
              >
                0
              </span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="communities"
            >
              <span>Communities</span>
              <span id="nav-communities-count" class="nav-count">0</span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="organizations"
            >
              <span>Sponsors & Logos</span>
              <span id="nav-organizations-count" class="nav-count">0</span>
            </button>

            <button
              class="nav-button"
              type="button"
              data-section="people"
            >
              <span>Speakers</span>
              <span id="nav-people-count" class="nav-count">0</span>
            </button>

            <button class="nav-button" type="button" data-section="evidence">
              <span>Evidence</span>
              <span id="nav-evidence-count" class="nav-count">0</span>
            </button>

          </nav>

          <nav id="venture-sidebar-nav" class="sidebar-nav hidden"></nav>

          <div class="sidebar-footer">
            <div
              id="sidebar-email"
              class="sidebar-email"
            ></div>

            <a
              class="quiet-button sidebar-signout"
              href="/"
            >
              View website ↗
            </a>

            <button
              id="signout-button"
              class="quiet-button sidebar-signout"
              type="button"
            >
              Sign out
            </button>
          </div>
        </aside>

        <main class="main">
          <div class="main-inner">
            <div class="topbar">
              <div>
                <button
                  id="mobile-menu-button"
                  class="secondary-button mobile-menu-button"
                  type="button"
                  aria-label="Open admin navigation"
                >
                  Menu
                </button>

                <p
                  id="page-eyebrow"
                  class="eyebrow"
                >
                  Overview
                </p>

                <h1
                  id="page-title"
                  class="page-title"
                >
                  Dashboard
                </h1>

                <p
                  id="page-subtitle"
                  class="page-subtitle"
                >
                  Manage Soleil & Stone content from one place.
                </p>
              </div>

              <div id="sync-note" class="sync-note">
                The CMS is now the public site's source of truth. Published changes rebuild automatically and usually appear on the website within about 15 minutes. Scheduled content becomes public automatically after its publication time.
              </div>

              <div id="portfolio-top-actions" class="portfolio-top-actions hidden">
                <a class="secondary-button" href="/">View Website ↗</a>
                <button id="portfolio-signout-button" class="secondary-button" type="button">Sign Out</button>
              </div>
            </div>


            <!-- =============================================
                 DASHBOARD
                 ============================================= -->

            <section id="section-my-dashboard" class="admin-section hidden" data-admin-section="my-dashboard">
              <div class="panel">
                <div class="panel-header"><div><h2 class="panel-title">Quick Add</h2><p class="panel-copy">Private workspace only. Seltech, CASA and Personal are excluded.</p></div><button id="manage-workspace-areas" class="secondary-button" type="button">+ Area</button></div>
                <form id="workspace-quick-add" class="mydash-add">
                  <div class="form-field mydash-title-field"><label class="label" for="workspace-task-title">Task</label><input id="workspace-task-title" class="input" required placeholder="What needs to happen?" /></div>
                  <div class="form-field"><label class="label" for="workspace-task-area">Area</label><select id="workspace-task-area" class="select" required></select></div>
                  <div class="form-field"><label class="label" for="workspace-task-due">Due</label><input id="workspace-task-due" class="input" type="date" /></div>
                  <button class="primary-button" type="submit">Add Task</button>
                </form>
              </div>
              <div class="stats-grid" style="margin-top:18px;">
                <div class="stat-card"><div id="workspace-stat-open" class="stat-value">0</div><div class="stat-label">Open</div></div>
                <div class="stat-card"><div id="workspace-stat-today" class="stat-value">0</div><div class="stat-label">Due Today</div></div>
                <div class="stat-card"><div id="workspace-stat-overdue" class="stat-value">0</div><div class="stat-label">Overdue</div></div>
                <div class="stat-card"><div id="workspace-stat-waiting" class="stat-value">0</div><div class="stat-label">Waiting</div></div>
              </div>
              <div id="workspace-task-groups"></div>
            </section>

            <section
              id="section-dashboard"
              class="admin-section hidden"
              data-admin-section="dashboard"
            >
              <div class="quick-actions">
                <button
                  class="quick-action"
                  type="button"
                  data-quick-action="event"
                >
                  <span class="quick-action-icon">＋</span>
                  <span class="quick-action-label">New Event</span>
                </button>

                <button
                  class="quick-action"
                  type="button"
                  data-quick-action="field-note"
                >
                  <span class="quick-action-icon">＋</span>
                  <span class="quick-action-label">Field Note</span>
                </button>

                <button
                  class="quick-action"
                  type="button"
                  data-quick-action="recap"
                >
                  <span class="quick-action-icon">＋</span>
                  <span class="quick-action-label">Event Recap</span>
                </button>

                <button
                  class="quick-action"
                  type="button"
                  data-quick-action="media"
                >
                  <span class="quick-action-icon">↑</span>
                  <span class="quick-action-label">Upload Media</span>
                </button>
              </div>

              <div class="stats-grid">
                <div class="stat-card">
                  <div
                    id="stat-events"
                    class="stat-value"
                  >
                    0
                  </div>
                  <div class="stat-label">
                    Events
                  </div>
                </div>

                <div class="stat-card">
                  <div
                    id="stat-field-notes"
                    class="stat-value"
                  >
                    0
                  </div>
                  <div class="stat-label">
                    Field Notes
                  </div>
                </div>

                <div class="stat-card">
                  <div
                    id="stat-recaps"
                    class="stat-value"
                  >
                    0
                  </div>
                  <div class="stat-label">
                    Event Recaps
                  </div>
                </div>

                <div class="stat-card">
                  <div
                    id="stat-media"
                    class="stat-value"
                  >
                    0
                  </div>
                  <div class="stat-label">
                    Media Files
                  </div>
                </div>
              </div>

              <div class="panel recent-content-panel">
                <div class="panel-header recent-content-header">
                  <div>
                    <h2 class="panel-title">
                      Recent Content
                    </h2>
                    <p class="panel-copy">
                      Your most recently updated CMS items.
                    </p>
                  </div>

                  <div
                    id="recent-content-filters"
                    class="filters recent-content-filters"
                    aria-label="Filter recent content"
                  >
                    <button
                      class="filter-button active"
                      type="button"
                      data-recent-filter="all"
                    >
                      All
                    </button>
                    <button
                      class="filter-button"
                      type="button"
                      data-recent-filter="events"
                    >
                      Events
                    </button>
                    <button
                      class="filter-button"
                      type="button"
                      data-recent-filter="field-notes"
                    >
                      Field Notes
                    </button>
                    <button
                      class="filter-button"
                      type="button"
                      data-recent-filter="recaps"
                    >
                      Recaps
                    </button>
                  </div>
                </div>

                <div class="recent-content-secondary-filters">
                  <div class="recent-filter-group">
                    <span class="recent-filter-label">
                      Completeness
                    </span>

                    <div
                      id="recent-completeness-filters"
                      class="filters recent-content-filters"
                      aria-label="Filter recent content by completeness"
                    >
                      <button
                        class="filter-button active"
                        type="button"
                        data-recent-completeness="all"
                      >
                        All
                      </button>

                      <button
                        class="filter-button"
                        type="button"
                        data-recent-completeness="missing"
                      >
                        Missing info
                      </button>

                      <button
                        class="filter-button"
                        type="button"
                        data-recent-completeness="complete"
                      >
                        Complete
                      </button>
                    </div>
                  </div>

                  <div class="recent-filter-group">
                    <span class="recent-filter-label">
                      Publishing
                    </span>

                    <div
                      id="recent-status-filters"
                      class="filters recent-content-filters"
                      aria-label="Filter recent content by publishing status"
                    >
                      <button
                        class="filter-button active"
                        type="button"
                        data-recent-status="all"
                      >
                        All
                      </button>

                      <button
                        class="filter-button"
                        type="button"
                        data-recent-status="published"
                      >
                        Published
                      </button>

                      <button
                        class="filter-button"
                        type="button"
                        data-recent-status="scheduled"
                      >
                        Scheduled
                      </button>

                      <button
                        class="filter-button"
                        type="button"
                        data-recent-status="draft"
                      >
                        Draft
                      </button>

                      <button
                        class="filter-button"
                        type="button"
                        data-recent-status="archived"
                      >
                        Archived
                      </button>
                    </div>
                  </div>
                </div>

                <div
                  id="recent-content-list"
                  class="content-list recent-content-list"
                ></div>

                <div
                  id="recent-content-pagination"
                  class="recent-content-pagination hidden"
                  aria-label="Recent content pagination"
                >
                  <div
                    id="recent-content-page-summary"
                    class="recent-content-page-summary"
                  ></div>

                  <div
                    id="recent-content-page-buttons"
                    class="recent-content-page-buttons"
                  ></div>
                </div>
              </div>
            </section>


            <!-- =============================================
                 FEATURES
                 ============================================= -->

            <section
              id="section-features"
              class="admin-section hidden"
              data-admin-section="features"
            >
              <div class="feature-intro panel">
                <div class="panel-header feature-intro-header">
                  <div>
                    <p class="eyebrow">Placement manager</p>
                    <h2 class="panel-title">Featured Content</h2>
                    <p class="panel-copy">
                      Control what gets highlighted across Soleil & Stone without reopening each content editor.
                      Changes are saved immediately.
                    </p>
                  </div>
                  <div class="feature-total-badge">
                    <strong id="feature-placement-count">0</strong>
                    <span>featured here</span>
                  </div>
                </div>

                <div
                  id="feature-placement-tabs"
                  class="feature-placement-tabs"
                  aria-label="Feature placement"
                >
                  <button class="feature-placement-tab active" type="button" data-feature-placement="home">Homepage</button>
                  <button class="feature-placement-tab" type="button" data-feature-placement="fieldwork">Fieldwork</button>
                  <button class="feature-placement-tab" type="button" data-feature-placement="field-notes">Field Notes</button>
                  <button class="feature-placement-tab" type="button" data-feature-placement="community-startup-mixer">Startup Mixer</button>
                  <button class="feature-placement-tab" type="button" data-feature-placement="community-hardware-meetup">Hardware Meetup</button>
                </div>

                <div class="feature-placement-copy">
                  <strong id="feature-placement-title">Homepage</strong>
                  <span id="feature-placement-description">Choose the content you want to highlight on the homepage.</span>
                </div>
              </div>

              <div class="feature-manager-grid">
                <div class="panel feature-column">
                  <div class="feature-column-header">
                    <div>
                      <p class="eyebrow">Live selection</p>
                      <h2 class="panel-title">Currently featured</h2>
                      <p class="panel-copy">Use the arrows to change the display order. Remove only removes the feature placement — it never deletes the content.</p>
                    </div>
                  </div>
                  <div id="feature-current-list" class="feature-list"></div>
                </div>

                <div class="panel feature-column">
                  <div class="feature-column-header">
                    <div>
                      <p class="eyebrow">Content library</p>
                      <h2 class="panel-title">Add featured content</h2>
                      <p class="panel-copy">Only content relevant to the selected page appears here.</p>
                    </div>
                  </div>

                  <div class="feature-library-toolbar">
                    <input
                      id="feature-search"
                      class="input"
                      type="search"
                      placeholder="Search available content..."
                    />
                    <div id="feature-type-filters" class="filters feature-type-filters">
                      <button class="filter-button active" type="button" data-feature-type="all">All</button>
                      <button class="filter-button" type="button" data-feature-type="event">Events</button>
                      <button class="filter-button" type="button" data-feature-type="field_note">Field Notes</button>
                      <button class="filter-button" type="button" data-feature-type="event_recap">Recaps</button>
                    </div>
                  </div>

                  <div id="feature-available-list" class="feature-list"></div>
                </div>
              </div>
            </section>


            <!-- =============================================
                 EVENTS
                 ============================================= -->

            <section
              id="section-events"
              class="admin-section hidden"
              data-admin-section="events"
            >
              <div class="toolbar">
                <div class="toolbar-left">
                  <input
                    id="events-search"
                    class="input search-input"
                    type="search"
                    placeholder="Search events..."
                  />
                </div>

                <button
                  id="add-event-button"
                  class="primary-button"
                  type="button"
                >
                  + Add Event
                </button>
              </div>

              <div
                id="event-filters"
                class="filters"
              >
                <button
                  class="filter-button active"
                  type="button"
                  data-filter="all"
                >
                  All
                </button>
                <button
                  class="filter-button"
                  type="button"
                  data-filter="upcoming"
                >
                  Upcoming
                </button>
                <button
                  class="filter-button"
                  type="button"
                  data-filter="past"
                >
                  Past
                </button>
                <button
                  class="filter-button"
                  type="button"
                  data-filter="draft"
                >
                  Drafts
                </button>
                <button
                  class="filter-button"
                  type="button"
                  data-filter="archived"
                >
                  Archived
                </button>
              </div>

              <div
                id="events-list"
                class="content-list"
              ></div>
            </section>


            <!-- =============================================
                 FIELD NOTES
                 ============================================= -->

            <section
              id="section-field-notes"
              class="admin-section hidden"
              data-admin-section="field-notes"
            >
              <div class="toolbar">
                <div class="toolbar-left">
                  <input
                    id="field-notes-search"
                    class="input search-input"
                    type="search"
                    placeholder="Search Field Notes..."
                  />
                </div>

                <button
                  id="add-field-note-button"
                  class="primary-button"
                  type="button"
                >
                  + New Field Note
                </button>
              </div>

              <div
                id="field-notes-list"
                class="content-list"
              ></div>
            </section>


            <!-- =============================================
                 RECAPS
                 ============================================= -->

            <section
              id="section-recaps"
              class="admin-section hidden"
              data-admin-section="recaps"
            >
              <div class="toolbar">
                <div class="toolbar-left">
                  <input
                    id="recaps-search"
                    class="input search-input"
                    type="search"
                    placeholder="Search event recaps..."
                  />
                </div>

                <button
                  id="add-recap-button"
                  class="primary-button"
                  type="button"
                >
                  + New Recap
                </button>
              </div>

              <div
                id="recaps-list"
                class="content-list"
              ></div>
            </section>


            <!-- =============================================
                 MEDIA
                 ============================================= -->

            <section
              id="section-media"
              class="admin-section hidden"
              data-admin-section="media"
            >
              <div class="media-layout">
                <div class="upload-panel">
                  <p class="eyebrow">
                    Upload
                  </p>

                  <h2 class="panel-title">
                    Add Photos & Logos
                  </h2>

                  <p class="panel-copy">
                    Drag a file here or choose one from your device. You can use it later as an event image, logo, Field Note image or recap photo.
                  </p>

                  <div
                    id="drop-zone"
                    class="drop-zone"
                  >
                    <div>
                      <strong>
                        Drop image here
                      </strong>
                      <span>
                        PNG, JPG, WebP, SVG or AVIF
                      </span>

                      <div style="margin-top: 14px;">
                        <button
                          id="choose-media-button"
                          class="secondary-button"
                          type="button"
                        >
