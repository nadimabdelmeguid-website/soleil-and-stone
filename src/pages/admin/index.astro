      function currentVenture() {
        return state.ventures.find((item) => String(item.id) === String(state.currentVentureId)) || null;
      }


      function isSoleilAndStoneVenture(venture) {
        if (!venture) return false;
        const slug = String(venture.slug || "").trim().toLowerCase();
        const name = String(venture.name || "").trim().toLowerCase();
        return slug === "soleil-and-stone" || slug === "soleil-stone" || name === "soleil & stone";
      }


      function workspaceConfigFor(venture = currentVenture()) {
        if (!venture) return { subtitle: "Venture workspace", modules: [] };
        const configured = isSoleilAndStoneVenture(venture)
          ? ventureWorkspaceConfig["soleil-and-stone"]
          : ventureWorkspaceConfig[venture.slug];
        if (configured) return configured;

        const templated = ventureTemplateConfig[venture.template_key || "blank"];
        if (templated && templated.modules.length) return templated;

        const dynamicModules = [...new Set(
          state.ventureWorkspaceItems
            .filter((item) => !item.archived_at)
            .filter((item) => String(item.venture_id) === String(venture.id))
            .map((item) => item.module_key)
        )].map((key) => ({
          key,
          label: String(key || "module").replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase()),
          description: "Venture workspace module."
        }));

        return {
          subtitle: venture.sector || "Venture workspace",
          modules: dynamicModules
        };
      }


      function workspaceItemsFor(ventureId, moduleKey = null) {
        return state.ventureWorkspaceItems
          .filter((item) => !item.archived_at)
          .filter((item) => String(item.venture_id) === String(ventureId))
          .filter((item) => !moduleKey || item.module_key === moduleKey)
          .sort((a, b) =>
            Number(a.sort_order || 0) - Number(b.sort_order || 0)
            || String(a.title || "").localeCompare(String(b.title || ""))
          );
      }


      function renderVentureSidebar() {
        const venture = currentVenture();
        if (!venture) return;

        $("#sidebar-venture-name").textContent = venture.name;
        $("#sidebar-venture-subtitle").textContent = workspaceConfigFor(venture).subtitle;

        const isSoleil = isSoleilAndStoneVenture(venture);
        $("#website-sidebar-nav").classList.toggle("hidden", !isSoleil);
        $("#venture-sidebar-nav").classList.toggle("hidden", isSoleil);

        if (isSoleil) {
          refreshCounts();
          return;
        }

        const config = workspaceConfigFor(venture);
        $("#venture-sidebar-nav").innerHTML = `
          <div class="sidebar-group-label">Overview</div>
          <button class="nav-button" type="button" data-section="venture-home">
            <span>Dashboard</span>
