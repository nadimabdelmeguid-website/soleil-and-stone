                    </div>

                    <div class="row-actions">
                      <button
                        class="secondary-button"
                        type="button"
                        data-edit-event="${escapeHtml(event.id)}"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                `;

              }
            )
            .join(
              ""
            );

      }


