  <body>
    <!-- =====================================================
         AUTH SCREEN
         ===================================================== -->

    <section
      id="auth-screen"
      class="auth-screen"
    >
      <div class="auth-card">
        <a
          href="/"
          class="auth-logo-link"
          aria-label="Soleil & Stone home"
        >
          <img
            src="/brand/logo-primary.png"
            alt="Soleil & Stone"
            class="auth-logo"
          />
        </a>

        <p class="eyebrow">
          Private Administration
        </p>

        <h1 class="auth-title">
          Content Manager
        </h1>

        <p class="auth-copy">
          Manage events, Field Notes, recaps, photos, logos and community content without editing the website code.
        </p>

        <form id="login-form">
          <label
            class="label"
            for="login-email"
          >
            Email
          </label>

          <input
            id="login-email"
            class="input"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />

          <button
            id="login-submit"
            class="primary-button auth-submit"
            type="submit"
          >
            Send secure sign-in email
          </button>
        </form>

        <div class="auth-divider" aria-hidden="true">
          <span>then</span>
        </div>

        <form
          id="otp-form"
          style="margin-top: 0;"
        >
          <label
            class="label"
            for="login-otp"
          >
            Verification code
          </label>

          <p class="auth-code-help">
            After requesting the sign-in email, enter the code you received here. If the email contains a clickable sign-in link instead, you can use that too.
          </p>

          <input
            id="login-otp"
            class="input"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            placeholder="Enter the code from your email"
            maxlength="8"
