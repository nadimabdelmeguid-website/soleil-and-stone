                        </p>
                      </div>

                      <div class="form-field full">
                        <label class="label" for="field-note-seo-title">
                          SEO title
                        </label>
                        <input
                          id="field-note-seo-title"
                          class="input"
                          type="text"
                          maxlength="70"
                          placeholder="Defaults to the Field Note title"
                        />
                        <div id="field-note-seo-title-count" class="seo-counter">0 / 60 recommended</div>
                      </div>

                      <div class="form-field full">
                        <label class="label" for="field-note-seo-description">
