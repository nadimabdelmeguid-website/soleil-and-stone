---
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ??
  "https://szdhkttphzvtmljuhcqs.supabase.co";

const supabasePublishableKey =
  import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ??
  "sb_publishable_iN7aDql5whleXHRCRVNS-w_Awl-iQez";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <meta
      name="theme-color"
      content="#22252A"
    />

    <title>
      Soleil & Stone | Admin
    </title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --cream: #f4f1e8;
        --card: #ffffff;
        --charcoal: #22252a;
        --slate: #4a505a;
        --gold: #c5a059;
        --gold-light: #e5c98b;
        --border: #ddd8cb;
        --danger: #a94b4b;
        --success: #477a5a;
        --shadow: 0 18px 60px rgba(34, 37, 42, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--cream);
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--cream);
        color: var(--charcoal);
        font-family: "Plus Jakarta Sans", Inter, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        cursor: pointer;
      }

      .hidden {
        display: none !important;
      }

      .serif {
        font-family: "Cinzel", Georgia, serif;
      }

      /* =====================================================
         AUTH
         ===================================================== */

      .auth-screen {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px;
        background:
          radial-gradient(
            circle at top left,
            rgba(197, 160, 89, 0.14),
            transparent 34%
          ),
          var(--cream);
      }

      .auth-card {
        width: min(100%, 460px);
        background: white;
        border: 1px solid var(--border);
        padding: 38px;
        box-shadow: var(--shadow);
      }

      .auth-mark {
        width: 54px;
        height: 54px;
        border: 1px solid var(--gold);
        display: grid;
        place-items: center;
        color: var(--gold);
        margin-bottom: 26px;
        font-family: "Cinzel", Georgia, serif;
        font-size: 18px;
        letter-spacing: 0.08em;
      }

      .eyebrow {
        margin: 0 0 8px;
        color: var(--gold);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .auth-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: clamp(28px, 5vw, 38px);
        font-weight: 400;
        line-height: 1.2;
      }

      .auth-copy {
        margin: 16px 0 26px;
        color: var(--slate);
        font-size: 14px;
        line-height: 1.7;
        font-weight: 300;
      }

      .label {
        display: block;
        margin-bottom: 8px;
        color: var(--charcoal);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .input,
      .select,
      .textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 0;
        background: white;
        color: var(--charcoal);
        outline: none;
        transition:
          border-color 160ms ease,
          box-shadow 160ms ease;
      }

      .input,
      .select {
        min-height: 46px;
        padding: 0 13px;
      }

      .textarea {
        min-height: 120px;
        padding: 13px;
        resize: vertical;
        line-height: 1.6;
      }

      .input:focus,
      .select:focus,
      .textarea:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.12);
      }

      .primary-button,
      .secondary-button,
      .quiet-button,
      .danger-button {
        min-height: 44px;
        border-radius: 0;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition:
          background 160ms ease,
          color 160ms ease,
          border-color 160ms ease,
          opacity 160ms ease;
      }

      .primary-button {
        border: 1px solid var(--charcoal);
        background: var(--charcoal);
        color: white;
      }

      .primary-button:hover {
        border-color: var(--gold);
        background: var(--gold);
      }

      .secondary-button {
        border: 1px solid var(--border);
        background: white;
        color: var(--charcoal);
      }

      .secondary-button:hover {
        border-color: var(--gold);
        color: var(--gold);
      }

      .quiet-button {
        border: 0;
        background: transparent;
        color: var(--slate);
        padding-inline: 8px;
      }

      .quiet-button:hover {
        color: var(--gold);
      }

      .danger-button {
        border: 1px solid rgba(169, 75, 75, 0.3);
        background: rgba(169, 75, 75, 0.06);
        color: var(--danger);
      }

      .primary-button:disabled,
      .secondary-button:disabled,
      .danger-button:disabled {
        cursor: not-allowed;
        opacity: 0.48;
      }

      .auth-submit {
        width: 100%;
        margin-top: 16px;
      }

      .form-message {
        margin: 14px 0 0;
        font-size: 12px;
        line-height: 1.6;
      }

      .form-message.success {
        color: var(--success);
      }

      .form-message.error {
        color: var(--danger);
      }

      /* =====================================================
         APP SHELL
         ===================================================== */

      .admin-app {
        min-height: 100vh;
      }

      .admin-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        background: var(--charcoal);
        color: white;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        padding: 26px 20px;
        display: flex;
        flex-direction: column;
      }

      .admin-brand {
        color: white;
        text-decoration: none;
      }

      .admin-brand-name {
        font-family: "Cinzel", Georgia, serif;
        font-size: 17px;
        letter-spacing: 0.14em;
      }

      .admin-brand-subtitle {
        margin-top: 5px;
        color: rgba(255, 255, 255, 0.46);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .sidebar-nav {
        margin-top: 38px;
        display: grid;
        gap: 4px;
      }

      .nav-button {
        width: 100%;
        min-height: 44px;
        border: 0;
        background: transparent;
        color: rgba(255, 255, 255, 0.62);
        padding: 0 12px;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        transition:
          background 160ms ease,
          color 160ms ease;
      }

      .nav-button:hover,
      .nav-button.active {
        background: rgba(255, 255, 255, 0.06);
        color: white;
      }

      .nav-button.active {
        box-shadow: inset 2px 0 0 var(--gold);
      }

      .nav-count {
        color: rgba(255, 255, 255, 0.35);
        font-size: 10px;
      }

      .sidebar-footer {
        margin-top: auto;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .sidebar-email {
        margin-bottom: 12px;
        color: rgba(255, 255, 255, 0.45);
        font-size: 10px;
        line-height: 1.5;
        word-break: break-word;
      }

      .sidebar-signout {
        color: rgba(255, 255, 255, 0.7);
      }

      .main {
        min-width: 0;
        padding: 34px;
      }

      .main-inner {
        width: min(100%, 1180px);
        margin: 0 auto;
      }

      .topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 22px;
        margin-bottom: 30px;
      }

      .page-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 400;
        line-height: 1.2;
      }

      .page-subtitle {
        margin: 8px 0 0;
        color: var(--slate);
        font-size: 13px;
        line-height: 1.6;
        font-weight: 300;
      }

      .sync-note {
        border: 1px solid rgba(197, 160, 89, 0.35);
        background: rgba(197, 160, 89, 0.08);
        padding: 12px 14px;
        color: #80652f;
        font-size: 11px;
        line-height: 1.55;
      }

      .mobile-menu-button {
        display: none;
      }

      /* =====================================================
         DASHBOARD
         ===================================================== */

      .quick-actions {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 28px;
      }

      .quick-action {
        min-height: 92px;
        border: 1px solid var(--border);
        background: white;
        padding: 16px;
        text-align: left;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: var(--charcoal);
        transition:
          border-color 160ms ease,
          transform 160ms ease;
      }

      .quick-action:hover {
        border-color: var(--gold);
        transform: translateY(-1px);
      }

      .quick-action-icon {
        color: var(--gold);
        font-size: 18px;
      }

      .quick-action-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        margin-bottom: 28px;
      }

      .stat-card {
        background: white;
        padding: 20px;
      }

      .stat-value {
        font-family: "Cinzel", Georgia, serif;
        font-size: 30px;
        color: var(--gold);
      }

      .stat-label {
        margin-top: 6px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .panel {
        border: 1px solid var(--border);
        background: white;
      }

      .panel-header {
        min-height: 66px;
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .panel-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 18px;
        font-weight: 400;
      }

      .panel-copy {
        margin: 3px 0 0;
        color: var(--slate);
        font-size: 11px;
        font-weight: 300;
      }

      .empty-state {
        padding: 44px 20px;
        text-align: center;
        color: var(--slate);
      }

      .empty-state strong {
        display: block;
        margin-bottom: 8px;
        color: var(--charcoal);
        font-family: "Cinzel", Georgia, serif;
        font-weight: 400;
        font-size: 19px;
      }

      /* =====================================================
         CONTENT LISTS
         ===================================================== */

      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
      }

      .toolbar-left {
        min-width: 0;
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .search-input {
        width: min(100%, 420px);
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 16px;
      }

      .filter-button {
        min-height: 34px;
        border: 1px solid var(--border);
        background: white;
        padding: 0 12px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .filter-button.active {
        border-color: var(--charcoal);
        background: var(--charcoal);
        color: white;
      }

      .content-list {
        border: 1px solid var(--border);
        background: white;
      }

      .content-row {
        padding: 16px 18px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        border-bottom: 1px solid var(--border);
      }

      .content-row:last-child {
        border-bottom: 0;
      }

      .row-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.4;
      }

      .row-meta {
        margin-top: 5px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 7px;
        color: var(--slate);
        font-size: 10px;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 0 8px;
        border: 1px solid var(--border);
        color: var(--slate);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .status-pill.published,
      .status-pill.active {
        border-color: rgba(71, 122, 90, 0.25);
        background: rgba(71, 122, 90, 0.07);
        color: var(--success);
      }

      .status-pill.draft {
        border-color: rgba(197, 160, 89, 0.35);
        background: rgba(197, 160, 89, 0.08);
        color: #80652f;
      }

      .status-pill.archived {
        opacity: 0.72;
      }

      .row-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      /* =====================================================
         MEDIA
         ===================================================== */

      .media-layout {
        display: grid;
        grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
        gap: 18px;
      }

      .upload-panel {
        border: 1px solid var(--border);
        background: white;
        padding: 20px;
        align-self: start;
      }

      .drop-zone {
        margin-top: 16px;
        border: 1px dashed #bdb6a6;
        background: var(--cream);
        min-height: 180px;
        display: grid;
        place-items: center;
        padding: 20px;
        text-align: center;
        transition:
          border-color 160ms ease,
          background 160ms ease;
      }

      .drop-zone.dragging {
        border-color: var(--gold);
        background: rgba(197, 160, 89, 0.1);
      }

      .drop-zone strong {
        display: block;
        margin-bottom: 6px;
        font-family: "Cinzel", Georgia, serif;
        font-weight: 400;
      }

      .drop-zone span {
        color: var(--slate);
        font-size: 11px;
        line-height: 1.6;
      }

      .media-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .media-card {
        border: 1px solid var(--border);
        background: white;
        min-width: 0;
      }

      .media-preview {
        aspect-ratio: 4 / 3;
        background: var(--cream);
        border-bottom: 1px solid var(--border);
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .media-preview img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .media-card-body {
        padding: 11px;
      }

      .media-name {
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 10px;
        font-weight: 500;
      }

      .media-meta {
        margin-top: 5px;
        color: var(--slate);
        font-size: 9px;
      }

      /* =====================================================
         MODAL / EDITOR
         ===================================================== */

      .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(34, 37, 42, 0.54);
        display: grid;
        place-items: center;
        padding: 20px;
        overflow-y: auto;
      }

      .modal {
        width: min(100%, 880px);
        max-height: calc(100vh - 40px);
        overflow-y: auto;
        background: var(--cream);
        border: 1px solid var(--border);
        box-shadow: 0 24px 100px rgba(0, 0, 0, 0.2);
      }

      .modal-header {
        position: sticky;
        top: 0;
        z-index: 4;
        min-height: 70px;
        padding: 14px 20px;
        background: white;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .modal-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 20px;
        font-weight: 400;
      }

      .modal-body {
        padding: 20px;
      }

      .form-section {
        border: 1px solid var(--border);
        background: white;
        margin-bottom: 14px;
      }

      .form-section-header {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
      }

      .form-section-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 15px;
        font-weight: 400;
      }

      .form-section-copy {
        margin: 4px 0 0;
        color: var(--slate);
        font-size: 10px;
        line-height: 1.5;
      }

      .form-section-body {
        padding: 16px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .form-field.full {
        grid-column: 1 / -1;
      }

      .checkbox-row {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .checkbox-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--slate);
        font-size: 11px;
      }

      .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 4;
        padding: 14px 20px;
        background: white;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .modal-footer-right {
        display: flex;
        gap: 8px;
      }

      /* =====================================================
         TOAST
         ===================================================== */

      .toast {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 200;
        width: min(calc(100% - 44px), 360px);
        border: 1px solid var(--border);
        background: white;
        padding: 13px 15px;
        box-shadow: var(--shadow);
        color: var(--charcoal);
        font-size: 12px;
        line-height: 1.55;
      }

      .toast.success {
        border-left: 3px solid var(--success);
      }

      .toast.error {
        border-left: 3px solid var(--danger);
      }

      /* =====================================================
         MOBILE
         ===================================================== */

      @media (max-width: 900px) {
        .admin-shell {
          display: block;
        }

        .sidebar {
          position: fixed;
          left: 0;
          top: 0;
          z-index: 80;
          width: min(86vw, 300px);
          transform: translateX(-105%);
          transition: transform 180ms ease;
        }

        .sidebar.open {
          transform: translateX(0);
        }

        .mobile-menu-button {
          display: inline-flex;
        }

        .main {
          padding: 22px;
        }

        .quick-actions,
        .stats-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .media-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .auth-card {
          padding: 26px 22px;
        }

        .main {
          padding: 18px 14px 28px;
        }

        .topbar {
          align-items: center;
        }

        .page-title {
          font-size: 28px;
        }

        .quick-actions {
          grid-template-columns: 1fr 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .toolbar {
          align-items: stretch;
          flex-direction: column;
        }

        .toolbar-left {
          width: 100%;
        }

        .search-input {
          width: 100%;
        }

        .content-row {
          grid-template-columns: 1fr;
        }

        .row-actions {
          justify-content: flex-start;
        }

        .media-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .modal-backdrop {
          padding: 0;
          place-items: stretch;
        }

        .modal {
          width: 100%;
          max-height: 100vh;
          min-height: 100vh;
          border: 0;
        }

        .form-grid {
          grid-template-columns: 1fr;
        }

        .form-field.full {
          grid-column: auto;
        }

        .modal-footer {
          align-items: stretch;
          flex-direction: column;
        }

        .modal-footer-right {
          width: 100%;
        }

        .modal-footer-right > * {
          flex: 1;
        }
      }

      @media (max-width: 430px) {
        .quick-actions {
          grid-template-columns: 1fr;
        }

        .media-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <!-- =====================================================
         AUTH SCREEN
         ===================================================== -->

    <section
      id="auth-screen"
      class="auth-screen"
    >
      <div class="auth-card">
        <div class="auth-mark">
          S&S
        </div>

        <p class="eyebrow">
          Private Administration
        </p>

        <h1 class="auth-title">
          Content Manager
        </h1>

        <p class="auth-copy">
          Manage events, Field Notes, recaps, photos, logos and community content without editing the website code.
        </p>

        <form id="login-form">
          <label
            class="label"
            for="login-email"
          >
            Email
          </label>

          <input
            id="login-email"
            class="input"
            type="email"
