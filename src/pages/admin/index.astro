      async function savePerson() {
        const existingId = $("#person-record-id").value;
        const payload = {
          name: $("#person-name").value.trim(),
          company: $("#person-company").value.trim() || null,
          company_url: $("#person-company-url").value.trim() || null,
          company_logo_media_id: $("#person-company-logo-media").value || null,
