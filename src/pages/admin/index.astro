      function renderEventAdditionalImage() {
        const url = $("#event-image-url")?.value?.trim() || "";
        const preview = $("#event-additional-image-preview");
        const button = $("#event-additional-image-button");
        const remove = $("#event-additional-image-remove");

        if (!preview || !button || !remove) return;

        if (!url) {
          preview.classList.remove("has-image");
          preview.innerHTML = "No additional event image";
          button.textContent = "Upload event image";
          remove.classList.add("hidden");
          return;
        }

        preview.classList.add("has-image");
        preview.innerHTML = `<img src="${escapeHtml(url)}" alt="Event image preview" />`;
        button.textContent = "Replace event image";
        remove.classList.remove("hidden");
      }


      async function uploadEventAdditionalImage(file) {
        if (!file) return;

        const button = $("#event-additional-image-button");
        setButtonLoading(button, true, "Uploading...", "Upload event image");

        try {
          const media = await uploadMediaFile(file, {
            targets: ["events"],
            mediaKind: "image",
            altText: file.name.replace(/\.[^.]+$/, "")
          });

          await loadMedia();
          refreshMediaSelectors();
          refreshCounts();

          $("#event-image-url").value = media.public_url || "";
          renderEventAdditionalImage();
          showToast("Event image uploaded.");
        } catch (error) {
          console.error(error);
          showToast(error?.message || "Could not upload event image.", "error");
        } finally {
          button.disabled = false;
          renderEventAdditionalImage();
        }
      }


      function markdownImagesFromContent(value = "") {
        const images = [];
        const regex = /!\[([^\]]*)\]\((https?:\/\/[^)\s]+)(?:\s+\"[^\"]*\")?\)/g;
        let match;

        while ((match = regex.exec(String(value || "")))) {
          images.push({
            markdown: match[0],
            alt: match[1] || "Article picture",
            url: match[2]
          });
        }

        return images;
      }


