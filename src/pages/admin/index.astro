      async function saveFieldNote() {

        const existingId =
          $("#field-note-record-id").value;

        const title =
          $("#field-note-title").value.trim();

        const publishingMode =
          $("#field-note-status").value;

        const publicationInput =
          $("#field-note-published-at").value;

        let status = publishingMode;
        let publishedAt = null;

        if (publishingMode === "scheduled") {
          if (!publicationInput) {
            throw new Error("Choose a future publication date and time.");
          }

          const scheduledDate = new Date(publicationInput);

          if (
            Number.isNaN(scheduledDate.getTime()) ||
            scheduledDate.getTime() <= Date.now()
          ) {
            throw new Error("The scheduled publication date must be in the future.");
          }

          // Store scheduled content as published with a future timestamp.
          // Supabase RLS keeps it private until published_at <= now().
          status = "published";
          publishedAt = scheduledDate.toISOString();
        } else if (publishingMode === "published") {
          status = "published";

          const existingItem = existingId
            ? state.fieldNotes.find((item) => item.id === existingId)
            : null;

          const existingPublishTime = existingItem?.published_at
            ? new Date(existingItem.published_at)
            : null;

          publishedAt =
            existingPublishTime &&
            Number.isFinite(existingPublishTime.getTime()) &&
            existingPublishTime.getTime() <= Date.now()
              ? existingPublishTime.toISOString()
              : new Date().toISOString();
        } else if (publishingMode === "archived") {
          status = "archived";

          const existingItem = existingId
            ? state.fieldNotes.find((item) => item.id === existingId)
            : null;

          publishedAt = existingItem?.published_at || null;
        } else {
          status = "draft";
          publishedAt = null;
        }


        const payload = {
          title,
          excerpt:
            $("#field-note-excerpt").value.trim() || null,
          category:
            $("#field-note-category").value.trim() || null,
          content_markdown:
            $("#field-note-content").value,
          hero_media_id:
            $("#field-note-hero-media").value || null,
          featured:
            $("#field-note-featured").checked,
          reading_minutes:
            $("#field-note-reading-minutes").value
              ? Number($("#field-note-reading-minutes").value)
              : null,
          legacy_url:
            $("#field-note-legacy-url").value.trim() || null,
          seo_title:
            $("#field-note-seo-title").value.trim() || title,
          seo_description:
            $("#field-note-seo-description").value.trim() ||
            $("#field-note-excerpt").value.trim() ||
            null,
          published_at:
            publishedAt,
          status
        };


        let response;
        let savedFieldNoteId = existingId;


        if (
          existingId
        ) {

          response =
            await supabase
              .from("field_notes")
              .update(payload)
              .eq("id", existingId);

        } else {

          const id =
            `note-${crypto.randomUUID()}`;

          savedFieldNoteId = id;


          response =
            await supabase
              .from("field_notes")
              .insert({
                id,
                slug:
                  `${slugify(title)}-${crypto.randomUUID().slice(0, 6)}`,
                ...payload
              });

        }


        if (
          response.error
        ) {
          throw response.error;
        }

        await syncEditorFeaturePlacement(
          "home",
          "field_note",
          savedFieldNoteId,
          payload.featured
        );


        closeModal("field-note");
        showToast(existingId ? "Field Note updated." : "Field Note created.");
        await loadFieldNotes();
        refreshCounts();
        renderRecentContent();

      }


