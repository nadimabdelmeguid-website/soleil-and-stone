      function openSection(
        section
      ) {

        $$(".admin-section").forEach(
          (
            element
          ) =>
            element.classList.toggle(
              "hidden",
              element.dataset.adminSection !== section
            )
        );


        $$(".nav-button").forEach(
          (
            button
          ) =>
            button.classList.toggle(
              "active",
              button.dataset.section === section
            )
        );


        const copy =
          sectionCopy[
            section
          ] ||
          sectionCopy.dashboard;


        $("#page-eyebrow").textContent =
          copy.eyebrow;

        $("#page-title").textContent =
          copy.title;

        $("#page-subtitle").textContent =
          copy.subtitle;

        $("#sidebar").classList.remove("open");

      }


      function closeModal(
        type
      ) {

        const map = {
          event:
            "#event-modal",
          "field-note":
            "#field-note-modal",
          recap:
            "#recap-modal",
          community:
            "#community-modal",
          organization:
            "#organization-modal",
          person:
            "#person-modal"
        };


        const modal =
          $(map[type]);


        modal?.classList.add("hidden");
        document.body.style.overflow = "";

      }


