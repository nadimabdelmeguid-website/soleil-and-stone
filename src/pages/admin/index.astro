          showToast(error?.message || "Could not delete task.", "error");
        }
      });

      $("#save-venture-task-button").addEventListener("click", async () => {
        const button = $("#save-venture-task-button");
        setButtonLoading(button, true, "Saving...", "Save Task");
        try {
          await saveVentureTask();
        } catch (error) {
          console.error(error);
          showToast(error?.message || "Could not save task.", "error");
        } finally {
          setButtonLoading(button, false, "Saving...", "Save Task");
        }
      });


      $("#evidence-form").addEventListener("submit", async (event) => {
        event.preventDefault();
        const button=$("#save-evidence-button"); setButtonLoading(button,true,"Saving...","Save Evidence");
        try { await saveEvidence(); } catch(error) { console.error(error); showToast(error?.message||"Could not save evidence.","error"); } finally { setButtonLoading(button,false,"Saving...","Save Evidence"); }
      });


      $("#venture-private-files-button")?.addEventListener("click", () => {
        const ventureId = $("#venture-record-id")?.value;
        if (ventureId) openVentureFiles("venture", ventureId);
      });

      $("#venture-files-input")?.addEventListener("change",(event)=>{
        state.venturePendingFiles=[];
        const count=event.target.files?.length||0;
        if(count)showToast(`${count} file${count===1?"":"s"} selected.`);
      });

      const ventureFileDropZone=$("#venture-file-drop-zone");
      ventureFileDropZone?.addEventListener("dragover",(event)=>{
        event.preventDefault();
        ventureFileDropZone.classList.add("dragging");
      });
      ventureFileDropZone?.addEventListener("dragleave",()=>ventureFileDropZone.classList.remove("dragging"));
      ventureFileDropZone?.addEventListener("drop",(event)=>{
        event.preventDefault();
        ventureFileDropZone.classList.remove("dragging");
        state.venturePendingFiles=Array.from(event.dataTransfer?.files||[]);
        $("#venture-files-input").value="";
        if(state.venturePendingFiles.length)showToast(`${state.venturePendingFiles.length} dropped file${state.venturePendingFiles.length===1?"":"s"} ready to upload.`);
      });

      $("#upload-venture-files-button")?.addEventListener("click", async () => {
        const button = $("#upload-venture-files-button");
        setButtonLoading(button, true, "Uploading...", "Upload Selected Files");
        try { await uploadVentureFiles(); }
        catch (error) { console.error(error); showToast(error?.message || "Could not upload private files.", "error"); }
        finally { setButtonLoading(button, false, "Uploading...", "Upload Selected Files"); }
      });


      $("#mobile-venture-task")?.addEventListener("click",()=>{
        const venture=currentVenture();
        if(venture)openVentureModal(venture.id,"execution",true);
        else openVentureModal();
      });
      $("#mobile-venture-file")?.addEventListener("click",()=>{
        const venture=currentVenture();
        if(venture)openVentureFiles("venture",venture.id);
        else { openPortfolio(); window.setTimeout(()=>$("#venture-universal-search")?.focus(),0); }
      });
      $("#mobile-venture-edit")?.addEventListener("click",()=>{
        const venture=currentVenture();
        if(venture)openVentureModal(venture.id,"overview");
        else openCommandPalette();
      });


      $("#venture-file-details-form")?.addEventListener("submit",async(event)=>{
        event.preventDefault();
        const button=$("#save-venture-file-details-button");
        setButtonLoading(button,true,"Saving...","Save Details");
        try{await saveVentureFileDetails();}
        catch(error){console.error(error);showToast(error?.message||"Could not save file details.","error");}
        finally{setButtonLoading(button,false,"Saving...","Save Details");}
      });


      $("#venture-form").addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();
          const button = $("#save-venture-button");
          const normalText = $("#venture-record-id").value ? "Save Changes" : "Create Venture";
          setButtonLoading(button, true, "Saving...", normalText);
          try {
            await saveVenture();
          } catch (error) {
            console.error(error);
            showToast(error?.message || "Could not save venture.", "error");
          } finally {
            setButtonLoading(
              button,
              false,
              "Saving...",
              $("#venture-record-id").value ? "Save Changes" : "Create Venture"
            );
          }
        }
      );


      const dropZone =
        $("#drop-zone");


      $("#choose-media-button").addEventListener(
        "click",
        () =>
          $("#media-file-input").click()
      );


      $("#media-file-input").addEventListener(
        "change",
        (
          event
        ) => {
          setSelectedMediaFile(
            event.target.files?.[0]
          );
        }
      );


      dropZone.addEventListener(
        "dragover",
        (
          event
        ) => {
          event.preventDefault();
          dropZone.classList.add("dragging");
        }
      );


      dropZone.addEventListener(
        "dragleave",
        () =>
          dropZone.classList.remove("dragging")
      );


      dropZone.addEventListener(
        "drop",
        (
          event
        ) => {
          event.preventDefault();
          dropZone.classList.remove("dragging");
          setSelectedMediaFile(
            event.dataTransfer?.files?.[0]
          );
        }
      );


      $("#media-target-filter").addEventListener(
        "change",
        renderMedia
      );


      $$("[data-editor-upload]").forEach((button) => {
        button.addEventListener("click", () => {
          const textareaId = button.dataset.editorUpload;
          const target = button.dataset.editorTarget;
          const input = textareaId === "field-note-content"
            ? $("#field-note-inline-upload")
            : $("#recap-inline-upload");
          state.pendingEditorUpload = { textareaId, target };
          input.value = "";
          input.click();
        });
      });


      $("#field-note-inline-upload").addEventListener("change", async (event) => {
        const pending = state.pendingEditorUpload;
        if (pending) await uploadAndInsertEditorImage(event.target.files?.[0], pending.textareaId, pending.target);
        state.pendingEditorUpload = null;
      });


      $("#recap-inline-upload").addEventListener("change", async (event) => {
        const pending = state.pendingEditorUpload;
        if (pending) await uploadAndInsertEditorImage(event.target.files?.[0], pending.textareaId, pending.target);
        state.pendingEditorUpload = null;
      });


      $("#field-note-insert-media").addEventListener("click", () => {
        insertSelectedLibraryImage("field-note-inline-media", "field-note-content");
        renderFieldNotePictureUploaders();
      });

      $("#recap-insert-media").addEventListener("click", () => {
        insertSelectedLibraryImage("recap-inline-media", "recap-content");
        renderRecapPictureUploaders();
      });



      $("#event-additional-image-button")?.addEventListener("click", () => {
        const input = $("#event-additional-image-upload");
        input.value = "";
        input.click();
      });


      $("#event-additional-image-upload")?.addEventListener("change", async (event) => {
        await uploadEventAdditionalImage(event.target.files?.[0]);
        event.target.value = "";
      });


      $("#event-additional-image-remove")?.addEventListener("click", () => {
        $("#event-image-url").value = "";
        renderEventAdditionalImage();
        showToast("Event image removed from this event. The original file remains in the Media Library.");
      });


      $("#field-note-picture-list")?.addEventListener("click", (event) => {
        const uploadButton = event.target.closest("[data-upload-next-field-note-picture]");
        if (uploadButton) {
          const input = $("#field-note-picture-upload");
          input.value = "";
          input.click();
          return;
        }

        const removeButton = event.target.closest("[data-remove-field-note-picture]");
        if (removeButton) {
          removeFieldNotePicture(Number(removeButton.dataset.removeFieldNotePicture));
        }
      });


      $("#field-note-picture-upload")?.addEventListener("change", async (event) => {
        await uploadAndInsertEditorImage(
          event.target.files?.[0],
          "field-note-content",
          "field-notes"
        );
        event.target.value = "";
        renderFieldNotePictureUploaders();
      });


      $("#field-note-content")?.addEventListener("input", renderFieldNotePictureUploaders);
      $("#field-note-seo-title")?.addEventListener("input", updateFieldNoteSeoCounters);
      $("#field-note-seo-description")?.addEventListener("input", updateFieldNoteSeoCounters);


      $("#recap-picture-list")?.addEventListener("click", (event) => {
        const uploadButton = event.target.closest("[data-upload-next-recap-picture]");
        if (uploadButton) {
          const input = $("#recap-picture-upload");
          input.value = "";
          input.click();
          return;
        }

        const removeButton = event.target.closest("[data-remove-recap-picture]");
        if (removeButton) {
          removeRecapPicture(Number(removeButton.dataset.removeRecapPicture));
        }
      });


      $("#recap-picture-upload")?.addEventListener("change", async (event) => {
        await uploadAndInsertEditorImage(
          event.target.files?.[0],
          "recap-content",
          "event-recaps,fieldwork"
        );
        event.target.value = "";
        renderRecapPictureUploaders();
      });


      $("#recap-content")?.addEventListener("input", renderRecapPictureUploaders);
      $("#recap-seo-title")?.addEventListener("input", updateRecapSeoCounters);
      $("#recap-seo-description")?.addEventListener("input", updateRecapSeoCounters);


      $$("[data-cover-upload]").forEach((button) => {
        button.addEventListener("click", () => {
          const selectId = button.dataset.coverUpload;
          const target = button.dataset.coverTarget;
          const inputMap = {
            "event-cover-media": "#event-cover-upload",
            "event-community-track-media": "#event-community-track-upload",
            "event-industry-logo-media": "#event-industry-logo-upload",
            "field-note-hero-media": "#field-note-hero-upload",
            "recap-hero-media": "#recap-hero-upload"
          };
          const input = $(inputMap[selectId]);
          state.pendingCoverUpload = { selectId, target };
          input.value = "";
          input.click();
        });
      });


      [
        $("#event-cover-upload"),
        $("#event-community-track-upload"),
        $("#event-industry-logo-upload"),
        $("#field-note-hero-upload"),
        $("#recap-hero-upload")
      ].forEach((input) => {
        input?.addEventListener("change", async (event) => {
          const pending = state.pendingCoverUpload;
          if (pending) await uploadAndSelectCover(event.target.files?.[0], pending.selectId, pending.target);
          state.pendingCoverUpload = null;
        });
      });


      $("#upload-media-button").addEventListener(
        "click",
        uploadSelectedMedia
      );


      document.addEventListener(
        "keydown",
        (
          event
        ) => {

          if (
            event.key !== "Escape"
          ) {
            return;
          }


          [
            "event",
            "field-note",
            "recap",
            "community",
            "organization",
            "person",
            "venture",
            "venture-workspace-item",
            "evidence"
          ].forEach(
            closeModal
          );

          $("#sidebar").classList.remove("open");

        }
      );


      /* =====================================================
         INITIALIZE
         ===================================================== */

      const {
        data: {
          session
        }
      } =
        await supabase.auth.getSession();


      await handleSession(
        session
      );


      supabase.auth.onAuthStateChange(
        async (
          event,
          session
        ) => {

          if (
            event === "SIGNED_IN" ||
            event === "INITIAL_SESSION"
          ) {
            await handleSession(session);
          }

          if (
            event === "SIGNED_OUT"
          ) {
            state.user = null;
            showAuth();
          }

        }
      );
    </script>
  </body>
</html>
