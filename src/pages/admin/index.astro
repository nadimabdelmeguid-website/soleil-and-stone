      function getEventTimeState(
        event
      ) {

        const today =
          new Date();

        today.setHours(
          0,
          0,
          0,
          0
        );


        const end =
          new Date(
            `${event.end_date || event.start_date}T23:59:59`
          );


        return end < today
          ? "past"
          : "upcoming";

      }


