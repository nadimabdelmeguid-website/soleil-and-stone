      function getRecentContentDisplayStatus(
        item
      ) {

        if (
          item.contentSection === "field-notes"
        ) {
          return fieldNoteDisplayStatus(
            item
          );
        }


        if (
          item.contentSection === "recaps"
        ) {
          return recapDisplayStatus(
            item
          );
        }


        const mode =
          item.status ||
          "published";


        return {
          mode,

          label:
            mode === "published"
              ? "Published"
              : mode === "scheduled"
                ? "Scheduled"
                : mode === "archived"
                  ? "Archived"
                  : mode === "draft"
                    ? "Draft"
                    : mode
        };

      }


      function getContentMissingFields(item) {

        const missing = [];

        const blank =
          (value) =>
            value === null ||
            value === undefined ||
            String(value).trim() === "";


        if (
          item.contentSection === "events"
        ) {

          if (blank(item.start_date)) {
            missing.push("Date");
          }

          if (blank(item.event_type)) {
            missing.push("Event type");
          }

          if (blank(item.type_label)) {
            missing.push("Display label");
          }

          if (blank(item.description)) {
            missing.push("Description");
          }

          if (
            blank(item.venue) &&
            blank(item.city)
          ) {
            missing.push("Location");
          }

          if (!item.cover_media_id) {
            missing.push("Primary image");
          }

          const led =
            item.participation === "hosted" ||
            item.participation === "co-organized";

          if (
            led &&
            (
              item.registrations === null ||
              item.registrations === undefined
            )
          ) {
            missing.push("Registrations");
          }

          if (
            led &&
            ["hardware-meetup", "startup-mixer"].includes(
              item.community_id || ""
            ) &&
            !item.community_track_media_id
          ) {
            missing.push("Community image");
          }

          const isIndustryEvent =
            item.event_type === "trade-show" ||
            item.participation === "exhibitor" ||
            String(item.type_label || "")
              .toLowerCase()
              .includes("trade show");

          if (
            isIndustryEvent &&
            !item.industry_logo_media_id
          ) {
            missing.push("Industry event logo");
          }

        } else if (
          item.contentSection === "field-notes"
        ) {

          if (blank(item.category)) {
            missing.push("Category");
          }

          if (blank(item.excerpt)) {
            missing.push("Short description");
          }

          if (blank(item.content_markdown)) {
            missing.push("Article content");
          }

          if (!item.hero_media_id) {
            missing.push("Hero image");
          }

          if (
            item.reading_minutes === null ||
            item.reading_minutes === undefined ||
            Number(item.reading_minutes) <= 0
          ) {
            missing.push("Reading time");
          }

          if (
            item.status === "published" &&
            !item.published_at
          ) {
            missing.push("Publication date");
          }

        } else if (
          item.contentSection === "recaps"
        ) {

          if (!item.event_id) {
            missing.push("Linked event");
          }

          if (blank(item.excerpt)) {
            missing.push("Short description");
          }

          if (blank(item.content_markdown)) {
            missing.push("Recap content");
          }

          if (!item.hero_media_id) {
            missing.push("Hero image");
          }

          if (
            item.reading_minutes === null ||
            item.reading_minutes === undefined ||
            Number(item.reading_minutes) <= 0
          ) {
            missing.push("Reading time");
          }

          if (
            item.status === "published" &&
            !item.published_at
          ) {
            missing.push("Publication date");
          }

        }


        return missing;

      }


      function recentPaginationTokens(
        currentPage,
        totalPages
      ) {

        if (
          totalPages <= 7
        ) {
          return Array.from(
            {
              length:
                totalPages
            },
            (
              _,
              index
            ) =>
              index + 1
          );
        }


        const tokens = [
          1
        ];

        const start =
          Math.max(
            2,
            currentPage - 1
          );

        const end =
          Math.min(
            totalPages - 1,
            currentPage + 1
          );


        if (
          start > 2
        ) {
          tokens.push(
            "ellipsis-start"
          );
        }


        for (
          let page = start;
          page <= end;
          page += 1
        ) {
          tokens.push(
            page
          );
        }


        if (
          end <
          totalPages - 1
        ) {
          tokens.push(
            "ellipsis-end"
          );
        }


        tokens.push(
          totalPages
        );


        return tokens;

      }


      function renderRecentContent() {

        const allItems = [
          ...state.events.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Event",
              contentSection:
                "events"
            })
          ),

          ...state.fieldNotes.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Field Note",
              contentSection:
                "field-notes"
            })
          ),

          ...state.recaps.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Recap",
              contentSection:
                "recaps"
            })
          )
        ];


        const filteredItems =
          allItems
            .filter(
              (
                item
              ) => {

                const matchesType =
                  state.recentFilter === "all" ||
                  item.contentSection ===
                    state.recentFilter;


                if (
                  !matchesType
                ) {
                  return false;
                }


                const missingFields =
                  getContentMissingFields(
                    item
                  );

                const matchesCompleteness =
                  state.recentCompletenessFilter === "all" ||
                  (
                    state.recentCompletenessFilter === "missing" &&
                    missingFields.length > 0
                  ) ||
                  (
                    state.recentCompletenessFilter === "complete" &&
                    missingFields.length === 0
                  );


                if (
                  !matchesCompleteness
                ) {
                  return false;
                }


                const displayStatus =
                  getRecentContentDisplayStatus(
                    item
                  );

                const matchesStatus =
                  state.recentStatusFilter === "all" ||
                  displayStatus.mode ===
                    state.recentStatusFilter;


                return matchesStatus;

              }
            )
            .sort(
              (
                a,
                b
              ) =>
                new Date(
                  b.updated_at ||
                  b.created_at ||
                  0
                ).getTime() -
                new Date(
                  a.updated_at ||
                  a.created_at ||
                  0
                ).getTime()
            );


        const pageSize =
          state.recentPageSize ||
          25;

        const totalItems =
          filteredItems.length;

        const totalPages =
          Math.max(
            1,
            Math.ceil(
              totalItems /
              pageSize
            )
          );


        state.recentPage =
          Math.min(
            Math.max(
              1,
              state.recentPage ||
              1
            ),
            totalPages
          );


        const pageStart =
          (
            state.recentPage -
            1
          ) *
          pageSize;

        const pageEnd =
          Math.min(
            pageStart +
            pageSize,
            totalItems
          );

        const items =
          filteredItems.slice(
            pageStart,
            pageEnd
          );


        const container =
          $("#recent-content-list");

        const pagination =
          $("#recent-content-pagination");

        const pageSummary =
          $("#recent-content-page-summary");

        const pageButtons =
          $("#recent-content-page-buttons");


        if (
          items.length === 0
        ) {

          container.innerHTML =
            `
              <div class="empty-state">
                <strong>No matching recent content</strong>
                Try another filter or create a new item.
              </div>
            `;

          pagination?.classList.add(
            "hidden"
          );

          return;
        }


        container.innerHTML =
          items
            .map(
              (
                item
              ) => {
                const itemDate =
                  item.updated_at ||
                  item.created_at;

                const dateLabel =
                  itemDate
                    ? formatDate(
                        itemDate
                      )
                    : "";

                const displayStatus =
                  getRecentContentDisplayStatus(
                    item
                  );

                const missingFields =
                  getContentMissingFields(
                    item
                  );

                const missingAlert =
                  missingFields.length
                    ? `
                        <div
                          class="content-completeness-alert"
                          title="This is a soft content-quality reminder. It does not block publishing."
                        >
                          <span>
                            <strong>Missing information:</strong>
                            ${escapeHtml(missingFields.join(", "))}
                          </span>
                        </div>
                      `
                    : "";

                return `
                  <div class="content-row recent-content-row">
                    <div class="recent-content-main">
                      <div class="recent-content-topline">
                        <span class="content-type-pill">
                          ${escapeHtml(item.contentType)}
                        </span>

                        ${
                          dateLabel
                            ? `<span class="recent-content-date">${escapeHtml(dateLabel)}</span>`
                            : ""
                        }
                      </div>

                      <h3 class="row-title">
                        ${escapeHtml(item.title || item.file_name || "Untitled")}
                      </h3>

                      <div class="row-meta">
                        <span class="status-pill ${escapeHtml(displayStatus.mode)}">
                          ${escapeHtml(displayStatus.label)}
                        </span>
                      </div>

                      ${missingAlert}
                    </div>

                    <div class="row-actions">
                      <button
                        class="secondary-button recent-edit-button"
                        type="button"
                        data-recent-edit-section="${escapeHtml(item.contentSection)}"
                        data-recent-edit-id="${escapeHtml(item.id)}"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                `;
              }
            )
            .join(
              ""
            );


        if (
          pagination &&
          pageSummary &&
          pageButtons
        ) {

          pagination.classList.remove(
            "hidden"
          );

          pageSummary.textContent =
            totalItems === 1
              ? "Showing 1 of 1 item"
              : `Showing ${pageStart + 1}–${pageEnd} of ${totalItems} items · Page ${state.recentPage} of ${totalPages}`;


          const tokens =
            recentPaginationTokens(
              state.recentPage,
              totalPages
            );


          pageButtons.innerHTML =
            `
              <button
                class="recent-page-button"
                type="button"
                data-recent-page="${state.recentPage - 1}"
                ${state.recentPage <= 1 ? "disabled" : ""}
              >
                Previous
              </button>

              ${
                tokens
                  .map(
                    (
                      token
                    ) =>
                      typeof token === "number"
                        ? `
                            <button
                              class="recent-page-button ${token === state.recentPage ? "active" : ""}"
                              type="button"
                              data-recent-page="${token}"
                              aria-label="Go to recent content page ${token}"
                              ${token === state.recentPage ? 'aria-current="page"' : ""}
                            >
                              ${token}
                            </button>
                          `
                        : `
                            <span class="recent-page-ellipsis" aria-hidden="true">
                              …
                            </span>
                          `
                  )
                  .join("")
              }

              <button
                class="recent-page-button"
                type="button"
                data-recent-page="${state.recentPage + 1}"
                ${state.recentPage >= totalPages ? "disabled" : ""}
              >
                Next
              </button>
            `;

        }

      }


      /* =====================================================
         EVENTS
         ===================================================== */

      function getFilteredEvents() {

        const search =
          $("#events-search")
            .value
            .trim()
            .toLowerCase();


        return state.events.filter(
          (
            event
          ) => {

            const matchesSearch =
              !search ||
              [
                event.title,
                event.city,
                event.venue,
                event.description
              ]
                .filter(
                  Boolean
                )
                .some(
                  (
                    value
                  ) =>
                    String(
                      value
                    )
                      .toLowerCase()
                      .includes(
                        search
                      )
                );


            if (
              !matchesSearch
            ) {
              return false;
            }


            if (
              state.eventFilter ===
                "all"
            ) {
              return true;
            }


            if (
              state.eventFilter ===
                "draft" ||
              state.eventFilter ===
                "archived"
            ) {

              return event.status ===
                state.eventFilter;

            }


            if (
              event.status ===
                "archived"
            ) {
              return false;
            }


            return getEventTimeState(
              event
            ) ===
              state.eventFilter;

          }
        );

      }


      function renderEvents() {

        const container =
          $("#events-list");

        const events =
          getFilteredEvents();


        if (
          events.length === 0
        ) {

          container.innerHTML =
            `
              <div class="empty-state">
                <strong>No events found</strong>
                Add an event or change the current filter.
              </div>
            `;

          return;
        }


        container.innerHTML =
          events
            .map(
              (
                event
              ) => {

                const timeState =
                  getEventTimeState(
                    event
                  );


                return `
                  <div class="content-row">
                    <div>
                      <h3 class="row-title">
                        ${escapeHtml(event.title)}
                      </h3>

                      <div class="row-meta">
                        <span>${escapeHtml(formatDate(event.start_date))}</span>
                        ${event.city ? `<span>•</span><span>${escapeHtml(event.city)}</span>` : ""}
                        <span>•</span>
                        <span>${escapeHtml(timeState)}</span>
                        <span class="status-pill ${escapeHtml(event.status)}">
                          ${escapeHtml(event.status)}
                        </span>
                      </div>
                    </div>

                    <div class="row-actions">
                      <button
                        class="secondary-button"
                        type="button"
                        data-edit-event="${escapeHtml(event.id)}"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                `;

              }
            )
            .join(
              ""
            );

      }


      function isLedParticipation(
        participation = $("#event-participation")?.value || ""
      ) {
        return participation === "hosted" || participation === "co-organized";
      }


      function isHardwareMeetupEvent() {
        return (
          isLedParticipation() &&
          $("#event-community")?.value === "hardware-meetup"
        );
      }


      function isCommunityLogoEvent() {
        return (
          isLedParticipation() &&
          ["hardware-meetup", "startup-mixer"].includes(
            $("#event-community")?.value || ""
          )
        );
      }


      function isTradeShowEventContext() {
        const eventType =
          ($("#event-type")?.value || "").toLowerCase();
        const typeLabel =
          ($("#event-type-label")?.value || "").trim().toLowerCase();
        const participation =
          $("#event-participation")?.value || "";

        return (
          participation === "exhibitor" ||
          ["trade-show", "tradeshow", "expo", "conference", "convention"].includes(eventType) ||
          eventType.includes("trade") ||
          eventType.includes("expo") ||
          typeLabel.includes("trade show") ||
          typeLabel.includes("exhibitor")
        );
      }


      function syncEventConditionalFields() {
        const led = isLedParticipation();
        const hardware = isHardwareMeetupEvent();
        const communityLogoEvent = isCommunityLogoEvent();
        const industry = isTradeShowEventContext();

        $("#event-registrations-field")?.classList.toggle("hidden", !led);
        $("#hosted-event-section")?.classList.toggle("hidden", !led);
        $("#hardware-community-image-field")?.classList.toggle("hidden", !communityLogoEvent);
        $("#industry-event-logo-field")?.classList.toggle("hidden", !industry);

        const eventTypeField = $("#event-type");
        const communityValue = $("#event-community")?.value || "";

        if (eventTypeField && !eventTypeField.value) {
          if (communityValue === "hardware-meetup") {
            eventTypeField.value = "meetup";
          } else if (communityValue === "startup-mixer") {
            eventTypeField.value = "mixer";
          }
        }

        const typeLabel = $("#event-type-label");
        if (typeLabel && !typeLabel.value) {
          const eventType = ($("#event-type")?.value || "").toLowerCase();

          if ($("#event-participation")?.value === "hosted") {
            typeLabel.value =
              $("#event-community")?.value
                ? "Hosted Community Event"
                : "Hosted Event";
          } else if ($("#event-participation")?.value === "co-organized") {
            typeLabel.value =
              $("#event-community")?.value === "hardware-meetup"
                ? "Co-Organized Hardware Event"
                : "Co-Organized Event";
          } else if ($("#event-participation")?.value === "exhibitor") {
            typeLabel.value = "Exhibitor";
          } else if ($("#event-participation")?.value === "attending") {
            typeLabel.value =
              eventType === "trade-show"
                ? "Attending Trade Show"
                : "Attending Event";
          }
        }
      }


      function showEventImportStatus(message = "", type = "") {
        const box = $("#event-import-status");
        if (!box) return;

        if (!message) {
          box.textContent = "";
          box.className = "import-status hidden";
          return;
        }

        box.textContent = message;
        box.className = `import-status ${type}`.trim();
      }


      function applyImportedField(selector, value) {
        const field = $(selector);
        if (!field || value === undefined || value === null || value === "") {
          return;
        }

        field.value = String(value);
      }


      function normalizeEventType(value = "") {
        const normalized = String(value)
          .trim()
          .toLowerCase()
          .replace(/[_\s]+/g, "-");

        const aliases = {
          "meet-up": "meetup",
          "meetup": "meetup",
          "community-event": "meetup",
          "mixer": "mixer",
          "networking-event": "mixer",
          "networking": "mixer",
          "trade-show": "trade-show",
          "tradeshow": "trade-show",
          "expo": "trade-show",
          "exhibition": "trade-show",
          "industry-event": "trade-show",
          "conference": "conference",
          "convention": "conference",
          "summit": "conference",
          "professional-event": "conference",
          "workshop": "workshop",
          "panel": "workshop",
          "demo-day": "demo-day",
          "pitch-event": "demo-day",
          "other": "other"
        };

        return aliases[normalized] || "";
      }


      function inferEventContext(imported = {}) {
        const title = String(imported.title || "").toLowerCase();
        const url = String($("#event-url")?.value || "").toLowerCase();

        if (
          title.includes("san diego hardware meetup") ||
          title.includes("sd hardware meetup")
        ) {
          $("#event-community").value = "hardware-meetup";
          $("#event-participation").value = "co-organized";

          if (!$("#event-type").value) {
            $("#event-type").value = "meetup";
          }
        } else if (
          title.includes("san diego county startup mixer") &&
          !title.includes("north county")
        ) {
          $("#event-community").value = "startup-mixer";
          $("#event-participation").value = "hosted";

          if (!$("#event-type").value) {
            $("#event-type").value = "mixer";
          }
        }

        if (!$("#event-button-label").value.trim()) {
          $("#event-button-label").value =
            imported.eventType === "trade-show"
              ? "View Show"
              : "View Event";
        }

        if (
          url.includes("ces.tech") ||
          title.includes("ces ")
        ) {
          if (!$("#event-type").value.trim()) {
            $("#event-type").value = "trade-show";
          }
        }

        syncEventConditionalFields();
      }


      async function importEventFromUrl() {
        const url = $("#event-url").value.trim();
        const button = $("#import-event-url-button");

        if (!url) {
          showEventImportStatus("Add the event URL first.", "error");
          return;
        }

        setButtonLoading(
          button,
          true,
          "Importing...",
          "Import details"
        );

        showEventImportStatus(
          "Reading the public event page and extracting available details..."
        );

        try {
          const {
            data,
            error
          } = await supabase.functions.invoke(
            "import-event",
            {
              body: {
                url
              }
            }
          );

          if (error) {
            let message =
              error.message ||
              "Could not import this event.";

            try {
              const context =
                error.context;

              if (context?.json) {
                const details =
                  await context.json();

                message =
                  details?.error ||
                  message;
              }
            } catch {
              // Keep the original function error message.
            }

            throw new Error(message);
          }

          if (data?.error) {
            throw new Error(data.error);
          }

          const imported = data?.event || {};

          applyImportedField("#event-title", imported.title);
          applyImportedField("#event-start-date", imported.startDate);
          applyImportedField("#event-end-date", imported.endDate);
          applyImportedField("#event-description", imported.description);
          applyImportedField("#event-venue", imported.venue);
          applyImportedField("#event-city", imported.city);
          applyImportedField("#event-region", imported.region);
          applyImportedField("#event-country", imported.country);
          applyImportedField("#event-address", imported.address);

          const normalizedImportedEventType =
            normalizeEventType(imported.eventType);

          if (normalizedImportedEventType) {
            $("#event-type").value =
              normalizedImportedEventType;
          }

          if (
            imported.registrations !== undefined &&
            imported.registrations !== null
          ) {
            $("#event-registrations").value =
              String(imported.registrations);
          }

          if (
            Array.isArray(imported.organizers) &&
            imported.organizers.length
          ) {
            $("#event-organizers").value =
              imported.organizers.join("\n");
          }

          if (
            Array.isArray(imported.speakers) &&
            imported.speakers.length
          ) {
            $("#event-speaker-list").innerHTML = "";

            imported.speakers.forEach(
              (speaker) =>
                addEventSpeakerEntry(
                  {
                    name: speaker.name || "",
                    title: speaker.title || "",
                    company: speaker.company || "",
                    company_url: speaker.companyUrl || ""
                  }
                )
            );
          }

          if (
            Array.isArray(imported.sponsors) &&
            imported.sponsors.length
          ) {
            $("#event-sponsor-list").innerHTML = "";

            imported.sponsors.forEach(
              (sponsor) =>
                addEventSponsorEntry(
                  {
                    name:
                      typeof sponsor === "string"
                        ? sponsor
                        : sponsor.name || "",
                    website_url:
                      typeof sponsor === "string"
                        ? ""
                        : sponsor.url || ""
                  }
                )
            );
          }

          inferEventContext(imported);
          ensureRepeaterEmptyStates();

          const importedPieces = [
            imported.title ? "title" : "",
            imported.startDate ? "date" : "",
            imported.venue || imported.city ? "location" : "",
            imported.description ? "description" : "",
            imported.speakers?.length
              ? `${imported.speakers.length} speaker${imported.speakers.length === 1 ? "" : "s"}`
              : "",
            imported.sponsors?.length
              ? `${imported.sponsors.length} sponsor${imported.sponsors.length === 1 ? "" : "s"}`
              : ""
          ].filter(Boolean);

          showEventImportStatus(
            importedPieces.length
              ? `Imported ${importedPieces.join(", ")}. Review the fields below, add your CMS images/logos, then save the event.`
              : "The page was reachable, but it did not expose much structured event data. You can still complete the event manually.",
            "success"
          );

        } catch (error) {
          console.error(error);

          showEventImportStatus(
            error?.message ||
            "Could not import this event URL.",
            "error"
          );

        } finally {
          setButtonLoading(
            button,
            false,
            "Importing...",
            "Import details"
          );
        }
      }


