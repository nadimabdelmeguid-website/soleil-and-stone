      function downloadJson(filename,payload) {
        const blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
        const url=URL.createObjectURL(blob);
        const a=document.createElement("a");
        a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();
        window.setTimeout(()=>URL.revokeObjectURL(url),1000);
      }


      function ventureExportPayload(venture) {
        return {
          exported_at:new Date().toISOString(),
          venture,
          public_overview:publicOverviewForVenture(venture.id),
          tasks:state.ventureTasks.filter((item)=>String(item.venture_id)===String(venture.id)),
          milestones:state.ventureMilestones.filter((item)=>String(item.venture_id)===String(venture.id)),
          workspace_items:state.ventureWorkspaceItems.filter((item)=>String(item.venture_id)===String(venture.id)),
          private_file_manifest:state.ventureAttachments.filter((item)=>String(item.venture_id)===String(venture.id)),
          activity:state.ventureActivity.filter((item)=>String(item.venture_id)===String(venture.id))
        };
      }


      function exportVenture(venture=currentVenture()) {
        if(!venture)return;
        downloadJson(`${slugify(venture.name)}-venture-backup-${localDateKey()}.json`,ventureExportPayload(venture));
      }


      function exportVenturePortfolio() {
        downloadJson(`venture-portfolio-backup-${localDateKey()}.json`,{
          exported_at:new Date().toISOString(),
          ventures:state.ventures.map(ventureExportPayload)
        });
