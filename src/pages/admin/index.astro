      function formatDate(
        value
      ) {

        if (
          !value
        ) {
          return "No date";
        }


        const date =
          new Date(
            `${value}T12:00:00`
          );


        return date.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric",

            year:
              "numeric"
          }
        );

      }


      function toLocalDateTimeInput(
        value
      ) {

        if (
          !value
        ) {
          return "";
        }


        const date =
          new Date(
            value
          );


        const offset =
          date.getTimezoneOffset();


        const local =
          new Date(
            date.getTime() -
            offset *
              60_000
          );


        return local
          .toISOString()
          .slice(
            0,
            16
          );

      }


      function fieldNotePublishingMode(item) {
        if (!item) return "draft";

        if (item.status === "published" && item.published_at) {
          const publishTime = new Date(item.published_at).getTime();

          if (Number.isFinite(publishTime) && publishTime > Date.now()) {
            return "scheduled";
          }
        }

        return item.status || "draft";
      }


      function fieldNoteDisplayStatus(item) {
        const mode = fieldNotePublishingMode(item);

        return {
          mode,
          label:
            mode === "scheduled"
              ? "Scheduled"
              : mode === "published"
                ? "Published"
                : mode === "archived"
                  ? "Archived"
                  : "Draft"
        };
      }


      function updateFieldNotePublishingUI() {
        const mode = $("#field-note-status")?.value || "draft";
        const dateField = $("#field-note-publish-date-field");
        const dateInput = $("#field-note-published-at");
        const help = $("#field-note-publishing-help");

        if (!dateField || !dateInput || !help) return;

        dateField.classList.toggle("hidden", mode !== "scheduled");
        dateInput.required = mode === "scheduled";

        if (mode === "scheduled") {
          dateInput.min = toLocalDateTimeInput(
            new Date(Date.now() + 60_000).toISOString()
          );
          help.textContent =
            "Choose a future date and time. The note will remain private until then and publish automatically.";
        } else if (mode === "published") {
          dateInput.min = "";
          help.textContent =
            "The note will become public immediately when you save it.";
        } else if (mode === "archived") {
          dateInput.min = "";
          help.textContent =
            "Archived notes remain in the CMS but are not public.";
        } else {
          dateInput.min = "";
          help.textContent =
            "Drafts stay private until you choose to publish or schedule them.";
        }
      }



