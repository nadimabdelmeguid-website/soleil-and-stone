                    id="field-note-content"
                    class="textarea"
                    style="min-height: 360px;"
                    placeholder="Write your Field Note here..."
                  ></textarea>
                  <p class="field-help">
                    Content is stored as Markdown. Select an existing Media Library image above when you want to insert one manually at your cursor.
                  </p>
                </div>

                <div class="form-field full">
                  <label class="label">
                    Article pictures
                  </label>
                  <p class="field-help" style="margin-bottom: 10px;">
                    Click inside the article where you want the next picture, then upload it below. After each upload, another picture button appears automatically.
                  </p>
                  <div
                    id="field-note-picture-list"
                    class="article-picture-list"
                  ></div>
                  <input
                    id="field-note-picture-upload"
                    class="hidden"
                    type="file"
                    accept="image/png,image/jpeg,image/webp,image/svg+xml,image/avif"
                  />
                </div>

                <div id="field-note-publish-date-field" class="form-field hidden">
                  <label class="label" for="field-note-published-at">
                    Scheduled publication date & time
                  </label>
                  <input
                    id="field-note-published-at"
                    class="input"
                    type="datetime-local"
                  />
                  <p class="field-help">
                    The note stays private until this exact date and time, then becomes public automatically.
                  </p>
                </div>

                <div class="form-field">
                  <label class="label" for="field-note-hero-media">
                    Hero image
                  </label>
                  <select
                    id="field-note-hero-media"
                    class="select"
                  >
                    <option value="">
