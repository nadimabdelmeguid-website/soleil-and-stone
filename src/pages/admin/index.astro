---
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ??
  "https://szdhkttphzvtmljuhcqs.supabase.co";

const supabasePublishableKey =
  import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ??
  "sb_publishable_iN7aDql5whleXHRCRVNS-w_Awl-iQez";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <meta
      name="theme-color"
      content="#22252A"
    />

    <title>
      Soleil & Stone | Admin
    </title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --cream: #f4f1e8;
        --card: #ffffff;
        --charcoal: #22252a;
        --slate: #4a505a;
        --gold: #c5a059;
        --gold-light: #e5c98b;
        --border: #ddd8cb;
        --danger: #a94b4b;
        --success: #477a5a;
        --shadow: 0 18px 60px rgba(34, 37, 42, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--cream);
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--cream);
        color: var(--charcoal);
        font-family: "Plus Jakarta Sans", Inter, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        cursor: pointer;
      }

      [hidden],
      .hidden {
        display: none !important;
      }

      .serif {
        font-family: "Cinzel", Georgia, serif;
      }


      .mydash-add { display:grid; grid-template-columns:minmax(0,2fr) 1fr 1fr auto; gap:10px; align-items:end; }
      .mydash-task { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:12px; align-items:center; padding:14px 16px; background:white; border:1px solid var(--border); }
      .mydash-check { width:44px; height:44px; border:1px solid var(--border); background:white; font-size:18px; }
      .mydash-actions { display:flex; gap:6px; }
      .mydash-section { margin-top:24px; }
      .mydash-section-title { font-family:"Cinzel",Georgia,serif; font-size:18px; font-weight:400; margin:0 0 10px; }
      .mydash-task-title { font-weight:600; font-size:14px; }
      .mydash-task-meta { color:var(--slate); font-size:11px; margin-top:4px; }
      .mydash-done .mydash-task-title { text-decoration:line-through; opacity:.55; }
      @media (max-width: 720px) {
        .mydash-add { grid-template-columns:1fr 1fr; }
        .mydash-add .mydash-title-field { grid-column:1/-1; }
        .mydash-add button { min-height:48px; }
        .mydash-task { grid-template-columns:auto minmax(0,1fr); padding:12px; }
        .mydash-actions { grid-column:2; }
        .mydash-actions button { min-height:42px; }
      }


      /* =====================================================
         MULTI-VENTURE ADMIN SHELL
         ===================================================== */

      .admin-shell.portfolio-mode {
        grid-template-columns: minmax(0, 1fr);
      }

      .admin-shell.portfolio-mode .sidebar {
        display: none;
      }

      .admin-shell.portfolio-mode .main-inner {
        width: min(100%, 1320px);
      }

      .portfolio-top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .portfolio-top-actions a {
        text-decoration: none;
      }

      .sidebar-back {
        width: 100%;
        min-height: 40px;
        margin-top: 22px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: transparent;
        color: rgba(255, 255, 255, 0.72);
        padding: 0 12px;
        text-align: left;
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .sidebar-back:hover {
        color: white;
        border-color: rgba(255, 255, 255, 0.28);
      }

      .sidebar-group-label {
        padding: 18px 12px 7px;
        color: rgba(255, 255, 255, 0.34);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .venture-context-hero {
        margin-bottom: 20px;
        padding: 22px;
        border: 1px solid var(--border);
        background:
          linear-gradient(135deg, rgba(197, 160, 89, 0.10), transparent 44%),
          white;
      }

      .venture-context-hero-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
      }

      .venture-context-name {
        margin: 5px 0 7px;
        font-family: "Cinzel", Georgia, serif;
        font-size: 26px;
        font-weight: 400;
      }

      .venture-context-description {
        max-width: 760px;
        margin: 0;
        color: var(--slate);
        font-size: 12px;
        line-height: 1.7;
      }

      .venture-context-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin: 18px 0 24px;
      }

      .venture-context-stat {
        min-width: 0;
        border: 1px solid var(--border);
        background: white;
        padding: 17px;
      }

      .venture-context-stat strong {
        display: block;
        font-family: "Cinzel", Georgia, serif;
        font-size: 25px;
        font-weight: 400;
        color: var(--gold);
      }

      .venture-context-stat span {
        display: block;
        margin-top: 5px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .venture-module-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .venture-module-card {
        min-width: 0;
        min-height: 150px;
        border: 1px solid var(--border);
        background: white;
        padding: 17px;
        display: flex;
        flex-direction: column;
        text-align: left;
        color: var(--charcoal);
        transition: border-color 150ms ease, transform 150ms ease;
      }

      button.venture-module-card {
        cursor: pointer;
      }

      .venture-module-card:hover {
        border-color: var(--gold);
        transform: translateY(-1px);
      }

      .venture-module-count {
        margin-top: auto;
        padding-top: 18px;
        color: var(--gold);
        font-family: "Cinzel", Georgia, serif;
        font-size: 24px;
      }

      .venture-module-title {
        margin: 6px 0 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 16px;
        font-weight: 400;
      }

      .venture-module-copy {
        margin: 6px 0 0;
        color: var(--slate);
        font-size: 10px;
        line-height: 1.55;
      }

      .venture-workspace-item-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .venture-workspace-item {
        border: 1px solid var(--border);
        background: white;
        padding: 17px;
        min-width: 0;
      }

      .venture-workspace-item-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
      }

      .venture-workspace-item-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 16px;
        font-weight: 400;
      }

      .venture-workspace-item-summary {
        margin: 10px 0 0;
        color: var(--slate);
        font-size: 11px;
        line-height: 1.6;
      }

      .venture-workspace-item-notes {
        margin: 10px 0 0;
        padding-top: 10px;
        border-top: 1px solid var(--border);
        color: var(--slate);
        font-size: 10px;
        line-height: 1.6;
      }

      .venture-context-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .venture-context-task-list,
      .venture-context-milestone-list {
        display: grid;
        gap: 8px;
      }

      .portfolio-venture-card {
        cursor: pointer;
      }

      @media (max-width: 900px) {
        .venture-context-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .venture-module-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .admin-shell.portfolio-mode .mobile-menu-button {
          display: none !important;
        }
      }

      @media (max-width: 640px) {
        .portfolio-top-actions {
          width: 100%;
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .venture-context-hero-head {
          flex-direction: column;
        }

        .venture-context-grid,
        .venture-module-grid,
        .venture-workspace-item-grid {
          grid-template-columns: 1fr;
        }

        .venture-context-actions {
          width: 100%;
        }

        .venture-context-actions > * {
          flex: 1;
        }
      }


      /* =====================================================
         VENTURES COMMAND CENTER
         ===================================================== */

      .ventures-hero {
        margin-bottom: 20px;
        padding: 22px;
        border: 1px solid var(--border);
        background:
          linear-gradient(135deg, rgba(197, 160, 89, 0.10), transparent 42%),
          white;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
      }

      .ventures-hero-copy {
        max-width: 720px;
      }

      .ventures-hero-title {
        margin: 4px 0 8px;
        font-family: "Cinzel", Georgia, serif;
        font-size: 25px;
        font-weight: 400;
      }

      .ventures-hero-text {
        margin: 0;
        color: var(--slate);
        font-size: 12px;
        line-height: 1.7;
        font-weight: 300;
      }

      .ventures-private-badge {
        display: inline-flex;
        min-height: 24px;
        align-items: center;
        padding: 0 8px;
        border: 1px solid rgba(197, 160, 89, 0.45);
        background: rgba(197, 160, 89, 0.08);
        color: #80652f;
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .venture-controls {
        margin-bottom: 16px;
        display: grid;
        grid-template-columns: minmax(220px, 1fr) auto;
        gap: 12px;
        align-items: center;
      }

      .venture-control-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
      }

      .venture-stage-filters {
        margin-bottom: 18px;
        display: flex;
        gap: 7px;
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 2px;
      }

      .venture-stage-filters::-webkit-scrollbar {
        display: none;
      }

      .venture-stage-button {
        min-height: 36px;
        flex: 0 0 auto;
        border: 1px solid var(--border);
        background: white;
        padding: 0 12px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .venture-stage-button.active {
        border-color: var(--charcoal);
        background: var(--charcoal);
        color: white;
      }

      .venture-focus-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin: 18px 0 26px;
      }

      .venture-focus-panel {
        min-width: 0;
        border: 1px solid var(--border);
        background: white;
      }

      .venture-focus-panel .panel-header {
        min-height: 72px;
      }

      .venture-focus-list {
        max-height: 360px;
        overflow-y: auto;
      }

      .venture-focus-row {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 11px;
      }

      .venture-focus-row:last-child {
        border-bottom: 0;
      }

      .venture-check {
        width: 36px;
        height: 36px;
        border: 1px solid var(--border);
        background: white;
        display: inline-grid;
        place-items: center;
        color: var(--slate);
        font-size: 15px;
      }

      .venture-check:hover {
        border-color: var(--gold);
        color: var(--gold);
      }

      .venture-focus-title {
        margin: 0;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.45;
      }

      .venture-focus-meta {
        margin-top: 4px;
        color: var(--slate);
        font-size: 9px;
        line-height: 1.5;
      }

      .venture-section-heading {
        margin: 28px 0 12px;
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
      }

      .venture-section-heading h2 {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 20px;
        font-weight: 400;
      }

      .venture-result-count {
        color: var(--slate);
        font-size: 10px;
      }

      .venture-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .venture-card {
        min-width: 0;
        border: 1px solid var(--border);
        background: white;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
      }

      .venture-card:hover {
        transform: translateY(-1px);
        border-color: #c8c0ae;
        box-shadow: 0 10px 30px rgba(34, 37, 42, 0.06);
      }

      .venture-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
      }

      .venture-card-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 19px;
        font-weight: 400;
        line-height: 1.35;
      }

      .venture-card-tagline {
        margin: 7px 0 0;
        color: var(--slate);
        font-size: 11px;
        line-height: 1.55;
      }

      .venture-meta-line {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        align-items: center;
        color: var(--slate);
        font-size: 9px;
      }

      .venture-focus-card {
        padding: 12px 13px;
        border-left: 2px solid var(--gold);
        background: var(--cream);
      }

      .venture-focus-label {
        color: var(--gold);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .venture-focus-copy {
        margin: 5px 0 0;
        color: var(--charcoal);
        font-size: 11px;
        line-height: 1.5;
      }

      .venture-progress-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
      }

      .venture-progress-track {
        height: 6px;
        background: #ece8df;
        overflow: hidden;
      }

      .venture-progress-fill {
        height: 100%;
        background: var(--gold);
      }

      .venture-progress-label {
        color: var(--slate);
        font-size: 9px;
        white-space: nowrap;
      }

      .venture-card-actions {
        margin-top: auto;
        padding-top: 2px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .venture-card-actions > * {
        min-height: 40px;
      }

      .status-pill.idea {
        border-color: rgba(197, 160, 89, 0.30);
        background: rgba(197, 160, 89, 0.08);
        color: #80652f;
      }

      .status-pill.validation {
        border-color: rgba(58, 92, 132, 0.28);
        background: rgba(58, 92, 132, 0.07);
        color: #3a5c84;
      }

      .status-pill.building {
        border-color: rgba(116, 83, 151, 0.26);
        background: rgba(116, 83, 151, 0.07);
        color: #684788;
      }

      .status-pill.pilot {
        border-color: rgba(180, 105, 54, 0.28);
        background: rgba(180, 105, 54, 0.07);
        color: #9a5e35;
      }

      .status-pill.paused {
        opacity: 0.72;
        background: var(--cream);
      }

      .venture-modal {
        width: min(100%, 1120px);
      }

      .venture-modal-header-meta {
        margin-top: 5px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }

      .venture-tabs {
        position: sticky;
        top: 70px;
        z-index: 3;
        display: flex;
        gap: 0;
        overflow-x: auto;
        border-bottom: 1px solid var(--border);
        background: white;
        scrollbar-width: none;
      }

      .venture-tabs::-webkit-scrollbar {
        display: none;
      }

      .venture-tab {
        min-height: 48px;
        flex: 0 0 auto;
        border: 0;
        border-right: 1px solid var(--border);
        border-bottom: 2px solid transparent;
        background: white;
        padding: 0 18px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .venture-tab.active {
        border-bottom-color: var(--gold);
        color: var(--charcoal);
        background: rgba(197, 160, 89, 0.05);
      }

      .venture-tab:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .venture-tab-panel {
        padding-top: 4px;
      }

      .venture-overview-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.8fr);
        gap: 14px;
      }

      .venture-summary-card {
        border: 1px solid var(--border);
        background: white;
        padding: 16px;
      }

      .venture-summary-number {
        display: block;
        margin-top: 5px;
        font-family: "Cinzel", Georgia, serif;
        font-size: 25px;
        color: var(--gold);
      }

      .venture-task-row {
        padding: 13px 14px;
        border: 1px solid var(--border);
        background: white;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
      }

      .venture-task-row + .venture-task-row {
        margin-top: 8px;
      }

      .venture-task-row.is-done {
        opacity: 0.68;
      }

      .venture-task-row.is-overdue {
        border-left: 3px solid var(--danger);
      }

      .venture-task-row-title {
        margin: 0;
        font-size: 11px;
        font-weight: 600;
      }

      .venture-task-row.is-done .venture-task-row-title {
        text-decoration: line-through;
      }

      .venture-task-row-meta {
        margin-top: 5px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        color: var(--slate);
        font-size: 9px;
      }

      .venture-task-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 6px;
      }

      .venture-priority-high {
        color: var(--danger);
        font-weight: 600;
      }

      .venture-milestone-card {
        padding: 14px 16px;
        border: 1px solid var(--border);
        background: white;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
      }

      .venture-milestone-card + .venture-milestone-card {
        margin-top: 8px;
      }

      .venture-milestone-card.completed {
        opacity: 0.65;
      }

      .venture-milestone-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 14px;
        font-weight: 400;
      }

      .venture-inline-editor {
        margin-top: 14px;
        border: 1px solid rgba(197, 160, 89, 0.55);
        background: rgba(197, 160, 89, 0.035);
      }

      .venture-readiness {
        min-height: 46px;
        padding: 11px 12px;
        border: 1px solid var(--border);
        background: var(--cream);
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--slate);
        font-size: 10px;
        line-height: 1.45;
      }

      .venture-readiness input {
        width: 18px;
        height: 18px;
      }

      @media (max-width: 1040px) {
        .venture-focus-grid {
          grid-template-columns: 1fr;
        }

        .venture-focus-list {
          max-height: 280px;
        }
      }

      @media (max-width: 780px) {
        .ventures-hero {
          flex-direction: column;
        }

        .venture-controls {
          grid-template-columns: 1fr;
        }

        .venture-control-right {
          justify-content: stretch;
        }

        .venture-control-right .select {
          width: 100%;
        }

        .venture-grid {
          grid-template-columns: 1fr;
        }

        .venture-overview-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .ventures-hero {
          padding: 17px;
        }

        .ventures-hero-actions {
          width: 100%;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 8px;
        }

        .ventures-hero-actions button {
          min-height: 46px;
        }

        .venture-card {
          padding: 15px;
        }

        .venture-card-actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .venture-card-actions button {
          width: 100%;
        }

        .venture-card-actions .primary-button {
          grid-column: 1 / -1;
        }

        .venture-tabs {
          top: 69px;
        }

        .venture-tab {
          min-height: 50px;
          padding: 0 14px;
        }

        .venture-task-row {
          grid-template-columns: auto minmax(0, 1fr);
        }

        .venture-task-actions {
          grid-column: 2;
          justify-content: flex-start;
        }

        .venture-milestone-card {
          grid-template-columns: 1fr;
        }
      }

      /* =====================================================
         AUTH
         ===================================================== */

      .auth-screen {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px;
        background:
          radial-gradient(
            circle at top left,
            rgba(197, 160, 89, 0.14),
            transparent 34%
          ),
          var(--cream);
      }

      .auth-card {
        width: min(100%, 460px);
        background: white;
        border: 1px solid var(--border);
        padding: 38px;
        box-shadow: var(--shadow);
      }

      .auth-logo-link {
        display: inline-flex;
        align-items: center;
        margin-bottom: 26px;
        text-decoration: none;
      }

      .auth-logo {
        display: block;
        width: 88px;
        height: auto;
        object-fit: contain;
      }

      .eyebrow {
        margin: 0 0 8px;
        color: var(--gold);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .auth-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: clamp(28px, 5vw, 38px);
        font-weight: 400;
        line-height: 1.2;
      }

      .auth-copy {
        margin: 16px 0 26px;
        color: var(--slate);
        font-size: 14px;
        line-height: 1.7;
        font-weight: 300;
      }

      .label {
        display: block;
        margin-bottom: 8px;
        color: var(--charcoal);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .input,
      .select,
      .textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 0;
        background: white;
        color: var(--charcoal);
        outline: none;
        transition:
          border-color 160ms ease,
          box-shadow 160ms ease;
      }

      .input,
      .select {
        min-height: 46px;
        padding: 0 13px;
      }

      .textarea {
        min-height: 120px;
        padding: 13px;
        resize: vertical;
        line-height: 1.6;
      }

      .input:focus,
      .select:focus,
      .textarea:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.12);
      }

      .primary-button,
      .secondary-button,
      .quiet-button,
      .danger-button {
        min-height: 44px;
        border-radius: 0;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition:
          background 160ms ease,
          color 160ms ease,
          border-color 160ms ease,
          opacity 160ms ease;
      }

      .primary-button {
        border: 1px solid var(--charcoal);
        background: var(--charcoal);
        color: white;
      }

      .primary-button:hover {
        border-color: var(--gold);
        background: var(--gold);
      }

      .secondary-button {
        border: 1px solid var(--border);
        background: white;
        color: var(--charcoal);
      }

      .secondary-button:hover {
        border-color: var(--gold);
        color: var(--gold);
      }

      .quiet-button {
        border: 0;
        background: transparent;
        color: var(--slate);
        padding-inline: 8px;
      }

      .quiet-button:hover {
        color: var(--gold);
      }

      .danger-button {
        border: 1px solid rgba(169, 75, 75, 0.3);
        background: rgba(169, 75, 75, 0.06);
        color: var(--danger);
      }

      .primary-button:disabled,
      .secondary-button:disabled,
      .danger-button:disabled {
        cursor: not-allowed;
        opacity: 0.48;
      }

      .auth-submit {
        width: 100%;
        margin-top: 16px;
      }

      .form-message {
        margin: 14px 0 0;
        font-size: 12px;
        line-height: 1.6;
      }

      .form-message.success {
        color: var(--success);
      }

      .form-message.error {
        color: var(--danger);
      }

      .auth-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 24px 0;
        color: #8b8f95;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.16em;
      }

      .auth-divider::before,
      .auth-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #ddd8cb;
      }

      .auth-code-help {
        margin: -2px 0 12px;
        color: #6b7078;
        font-size: 13px;
        line-height: 1.55;
      }

      /* =====================================================
         APP SHELL
         ===================================================== */

      .admin-app {
        min-height: 100vh;
      }

      .admin-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        background: var(--charcoal);
        color: white;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        padding: 26px 20px;
        display: flex;
        flex-direction: column;
      }

      .admin-brand {
        color: white;
        text-decoration: none;
      }

      .admin-brand-name {
        font-family: "Cinzel", Georgia, serif;
        font-size: 17px;
        letter-spacing: 0.14em;
      }

      .admin-brand-subtitle {
        margin-top: 5px;
        color: rgba(255, 255, 255, 0.46);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .sidebar-nav {
        margin-top: 38px;
        display: grid;
        gap: 4px;
      }

      .nav-button {
        width: 100%;
        min-height: 44px;
        border: 0;
        background: transparent;
        color: rgba(255, 255, 255, 0.62);
        padding: 0 12px;
        text-align: left;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        transition:
          background 160ms ease,
          color 160ms ease;
      }

      .nav-button:hover,
      .nav-button.active {
        background: rgba(255, 255, 255, 0.06);
        color: white;
      }

      .nav-button.active {
        box-shadow: inset 2px 0 0 var(--gold);
      }

      .nav-count {
        color: rgba(255, 255, 255, 0.35);
        font-size: 10px;
      }

      .sidebar-footer {
        margin-top: auto;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .sidebar-email {
        margin-bottom: 12px;
        color: rgba(255, 255, 255, 0.45);
        font-size: 10px;
        line-height: 1.5;
        word-break: break-word;
      }

      .sidebar-signout {
        color: rgba(255, 255, 255, 0.7);
      }

      .main {
        min-width: 0;
        padding: 34px;
      }

      .main-inner {
        width: min(100%, 1180px);
        margin: 0 auto;
      }

      .topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 22px;
        margin-bottom: 30px;
      }

      .page-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 400;
        line-height: 1.2;
      }

      .page-subtitle {
        margin: 8px 0 0;
        color: var(--slate);
        font-size: 13px;
        line-height: 1.6;
        font-weight: 300;
      }

      .sync-note {
        border: 1px solid rgba(197, 160, 89, 0.35);
        background: rgba(197, 160, 89, 0.08);
        padding: 12px 14px;
        color: #80652f;
        font-size: 11px;
        line-height: 1.55;
      }

      .mobile-menu-button {
        display: none;
      }

      /* =====================================================
         DASHBOARD
         ===================================================== */

      .quick-actions {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 28px;
      }

      .quick-action {
        min-height: 92px;
        border: 1px solid var(--border);
        background: white;
        padding: 16px;
        text-align: left;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: var(--charcoal);
        transition:
          border-color 160ms ease,
          transform 160ms ease;
      }

      .quick-action:hover {
        border-color: var(--gold);
        transform: translateY(-1px);
      }

      .quick-action-icon {
        color: var(--gold);
        font-size: 18px;
      }

      .quick-action-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        margin-bottom: 28px;
      }

      .stat-card {
        background: white;
        padding: 20px;
      }

      .stat-value {
        font-family: "Cinzel", Georgia, serif;
        font-size: 30px;
        color: var(--gold);
      }

      .stat-label {
        margin-top: 6px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .panel {
        border: 1px solid var(--border);
        background: white;
      }

      .panel-header {
        min-height: 66px;
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .panel-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 18px;
        font-weight: 400;
      }

      .panel-copy {
        margin: 3px 0 0;
        color: var(--slate);
        font-size: 11px;
        font-weight: 300;
      }

      .field-help {
        margin: 7px 0 0;
        color: var(--slate);
        font-size: 10px;
        line-height: 1.5;
        font-weight: 300;
      }

      .markdown-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
      }

      .markdown-tool {
        min-height: 30px;
        padding: 0 9px;
        border: 1px solid var(--border);
        background: var(--cream);
        color: var(--charcoal);
        font: inherit;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .markdown-tool:hover {
        border-color: var(--gold);
        color: var(--gold);
      }

      .target-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px 12px;
        margin-top: 8px;
      }

      .target-option {
        min-height: 38px;
        border: 1px solid var(--border);
        background: var(--cream);
        padding: 9px 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--slate);
        font-size: 10px;
        cursor: pointer;
      }

      .target-option:has(input:checked) {
        border-color: var(--gold);
        color: var(--charcoal);
        background: rgba(197, 160, 89, 0.08);
      }

      .target-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 7px;
      }

      .target-badge {
        border: 1px solid var(--border);
        background: var(--cream);
        padding: 3px 6px;
        color: var(--slate);
        font-size: 8px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .editor-media-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
        align-items: center;
        margin: 8px 0 10px;
      }

      .compact-action {
        white-space: nowrap;
      }

      .empty-state {
        padding: 44px 20px;
        text-align: center;
        color: var(--slate);
      }

      .empty-state strong {
        display: block;
        margin-bottom: 8px;
        color: var(--charcoal);
        font-family: "Cinzel", Georgia, serif;
        font-weight: 400;
        font-size: 19px;
      }

      /* =====================================================
         CONTENT LISTS
         ===================================================== */

      .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
      }

      .toolbar-left {
        min-width: 0;
        flex: 1;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .search-input {
        width: min(100%, 420px);
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 16px;
      }

      .filter-button {
        min-height: 34px;
        border: 1px solid var(--border);
        background: white;
        padding: 0 12px;
        color: var(--slate);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .filter-button.active {
        border-color: var(--charcoal);
        background: var(--charcoal);
        color: white;
      }

      .content-list {
        border: 1px solid var(--border);
        background: white;
      }

      .content-row {
        padding: 16px 18px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        border-bottom: 1px solid var(--border);
      }

      .content-row:last-child {
        border-bottom: 0;
      }

      .row-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.4;
      }

      .row-meta {
        margin-top: 5px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 7px;
        color: var(--slate);
        font-size: 10px;
      }

      .row-description {
        max-width: 780px;
        margin: 9px 0 0;
        color: var(--slate);
        font-size: 11px;
        font-weight: 300;
        line-height: 1.55;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        min-height: 24px;
        padding: 0 8px;
        border: 1px solid var(--border);
        color: var(--slate);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .status-pill.published,
      .status-pill.active {
        border-color: rgba(71, 122, 90, 0.25);
        background: rgba(71, 122, 90, 0.07);
        color: var(--success);
      }

      .status-pill.draft {
        border-color: rgba(197, 160, 89, 0.35);
        background: rgba(197, 160, 89, 0.08);
        color: #80652f;
      }

      .status-pill.scheduled {
        border-color: rgba(58, 92, 132, 0.28);
        background: rgba(58, 92, 132, 0.07);
        color: #3a5c84;
      }

      .status-pill.archived,
      .status-pill.inactive {
        opacity: 0.72;
      }

      .row-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      /* =====================================================
         MEDIA
         ===================================================== */

      .media-layout {
        display: grid;
        grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
        gap: 18px;
      }

      .upload-panel {
        border: 1px solid var(--border);
        background: white;
        padding: 20px;
        align-self: start;
      }

      .drop-zone {
        margin-top: 16px;
        border: 1px dashed #bdb6a6;
        background: var(--cream);
        min-height: 180px;
        display: grid;
        place-items: center;
        padding: 20px;
        text-align: center;
        transition:
          border-color 160ms ease,
          background 160ms ease;
      }

      .drop-zone.dragging {
        border-color: var(--gold);
        background: rgba(197, 160, 89, 0.1);
      }

      .drop-zone strong {
        display: block;
        margin-bottom: 6px;
        font-family: "Cinzel", Georgia, serif;
        font-weight: 400;
      }

      .drop-zone span {
        color: var(--slate);
        font-size: 11px;
        line-height: 1.6;
      }

      .media-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
      }

      .media-card {
        border: 1px solid var(--border);
        background: white;
        min-width: 0;
      }

      .media-preview {
        aspect-ratio: 4 / 3;
        background: var(--cream);
        border-bottom: 1px solid var(--border);
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .media-preview img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .media-card-body {
        padding: 11px;
      }

      .media-name {
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 10px;
        font-weight: 500;
      }

      .media-meta {
        margin-top: 5px;
        color: var(--slate);
        font-size: 9px;
      }

      /* =====================================================
         MODAL / EDITOR
         ===================================================== */

      .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(34, 37, 42, 0.54);
        display: grid;
        place-items: center;
        padding: 20px;
        overflow-y: auto;
      }

      .modal {
        width: min(100%, 880px);
        max-height: calc(100vh - 40px);
        overflow-y: auto;
        background: var(--cream);
        border: 1px solid var(--border);
        box-shadow: 0 24px 100px rgba(0, 0, 0, 0.2);
      }

      .modal-header {
        position: sticky;
        top: 0;
        z-index: 4;
        min-height: 70px;
        padding: 14px 20px;
        background: white;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .modal-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 20px;
        font-weight: 400;
      }

      .modal-body {
        padding: 20px;
      }

      .form-section {
        border: 1px solid var(--border);
        background: white;
        margin-bottom: 14px;
      }

      .form-section-header {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
      }

      .form-section-title {
        margin: 0;
        font-family: "Cinzel", Georgia, serif;
        font-size: 15px;
        font-weight: 400;
      }

      .form-section-copy {
        margin: 4px 0 0;
        color: var(--slate);
        font-size: 10px;
        line-height: 1.5;
      }

      .form-section-body {
        padding: 16px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .form-field.full {
        grid-column: 1 / -1;
      }

      .checkbox-row {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      .checkbox-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--slate);
        font-size: 11px;
      }

      .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 4;
        padding: 14px 20px;
        background: white;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .modal-footer-right {
        display: flex;
        gap: 8px;
      }

      /* =====================================================
         TOAST
         ===================================================== */

      .toast {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 200;
        width: min(calc(100% - 44px), 360px);
        border: 1px solid var(--border);
        background: white;
        padding: 13px 15px;
        box-shadow: var(--shadow);
        color: var(--charcoal);
        font-size: 12px;
        line-height: 1.55;
      }

      .toast.success {
        border-left: 3px solid var(--success);
      }

      .toast.error {
        border-left: 3px solid var(--danger);
      }

      /* =====================================================
         MOBILE
         ===================================================== */

      @media (max-width: 900px) {
        .admin-shell {
          display: block;
        }

        .sidebar {
          position: fixed;
          left: 0;
          top: 0;
          z-index: 80;
          width: min(86vw, 300px);
          transform: translateX(-105%);
          transition: transform 180ms ease;
        }

        .sidebar.open {
          transform: translateX(0);
        }

        .mobile-menu-button {
          display: inline-flex;
        }

        .main {
          padding: 22px;
        }

        .quick-actions,
        .stats-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .media-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .auth-card {
          padding: 26px 22px;
        }

        .main {
          padding: 18px 14px 28px;
        }

        .topbar {
          align-items: center;
        }

        .page-title {
          font-size: 28px;
        }

        .quick-actions {
          grid-template-columns: 1fr 1fr;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .toolbar {
          align-items: stretch;
          flex-direction: column;
        }

        .toolbar-left {
          width: 100%;
        }

        .search-input {
          width: 100%;
        }

        .content-row {
          grid-template-columns: 1fr;
        }

        .row-actions {
          justify-content: flex-start;
        }

        .media-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .target-grid {
          grid-template-columns: 1fr;
        }

        .editor-media-row {
          grid-template-columns: 1fr;
        }

        .modal-backdrop {
          padding: 0;
          place-items: stretch;
        }

        .modal {
          width: 100%;
          max-height: 100vh;
          min-height: 100vh;
          border: 0;
        }

        .form-grid {
          grid-template-columns: 1fr;
        }

        .form-field.full {
          grid-column: auto;
        }

        .modal-footer {
          align-items: stretch;
          flex-direction: column;
        }

        .modal-footer-right {
          width: 100%;
        }

        .modal-footer-right > * {
          flex: 1;
        }
      }

      @media (max-width: 430px) {
        .quick-actions {
          grid-template-columns: 1fr;
        }

        .media-grid {
          grid-template-columns: 1fr;
        }
      }

      /* =====================================================
         SMART EVENT EDITOR
         ===================================================== */

      .import-section {
        border-color: rgba(197, 160, 89, 0.55);
        background: rgba(197, 160, 89, 0.035);
      }

      .import-url-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
      }

      .import-status {
        margin-top: 12px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        background: #fff;
        color: var(--slate);
        font-size: 12px;
        line-height: 1.6;
      }

      .import-status.success {
        border-color: rgba(71, 122, 90, 0.35);
        color: var(--success);
      }

      .import-status.error {
        border-color: rgba(169, 75, 75, 0.35);
        color: var(--danger);
      }

      .repeater-block + .repeater-block {
        margin-top: 28px;
        padding-top: 28px;
        border-top: 1px solid var(--border);
      }

      .repeater-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 14px;
      }

      .repeater-title {
        margin: 0 0 4px;
        font-family: "Cinzel", Georgia, serif;
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 0.04em;
      }

      .repeat-list {
        display: grid;
        gap: 12px;
      }

      .repeat-empty {
        padding: 18px;
        border: 1px dashed var(--border);
        color: var(--slate);
        font-size: 12px;
        background: rgba(255, 255, 255, 0.5);
      }

      .repeat-card {
        border: 1px solid var(--border);
        background: #fff;
        padding: 18px;
      }

      .repeat-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
      }

      .repeat-card-title {
        margin: 0;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-weight: 600;
        color: var(--charcoal);
      }

      .repeat-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .repeat-card-grid .full {
        grid-column: 1 / -1;
      }

      .logo-control {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
        align-items: center;
      }

      .logo-preview {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
        min-height: 34px;
        color: var(--slate);
        font-size: 11px;
      }

      .logo-preview img {
        width: 54px;
        height: 34px;
        object-fit: contain;
        background: #fff;
        border: 1px solid var(--border);
        padding: 4px;
      }

      /* =====================================================
         DYNAMIC ADMIN CONTENT
         These elements are injected with JavaScript, so the
         admin stylesheet is intentionally global on this page.
         ===================================================== */

      .recent-content-panel {
        overflow: hidden;
      }

      .recent-content-header {
        align-items: flex-end;
        gap: 24px;
      }

      .recent-content-filters {
        margin: 0;
        justify-content: flex-end;
      }

      .recent-content-secondary-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 18px 28px;
        padding: 14px 24px;
        border-top: 1px solid var(--border);
        background: rgba(244, 241, 232, 0.34);
      }

      .recent-filter-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
      }

      .recent-filter-label {
        color: var(--slate);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .recent-content-list {
        border: 0;
        border-top: 1px solid var(--border);
      }

      .recent-content-row {
        min-height: 94px;
        padding: 18px 24px;
      }

      .recent-content-main {
        min-width: 0;
      }

      .recent-content-topline {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 8px;
      }

      .content-type-pill {
        display: inline-flex;
        align-items: center;
        min-height: 23px;
        padding: 0 8px;
        background: var(--cream);
        border: 1px solid var(--border);
