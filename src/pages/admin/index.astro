        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .recent-content-date {
        color: var(--slate);
        font-size: 9px;
      }

      .recent-edit-button {
        min-width: 82px;
      }

      .content-completeness-alert {
