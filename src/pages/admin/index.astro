      function enterVenture(ventureId, initialSection = "venture-home") {
        const venture = state.ventures.find((item) => String(item.id) === String(ventureId));
        if (!venture) return;

        state.currentVentureId = venture.id;
        state.currentVentureModule = null;

        // Prepare the venture view while the portfolio shell is still collapsed.
        // This avoids reflowing the large portfolio dashboard with the sidebar visible
        // immediately before hiding it.
        renderVentureSidebar();

        if (isSoleilAndStoneVenture(venture)) {
          openSection("dashboard");
          portfolioMode(false);
          updateMobileVentureActions();
          return;
        }

        openSection(initialSection);
        portfolioMode(false);
        updateMobileVentureActions();
      }


      function renderVentureSection(section = state.currentAdminSection) {
        if (!state.currentVentureId) return;

        if (section === "venture-home") {
          renderVentureContextDashboard();
          return;
        }

        if (section === "venture-module") {
          renderVentureModule();
          return;
        }

        if (section === "venture-execution") {
          renderVentureContextExecution();
          return;
        }

        if (section === "venture-milestones") {
          renderVentureContextMilestones();
          return;
        }

        if (section === "venture-notes") {
          renderVentureContextNotes();
        }
      }


