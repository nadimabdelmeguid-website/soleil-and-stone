      async function saveFieldNote() {

        const existingId =
          $("#field-note-record-id").value;

        const title =
          $("#field-note-title").value.trim();

        const status =
          $("#field-note-status").value;

        let publishedAt =
          $("#field-note-published-at").value;


        if (
          status === "published" &&
          !publishedAt
        ) {
          publishedAt =
            new Date().toISOString();
        } else if (
          publishedAt
        ) {
          publishedAt =
            new Date(
              publishedAt
            ).toISOString();
        } else {
          publishedAt =
            null;
        }


        const payload = {
          title,
          excerpt:
            $("#field-note-excerpt").value.trim() || null,
          category:
            $("#field-note-category").value.trim() || null,
          content_markdown:
            $("#field-note-content").value,
