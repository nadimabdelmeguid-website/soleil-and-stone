            state.media.length,

          communities:
            state.communities.length,

          organizations:
            state.organizations.length,

          people:
            state.people.length,

          ventures:
            state.ventures.length,

          evidence:
            state.evidence.length,

          features:
            state.featuredContent.filter((item) => item.active !== false).length
        };


        $("#stat-events").textContent =
          values.events;

        $("#stat-field-notes").textContent =
          values.fieldNotes;

        $("#stat-recaps").textContent =
          values.recaps;

        $("#stat-media").textContent =
          values.media;

        $("#nav-events-count").textContent =
          values.events;

        $("#nav-field-notes-count").textContent =
          values.fieldNotes;

        $("#nav-recaps-count").textContent =
          values.recaps;

        $("#nav-media-count").textContent =
          values.media;

        $("#nav-communities-count").textContent =
          values.communities;

        $("#nav-organizations-count").textContent =
          values.organizations;

        $("#nav-people-count").textContent =
