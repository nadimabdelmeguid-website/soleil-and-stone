    <script>
      import { createClient } from "@supabase/supabase-js";
      import { ventureWorkspaceConfig, ventureTemplateConfig } from "../../lib/venture-admin-config.js";

      const authRoot = document.getElementById("login-form");
      const supabaseUrl = authRoot?.dataset.supabaseUrl || "";
      const supabasePublishableKey = authRoot?.dataset.supabaseKey || "";

      const supabase =
        createClient(
          supabaseUrl,
          supabasePublishableKey,
          {
            auth: {
              persistSession:
                true,

              autoRefreshToken:
                true,

              detectSessionInUrl:
                true
            }
          }
        );


      const state = {
        user:
          null,

        workspaceAreas:
          [],

        workspaceTasks:
          [],

        events:
          [],

        fieldNotes:
          [],

        recaps:
          [],

        media:
          [],

        communities:
          [],

        organizations:
          [],

        people:
          [],

        ventures:
          [],

        ventureTasks:
          [],

        ventureWorkspaceItems:
          [],

        ventureAttachments:
          [],

        venturePublicOverviews:
          [],

        ventureActivity:
          [],

        ventureFileTarget:
          null,

        venturePendingFiles:
          [],

        currentVentureId:
          null,

        currentVentureModule:
          null,

        ventureStageFilter:
          "all",

        ventureSort:
          "priority",

        currentAdminSection:
          "",

        isBulkLoading:
          false,

        ventureUiFrame:
          0,

        ventureUiDirty: {
          portfolio: false,
          current: false,
          sidebar: false,
          modal: false
        },

        evidence:
          [],

        fieldNoteEvents:
          [],

        ventureMilestones:
          [],

        eventSpeakers:
          [],

        eventSponsors:
          [],

        featuredContent:
          [],

        featurePlacement:
          "home",

        featureTypeFilter:
          "all",

        eventFilter:
          "all",

        recentFilter:
          "all",

        recentCompletenessFilter:
          "all",

        recentStatusFilter:
          "all",

        recentPage:
          1,

        recentPageSize:
          25,

        selectedMediaFile:
          null,

        pendingEditorUpload: null,

        pendingCoverUpload: null
      };


      const $ =
        (
          selector
        ) =>
          document.querySelector(
            selector
          );


      const $$ =
        (
          selector
        ) =>
          Array.from(
            document.querySelectorAll(
              selector
            )
          );


      const AUTHORIZED_ADMIN_EMAIL = "nadimabdelmeguid@gmail.com";
      const PRODUCTION_ADMIN_REDIRECT = "https://soleilandstone.co/admin/";

      function setAuthMessage(text, type = "") {
        const message = $("#login-message");
        if (!message) return;
        message.textContent = text;
        message.className = "form-message " + type;
      }

      $("#google-login-button")?.addEventListener("click", async () => {
        const button = $("#google-login-button");
        setButtonLoading(button, true, "Opening Google...", "Continue with Google");
        setAuthMessage("Redirecting to Google sign-in...");

        const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
        const redirectTo = isLocal ? window.location.origin + "/admin/" : PRODUCTION_ADMIN_REDIRECT;

        const { error } = await supabase.auth.signInWithOAuth({
          provider: "google",
          options: {
            redirectTo,
            scopes: "openid email profile"
          }
        });

        if (error) {
          setButtonLoading(button, false, "Opening Google...", "Continue with Google");
          setAuthMessage(error.message || "Could not start Google sign-in.", "error");
        }
      });


      /* =====================================================
         UTILITIES
         ===================================================== */

      function escapeHtml(
        value = ""
      ) {

        return String(
          value
        )
          .replaceAll(
            "&",
            "&amp;"
          )
          .replaceAll(
            "<",
            "&lt;"
          )
          .replaceAll(
            ">",
            "&gt;"
          )
          .replaceAll(
            '"',
            "&quot;"
          )
          .replaceAll(
            "'",
            "&#039;"
          );

      }


      function slugify(
        value
      ) {

        return String(
          value || "content"
        )
          .normalize(
            "NFD"
          )
          .replace(
            /[\u0300-\u036f]/g,
            ""
          )
          .toLowerCase()
          .replace(
            /[^a-z0-9]+/g,
            "-"
          )
          .replace(
            /^-+|-+$/g,
            ""
          )
          .slice(
            0,
            90
          );

      }


      function linesToArray(
        value
      ) {
        return String(value || "")
          .split(/\n|,/)
          .map((item) => item.trim())
          .filter(Boolean)
