      function openSection(
        section
      ) {

        const sectionChanged = state.currentAdminSection !== section;
        state.currentAdminSection = section;

        if (sectionChanged) {
          $(".admin-section").forEach(
            (
              element
            ) =>
              element.classList.toggle(
                "hidden",
                element.dataset.adminSection !== section
              )
          );
        }


        $$(".nav-button").forEach(
          (
            button
          ) => {
            const moduleMatch =
              section === "venture-module" &&
              button.dataset.ventureModule &&
              button.dataset.ventureModule === state.currentVentureModule;

            button.classList.toggle(
              "active",
              moduleMatch ||
              (
                !button.dataset.ventureModule &&
                button.dataset.section === section
              )
            );
          }
        );


        let copy =
          sectionCopy[
            section
          ] ||
          sectionCopy.dashboard;

        const venture =
          currentVenture();

        if (
          venture &&
          section === "venture-home"
        ) {
          copy = {
            eyebrow: "Venture Workspace",
            title: venture.name,
            subtitle: venture.tagline || "Venture dashboard"
          };
        }

        if (
          venture &&
          section === "venture-module"
        ) {
          const module =
            workspaceConfigFor(venture).modules.find(
              (item) => item.key === state.currentVentureModule
            );

          copy = {
            eyebrow: venture.name,
            title: module?.label || "Business Module",
            subtitle: module?.description || "Venture-specific working context."
          };
        }

        if (
          venture &&
          ["venture-execution", "venture-milestones", "venture-notes"].includes(section)
        ) {
          copy = {
            ...copy,
            eyebrow: venture.name
          };
        }


        $("#page-eyebrow").textContent =
          copy.eyebrow;

        $("#page-title").textContent =
          copy.title;

        $("#page-subtitle").textContent =
          copy.subtitle;

        $("#sidebar").classList.remove("open");


        const soleilCmsSections = [
          "dashboard",
          "features",
          "events",
          "field-notes",
          "recaps",
          "media",
          "communities",
          "organizations",
          "people",
          "evidence"
        ];

