        } catch (
          error
        ) {

          console.error(
            error
          );

          showToast(
            error?.message ||
            "Upload failed.",
            "error"
          );

        } finally {

          setButtonLoading(
            button,
            false,
            "Uploading...",
            "Upload"
          );

          button.disabled =
            !state.selectedMediaFile;

        }

      }


      function setSelectedMediaFile(
        file
      ) {

        if (
          !file
        ) {
          return;
        }


        if (
          !file.type.startsWith("image/")
        ) {
          showToast(
            "Please select an image file.",
            "error"
          );
          return;
        }


        state.selectedMediaFile =
          file;

        $("#drop-zone strong").textContent =
          file.name;

        $("#drop-zone span").textContent =
          `${Math.round(file.size / 1024)} KB ready to upload`;

        $("#upload-media-button").disabled =
          false;

      }


      async function toggleMediaStatus(
        mediaId
      ) {
        const item =
          state.media.find(
            (media) =>
              media.id === mediaId
          );

        if (!item) return;

        const nextStatus =
          item.status === "active"
            ? "archived"
            : "active";

        const response =
          await supabase
            .from("media")
            .update({
              status: nextStatus
            })
            .eq("id", mediaId);

        if (response.error) {
          throw response.error;
        }

        showToast(
          nextStatus === "active"
            ? "Media restored."
            : "Media archived."
        );

        await loadMedia();
        refreshCounts();
        refreshMediaSelectors();
      }


      function refreshMediaSelectors() {

        const selectors = [
          $("#event-cover-media"),
          $("#event-community-track-media"),
          $("#event-industry-logo-media"),
          $("#field-note-hero-media"),
          $("#recap-hero-media"),
          $("#organization-logo-media"),
          $("#person-photo-media"),
          $("#person-company-logo-media"),
          $("#field-note-inline-media"),
          $("#recap-inline-media")
        ];


        selectors.forEach(
          (
            select
          ) => {

            if (
              !select
            ) {
              return;
            }


            const current =
              select.value;

            const emptyLabel =
              select.id === "event-cover-media"
                ? "No Fieldwork cover"
                : select.id === "event-community-track-media"
                  ? "No Community Track Record image"
                  : select.id === "event-industry-logo-media"
                    ? "No industry event logo"
                  : select.id === "organization-logo-media" ||
                    select.id === "person-company-logo-media"
                    ? "No logo"
                    : select.id === "person-photo-media"
                      ? "No photo"
                      : select.id.endsWith("inline-media")
                        ? "Insert existing image..."
                        : "No hero image";

            const target =
              select.id === "event-community-track-media"
                ? "community"
                : select.id === "event-industry-logo-media"
                  ? "fieldwork"
                : select.id.startsWith("field-note")
                  ? "field-notes"
                  : select.id.startsWith("recap")
                    ? "event-recaps"
                    : select.id === "organization-logo-media"
                      ? "sponsors"
                      : select.id === "person-company-logo-media"
                        ? "community"
                        : "events";

            select.innerHTML =
              `<option value="">${emptyLabel}</option>` +
              state.media
                .filter((item) => mediaAvailableFor(item, target))
                .map((item) =>
                  `<option value="${escapeHtml(item.id)}">${escapeHtml(item.file_name)}</option>`
                )
                .join("");


            select.value =
              current;

          }
        );

        refreshEventRepeaterMediaSelectors();

      }


