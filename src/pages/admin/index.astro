      function isLedParticipation(
        participation = $("#event-participation")?.value || ""
      ) {
        return participation === "hosted" || participation === "co-organized";
      }


      function isHardwareMeetupEvent() {
        return (
          isLedParticipation() &&
          $("#event-community")?.value === "hardware-meetup"
        );
      }


      function isCommunityLogoEvent() {
        return (
          isLedParticipation() &&
          ["hardware-meetup", "startup-mixer"].includes(
            $("#event-community")?.value || ""
          )
        );
      }


      function isTradeShowEventContext() {
        const eventType =
          ($("#event-type")?.value || "").toLowerCase();
        const typeLabel =
          ($("#event-type-label")?.value || "").trim().toLowerCase();
        const participation =
          $("#event-participation")?.value || "";

        return (
          participation === "exhibitor" ||
          ["trade-show", "tradeshow", "expo", "conference", "convention"].includes(eventType) ||
          eventType.includes("trade") ||
          eventType.includes("expo") ||
          typeLabel.includes("trade show") ||
          typeLabel.includes("exhibitor")
        );
      }


      function syncEventConditionalFields() {
        const led = isLedParticipation();
        const hardware = isHardwareMeetupEvent();
        const communityLogoEvent = isCommunityLogoEvent();
        const industry = isTradeShowEventContext();

        $("#event-registrations-field")?.classList.toggle("hidden", !led);
        $("#hosted-event-section")?.classList.toggle("hidden", !led);
        $("#hardware-community-image-field")?.classList.toggle("hidden", !communityLogoEvent);
        $("#industry-event-logo-field")?.classList.toggle("hidden", !industry);

        const eventTypeField = $("#event-type");
        const communityValue = $("#event-community")?.value || "";

        if (eventTypeField && !eventTypeField.value) {
          if (communityValue === "hardware-meetup") {
            eventTypeField.value = "meetup";
          } else if (communityValue === "startup-mixer") {
            eventTypeField.value = "mixer";
          }
        }

        const typeLabel = $("#event-type-label");
        if (typeLabel && !typeLabel.value) {
          const eventType = ($("#event-type")?.value || "").toLowerCase();

          if ($("#event-participation")?.value === "hosted") {
            typeLabel.value =
              $("#event-community")?.value
                ? "Hosted Community Event"
                : "Hosted Event";
          } else if ($("#event-participation")?.value === "co-organized") {
            typeLabel.value =
              $("#event-community")?.value === "hardware-meetup"
                ? "Co-Organized Hardware Event"
                : "Co-Organized Event";
          } else if ($("#event-participation")?.value === "exhibitor") {
            typeLabel.value = "Exhibitor";
          } else if ($("#event-participation")?.value === "attending") {
            typeLabel.value =
              eventType === "trade-show"
                ? "Attending Trade Show"
                : "Attending Event";
          }
        }
      }


      function showEventImportStatus(message = "", type = "") {
        const box = $("#event-import-status");
        if (!box) return;

        if (!message) {
          box.textContent = "";
          box.className = "import-status hidden";
          return;
        }

        box.textContent = message;
        box.className = `import-status ${type}`.trim();
      }


      function applyImportedField(selector, value) {
        const field = $(selector);
        if (!field || value === undefined || value === null || value === "") {
          return;
        }

        field.value = String(value);
      }


      function normalizeEventType(value = "") {
        const normalized = String(value)
          .trim()
          .toLowerCase()
          .replace(/[_\s]+/g, "-");

        const aliases = {
          "meet-up": "meetup",
          "meetup": "meetup",
          "community-event": "meetup",
          "mixer": "mixer",
          "networking-event": "mixer",
          "networking": "mixer",
          "trade-show": "trade-show",
          "tradeshow": "trade-show",
          "expo": "trade-show",
          "exhibition": "trade-show",
          "industry-event": "trade-show",
          "conference": "conference",
          "convention": "conference",
          "summit": "conference",
          "professional-event": "conference",
          "workshop": "workshop",
          "panel": "workshop",
          "demo-day": "demo-day",
          "pitch-event": "demo-day",
          "other": "other"
        };

        return aliases[normalized] || "";
      }


      function inferEventContext(imported = {}) {
        const title = String(imported.title || "").toLowerCase();
        const url = String($("#event-url")?.value || "").toLowerCase();

        if (
          title.includes("san diego hardware meetup") ||
          title.includes("sd hardware meetup")
        ) {
          $("#event-community").value = "hardware-meetup";
          $("#event-participation").value = "co-organized";

          if (!$("#event-type").value) {
            $("#event-type").value = "meetup";
          }
        } else if (
          title.includes("san diego county startup mixer") &&
          !title.includes("north county")
        ) {
          $("#event-community").value = "startup-mixer";
          $("#event-participation").value = "hosted";

          if (!$("#event-type").value) {
            $("#event-type").value = "mixer";
          }
        }

        if (!$("#event-button-label").value.trim()) {
          $("#event-button-label").value =
            imported.eventType === "trade-show"
              ? "View Show"
              : "View Event";
        }

        if (
          url.includes("ces.tech") ||
          title.includes("ces ")
        ) {
          if (!$("#event-type").value.trim()) {
            $("#event-type").value = "trade-show";
          }
        }

        syncEventConditionalFields();
      }


      async function importEventFromUrl() {
        const url = $("#event-url").value.trim();
        const button = $("#import-event-url-button");

        if (!url) {
          showEventImportStatus("Add the event URL first.", "error");
          return;
        }

        setButtonLoading(
          button,
          true,
          "Importing...",
          "Import details"
        );

        showEventImportStatus(
          "Reading the public event page and extracting available details..."
        );

        try {
          const {
            data,
            error
          } = await supabase.functions.invoke(
            "import-event",
            {
              body: {
                url
              }
            }
          );

          if (error) {
            let message =
              error.message ||
              "Could not import this event.";

            try {
              const context =
                error.context;

              if (context?.json) {
                const details =
                  await context.json();

                message =
                  details?.error ||
                  message;
              }
            } catch {
              // Keep the original function error message.
            }

            throw new Error(message);
          }

          if (data?.error) {
            throw new Error(data.error);
          }

          const imported = data?.event || {};

          applyImportedField("#event-title", imported.title);
          applyImportedField("#event-start-date", imported.startDate);
          applyImportedField("#event-end-date", imported.endDate);
          applyImportedField("#event-description", imported.description);
          applyImportedField("#event-venue", imported.venue);
          applyImportedField("#event-city", imported.city);
          applyImportedField("#event-region", imported.region);
          applyImportedField("#event-country", imported.country);
          applyImportedField("#event-address", imported.address);

          const normalizedImportedEventType =
            normalizeEventType(imported.eventType);

          if (normalizedImportedEventType) {
            $("#event-type").value =
              normalizedImportedEventType;
          }

          if (
            imported.registrations !== undefined &&
            imported.registrations !== null
          ) {
            $("#event-registrations").value =
              String(imported.registrations);
          }

          if (
            Array.isArray(imported.organizers) &&
            imported.organizers.length
          ) {
            $("#event-organizers").value =
              imported.organizers.join("\n");
          }

          if (
            Array.isArray(imported.speakers) &&
            imported.speakers.length
          ) {
            $("#event-speaker-list").innerHTML = "";

            imported.speakers.forEach(
              (speaker) =>
                addEventSpeakerEntry(
                  {
                    name: speaker.name || "",
                    title: speaker.title || "",
                    company: speaker.company || "",
                    company_url: speaker.companyUrl || ""
                  }
                )
            );
          }

          if (
            Array.isArray(imported.sponsors) &&
            imported.sponsors.length
          ) {
            $("#event-sponsor-list").innerHTML = "";

            imported.sponsors.forEach(
              (sponsor) =>
                addEventSponsorEntry(
                  {
                    name:
                      typeof sponsor === "string"
                        ? sponsor
                        : sponsor.name || "",
                    website_url:
                      typeof sponsor === "string"
                        ? ""
                        : sponsor.url || ""
                  }
                )
            );
          }

          inferEventContext(imported);
          ensureRepeaterEmptyStates();

          const importedPieces = [
            imported.title ? "title" : "",
            imported.startDate ? "date" : "",
            imported.venue || imported.city ? "location" : "",
            imported.description ? "description" : "",
            imported.speakers?.length
              ? `${imported.speakers.length} speaker${imported.speakers.length === 1 ? "" : "s"}`
              : "",
            imported.sponsors?.length
              ? `${imported.sponsors.length} sponsor${imported.sponsors.length === 1 ? "" : "s"}`
              : ""
          ].filter(Boolean);

          showEventImportStatus(
            importedPieces.length
              ? `Imported ${importedPieces.join(", ")}. Review the fields below, add your CMS images/logos, then save the event.`
              : "The page was reachable, but it did not expose much structured event data. You can still complete the event manually.",
            "success"
          );

        } catch (error) {
          console.error(error);

          showEventImportStatus(
            error?.message ||
            "Could not import this event URL.",
            "error"
          );

        } finally {
          setButtonLoading(
            button,
            false,
            "Importing...",
            "Import details"
          );
        }
      }


