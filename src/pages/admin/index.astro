      function ventureDocumentKind(file) {
        const mime = String(file.mime_type || "").toLowerCase();
        const name = String(file.display_name || file.original_name || "").toLowerCase();
        if (mime.startsWith("image/")) return "image";
        if (mime === "application/pdf" || name.endsWith(".pdf")) return "pdf";
        if (mime.includes("spreadsheet") || mime.includes("excel") || /\.(xlsx?|csv)$/.test(name)) return "spreadsheet";
        return "document";
      }


      function ventureAttachmentTargetLabel(file) {
        if (file.entity_type === "venture") return ventureById(file.venture_id)?.name || "Venture";
        if (file.entity_type === "task") return state.ventureTasks.find((item) => String(item.id) === String(file.entity_id))?.title || "Task";
        if (file.entity_type === "milestone") return state.ventureMilestones.find((item) => String(item.id) === String(file.entity_id))?.title || "Milestone";
        if (file.entity_type === "workspace_item") return state.ventureWorkspaceItems.find((item) => String(item.id) === String(file.entity_id))?.title || "Workspace card";
        return "Venture item";
      }


      function renderVentureDocumentCenter() {
        const container = $("#ventures-documents-list");
        if (!container) return;
        const filter = $("#venture-document-filter")?.value || "all";
        const query = $("#venture-document-search")?.value.trim().toLowerCase() || "";

        const items = state.ventureAttachments
          .filter((file) => !file.archived_at)
          .filter((file) => {
            if(filter==="all")return true;
            if(filter.startsWith("target-"))return file.entity_type===filter.replace("target-","");
            return ventureDocumentKind(file)===filter;
          })
          .filter((file) => {
            if (!query) return true;
            const venture = ventureById(file.venture_id);
            return [
              file.display_name,file.original_name,file.category,file.source_label,
              ...(Array.isArray(file.tags) ? file.tags : []),
