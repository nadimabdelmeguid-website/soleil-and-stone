            showToast(
              error?.message || "Could not save Field Note.",
              "error"
            );
          } finally {
            setButtonLoading(
              button,
              false,
              "Saving...",
              "Save Field Note"
            );
          }

        }
      );


      $("#recap-form").addEventListener(
        "submit",
        async (
          event
        ) => {

          event.preventDefault();

          const button =
            $("#save-recap-button");

          setButtonLoading(
            button,
            true,
            "Saving...",
            "Save Recap"
          );

          try {
            await saveRecap();
          } catch (
            error
          ) {
            console.error(error);
            showToast(
              error?.message || "Could not save recap.",
              "error"
            );
          } finally {
            setButtonLoading(
              button,
              false,
              "Saving...",
              "Save Recap"
            );
          }

        }
      );


      const dropZone =
        $("#drop-zone");


      $("#choose-media-button").addEventListener(
        "click",
        () =>
          $("#media-file-input").click()
      );


      $("#media-file-input").addEventListener(
        "change",
        (
          event
        ) => {
          setSelectedMediaFile(
            event.target.files?.[0]
          );
        }
      );


      dropZone.addEventListener(
        "dragover",
        (
          event
        ) => {
          event.preventDefault();
          dropZone.classList.add("dragging");
        }
      );


      dropZone.addEventListener(
        "dragleave",
        () =>
          dropZone.classList.remove("dragging")
      );


      dropZone.addEventListener(
        "drop",
        (
          event
        ) => {
          event.preventDefault();
          dropZone.classList.remove("dragging");
          setSelectedMediaFile(
            event.dataTransfer?.files?.[0]
          );
        }
      );


      $("#upload-media-button").addEventListener(
        "click",
        uploadSelectedMedia
      );


      document.addEventListener(
        "keydown",
        (
          event
        ) => {

          if (
            event.key !== "Escape"
          ) {
            return;
          }


          [
            "event",
            "field-note",
            "recap"
          ].forEach(
            closeModal
          );

          $("#sidebar").classList.remove("open");

        }
      );


      /* =====================================================
         INITIALIZE
         ===================================================== */

      const {
        data: {
          session
        }
      } =
        await supabase.auth.getSession();


      await handleSession(
        session
      );


      supabase.auth.onAuthStateChange(
        async (
          event,
          session
        ) => {

          if (
            event === "SIGNED_IN" ||
            event === "INITIAL_SESSION"
          ) {
            await handleSession(session);
          }

          if (
            event === "SIGNED_OUT"
          ) {
            state.user = null;
            showAuth();
          }

        }
      );
    </script>
  </body>
</html>
