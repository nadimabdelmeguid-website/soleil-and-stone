      async function bootstrapAdminMembership(
        user
      ) {

        const email =
          user?.email;


        if (
          !user?.id ||
          !email
        ) {
          return false;
        }


        const {
          error:
            upsertError
        } =
          await supabase
            .from(
              "admin_users"
            )
            .upsert(
              {
                user_id:
                  user.id,

                email,

                display_name:
                  user.user_metadata?.full_name ||
                  "Nadim"
              },
              {
                onConflict:
                  "user_id"
              }
            );


        if (
          upsertError
        ) {
          console.warn(
            "Admin bootstrap denied:",
            upsertError.message
          );

          return false;
        }


        const {
          data,
          error
        } =
          await supabase
            .from(
              "admin_users"
            )
            .select(
              "user_id,email,display_name"
            )
            .eq(
              "user_id",
              user.id
            )
            .maybeSingle();


        return Boolean(
          !error &&
          data?.user_id
        );

      }


      async function handleSession(
        session
      ) {

        if (
          !session?.user
        ) {
          showAuth();
          return;
        }


        const allowed =
          await bootstrapAdminMembership(
            session.user
          );


        if (
          !allowed
        ) {

          await supabase.auth.signOut();

          showAuth(
            "This account is not authorized to access the Soleil & Stone admin."
          );

          return;
        }


        state.user =
          session.user;


        showAdmin();


        await loadAllContent();

      }


