    <!-- =====================================================
         ADMIN LOGIC
         ===================================================== -->

    <script
      type="module"
      define:vars={{ supabaseUrl, supabasePublishableKey }}
    >
      import {
        createClient
      } from "https://esm.sh/@supabase/supabase-js@2";


      const supabase =
        createClient(
          supabaseUrl,
          supabasePublishableKey,
          {
            auth: {
              persistSession:
                true,

              autoRefreshToken:
                true,

              detectSessionInUrl:
                true
            }
          }
        );


      const state = {
        user:
          null,

        events:
          [],

        fieldNotes:
          [],

        recaps:
          [],

        media:
          [],

        communities:
          [],

        organizations:
          [],

        people:
          [],

        eventSpeakers:
          [],

        eventSponsors:
          [],

        featuredContent:
          [],

        featurePlacement:
          "home",

        featureTypeFilter:
          "all",

        eventFilter:
          "all",

        recentFilter:
          "all",

        recentPage:
          1,

        recentPageSize:
          25,

        selectedMediaFile:
          null,

        pendingEditorUpload: null,

        pendingCoverUpload: null
      };


      const $ =
        (
          selector
        ) =>
          document.querySelector(
            selector
          );


      const $$ =
        (
          selector
        ) =>
          Array.from(
            document.querySelectorAll(
              selector
            )
          );


      /* =====================================================
         UTILITIES
         ===================================================== */

      function escapeHtml(
        value = ""
      ) {

        return String(
          value
        )
          .replaceAll(
            "&",
            "&amp;"
          )
          .replaceAll(
            "<",
            "&lt;"
          )
          .replaceAll(
            ">",
            "&gt;"
          )
          .replaceAll(
            '"',
            "&quot;"
          )
          .replaceAll(
            "'",
            "&#039;"
          );

      }


      function slugify(
        value
      ) {

        return String(
          value || "content"
        )
          .normalize(
            "NFD"
          )
          .replace(
            /[\u0300-\u036f]/g,
            ""
          )
          .toLowerCase()
          .replace(
            /[^a-z0-9]+/g,
            "-"
          )
          .replace(
            /^-+|-+$/g,
            ""
          )
          .slice(
            0,
            90
          );

      }


      function linesToArray(
        value
      ) {
        return String(value || "")
          .split(/\n|,/)
          .map((item) => item.trim())
          .filter(Boolean)
          .filter((item, index, array) =>
            array.findIndex((candidate) => candidate.toLowerCase() === item.toLowerCase()) === index
          );
      }


      function arrayToLines(
        value
      ) {
        return Array.isArray(value)
          ? value.filter(Boolean).join("\n")
          : "";
      }


      const mediaTargetLabels = {
        community: "Community",
        fieldwork: "Fieldwork",
        "field-notes": "Field Notes",
        events: "Events",
        "event-recaps": "Event Recaps",
        sponsors: "Sponsors & Logos",
        global: "Global"
      };


      function getMediaPublishTargets() {
        return $$("#media-publish-targets input[type='checkbox']:checked")
          .map((input) => input.value);
      }


      function resetMediaPublishTargets() {
        $$("#media-publish-targets input[type='checkbox']")
          .forEach((input) => { input.checked = false; });
      }


      function mediaAvailableFor(item, target) {
        if (!item || item.status !== "active") return false;
        const targets = Array.isArray(item.publish_targets) ? item.publish_targets : [];
        return targets.length === 0 || targets.includes("global") || targets.includes(target);
      }


      function insertMarkdownImage(textarea, media) {
        if (!textarea || !media?.public_url) return;
        const alt = (media.alt_text || media.file_name || "Image")
          .replace(/[\[\]]/g, "");
        const markdown = `![${alt}](${media.public_url})`;
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? start;
        const prefix = start > 0 && textarea.value[start - 1] !== "\n" ? "\n\n" : "";
        const suffix = end < textarea.value.length && textarea.value[end] !== "\n" ? "\n\n" : "";
        textarea.setRangeText(`${prefix}${markdown}${suffix}`, start, end, "end");
        textarea.focus();
        textarea.dispatchEvent(new Event("input", { bubbles: true }));
      }


      function selectedValues(
        select
      ) {
        return Array.from(select?.selectedOptions || [])
          .map((option) => option.value)
          .filter(Boolean);
      }


      function setSelectedValues(
        select,
        values = []
      ) {
        const selected = new Set(values || []);
        Array.from(select?.options || []).forEach((option) => {
          option.selected = selected.has(option.value);
        });
      }


      function parseFocus(
        value
      ) {
        return String(value || "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const separator = line.indexOf("::");
            return separator === -1
              ? { title: line, text: "" }
              : {
                  title: line.slice(0, separator).trim(),
                  text: line.slice(separator + 2).trim()
                };
          })
          .filter((item) => item.title);
      }


      function formatFocus(
        value
      ) {
        return (Array.isArray(value) ? value : [])
          .map((item) => `${item?.title || ""} :: ${item?.text || ""}`.trim())
          .join("\n");
      }


      function applyMarkdown(
        textarea,
        action
      ) {
        if (!textarea) return;

        const start = textarea.selectionStart ?? 0;
        const end = textarea.selectionEnd ?? start;
        const value = textarea.value || "";
        const selected = value.slice(start, end);

        const replaceSelection = (
          replacement,
          selectionStartOffset = 0,
          selectionEndOffset = replacement.length
        ) => {
          textarea.setRangeText(replacement, start, end, "end");
          const base = start;
          textarea.focus();
          textarea.setSelectionRange(
            base + selectionStartOffset,
            base + selectionEndOffset
          );
          textarea.dispatchEvent(new Event("input", { bubbles: true }));
        };

        const lineBlock = (
          prefixer,
          fallback
        ) => {
          const block = selected || fallback;
          const output = block
            .split("\n")
            .map((line, index) => prefixer(line, index))
            .join("\n");
          replaceSelection(output, 0, output.length);
        };

        switch (action) {
          case "bold": {
            const content = selected || "bold text";
            const output = `**${content}**`;
            replaceSelection(output, 2, output.length - 2);
            break;
          }

          case "italic": {
            const content = selected || "italic text";
            const output = `*${content}*`;
            replaceSelection(output, 1, output.length - 1);
            break;
          }

          case "link": {
            const content = selected || "link text";
            const output = `[${content}](https://)`;
            replaceSelection(
              output,
              output.indexOf("https://"),
              output.indexOf("https://") + 8
            );
            break;
          }

          case "h2":
            lineBlock(
              (line) => `## ${line.replace(/^#{1,6}\s+/, "")}`,
              "Section heading"
            );
            break;

          case "quote":
            lineBlock(
              (line) => `> ${line.replace(/^>\s?/, "")}`,
              "Quoted text"
            );
            break;

          case "bullet":
            lineBlock(
              (line) => `- ${line.replace(/^[-*+]\s+/, "")}`,
              "List item"
            );
            break;

          case "number":
            lineBlock(
              (line, index) =>
                `${index + 1}. ${line.replace(/^\d+\.\s+/, "")}`,
              "List item"
            );
            break;
        }
      }


      function getEventSpeakerIds(
        eventId
      ) {
        return state.eventSpeakers
          .filter((link) => link.event_id === eventId)
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0))
          .map((link) => link.person_id);
      }


      function getEventSponsorIds(
        eventId
      ) {
        return state.eventSponsors
          .filter((link) => link.event_id === eventId)
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0))
          .map((link) => link.organization_id);
      }


      function formatDate(
        value
      ) {

        if (
          !value
        ) {
          return "No date";
        }


        const date =
          new Date(
            `${value}T12:00:00`
          );


        return date.toLocaleDateString(
          "en-US",
          {
            month:
              "short",

            day:
              "numeric",

            year:
              "numeric"
          }
        );

      }


      function toLocalDateTimeInput(
        value
      ) {

        if (
          !value
        ) {
          return "";
        }


        const date =
          new Date(
            value
          );


        const offset =
          date.getTimezoneOffset();


        const local =
          new Date(
            date.getTime() -
            offset *
              60_000
          );


        return local
          .toISOString()
          .slice(
            0,
            16
          );

      }


      function fieldNotePublishingMode(item) {
        if (!item) return "draft";

        if (item.status === "published" && item.published_at) {
          const publishTime = new Date(item.published_at).getTime();

          if (Number.isFinite(publishTime) && publishTime > Date.now()) {
            return "scheduled";
          }
        }

        return item.status || "draft";
      }


      function fieldNoteDisplayStatus(item) {
        const mode = fieldNotePublishingMode(item);

        return {
          mode,
          label:
            mode === "scheduled"
