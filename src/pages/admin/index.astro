      function mergeVentureUiDirty(flags = {}) {
        state.ventureUiDirty = {
          portfolio: Boolean(state.ventureUiDirty.portfolio || flags.portfolio),
          current: Boolean(state.ventureUiDirty.current || flags.current),
          sidebar: Boolean(state.ventureUiDirty.sidebar || flags.sidebar),
          modal: Boolean(state.ventureUiDirty.modal || flags.modal)
        };
      }


      function flushVentureUiRefresh() {
        if (state.ventureUiFrame) {
          cancelAnimationFrame(state.ventureUiFrame);
          state.ventureUiFrame = 0;
        }

        const dirty = state.ventureUiDirty;
        state.ventureUiDirty = {
          portfolio: false,
          current: false,
          sidebar: false,
          modal: false
        };

        if (dirty.portfolio && state.currentAdminSection === "ventures") {
          renderVentures();
        }

        if (dirty.current && state.currentVentureId) {
          renderCurrentVentureContext({ sidebar: dirty.sidebar });
        } else if (dirty.sidebar && state.currentVentureId) {
          renderVentureSidebar();
        }

        if (dirty.modal && ventureModalIsOpen()) {
          renderVentureTasks();
          renderVentureMilestones();
          updateVentureLiveSummary();
          updateVenturePrivateFilesButton();
        }
      }


      function queueVentureUiRefresh(flags = {}) {
        mergeVentureUiDirty(flags);
        if (state.isBulkLoading || state.ventureUiFrame) return;

        state.ventureUiFrame = requestAnimationFrame(() => {
          state.ventureUiFrame = 0;
          flushVentureUiRefresh();
        });
      }


