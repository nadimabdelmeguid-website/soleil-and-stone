      function parseRecapTags(
        value = ""
      ) {
        return [...new Set(
          String(value || "")
            .split(/,|\n/)
            .map((item) => item.trim())
            .filter(Boolean)
        )];
      }


      function formatRecapTags(
        value
      ) {
        return (Array.isArray(value) ? value : [])
          .filter(Boolean)
          .join(", ");
      }


      function parseRecapStats(
        value = ""
      ) {
        return String(value || "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const separator = line.indexOf("::");

            if (separator === -1) {
              return {
                value: line,
                label: ""
              };
            }

            return {
              value: line.slice(0, separator).trim(),
              label: line.slice(separator + 2).trim()
            };
          })
          .filter((item) => item.value);
      }


      function formatRecapStats(
        value
      ) {
        return (Array.isArray(value) ? value : [])
          .map((item) =>
            item?.label
              ? `${item.value || ""} :: ${item.label}`
              : String(item?.value || "")
          )
          .filter(Boolean)
          .join("\n");
      }


