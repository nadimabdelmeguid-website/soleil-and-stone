                  <span>•</span><span class="status-pill ${escapeHtml(item.status || "active")}">${escapeHtml(item.status || "active")}</span>
                </div>
                ${item.bio ? `<p class="row-description">${escapeHtml(item.bio)}</p>` : ""}
              </div>
              <div class="row-actions"><button class="secondary-button" type="button" data-edit-person="${escapeHtml(item.id)}">Edit</button></div>
            </div>`;
        }).join("");
