        if (!state.currentVentureId) return;

        const venture = currentVenture();
        if (!venture) return;

        if (sidebar) {
          renderVentureSidebar();
        }

        if (isSoleilAndStoneVenture(venture)) {
          return;
        }

        const section = String(state.currentAdminSection || "");
        if (section.startsWith("venture-")) {
          renderVentureSection(section);
        }
