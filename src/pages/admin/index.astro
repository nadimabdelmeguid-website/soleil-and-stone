      function parseFocus(
        value
      ) {
        return String(value || "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const separator = line.indexOf("::");
            return separator === -1
              ? { title: line, text: "" }
              : {
                  title: line.slice(0, separator).trim(),
                  text: line.slice(separator + 2).trim()
                };
          })
          .filter((item) => item.title);
      }


      function formatFocus(
        value
      ) {
        return (Array.isArray(value) ? value : [])
          .map((item) => `${item?.title || ""} :: ${item?.text || ""}`.trim())
          .join("\n");
      }


      function applyMarkdown(
        textarea,
        action
      ) {
        if (!textarea) return;

        const start = textarea.selectionStart ?? 0;
        const end = textarea.selectionEnd ?? start;
        const value = textarea.value || "";
        const selected = value.slice(start, end);

        const replaceSelection = (
          replacement,
          selectionStartOffset = 0,
          selectionEndOffset = replacement.length
        ) => {
          textarea.setRangeText(replacement, start, end, "end");
          const base = start;
          textarea.focus();
          textarea.setSelectionRange(
            base + selectionStartOffset,
            base + selectionEndOffset
          );
          textarea.dispatchEvent(new Event("input", { bubbles: true }));
        };

        const lineBlock = (
          prefixer,
          fallback
        ) => {
          const block = selected || fallback;
          const output = block
            .split("\n")
            .map((line, index) => prefixer(line, index))
            .join("\n");
          replaceSelection(output, 0, output.length);
        };

        switch (action) {
          case "bold": {
            const content = selected || "bold text";
            const output = `**${content}**`;
            replaceSelection(output, 2, output.length - 2);
            break;
          }

          case "italic": {
            const content = selected || "italic text";
            const output = `*${content}*`;
            replaceSelection(output, 1, output.length - 1);
            break;
          }

          case "link": {
            const content = selected || "link text";
            const output = `[${content}](https://)`;
            replaceSelection(
              output,
              output.indexOf("https://"),
              output.indexOf("https://") + 8
            );
            break;
          }

          case "h2":
            lineBlock(
              (line) => `## ${line.replace(/^#{1,6}\s+/, "")}`,
              "Section heading"
            );
            break;

          case "quote":
            lineBlock(
              (line) => `> ${line.replace(/^>\s?/, "")}`,
              "Quoted text"
            );
            break;

          case "bullet":
            lineBlock(
              (line) => `- ${line.replace(/^[-*+]\s+/, "")}`,
              "List item"
            );
            break;

          case "number":
            lineBlock(
              (line, index) =>
                `${index + 1}. ${line.replace(/^\d+\.\s+/, "")}`,
              "List item"
            );
            break;
        }
      }


