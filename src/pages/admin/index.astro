      function getFilteredEvents() {

        const search =
          $("#events-search")
            .value
            .trim()
            .toLowerCase();


        return state.events.filter(
          (
            event
          ) => {

            const matchesSearch =
              !search ||
              [
                event.title,
                event.city,
                event.venue,
                event.description
              ]
                .filter(
                  Boolean
                )
                .some(
                  (
                    value
                  ) =>
                    String(
                      value
                    )
                      .toLowerCase()
                      .includes(
                        search
                      )
                );


            if (
              !matchesSearch
            ) {
              return false;
            }


            if (
              state.eventFilter ===
                "all"
            ) {
              return true;
            }


            if (
              state.eventFilter ===
                "draft" ||
              state.eventFilter ===
                "archived"
            ) {

              return event.status ===
                state.eventFilter;

            }


            if (
              event.status ===
                "archived"
            ) {
              return false;
            }


            return getEventTimeState(
              event
            ) ===
              state.eventFilter;

          }
        );

      }


      function renderEvents() {

        const container =
          $("#events-list");

        const events =
          getFilteredEvents();


        if (
          events.length === 0
        ) {

          container.innerHTML =
            `
              <div class="empty-state">
                <strong>No events found</strong>
                Add an event or change the current filter.
              </div>
            `;

          return;
        }


        container.innerHTML =
          events
            .map(
              (
                event
              ) => {

                const timeState =
                  getEventTimeState(
                    event
                  );


                return `
                  <div class="content-row">
                    <div>
                      <h3 class="row-title">
                        ${escapeHtml(event.title)}
                      </h3>

                      <div class="row-meta">
                        <span>${escapeHtml(formatDate(event.start_date))}</span>
                        ${event.city ? `<span>•</span><span>${escapeHtml(event.city)}</span>` : ""}
                        <span>•</span>
                        <span>${escapeHtml(timeState)}</span>
                        <span class="status-pill ${escapeHtml(event.status)}">
