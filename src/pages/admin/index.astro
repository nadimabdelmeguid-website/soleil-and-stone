      async function saveRecap() {

        const existingId =
          $("#recap-record-id").value;

        const title =
          $("#recap-title").value.trim();

        const publishingMode =
          $("#recap-status").value;

        const publicationInput =
          $("#recap-published-at").value;

        let status = publishingMode;
        let publishedAt = null;

        if (publishingMode === "scheduled") {
          if (!publicationInput) {
            throw new Error("Choose a future publication date and time.");
          }

          const scheduledDate = new Date(publicationInput);

          if (
            Number.isNaN(scheduledDate.getTime()) ||
            scheduledDate.getTime() <= Date.now()
          ) {
            throw new Error("The scheduled publication date must be in the future.");
          }

          // Store scheduled recaps as published with a future timestamp.
          // Supabase RLS keeps them private until published_at <= now().
          status = "published";
          publishedAt = scheduledDate.toISOString();
        } else if (publishingMode === "published") {
          status = "published";

          const existingItem = existingId
            ? state.recaps.find((item) => item.id === existingId)
            : null;

          const existingPublishTime = existingItem?.published_at
            ? new Date(existingItem.published_at)
            : null;

          publishedAt =
            existingPublishTime &&
            Number.isFinite(existingPublishTime.getTime()) &&
            existingPublishTime.getTime() <= Date.now()
              ? existingPublishTime.toISOString()
              : new Date().toISOString();
        } else if (publishingMode === "archived") {
          status = "archived";

          const existingItem = existingId
            ? state.recaps.find((item) => item.id === existingId)
            : null;

          publishedAt = existingItem?.published_at || null;
        } else {
          status = "draft";
          publishedAt = null;
        }


        const payload = {
          event_id:
            $("#recap-event-id").value,
          title,
          excerpt:
            $("#recap-excerpt").value.trim() || null,
          content_markdown:
            $("#recap-content").value,
          hero_media_id:
            $("#recap-hero-media").value || null,
          reading_minutes:
            $("#recap-reading-minutes").value
              ? Number($("#recap-reading-minutes").value)
              : null,
          eyebrow:
            $("#recap-eyebrow").value.trim() || "Event Recap",
          tags:
            parseRecapTags($("#recap-tags").value),
          stats:
            parseRecapStats($("#recap-stats").value),
          photo_credit:
            getRecapPhotoCreditFromForm(),
          seo_title:
            $("#recap-seo-title").value.trim() || title,
          seo_description:
            $("#recap-seo-description").value.trim() ||
            $("#recap-excerpt").value.trim() ||
            null,
          published_at:
            publishedAt,
          status
        };


        let response;


        if (
          existingId
        ) {

          response =
            await supabase
              .from("event_recaps")
              .update(payload)
              .eq("id", existingId);

        } else {

          response =
            await supabase
              .from("event_recaps")
              .insert({
                slug:
                  `${slugify(title)}-${crypto.randomUUID().slice(0, 6)}`,
                ...payload
              });

        }


        if (
          response.error
        ) {
          throw response.error;
        }


        closeModal("recap");
        showToast(existingId ? "Recap updated." : "Recap created.");
        await loadRecaps();
        refreshCounts();
        renderRecentContent();

      }


