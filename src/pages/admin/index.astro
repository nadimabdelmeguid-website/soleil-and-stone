                    </option>
                  </select>
                  <button class="quiet-button" type="button" data-cover-upload="field-note-hero-media" data-cover-target="field-notes" style="margin-top: 8px;">Upload new hero image</button>
                  <input id="field-note-hero-upload" class="hidden" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/avif" />
                </div>

                <div class="form-field">
                  <label class="label" for="field-note-reading-minutes">
                    Reading time (minutes)
                  </label>
                  <input
                    id="field-note-reading-minutes"
                    class="input"
                    type="number"
                    min="1"
                    step="1"
                  />
                </div>

                <details class="form-field full seo-settings">
                  <summary>
                    Advanced & SEO settings (optional)
                  </summary>
                  <div class="seo-settings-body">
                    <p class="field-help" style="margin-bottom: 14px;">
                      These control how the Field Note can appear in Google and link previews. Leave them blank and the CMS will automatically use the article title and short description.
                    </p>
                    <div class="form-grid">
                      <div class="form-field full">
                        <label class="label" for="field-note-legacy-url">
                          Previous URL (optional)
                        </label>
                        <input
                          id="field-note-legacy-url"
                          class="input"
                          type="text"
                          placeholder="/blogs/old-article-url.html"
                        />
