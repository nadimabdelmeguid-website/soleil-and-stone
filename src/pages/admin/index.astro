      function getContentMissingFields(item) {

        const missing = [];

        const blank =
          (value) =>
            value === null ||
            value === undefined ||
            String(value).trim() === "";


        if (
          item.contentSection === "events"
        ) {

          if (blank(item.start_date)) {
            missing.push("Date");
          }

          if (blank(item.event_type)) {
            missing.push("Event type");
          }

          if (blank(item.type_label)) {
            missing.push("Display label");
          }

          if (blank(item.description)) {
            missing.push("Description");
          }

          if (
            blank(item.venue) &&
            blank(item.city)
          ) {
            missing.push("Location");
          }

          if (!item.cover_media_id) {
            missing.push("Primary image");
          }

          const led =
            item.participation === "hosted" ||
            item.participation === "co-organized";

          if (
            led &&
            (
              item.registrations === null ||
              item.registrations === undefined
            )
          ) {
            missing.push("Registrations");
          }

          if (
            led &&
            ["hardware-meetup", "startup-mixer"].includes(
              item.community_id || ""
            ) &&
            !item.community_track_media_id
          ) {
            missing.push("Community image");
          }

          const isIndustryEvent =
            item.event_type === "trade-show" ||
            item.participation === "exhibitor" ||
            String(item.type_label || "")
              .toLowerCase()
              .includes("trade show");

          if (
            isIndustryEvent &&
            !item.industry_logo_media_id
          ) {
            missing.push("Industry event logo");
          }

        } else if (
          item.contentSection === "field-notes"
        ) {

          if (blank(item.category)) {
            missing.push("Category");
          }

          if (blank(item.excerpt)) {
            missing.push("Short description");
          }

          if (blank(item.content_markdown)) {
            missing.push("Article content");
          }

          if (!item.hero_media_id) {
            missing.push("Hero image");
          }

          if (
            item.reading_minutes === null ||
            item.reading_minutes === undefined ||
            Number(item.reading_minutes) <= 0
          ) {
            missing.push("Reading time");
          }

          if (
            item.status === "published" &&
            !item.published_at
          ) {
            missing.push("Publication date");
          }

        } else if (
          item.contentSection === "recaps"
        ) {

          if (!item.event_id) {
            missing.push("Linked event");
          }

          if (blank(item.excerpt)) {
            missing.push("Short description");
          }

          if (blank(item.content_markdown)) {
            missing.push("Recap content");
          }

          if (!item.hero_media_id) {
            missing.push("Hero image");
          }

          if (
            item.reading_minutes === null ||
            item.reading_minutes === undefined ||
            Number(item.reading_minutes) <= 0
          ) {
            missing.push("Reading time");
          }

          if (
            item.status === "published" &&
            !item.published_at
          ) {
            missing.push("Publication date");
          }

        }


        return missing;

      }


      function recentPaginationTokens(
        currentPage,
        totalPages
      ) {

        if (
          totalPages <= 7
        ) {
          return Array.from(
            {
              length:
                totalPages
            },
            (
              _,
              index
            ) =>
              index + 1
          );
        }


        const tokens = [
          1
        ];

        const start =
          Math.max(
            2,
            currentPage - 1
          );

        const end =
          Math.min(
            totalPages - 1,
            currentPage + 1
          );


        if (
          start > 2
        ) {
          tokens.push(
            "ellipsis-start"
          );
        }


        for (
          let page = start;
          page <= end;
          page += 1
        ) {
          tokens.push(
            page
          );
        }


        if (
          end <
          totalPages - 1
        ) {
          tokens.push(
            "ellipsis-end"
          );
        }


        tokens.push(
          totalPages
        );


        return tokens;

      }


      function renderRecentContent() {

        const allItems = [
          ...state.events.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Event",
              contentSection:
                "events"
            })
          ),

          ...state.fieldNotes.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Field Note",
              contentSection:
                "field-notes"
            })
          ),

          ...state.recaps.map(
            (
              item
            ) => ({
              ...item,
              contentType:
                "Recap",
              contentSection:
                "recaps"
            })
          )
        ];


        const filteredItems =
          (
            state.recentFilter === "all"
              ? allItems
              : allItems.filter(
                  (
                    item
                  ) =>
                    item.contentSection ===
                    state.recentFilter
                )
          )
            .sort(
              (
                a,
                b
              ) =>
                new Date(
                  b.updated_at ||
                  b.created_at ||
                  0
                ).getTime() -
                new Date(
                  a.updated_at ||
                  a.created_at ||
                  0
                ).getTime()
            );


        const pageSize =
          state.recentPageSize ||
          25;

        const totalItems =
          filteredItems.length;

        const totalPages =
          Math.max(
            1,
            Math.ceil(
              totalItems /
              pageSize
            )
          );


        state.recentPage =
          Math.min(
            Math.max(
              1,
              state.recentPage ||
              1
            ),
            totalPages
          );


        const pageStart =
          (
            state.recentPage -
            1
          ) *
          pageSize;

        const pageEnd =
          Math.min(
            pageStart +
            pageSize,
            totalItems
          );

        const items =
          filteredItems.slice(
            pageStart,
            pageEnd
          );


        const container =
          $("#recent-content-list");

        const pagination =
          $("#recent-content-pagination");

        const pageSummary =
          $("#recent-content-page-summary");

        const pageButtons =
          $("#recent-content-page-buttons");


        if (
          items.length === 0
        ) {

          container.innerHTML =
            `
              <div class="empty-state">
                <strong>No matching recent content</strong>
                Try another filter or create a new item.
              </div>
            `;

          pagination?.classList.add(
            "hidden"
          );

          return;
        }


        container.innerHTML =
          items
            .map(
              (
                item
              ) => {
                const itemDate =
                  item.updated_at ||
                  item.created_at;

                const dateLabel =
                  itemDate
                    ? formatDate(
                        itemDate
                      )
                    : "";

                const displayStatus =
                  item.contentSection === "field-notes"
                    ? fieldNoteDisplayStatus(item)
                    : {
                        mode: item.status || "published",
                        label: item.status || "published"
                      };

                const missingFields =
                  getContentMissingFields(
                    item
                  );

                const missingAlert =
                  missingFields.length
                    ? `
                        <div
                          class="content-completeness-alert"
                          title="This is a soft content-quality reminder. It does not block publishing."
                        >
                          <span>
                            <strong>Missing information:</strong>
                            ${escapeHtml(missingFields.join(", "))}
                          </span>
                        </div>
                      `
                    : "";

                return `
                  <div class="content-row recent-content-row">
                    <div class="recent-content-main">
                      <div class="recent-content-topline">
                        <span class="content-type-pill">
                          ${escapeHtml(item.contentType)}
                        </span>

                        ${
                          dateLabel
                            ? `<span class="recent-content-date">${escapeHtml(dateLabel)}</span>`
                            : ""
                        }
                      </div>

                      <h3 class="row-title">
                        ${escapeHtml(item.title || item.file_name || "Untitled")}
                      </h3>

                      <div class="row-meta">
                        <span class="status-pill ${escapeHtml(displayStatus.mode)}">
                          ${escapeHtml(displayStatus.label)}
                        </span>
                      </div>

                      ${missingAlert}
                    </div>

                    <div class="row-actions">
                      <button
                        class="secondary-button recent-edit-button"
                        type="button"
                        data-recent-edit-section="${escapeHtml(item.contentSection)}"
                        data-recent-edit-id="${escapeHtml(item.id)}"
                      >
                        Edit
                      </button>
                    </div>
                  </div>
                `;
              }
            )
            .join(
              ""
            );


        if (
          pagination &&
          pageSummary &&
          pageButtons
        ) {

          pagination.classList.remove(
            "hidden"
          );

          pageSummary.textContent =
            totalItems === 1
              ? "Showing 1 of 1 item"
              : `Showing ${pageStart + 1}–${pageEnd} of ${totalItems} items · Page ${state.recentPage} of ${totalPages}`;


          const tokens =
            recentPaginationTokens(
              state.recentPage,
              totalPages
            );


          pageButtons.innerHTML =
            `
              <button
                class="recent-page-button"
                type="button"
                data-recent-page="${state.recentPage - 1}"
                ${state.recentPage <= 1 ? "disabled" : ""}
              >
                Previous
              </button>

              ${
                tokens
                  .map(
                    (
                      token
                    ) =>
                      typeof token === "number"
                        ? `
                            <button
                              class="recent-page-button ${token === state.recentPage ? "active" : ""}"
                              type="button"
                              data-recent-page="${token}"
                              aria-label="Go to recent content page ${token}"
                              ${token === state.recentPage ? 'aria-current="page"' : ""}
                            >
                              ${token}
                            </button>
                          `
                        : `
                            <span class="recent-page-ellipsis" aria-hidden="true">
                              …
                            </span>
                          `
                  )
                  .join("")
              }

              <button
                class="recent-page-button"
                type="button"
                data-recent-page="${state.recentPage + 1}"
                ${state.recentPage >= totalPages ? "disabled" : ""}
              >
                Next
              </button>
            `;

        }

      }


