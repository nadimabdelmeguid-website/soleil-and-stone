      $("#login-form").addEventListener(
        "submit",
        async (
          event
        ) => {

          event.preventDefault();


          const email =
            $("#login-email")
              .value
              .trim();

          const button =
            $("#login-submit");

          const message =
            $("#login-message");


          setButtonLoading(
            button,
            true,
            "Sending...",
            "Send secure login link"
          );


          try {

            await sendLoginLink(
              email
            );

            message.textContent =
              "Check your inbox. Your secure login link is on the way.";

            message.className =
              "form-message success";

          } catch (
            error
          ) {

            message.textContent =
              error?.message ||
              "Could not send the login link.";

            message.className =
              "form-message error";

          } finally {

            setButtonLoading(
              button,
              false,
              "Sending...",
              "Send secure login link"
            );

          }

        }
      );


