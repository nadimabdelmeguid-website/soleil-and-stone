---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import {
  events
} from "../data/events";

import {
  isCompletedEvent,
  getParticipationPriority,
  getProfessionalMetrics
} from "../utils/eventMetrics";


const now =
  new Date();


/* =========================================================
   FIELD NOTES
   ========================================================= */

const posts =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    );


/* =========================================================
   EVENTS
   ========================================================= */

const completedEvents =
  events
    .filter(
      isCompletedEvent
    )
    .sort(
      (a, b) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() ||
        getParticipationPriority(b) -
        getParticipationPriority(a)
    );


const upcomingEvents =
  events
    .filter(
      (event) =>
        !isCompletedEvent(
          event
        )
    )
    .sort(
      (a, b) =>
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime()
    );


/* =========================================================
   DYNAMIC PROFESSIONAL METRICS
   ========================================================= */

const metrics =
  getProfessionalMetrics(
    events
  );


/* =========================================================
   FILTER OPTIONS
   ========================================================= */

const years =
  Array.from(
    new Set(
      completedEvents.map(
        (event) =>
          new Date(
            `${event.startDate}T12:00:00`
          ).getFullYear()
      )
    )
  )
    .sort(
      (a, b) =>
        b - a
    );


const months =
  [
    {
      value: "0",
      label: "January"
    },
    {
      value: "1",
      label: "February"
    },
    {
      value: "2",
      label: "March"
    },
    {
      value: "3",
      label: "April"
    },
    {
      value: "4",
      label: "May"
    },
    {
      value: "5",
      label: "June"
    },
    {
      value: "6",
      label: "July"
    },
    {
      value: "7",
      label: "August"
    },
    {
      value: "8",
      label: "September"
    },
    {
      value: "9",
      label: "October"
    },
    {
      value: "10",
      label: "November"
    },
    {
      value: "11",
      label: "December"
    }
  ];


/* =========================================================
   HELPERS
   ========================================================= */

function eventNotes(
  eventId: string
) {

  return posts.filter(
    (post) =>
      post.data.relatedEvents
        ?.includes(
          eventId
        )
  );

}


function parseDate(
  value: string
) {

  return new Date(
    `${value}T12:00:00`
  );

}


function formatDate(
  event
) {

  const start =
    parseDate(
      event.startDate
    );


  const end =
    event.endDate
      ? parseDate(
          event.endDate
        )
      : null;


  if (
    !end
  ) {

    return start.toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric",

        year:
          "numeric"
      }
    );

  }


  if (
    start.getMonth() ===
      end.getMonth() &&
    start.getFullYear() ===
      end.getFullYear()
  ) {

    return `${start.toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric"
      }
    )}–${end.getDate()}, ${end.getFullYear()}`;

  }


  return `${start.toLocaleDateString(
    "en-US",
    {
      month:
        "short",

      day:
        "numeric",

      year:
        "numeric"
    }
  )} – ${end.toLocaleDateString(
    "en-US",
    {
      month:
        "short",

      day:
        "numeric",

      year:
        "numeric"
    }
  )}`;

}


function labelFor(
  event
) {

  if (
    event.participation ===
      "hosted"
  ) {

    return "Hosted";

  }


  if (
    event.participation ===
      "co-organized"
  ) {

    return "Co-Organized";

  }


  if (
    event.participation ===
      "exhibitor"
  ) {

    return "Exhibitor";

  }


  return "Attended";

}


function labelClass(
  event
) {

  if (
    event.participation ===
      "hosted" ||
    event.participation ===
      "co-organized"
  ) {

    return "text-brand-gold";

  }


  if (
    event.participation ===
      "exhibitor"
  ) {

    return "text-brand-charcoal";

  }


  return "text-brand-slate";

}
---

<BaseLayout
  title="Industry Fieldwork | Soleil & Stone"
  description="A record of trade shows, technical communities and ecosystem events shaping my view of how hardware reaches the market."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Industry Fieldwork
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          text-brand-charcoal
          mt-2
          mb-6
        "
      >
        Learning From The Field
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          font-light
          leading-relaxed
          max-w-3xl
        "
      >
        Trade shows, technical communities, founder gatherings,
        and industry programs shaping my view of how hardware
        moves from engineering decisions to commercialization
        and real-world adoption.
      </p>

    </div>

  </section>



  <!-- =====================================================
       DYNAMIC IMPACT METRICS
       ===================================================== -->

  <section
    class="
      border-y
      border-brand-border
      bg-brand-cream
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-10
      "
    >

      <div
        class="
          grid
          grid-cols-2
          lg:grid-cols-4
          bg-white
          border
          border-brand-border
        "
      >

        <!-- EVENTS LED -->

        <div
          class="
            p-5
            sm:p-6
            border-r
            border-b
            border-brand-border
            lg:border-b-0
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.led}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Events Led / Co-Organized
          </div>

        </div>



        <!-- REGISTRATIONS -->

        <div
          class="
            p-5
            sm:p-6
            border-b
            border-brand-border
            lg:border-b-0
            lg:border-r
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.registrationsLed}+
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Documented Registrations
          </div>

        </div>



        <!-- SPEAKERS -->

        <div
          class="
            p-5
            sm:p-6
            border-r
            border-brand-border
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.speakers}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Speakers
          </div>

        </div>



        <!-- ORGANIZATIONS -->

        <div
          class="
            p-5
            sm:p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.organizationsEngaged}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Organizations Engaged
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       UPCOMING
       ===================================================== -->

  {
    upcomingEvents.length > 0 && (

      <section
        class="
          bg-white
          border-b
          border-brand-border
        "
      >

        <div
          class="
            max-w-6xl
            w-full
            mx-auto
            px-6
            py-14
          "
        >

          <div
            class="
              flex
              items-end
              justify-between
              gap-6
              mb-6
            "
          >

            <div>

              <span
                class="
                  text-[10px]
                  uppercase
                  tracking-[0.18em]
                  text-brand-gold
                  font-semibold
                "
              >
                Upcoming
              </span>


              <h2
                class="
                  font-serif
                  text-3xl
                  text-brand-charcoal
                  mt-2
                "
              >
                Upcoming Fieldwork
              </h2>

            </div>


            {
              upcomingEvents.length > 3 && (

                <span
                  class="
                    hidden
                    sm:block
                    text-[9px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-slate
                  "
                >
                  Scroll To Explore →
                </span>

              )
            }

          </div>



          <div
            class="
              overflow-x-auto
              pb-3
              custom-scrollbar
            "
          >

            <div
              class="
                grid
                grid-flow-col
                auto-cols-[86%]
                sm:auto-cols-[48%]
                lg:auto-cols-[calc((100%-2.5rem)/3)]
                gap-5
              "
            >

              {
                upcomingEvents.map(
                  (event) => (

                    <a
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="
                        block
                        bg-brand-cream
                        border
                        border-brand-border
                        p-6
                        hover:border-brand-gold
                        transition-colors
                      "
                    >

                      <div
                        class="
                          flex
                          items-center
                          justify-between
                          gap-4
                        "
                      >

                        <span
                          class:list={[
                            "text-[9px]",
                            "uppercase",
                            "tracking-[0.14em]",
                            "font-semibold",
                            labelClass(event)
                          ]}
                        >
                          {labelFor(event)}
                        </span>


                        <span
                          class="
                            text-[9px]
                            text-brand-slate
                          "
                        >
                          ↗
                        </span>

                      </div>


                      <h3
                        class="
                          font-serif
                          text-lg
                          sm:text-xl
                          text-brand-charcoal
                          mt-4
                          leading-snug
                        "
                      >
                        {event.title}
                      </h3>


                      <p
                        class="
                          text-xs
                          text-brand-slate
                          mt-4
                        "
                      >
                        {formatDate(event)}
                      </p>


                      {
                        event.city && (

                          <p
                            class="
                              text-xs
                              text-brand-slate
                              mt-1
                            "
                          >
                            {event.city}
                          </p>

                        )
                      }

                    </a>

                  )
                )
              }

            </div>

          </div>

        </div>

      </section>

    )
  }



  <!-- =====================================================
       ARCHIVE
       ===================================================== -->

  <section
    class="
      bg-brand-cream
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-16
      "
    >

      <!-- ARCHIVE HEADER -->

      <div
        class="
          flex
          flex-col
          lg:flex-row
          lg:items-end
          justify-between
          gap-8
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.18em]
              text-brand-gold
              font-semibold
            "
          >
            Archive
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
            "
          >
            Past Fieldwork
          </h2>

        </div>



        <!-- FILTERS -->

        <div
          class="
            flex
            flex-col
            sm:flex-row
            gap-3
            w-full
            lg:w-auto
          "
        >

          <div
            class="
              min-w-[160px]
            "
          >

            <label
              for="fieldwork-year"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              Year
            </label>


            <select
              id="fieldwork-year"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option
                value="all"
              >
                All Years
              </option>


              {
                years.map(
                  (year) => (

                    <option
                      value={String(year)}
                    >
                      {year}
                    </option>

                  )
                )
              }

            </select>

          </div>



          <div
            class="
              min-w-[180px]
            "
          >

            <label
              for="fieldwork-month"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              Month
            </label>


            <select
              id="fieldwork-month"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option
                value="all"
              >
                All Months
              </option>


              {
                months.map(
                  (month) => (

                    <option
                      value={month.value}
                    >
                      {month.label}
                    </option>

                  )
                )
              }

            </select>

          </div>

        </div>

      </div>



      <!-- RESULT COUNT -->

      <div
        class="
          flex
          items-center
          justify-between
          gap-4
          mb-5
          pb-4
          border-b
          border-brand-border
        "
      >

        <span
          id="fieldwork-result-count"
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >
          {completedEvents.length}
          {" "}
          Events
        </span>


        <button
          id="fieldwork-reset"
          type="button"
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-charcoal
            font-semibold
            hover:text-brand-gold
            transition-colors
          "
        >
          Reset Filters
        </button>

      </div>



      <!-- EVENT ARCHIVE -->

      <div
        id="fieldwork-archive"
        class="
          space-y-3
        "
      >

        {
          completedEvents.map(
            (event) => {

              const relatedNotes =
                eventNotes(
                  event.id
                );


              const eventDate =
                parseDate(
                  event.startDate
                );


              const eventYear =
                eventDate.getFullYear();


              const eventMonth =
                eventDate.getMonth();


              return (

                <details
                  class="
                    fieldwork-event
                    group
                    bg-white
                    border
                    border-brand-border
                    open:border-brand-gold
                    transition-colors
                  "
                  data-year={String(eventYear)}
                  data-month={String(eventMonth)}
                >

                  <summary
                    class="
                      list-none
                      cursor-pointer
                      px-5
                      py-5
                      sm:px-6
                      flex
                      flex-col
                      sm:flex-row
                      sm:items-center
                      gap-4
                      sm:gap-6
                    "
                  >

                    <div
                      class="
                        sm:w-[165px]
                        sm:shrink-0
                      "
                    >

                      <span
                        class:list={[
                          "text-[9px]",
                          "uppercase",
                          "tracking-[0.15em]",
                          "font-semibold",
                          labelClass(event)
                        ]}
                      >
                        {labelFor(event)}
                      </span>


                      <p
                        class="
                          text-[11px]
                          text-brand-slate
                          mt-1.5
                        "
                      >
                        {formatDate(event)}
                      </p>

                    </div>



                    <div
                      class="
                        flex-1
                        min-w-0
                      "
                    >

                      <h3
                        class="
                          font-serif
                          text-lg
                          sm:text-xl
                          text-brand-charcoal
                          leading-snug
                        "
                      >
                        {event.title}
                      </h3>


                      {
                        event.city && (

                          <p
                            class="
                              text-[10px]
                              text-brand-slate
                              mt-1
                            "
                          >
                            {event.city}
                          </p>

                        )
                      }

                    </div>



                    <div
                      class="
                        flex
                        items-center
                        gap-4
                        sm:justify-end
                        sm:min-w-[150px]
                      "
                    >

                      {
                        typeof event.registrations ===
                          "number" && (

                          <span
                            class="
                              text-[9px]
                              uppercase
                              tracking-[0.12em]
                              text-brand-gold
                              font-semibold
                            "
                          >
                            {event.registrations}
                            {" "}
                            Registrations
                          </span>

                        )
                      }


                      <span
                        class="
                          text-lg
                          text-brand-charcoal
                          transition-transform
                          group-open:rotate-45
                        "
                      >
                        +
                      </span>

                    </div>

                  </summary>



                  <div
                    class="
                      border-t
                      border-brand-border
                      px-5
                      py-6
                      sm:px-6
                      sm:py-7
                    "
                  >

                    <div
                      class="
                        grid
                        lg:grid-cols-12
                        gap-8
                      "
                    >

                      <!-- EVENT DETAILS -->

                      <div
                        class="
                          lg:col-span-8
                        "
                      >

                        {
                          event.description && (

                            <p
                              class="
                                text-sm
                                text-brand-slate
                                leading-relaxed
                                font-light
                                max-w-2xl
                              "
                            >
                              {event.description}
                            </p>

                          )
                        }



                        {
                          (
                            event.sponsors?.length > 0 ||
                            event.partners?.length > 0
                          ) && (

                            <div
                              class="
                                mt-6
                                flex
                                flex-col
                                gap-2
                              "
                            >

                              {
                                event.sponsors?.length > 0 && (

                                  <p
                                    class="
                                      text-xs
                                      text-brand-slate
                                    "
                                  >
                                    Sponsored by:
                                    {" "}

                                    <span
                                      class="
                                        text-brand-charcoal
                                        font-semibold
                                      "
                                    >
                                      {
                                        event.sponsors.join(
                                          ", "
                                        )
                                      }
                                    </span>
                                  </p>

                                )
                              }


                              {
                                event.partners?.length > 0 && (

                                  <p
                                    class="
                                      text-xs
                                      text-brand-slate
                                    "
                                  >
                                    Event collaborators:
                                    {" "}

                                    <span
                                      class="
                                        text-brand-charcoal
                                        font-semibold
                                      "
                                    >
                                      {
                                        event.partners.join(
                                          ", "
                                        )
                                      }
                                    </span>
                                  </p>

                                )
                              }

                            </div>

                          )
                        }



                        {
                          event.speakers?.length > 0 && (

                            <div
                              class="
                                mt-7
                                pt-6
                                border-t
                                border-brand-border
                              "
                            >

                              <p
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.14em]
                                  text-brand-gold
                                  font-semibold
                                  mb-3
                                "
                              >
                                Speakers
                              </p>


                              <div
                                class="
                                  grid
                                  md:grid-cols-2
                                  gap-x-8
                                  gap-y-2
                                "
                              >

                                {
                                  event.speakers.map(
                                    (speaker) => (

                                      <p
                                        class="
                                          text-xs
                                          text-brand-slate
                                          leading-relaxed
                                        "
                                      >

                                        <span
                                          class="
                                            text-brand-charcoal
                                            font-semibold
                                          "
                                        >
                                          {speaker.name}
                                        </span>


                                        {
                                          speaker.title
                                            ? ` · ${speaker.title}`
                                            : ""
                                        }


                                        {" · "}

                                        {speaker.company}

                                      </p>

                                    )
                                  )
                                }

                              </div>

                            </div>

                          )
                        }

                      </div>



                      <!-- LINKS -->

                      <div
                        class="
                          lg:col-span-4
                          lg:border-l
                          lg:border-brand-border
                          lg:pl-8
                      "
                      >

                        <a
                          href={event.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="
                            inline-flex
                            items-center
                            gap-2
                            text-[10px]
                            uppercase
                            tracking-[0.15em]
                            font-semibold
                            text-brand-charcoal
                            hover:text-brand-gold
                            transition-colors
                          "
                        >
                          View Event

                          <span>
                            ↗
                          </span>
                        </a>



                        {
                          relatedNotes.length > 0 && (

                            <div
                              class="
                                mt-7
                                pt-6
                                border-t
                                border-brand-border
                              "
                            >

                              <div
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.14em]
                                  text-brand-gold
                                  font-semibold
                                  mb-3
                                "
                              >
                                Related Field Notes
                              </div>


                              <div
                                class="
                                  space-y-3
                                "
                              >

                                {
                                  relatedNotes.map(
                                    (post) => (

                                      <a
                                        href={`/field-notes/${post.id}/`}
                                        class="
                                          block
                                          text-xs
                                          text-brand-charcoal
                                          hover:text-brand-gold
                                          transition-colors
                                        "
                                      >
                                        {post.data.title}
                                        {" "}
                                        →
                                      </a>

                                    )
                                  )
                                }

                              </div>

                            </div>

                          )
                        }

                      </div>

                    </div>

                  </div>

                </details>

              );

            }
          )
        }

      </div>



      <!-- EMPTY STATE -->

      <div
        id="fieldwork-empty"
        class="
          hidden
          bg-white
          border
          border-brand-border
          px-6
          py-10
          text-center
        "
      >

        <p
          class="
            font-serif
            text-xl
            text-brand-charcoal
          "
        >
          No events found.
        </p>


        <p
          class="
            text-xs
            text-brand-slate
            mt-2
          "
        >
          Try selecting a different year or month.
        </p>

      </div>

    </div>

  </section>



  <!-- =====================================================
       FILTER SCRIPT
       ===================================================== -->

  <script is:inline>

    (() => {

      const yearSelect =
        document.getElementById(
          "fieldwork-year"
        );


      const monthSelect =
        document.getElementById(
          "fieldwork-month"
        );


      const resetButton =
        document.getElementById(
          "fieldwork-reset"
        );


      const resultCount =
        document.getElementById(
          "fieldwork-result-count"
        );


      const emptyState =
        document.getElementById(
          "fieldwork-empty"
        );


      const events =
        Array.from(
          document.querySelectorAll(
            ".fieldwork-event"
          )
        );


      if (
        !yearSelect ||
        !monthSelect
      ) {

        return;

      }



      function applyFilters() {

        const selectedYear =
          yearSelect.value;


        const selectedMonth =
          monthSelect.value;


        let visibleCount =
          0;


        events.forEach(
          (event) => {

            const matchesYear =
              selectedYear ===
                "all" ||
              event.dataset.year ===
                selectedYear;


            const matchesMonth =
              selectedMonth ===
                "all" ||
              event.dataset.month ===
                selectedMonth;


            const visible =
              matchesYear &&
              matchesMonth;


            event.classList.toggle(
              "hidden",
              !visible
            );


            if (
              event.open
            ) {

              event.open =
                false;

            }


            if (
              visible
            ) {

              visibleCount +=
                1;

            }

          }
        );


        if (
          resultCount
        ) {

          resultCount.textContent =
            `${visibleCount} ${
              visibleCount ===
                1
                ? "Event"
                : "Events"
            }`;

        }


        if (
          emptyState
        ) {

          emptyState.classList.toggle(
            "hidden",
            visibleCount !==
              0
          );

        }

      }



      yearSelect.addEventListener(
        "change",
        applyFilters
      );


      monthSelect.addEventListener(
        "change",
        applyFilters
      );


      resetButton?.addEventListener(
        "click",
        () => {

          yearSelect.value =
            "all";


          monthSelect.value =
            "all";


          applyFilters();

        }
      );


      applyFilters();

    })();

  </script>

</BaseLayout>
