---
import {
  getCollection
} from "astro:content";

import {
  readdir
} from "node:fs/promises";

import path from "node:path";

import BaseLayout from "../layouts/BaseLayout.astro";

import {
  events
} from "../data/events";

import {
  isCompletedEvent,
  getParticipationPriority,
  getProfessionalMetrics
} from "../utils/eventMetrics";


const now =
  new Date();


/* =========================================================
   FIELD NOTES
   ========================================================= */

const posts =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    );


/* =========================================================
   EVENTS
   ========================================================= */

const completedEvents =
  events
    .filter(
      isCompletedEvent
    )
    .sort(
      (a, b) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() ||
        getParticipationPriority(b) -
        getParticipationPriority(a)
    );


const upcomingEvents =
  events
    .filter(
      (event) =>
        !isCompletedEvent(
          event
        )
    )
    .sort(
      (a, b) =>
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime()
    );


/* =========================================================
   DYNAMIC FIELDWORK METRICS
   ========================================================= */

const metrics =
  getProfessionalMetrics(
    events
  );


/* =========================================================
   FILTER OPTIONS
   ========================================================= */

const years =
  Array.from(
    new Set(
      completedEvents.map(
        (event) =>
          new Date(
            `${event.startDate}T12:00:00`
          ).getFullYear()
      )
    )
  )
    .sort(
      (a, b) =>
        b - a
    );


const months =
  [
    {
      value: "0",
      label: "January"
    },
    {
      value: "1",
      label: "February"
    },
    {
      value: "2",
      label: "March"
    },
    {
      value: "3",
      label: "April"
    },
    {
      value: "4",
      label: "May"
    },
    {
      value: "5",
      label: "June"
    },
    {
      value: "6",
      label: "July"
    },
    {
      value: "7",
      label: "August"
    },
    {
      value: "8",
      label: "September"
    },
    {
      value: "9",
      label: "October"
    },
    {
      value: "10",
      label: "November"
    },
    {
      value: "11",
      label: "December"
    }
  ];


/* =========================================================
   ADDITIONAL FILTER OPTIONS
   ========================================================= */

const cities =
  Array.from(
    new Set(
      completedEvents
        .map(
          (event) =>
            event.city
              ?.trim()
        )
        .filter(
          (city):
            city is string =>
              Boolean(
                city
              )
        )
    )
  )
    .sort(
      (a, b) =>
        a.localeCompare(
          b
        )
    );


/* =========================================================
   TRADE SHOW LOGOS

   Every supported image added to public/tradeshows is
   discovered automatically at build time.

   The file name is matched against completed trade-show
   events in events.ts. Examples:

   ces.png
   md&m-west.png
   isc-west.png
   aems.png
   cedia-expo.png

   A logo appears only after the matching event is completed,
   keeping this section focused on trade shows already attended.
   ========================================================= */

const tradeShowLogoDirectory =
  path.join(
    process.cwd(),
    "public",
    "tradeshows"
  );


let tradeShowLogoFiles:
  string[] = [];


try {

  tradeShowLogoFiles =
    (
      await readdir(
        tradeShowLogoDirectory
      )
    )
      .filter(
        (file) =>
          /\.(png|jpe?g|webp|svg)$/i
            .test(
              file
            )
      )
      .sort(
        (a, b) =>
          a.localeCompare(
            b
          )
      );

} catch {

  tradeShowLogoFiles =
    [];

}


/* =========================================================
   HELPERS
   ========================================================= */

function eventNotes(
  eventId: string
) {

  return posts.filter(
    (post) =>
      post.data.relatedEvents
        ?.includes(
          eventId
        )
  );

}


function parseDate(
  value: string
) {

  return new Date(
    `${value}T12:00:00`
  );

}


function formatDate(
  event
) {

  const start =
    parseDate(
      event.startDate
    );


  const end =
    event.endDate
      ? parseDate(
          event.endDate
        )
      : null;


  if (
    !end
  ) {

    return start.toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric",

        year:
          "numeric"
      }
    );

  }


  if (
    start.getMonth() ===
      end.getMonth() &&
    start.getFullYear() ===
      end.getFullYear()
  ) {

    return `${start.toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric"
      }
    )}–${end.getDate()}, ${end.getFullYear()}`;

  }


  return `${start.toLocaleDateString(
    "en-US",
    {
      month:
        "short",

      day:
        "numeric",

      year:
        "numeric"
    }
  )} – ${end.toLocaleDateString(
    "en-US",
    {
      month:
        "short",

      day:
        "numeric",

      year:
        "numeric"
    }
  )}`;

}


function labelFor(
  event
) {

  if (
    event.participation ===
      "hosted"
  ) {

    return "Hosted";

  }


  if (
    event.participation ===
      "co-organized"
  ) {

    return "Co-Organized";

  }


  if (
    event.participation ===
      "exhibitor"
  ) {

    return "Exhibitor";

  }


  return "Attended";

}


function labelClass(
  event
) {

  if (
    event.participation ===
      "hosted" ||
    event.participation ===
      "co-organized"
  ) {

    return "text-brand-gold";

  }


  if (
    event.participation ===
      "exhibitor"
  ) {

    return "text-brand-charcoal";

  }


  return "text-brand-slate";

}


/* =========================================================
   EVENT CATEGORY

   Used only for archive filtering. Existing event content
   remains unchanged.
   ========================================================= */

function eventCategory(
  event
) {

  const searchable =
    [
      event.title,
      event.typeLabel,
      event.description
    ]
      .filter(
        Boolean
      )
      .join(
        " "
      )
      .toLowerCase();


  if (
    event.eventType ===
      "trade-show" ||
    event.participation ===
      "exhibitor" ||
    searchable.includes(
      "trade show"
    ) ||
    searchable.includes(
      "expo"
    ) ||
    searchable.includes(
      "exhibition"
    )
  ) {

    return "trade-show";

  }


  if (
    event.communityId ||
    searchable.includes(
      "startup"
    ) ||
    searchable.includes(
      "founder"
    ) ||
    searchable.includes(
      "community"
    ) ||
    searchable.includes(
      "ecosystem"
    ) ||
    searchable.includes(
      "mixer"
    )
  ) {

    return "community";

  }


  if (
    searchable.includes(
      "hardware"
    ) ||
    searchable.includes(
      "engineering"
    ) ||
    searchable.includes(
      "technical"
    ) ||
    searchable.includes(
      "embedded"
    ) ||
    searchable.includes(
      "electronics"
    ) ||
    searchable.includes(
      "manufacturing"
    ) ||
    searchable.includes(
      "sensors"
    ) ||
    searchable.includes(
      "medtech"
    )
  ) {

    return "technical";

  }


  return "professional";

}


/* =========================================================
   TRADE SHOW HELPERS
   ========================================================= */

function isTradeShowEvent(
  event
) {

  return eventCategory(
    event
  ) ===
    "trade-show";

}


function normalizeTradeShowKey(
  value: string
) {

  return value
    .replace(
      /\.[^.]+$/,
      ""
    )
    .replace(
      /\b20\d{2}\b/g,
      ""
    )
    .toLowerCase()
    .replace(
      /[^a-z0-9]/g,
      ""
    );

}


function tradeShowAcronym(
  value: string
) {

  return value
    .replace(
      /\b20\d{2}\b/g,
      ""
    )
    .replace(
      /&/g,
      " "
    )
    .split(
      /[^A-Za-z0-9]+/
    )
    .filter(
      Boolean
    )
    .map(
      (word) =>
        word[0]
          ?.toLowerCase() ??
        ""
    )
    .join(
      ""
    );

}


function tradeShowMatchKeys(
  event
) {

  const title =
    event.title ??
    "";


  const normalized =
    normalizeTradeShowKey(
      title
    );


  const acronym =
    tradeShowAcronym(
      title
    );


  return Array.from(
    new Set(
      [
        normalized,
        acronym
      ]
        .filter(
          Boolean
        )
    )
  );

}


const completedTradeShows =
  completedEvents
    .filter(
      isTradeShowEvent
    )
    .sort(
      (a, b) =>
        parseDate(
          b.startDate
        ).getTime() -
        parseDate(
          a.startDate
        ).getTime()
    );


const tradeShowLogos =
  tradeShowLogoFiles
    .map(
      (file) => {

        const logoKey =
          normalizeTradeShowKey(
            file
          );


        const event =
          completedTradeShows.find(
            (candidate) => {

              const keys =
                tradeShowMatchKeys(
                  candidate
                );


              return keys.some(
                (key) =>
                  key ===
                    logoKey ||
                  key.includes(
                    logoKey
                  ) ||
                  logoKey.includes(
                    key
                  )
              );

            }
          );


        if (
          !event
        ) {

          return null;

        }


        return {

          file,

          src:
            `/tradeshows/${file}`,

          name:
            event.title,

          url:
            event.url,

          eventId:
            event.id

        };

      }
    )
    .filter(
      Boolean
    );


const tradeShowLogoLoop =
  tradeShowLogos;
---

<BaseLayout
  title="Industry Fieldwork | Soleil & Stone"
  description="A record of trade shows, technical communities and ecosystem events shaping my view of how hardware reaches the market."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Industry Fieldwork
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          text-brand-charcoal
          mt-2
          mb-6
        "
      >
        Learning From The Field
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          font-light
          leading-relaxed
          max-w-3xl
        "
      >
        Trade shows, technical communities, founder gatherings,
        and industry programs shaping my view of how hardware
        moves from engineering decisions to commercialization
        and real-world adoption.
      </p>

    </div>

  </section>



  <!-- =====================================================
       DYNAMIC FIELDWORK METRICS
       ===================================================== -->

  <section
    class="
      border-y
      border-brand-border
      bg-brand-cream
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-10
      "
    >

      <div
        class="
          grid
          grid-cols-2
          lg:grid-cols-4
          bg-white
          border
          border-brand-border
        "
      >

        <!-- PROFESSIONAL EVENTS -->

        <div
          class="
            p-5
            sm:p-6
            border-r
            border-b
            border-brand-border
            lg:border-b-0
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.total}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Professional Events
          </div>

        </div>



        <!-- TRADE SHOWS EXHIBITED -->

        <div
          class="
            p-5
            sm:p-6
            border-b
            border-brand-border
            lg:border-b-0
            lg:border-r
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.exhibited}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Trade Shows Exhibited
          </div>

        </div>



        <!-- ORGANIZATIONS -->

        <div
          class="
            p-5
            sm:p-6
            border-r
            border-brand-border
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.organizationsEngaged}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Organizations Engaged
          </div>

        </div>



        <!-- CITIES -->

        <div
          class="
            p-5
            sm:p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.cities}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Cities Across Fieldwork
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       UPCOMING
       ===================================================== -->

  {
    upcomingEvents.length > 0 && (

      <section
        class="
          bg-white
          border-b
          border-brand-border
        "
      >

        <div
          class="
            max-w-6xl
            w-full
            mx-auto
            px-6
            py-14
          "
        >

          <div
            class="
              flex
              items-end
              justify-between
              gap-6
              mb-6
            "
          >

            <div>

              <span
                class="
                  text-[10px]
                  uppercase
                  tracking-[0.18em]
                  text-brand-gold
                  font-semibold
                "
              >
                Upcoming
              </span>


              <h2
                class="
                  font-serif
                  text-3xl
                  text-brand-charcoal
                  mt-2
                "
              >
                Upcoming Fieldwork
              </h2>

            </div>


            {
              upcomingEvents.length > 3 && (

                <span
                  class="
                    hidden
                    sm:block
                    text-[9px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-slate
                  "
                >
                  Scroll To Explore →
                </span>

              )
            }

          </div>



          <div
            class="
              overflow-x-auto
              pb-3
              custom-scrollbar
            "
          >

            <div
              class="
                grid
                grid-flow-col
                auto-cols-[86%]
                sm:auto-cols-[48%]
                lg:auto-cols-[calc((100%-2.5rem)/3)]
                gap-5
              "
            >

              {
                upcomingEvents.map(
                  (event) => (

                    <a
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="
                        block
                        bg-brand-cream
                        border
                        border-brand-border
                        p-6
                        hover:border-brand-gold
                        transition-colors
                      "
                    >

                      <div
                        class="
                          flex
                          items-center
                          justify-between
                          gap-4
                        "
                      >

                        <span
                          class:list={[
                            "text-[9px]",
                            "uppercase",
                            "tracking-[0.14em]",
                            "font-semibold",
                            labelClass(event)
                          ]}
                        >
                          {labelFor(event)}
                        </span>


                        <span
                          class="
                            text-[9px]
                            text-brand-slate
                          "
                        >
                          ↗
                        </span>

                      </div>


                      <h3
                        class="
                          font-serif
                          text-lg
                          sm:text-xl
                          text-brand-charcoal
                          mt-4
                          leading-snug
                        "
                      >
                        {event.title}
                      </h3>


                      <p
                        class="
                          text-xs
                          text-brand-slate
                          mt-4
                        "
                      >
                        {formatDate(event)}
                      </p>


                      {
                        event.city && (

                          <p
                            class="
                              text-xs
                              text-brand-slate
                              mt-1
                            "
                          >
                            {event.city}
                          </p>

                        )
                      }

                    </a>

                  )
                )
              }

            </div>

          </div>

        </div>

      </section>

    )
  }



  <!-- =====================================================
       FEATURED TRADE SHOWS
       ===================================================== -->

  {
    tradeShowLogos.length > 0 && (

      <section
        class="
          bg-brand-cream
          border-b
          border-brand-border
          overflow-hidden
        "
      >

        <div
          class="
            max-w-6xl
            w-full
            mx-auto
            px-6
            pt-12
            pb-4
          "
        >

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.18em]
              text-brand-gold
              font-semibold
            "
          >
            Featured Trade Shows
          </span>


          <h2
            class="
              font-serif
              text-2xl
              sm:text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Industry Events I've Attended
          </h2>


          <p
            class="
              text-sm
              text-brand-slate
              font-light
              leading-relaxed
              max-w-2xl
              mt-3
            "
          >
            A selection of trade shows and industry exhibitions
            from my fieldwork since 2025.
          </p>

        </div>


        <div
          class="
            trade-show-marquee
            relative
            overflow-hidden
            py-8
          "
        >

          <div
            class="
              trade-show-fade
              trade-show-fade-left
            "
            aria-hidden="true"
          ></div>


          <div
            class="
              trade-show-fade
              trade-show-fade-right
            "
            aria-hidden="true"
          ></div>


          <div
            class="
              trade-show-track
              flex
              w-max
            "
          >

            {
              tradeShowLogoLoop.map(
                (logo) => (

                  <a
                    href={logo.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit ${logo.name}`}
                    class="
                      trade-show-logo-link
                      flex
                      items-center
                      justify-center
                      shrink-0
                    "
                  >

                    <div
                      class="
                        trade-show-logo-tile
                        flex
                        items-center
                        justify-center
                        bg-white
                        border
                        border-brand-border
                      "
                    >

                    <img
                      src={logo.src}
                      alt={`${logo.name} logo`}
                      loading="lazy"
                      class="
                        trade-show-logo
                        block
                        object-contain
                      "
                    />

                    </div>

                  </a>

                )
              )
            }

          </div>

        </div>

      </section>

    )
  }



  <!-- =====================================================
       ARCHIVE
       ===================================================== -->

  <section
    class="
      bg-brand-cream
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-16
      "
    >

      <div
        class="
          flex
          flex-col
          gap-8
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.18em]
              text-brand-gold
              font-semibold
            "
          >
            Archive
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
            "
          >
            Past Fieldwork
          </h2>

        </div>



        <div
          class="
            grid
            grid-cols-1
            sm:grid-cols-2
            lg:grid-cols-3
            xl:grid-cols-5
            gap-3
            w-full
          "
        >

          <!-- YEAR -->

          <div>

            <label
              for="fieldwork-year"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              Year
            </label>


            <select
              id="fieldwork-year"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option value="all">
                All Years
              </option>


              {
                years.map(
                  (year) => (

                    <option
                      value={String(year)}
                    >
                      {year}
                    </option>

                  )
                )
              }

            </select>

          </div>



          <!-- MONTH -->

          <div>

            <label
              for="fieldwork-month"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              Month
            </label>


            <select
              id="fieldwork-month"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option value="all">
                All Months
              </option>


              {
                months.map(
                  (month) => (

                    <option
                      value={month.value}
                    >
                      {month.label}
                    </option>

                  )
                )
              }

            </select>

          </div>



          <!-- PARTICIPATION -->

          <div>

            <label
              for="fieldwork-participation"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              Participation
            </label>


            <select
              id="fieldwork-participation"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option value="all">
                All Participation
              </option>

              <option value="hosted">
                Hosted
              </option>

              <option value="co-organized">
                Co-Organized
              </option>

              <option value="exhibitor">
                Exhibitor
              </option>

              <option value="attending">
                Attended
              </option>

            </select>

          </div>



          <!-- EVENT TYPE -->

          <div>

            <label
              for="fieldwork-type"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              Event Type
            </label>


            <select
              id="fieldwork-type"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option value="all">
                All Event Types
              </option>

              <option value="trade-show">
                Trade Shows
              </option>

              <option value="community">
                Community & Startup
              </option>

              <option value="technical">
                Hardware & Technical
              </option>

              <option value="professional">
                Professional
              </option>

            </select>

          </div>



          <!-- CITY -->

          <div>

            <label
              for="fieldwork-city"
              class="
                block
                text-[9px]
                uppercase
                tracking-[0.14em]
                text-brand-slate
                mb-2
              "
            >
              City
            </label>


            <select
              id="fieldwork-city"
              class="
                w-full
                bg-white
                border
                border-brand-border
                px-4
                py-3
                text-xs
                text-brand-charcoal
                outline-none
                focus:border-brand-gold
              "
            >

              <option value="all">
                All Cities
              </option>


              {
                cities.map(
                  (city) => (

                    <option
                      value={city.toLowerCase()}
                    >
                      {city}
                    </option>

                  )
                )
              }

            </select>

          </div>

        </div>
      </div>



      <div
        class="
          flex
          items-center
          justify-between
          gap-4
          mb-5
          pb-4
          border-b
          border-brand-border
        "
      >

        <span
          id="fieldwork-result-count"
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >
          {completedEvents.length}
          {" "}
          Events
        </span>


        <button
          id="fieldwork-reset"
          type="button"
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-charcoal
            font-semibold
            hover:text-brand-gold
            transition-colors
          "
        >
          Reset Filters
        </button>

      </div>



      <div
        id="fieldwork-archive"
        class="
          space-y-3
        "
      >

        {
          completedEvents.map(
            (event) => {

              const relatedNotes =
                eventNotes(
                  event.id
                );


              const eventDate =
                parseDate(
                  event.startDate
                );


              const eventYear =
                eventDate.getFullYear();


              const eventMonth =
                eventDate.getMonth();


              return (

                <details
                  class="
                    fieldwork-event
                    group
                    bg-white
                    border
                    border-brand-border
                    open:border-brand-gold
                    transition-colors
                  "
                  data-year={String(eventYear)}
                  data-month={String(eventMonth)}
                  data-participation={event.participation}
                  data-category={eventCategory(event)}
                  data-city={event.city?.toLowerCase() ?? ""}
                >

                  <summary
                    class="
                      list-none
                      cursor-pointer
                      px-5
                      py-5
                      sm:px-6
                      flex
                      flex-col
                      sm:flex-row
                      sm:items-center
                      gap-4
                      sm:gap-6
                    "
                  >

                    <div
                      class="
                        sm:w-[165px]
                        sm:shrink-0
                      "
                    >

                      <span
                        class:list={[
                          "text-[9px]",
                          "uppercase",
                          "tracking-[0.15em]",
                          "font-semibold",
                          labelClass(event)
                        ]}
                      >
                        {labelFor(event)}
                      </span>


                      <p
                        class="
                          text-[11px]
                          text-brand-slate
                          mt-1.5
                        "
                      >
                        {formatDate(event)}
                      </p>

                    </div>



                    <div
                      class="
                        flex-1
                        min-w-0
                      "
                    >

                      <h3
                        class="
                          font-serif
                          text-lg
                          sm:text-xl
                          text-brand-charcoal
                          leading-snug
                        "
                      >
                        {event.title}
                      </h3>


                      {
                        event.city && (

                          <p
                            class="
                              text-[10px]
                              text-brand-slate
                              mt-1
                            "
                          >
                            {event.city}
                          </p>

                        )
                      }

                    </div>



                    <div
                      class="
                        flex
                        items-center
                        gap-4
                        sm:justify-end
                        sm:min-w-[150px]
                      "
                    >

                      {
                        typeof event.registrations ===
                          "number" && (

                          <span
                            class="
                              text-[9px]
                              uppercase
                              tracking-[0.12em]
                              text-brand-gold
                              font-semibold
                            "
                          >
                            {event.registrations}
                            {" "}
                            Registrations
                          </span>

                        )
                      }


                      <span
                        class="
                          text-lg
                          text-brand-charcoal
                          transition-transform
                          group-open:rotate-45
                        "
                      >
                        +
                      </span>

                    </div>

                  </summary>



                  <div
                    class="
                      border-t
                      border-brand-border
                      px-5
                      py-6
                      sm:px-6
                      sm:py-7
                    "
                  >

                    <div
                      class="
                        grid
                        lg:grid-cols-12
                        gap-8
                      "
                    >

                      <div
                        class="
                          lg:col-span-8
                        "
                      >

                        {
                          event.description && (

                            <p
                              class="
                                text-sm
                                text-brand-slate
                                leading-relaxed
                                font-light
                                max-w-2xl
                              "
                            >
                              {event.description}
                            </p>

                          )
                        }


                        {
                          (
                            event.sponsors?.length > 0 ||
                            event.partners?.length > 0
                          ) && (

                            <div
                              class="
                                mt-6
                                flex
                                flex-col
                                gap-2
                              "
                            >

                              {
                                event.sponsors?.length > 0 && (

                                  <p
                                    class="
                                      text-xs
                                      text-brand-slate
                                    "
                                  >
                                    Sponsored by:
                                    {" "}

                                    <span
                                      class="
                                        text-brand-charcoal
                                        font-semibold
                                      "
                                    >
                                      {
                                        event.sponsors.join(
                                          ", "
                                        )
                                      }
                                    </span>
                                  </p>

                                )
                              }


                              {
                                event.partners?.length > 0 && (

                                  <p
                                    class="
                                      text-xs
                                      text-brand-slate
                                    "
                                  >
                                    Event collaborators:
                                    {" "}

                                    <span
                                      class="
                                        text-brand-charcoal
                                        font-semibold
                                      "
                                    >
                                      {
                                        event.partners.join(
                                          ", "
                                        )
                                      }
                                    </span>
                                  </p>

                                )
                              }

                            </div>

                          )
                        }


                        {
                          event.speakers?.length > 0 && (

                            <div
                              class="
                                mt-7
                                pt-6
                                border-t
                                border-brand-border
                              "
                            >

                              <p
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.14em]
                                  text-brand-gold
                                  font-semibold
                                  mb-3
                                "
                              >
                                Speakers
                              </p>


                              <div
                                class="
                                  grid
                                  md:grid-cols-2
                                  gap-x-8
                                  gap-y-2
                                "
                              >

                                {
                                  event.speakers.map(
                                    (speaker) => (

                                      <p
                                        class="
                                          text-xs
                                          text-brand-slate
                                          leading-relaxed
                                        "
                                      >

                                        <span
                                          class="
                                            text-brand-charcoal
                                            font-semibold
                                          "
                                        >
                                          {speaker.name}
                                        </span>


                                        {
                                          speaker.title
                                            ? ` · ${speaker.title}`
                                            : ""
                                        }


                                        {" · "}

                                        {speaker.company}

                                      </p>

                                    )
                                  )
                                }

                              </div>

                            </div>

                          )
                        }

                      </div>



                      <div
                        class="
                          lg:col-span-4
                          lg:border-l
                          lg:border-brand-border
                          lg:pl-8
                        "
                      >

                        <a
                          href={event.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="
                            inline-flex
                            items-center
                            gap-2
                            text-[10px]
                            uppercase
                            tracking-[0.15em]
                            font-semibold
                            text-brand-charcoal
                            hover:text-brand-gold
                            transition-colors
                          "
                        >
                          View Event

                          <span>
                            ↗
                          </span>
                        </a>


                        {
                          relatedNotes.length > 0 && (

                            <div
                              class="
                                mt-7
                                pt-6
                                border-t
                                border-brand-border
                              "
                            >

                              <div
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.14em]
                                  text-brand-gold
                                  font-semibold
                                  mb-3
                                "
                              >
                                Related Field Notes
                              </div>


                              <div
                                class="
                                  space-y-3
                                "
                              >

                                {
                                  relatedNotes.map(
                                    (post) => (

                                      <a
                                        href={`/field-notes/${post.id}/`}
                                        class="
                                          block
                                          text-xs
                                          text-brand-charcoal
                                          hover:text-brand-gold
                                          transition-colors
                                        "
                                      >
                                        {post.data.title}
                                        {" "}
                                        →
                                      </a>

                                    )
                                  )
                                }

                              </div>

                            </div>

                          )
                        }

                      </div>

                    </div>

                  </div>

                </details>

              );

            }
          )
        }

      </div>



      <div
        id="fieldwork-empty"
        class="
          hidden
          bg-white
          border
          border-brand-border
          px-6
          py-10
          text-center
        "
      >

        <p
          class="
            font-serif
            text-xl
            text-brand-charcoal
          "
        >
          No events found.
        </p>


        <p
          class="
            text-xs
            text-brand-slate
            mt-2
          "
        >
          Try adjusting the filters above.
        </p>

      </div>

    </div>

  </section>



  <style>

    .trade-show-marquee {
      width: 100%;
    }


    .trade-show-track {
      animation:
        trade-show-marquee
        34s
        linear
        infinite;

      will-change:
        transform;
    }


    .trade-show-marquee:hover
    .trade-show-track {
      animation-play-state:
        paused;
    }


    .trade-show-logo-link {
      width:
        220px;

      padding:
        0 12px;
    }


    .trade-show-logo-tile {
      width:
        196px;

      height:
        104px;

      padding:
        20px 24px;
    }


    .trade-show-logo {
      width:
        100%;

      height:
        100%;

      max-width:
        148px;

      max-height:
        64px;

      opacity:
        0.82;

      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }


    .trade-show-logo-link:hover
    .trade-show-logo {
      opacity:
        1;

      transform:
        scale(1.04);
    }


    .trade-show-fade {
      position:
        absolute;

      top:
        0;

      bottom:
        0;

      width:
        72px;

      z-index:
        2;

      pointer-events:
        none;
    }


    .trade-show-fade-left {
      left:
        0;

      background:
        linear-gradient(
          to right,
          #F9F8F3,
          rgba(249, 248, 243, 0)
        );
    }


    .trade-show-fade-right {
      right:
        0;

      background:
        linear-gradient(
          to left,
          #F9F8F3,
          rgba(249, 248, 243, 0)
        );
    }


    @keyframes trade-show-marquee {

      from {
        transform:
          translateX(100vw);
      }


      to {
        transform:
          translateX(-100%);
      }

    }


    @media (
      max-width: 640px
    ) {

      .trade-show-logo-link {
        width:
          180px;

        padding:
          0 10px;
      }


      .trade-show-logo-tile {
        width:
          160px;

        height:
          92px;

        padding:
          18px 20px;
      }


      .trade-show-logo {
        max-width:
          120px;

        max-height:
          56px;
      }


      .trade-show-fade {
        width:
          36px;
      }

    }


    @media (
      prefers-reduced-motion:
        reduce
    ) {

      .trade-show-track {
        animation:
          none;
      }

    }

  </style>



  <script is:inline>

    (() => {

      const yearSelect =
        document.getElementById(
          "fieldwork-year"
        );


      const monthSelect =
        document.getElementById(
          "fieldwork-month"
        );


      const participationSelect =
        document.getElementById(
          "fieldwork-participation"
        );


      const typeSelect =
        document.getElementById(
          "fieldwork-type"
        );


      const citySelect =
        document.getElementById(
          "fieldwork-city"
        );


      const resetButton =
        document.getElementById(
          "fieldwork-reset"
        );


      const resultCount =
        document.getElementById(
          "fieldwork-result-count"
        );


      const emptyState =
        document.getElementById(
          "fieldwork-empty"
        );


      const events =
        Array.from(
          document.querySelectorAll(
            ".fieldwork-event"
          )
        );


      if (
        !yearSelect ||
        !monthSelect ||
        !participationSelect ||
        !typeSelect ||
        !citySelect
      ) {

        return;

      }



      function applyFilters() {

        const selectedYear =
          yearSelect.value;


        const selectedMonth =
          monthSelect.value;


        const selectedParticipation =
          participationSelect.value;


        const selectedType =
          typeSelect.value;


        const selectedCity =
          citySelect.value;


        let visibleCount =
          0;


        events.forEach(
          (event) => {

            const matchesYear =
              selectedYear ===
                "all" ||
              event.dataset.year ===
                selectedYear;


            const matchesMonth =
              selectedMonth ===
                "all" ||
              event.dataset.month ===
                selectedMonth;


            const matchesParticipation =
              selectedParticipation ===
                "all" ||
              event.dataset.participation ===
                selectedParticipation;


            const matchesType =
              selectedType ===
                "all" ||
              event.dataset.category ===
                selectedType;


            const matchesCity =
              selectedCity ===
                "all" ||
              event.dataset.city ===
                selectedCity;


            const visible =
              matchesYear &&
              matchesMonth &&
              matchesParticipation &&
              matchesType &&
              matchesCity;


            event.classList.toggle(
              "hidden",
              !visible
            );


            if (
              event.open
            ) {

              event.open =
                false;

            }


            if (
              visible
            ) {

              visibleCount +=
                1;

            }

          }
        );


        if (
          resultCount
        ) {

          resultCount.textContent =
            `${visibleCount} ${
              visibleCount ===
                1
                ? "Event"
                : "Events"
            }`;

        }


        if (
          emptyState
        ) {

          emptyState.classList.toggle(
            "hidden",
            visibleCount !==
              0
          );

        }

      }



      [
        yearSelect,
        monthSelect,
        participationSelect,
        typeSelect,
        citySelect
      ]
        .forEach(
          (select) => {

            select.addEventListener(
              "change",
              applyFilters
            );

          }
        );


      resetButton?.addEventListener(
        "click",
        () => {

          yearSelect.value =
            "all";


          monthSelect.value =
            "all";


          participationSelect.value =
            "all";


          typeSelect.value =
            "all";


          citySelect.value =
            "all";


          applyFilters();

        }
      );


      applyFilters();

    })();

  </script>

</BaseLayout>
