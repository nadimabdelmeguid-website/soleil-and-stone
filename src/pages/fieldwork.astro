        transform:
          none !important;
      }

    }

  </style>



  <script is:inline>

    (() => {

      const yearSelect =
        document.getElementById(
          "fieldwork-year"
        );


      const monthSelect =
        document.getElementById(
          "fieldwork-month"
        );


      const participationSelect =
        document.getElementById(
          "fieldwork-participation"
        );


      const typeSelect =
        document.getElementById(
          "fieldwork-type"
        );


      const citySelect =
        document.getElementById(
          "fieldwork-city"
        );


      const resetButton =
        document.getElementById(
          "fieldwork-reset"
        );


      const resultCount =
        document.getElementById(
          "fieldwork-result-count"
        );


      const emptyState =
        document.getElementById(
          "fieldwork-empty"
        );


      const events =
        Array.from(
          document.querySelectorAll(
            ".fieldwork-event"
          )
        );


      if (
        !yearSelect ||
        !monthSelect ||
        !participationSelect ||
        !typeSelect ||
        !citySelect
      ) {

        return;

      }



      function applyFilters() {

        const selectedYear =
          yearSelect.value;


        const selectedMonth =
          monthSelect.value;


        const selectedParticipation =
          participationSelect.value;


        const selectedType =
          typeSelect.value;


        const selectedCity =
          citySelect.value;


        let visibleCount =
          0;


        events.forEach(
          (event) => {

            const matchesYear =
              selectedYear ===
                "all" ||
              event.dataset.year ===
                selectedYear;


            const matchesMonth =
              selectedMonth ===
                "all" ||
              event.dataset.month ===
                selectedMonth;


            const matchesParticipation =
              selectedParticipation ===
                "all" ||
              event.dataset.participation ===
                selectedParticipation;


            const matchesType =
              selectedType ===
                "all" ||
              event.dataset.category ===
                selectedType;


            const matchesCity =
              selectedCity ===
                "all" ||
              event.dataset.city ===
                selectedCity;


            const visible =
              matchesYear &&
              matchesMonth &&
              matchesParticipation &&
              matchesType &&
              matchesCity;


            event.classList.toggle(
              "hidden",
              !visible
            );


            if (
              event.open
            ) {

              event.open =
                false;

            }


            if (
              visible
            ) {

              visibleCount +=
                1;

            }

          }
        );


        if (
          resultCount
        ) {

          resultCount.textContent =
            `${visibleCount} ${
              visibleCount ===
                1
                ? "Event"
                : "Events"
            }`;

        }


        if (
          emptyState
        ) {

          emptyState.classList.toggle(
            "hidden",
            visibleCount !==
              0
          );

        }

      }



      [
        yearSelect,
        monthSelect,
        participationSelect,
        typeSelect,
        citySelect
      ]
        .forEach(
          (select) => {

            select.addEventListener(
              "change",
              applyFilters
            );

          }
        );


      resetButton?.addEventListener(
        "click",
        () => {

          yearSelect.value =
            "all";


          monthSelect.value =
            "all";


          participationSelect.value =
            "all";


          typeSelect.value =
            "all";


          citySelect.value =
            "all";


          applyFilters();

        }
      );


      applyFilters();



      /* =====================================================
         SEAMLESS TRADE SHOW MARQUEE

         Uses each logo only once in the DOM.

         When the first logo has fully moved off the left edge,
         that same element is moved to the end of the track.
         This creates a true endless loop where the last logo is
         immediately followed by the first, without cloned logos.
         ===================================================== */

      const marquee =
        document.querySelector(
          ".trade-show-marquee"
        );


      const track =
        document.querySelector(
          ".trade-show-track"
        );


      const reduceMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        );


      if (
        marquee &&
        track &&
        !reduceMotion.matches
      ) {

        let offset =
          0;


        let previousTime =
          performance.now();


        let paused =
          false;


        const speed =
          38;


        marquee.addEventListener(
          "mouseenter",
          () => {

            paused =
              true;

          }
        );


        marquee.addEventListener(
          "mouseleave",
          () => {

            paused =
              false;

            previousTime =
              performance.now();

          }
        );


        function animateMarquee(
          currentTime
        ) {

          const delta =
            Math.min(
              (
                currentTime -
                previousTime
              ) / 1000,
              0.05
            );


          previousTime =
            currentTime;


          if (
            !paused
          ) {

            offset -=
              speed *
              delta;


            let firstLogo =
              track.firstElementChild;


            while (
              firstLogo
            ) {

              const firstWidth =
                firstLogo.getBoundingClientRect()
                  .width;


              if (
                firstWidth <= 0 ||
                -offset <
                  firstWidth
              ) {

                break;

              }


              offset +=
                firstWidth;


              track.appendChild(
                firstLogo
              );


              firstLogo =
                track.firstElementChild;

            }


            track.style.transform =
              `translate3d(${offset}px, 0, 0)`;

          }


          requestAnimationFrame(
            animateMarquee
          );

        }


        requestAnimationFrame(
          animateMarquee
        );

      }

    })();

  </script>

</BaseLayout>
