---
import {
  getCollection
} from "astro:content";

import {
  readdir
} from "node:fs/promises";

import path from "node:path";

import BaseLayout from "../layouts/BaseLayout.astro";

import {
  eventSeeds
} from "../data/events";

import {
  isCompletedEvent,
  getParticipationPriority,
  getProfessionalMetrics
} from "../utils/eventMetrics";

import {
  getEventRecapUrl
} from "../utils/eventRecaps";


const now =
  new Date();


/*
 * FIELDWORK USES THE MANUALLY CURATED EVENT DATA FROM events.ts.
 *
 * This deliberately uses eventSeeds rather than the merged `events`
 * export, so dates shown on this page always come directly from the
 * startDate / endDate values you maintain in src/data/events.ts.
 */
const events =
  eventSeeds;


/* =========================================================
   FIELD NOTES
   ========================================================= */

const posts =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    );


/* =========================================================
   EVENTS
   ========================================================= */

const completedEvents =
  events
    .filter(
      isCompletedEvent
    )
    .sort(
      (a, b) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() ||
        getParticipationPriority(b) -
        getParticipationPriority(a)
    );


const upcomingEvents =
  events
    .filter(
      (event) =>
        !isCompletedEvent(
          event
        )
    )
    .sort(
      (a, b) =>
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime()
    );


/* =========================================================
   DYNAMIC FIELDWORK METRICS
   ========================================================= */

const metrics =
  getProfessionalMetrics(
    events
  );


/* =========================================================
   FILTER OPTIONS
   ========================================================= */

const years =
  Array.from(
    new Set(
      completedEvents.map(
        (event) =>
          new Date(
            `${event.startDate}T12:00:00`
          ).getFullYear()
      )
    )
  )
    .sort(
      (a, b) =>
        b - a
    );


const months =
  [
    {
      value: "0",
      label: "January"
    },
    {
      value: "1",
      label: "February"
    },
    {
      value: "2",
      label: "March"
    },
    {
      value: "3",
      label: "April"
    },
    {
      value: "4",
      label: "May"
    },
    {
      value: "5",
      label: "June"
    },
    {
      value: "6",
      label: "July"
    },
    {
      value: "7",
      label: "August"
    },
    {
      value: "8",
      label: "September"
    },
    {
      value: "9",
      label: "October"
    },
    {
      value: "10",
      label: "November"
    },
    {
      value: "11",
      label: "December"
    }
  ];


/* =========================================================
   ADDITIONAL FILTER OPTIONS
   ========================================================= */

const cities =
  Array.from(
    new Set(
      completedEvents
        .map(
          (event) =>
            event.city
              ?.trim()
        )
        .filter(
          (city):
            city is string =>
              Boolean(
                city
              )
        )
    )
  )
    .sort(
      (a, b) =>
        a.localeCompare(
          b
        )
    );


/* =========================================================
   TRADE SHOW LOGOS

   Every supported image added to public/tradeshows is
   discovered automatically at build time.

   The file name is matched against completed trade-show
   events in events.ts. Examples:

   ces.png
   md&m-west.png
   isc-west.png
   aems.png
   cedia-expo.png

   A logo appears only after the matching event is completed,
   keeping this section focused on trade shows already attended.
   ========================================================= */

const tradeShowLogoDirectory =
  path.join(
    process.cwd(),
    "public",
    "tradeshows"
  );


let tradeShowLogoFiles:
  string[] = [];


try {

  tradeShowLogoFiles =
    (
      await readdir(
        tradeShowLogoDirectory
      )
    )
      .filter(
        (file) =>
          /\.(png|jpe?g|webp|svg)$/i
            .test(
              file
            )
      )
      .sort(
        (a, b) =>
          a.localeCompare(
            b
          )
      );

} catch {

  tradeShowLogoFiles =
    [];

}


/* =========================================================
   FIELDWORK EVENT IMAGES

   Folder:
   public/fieldwork-event-images/

   Naming rule:
   event.id + image extension

   Examples:
   startup-mixer-sep-2026.jpg
   hardware-meetup-jun-2026.webp

   If no matching file exists, no thumbnail is rendered.
   ========================================================= */

const fieldworkEventImageDirectory =
  path.join(
    process.cwd(),
    "public",
    "fieldwork-event-images"
  );


let fieldworkEventImageFiles:
  string[] = [];


try {

  fieldworkEventImageFiles =
    (
      await readdir(
        fieldworkEventImageDirectory
      )
    )
      .filter(
        (file) =>
          /\.(png|jpe?g|webp|avif|svg)$/i
            .test(
              file
            )
      )
      .sort(
        (a, b) =>
          a.localeCompare(
            b
          )
      );

} catch {

  fieldworkEventImageFiles =
    [];

}


function findFieldworkEventImage(
  eventId: string
) {

  const file =
    fieldworkEventImageFiles.find(
      (candidate) =>
        path
          .parse(
            candidate
          )
          .name
          .toLowerCase() ===
        eventId.toLowerCase()
    );


  return file
    ? `/fieldwork-event-images/${encodeURIComponent(file)}`
    : undefined;

}


/* =========================================================
   HELPERS
   ========================================================= */

function eventNotes(
  eventId: string
) {

  return posts.filter(
    (post) =>
      post.data.relatedEvents
        ?.includes(
          eventId
        )
  );

}


function parseDate(
  value: string
) {

  return new Date(
    `${value}T12:00:00`
  );

}


function formatDate(
  event
) {

  const start =
    parseDate(
      event.startDate
    );


  const end =
    event.endDate
      ? parseDate(
          event.endDate
        )
      : null;


  if (
    !end
  ) {

    return start.toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric",

        year:
          "numeric"
      }
    );

  }


  if (
    start.getMonth() ===
      end.getMonth() &&
    start.getFullYear() ===
      end.getFullYear()
  ) {

    return `${start.toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric"
      }
    )}–${end.getDate()}, ${end.getFullYear()}`;

  }


  return `${start.toLocaleDateString(
    "en-US",
    {
      month:
        "short",

      day:
        "numeric",

      year:
        "numeric"
    }
  )} – ${end.toLocaleDateString(
    "en-US",
    {
      month:
        "short",

      day:
        "numeric",

      year:
        "numeric"
    }
  )}`;

}


function labelFor(
  event
) {

  if (
    event.participation ===
      "hosted"
  ) {

    return "Hosted";

  }


  if (
    event.participation ===
      "co-organized"
  ) {

    return "Co-Organized";

  }


  if (
    event.participation ===
      "exhibitor"
  ) {

    return "Exhibitor";

  }


  return "Attended";

}


function labelClass(
  event
) {

  if (
    event.participation ===
      "hosted" ||
    event.participation ===
      "co-organized"
  ) {

    return "text-brand-gold";

  }


  if (
    event.participation ===
      "exhibitor"
  ) {

    return "text-brand-charcoal";

  }


  return "text-brand-slate";

}


/* =========================================================
   EVENT CATEGORY

   Used only for archive filtering. Existing event content
   remains unchanged.
   ========================================================= */

function eventCategory(
  event
) {

  const searchable =
    [
      event.title,
      event.typeLabel,
      event.description
    ]
      .filter(
        Boolean
      )
      .join(
        " "
      )
      .toLowerCase();


  if (
    event.eventType ===
      "trade-show" ||
    event.participation ===
      "exhibitor" ||
    searchable.includes(
      "trade show"
    ) ||
    searchable.includes(
      "expo"
    ) ||
    searchable.includes(
      "exhibition"
    )
  ) {

    return "trade-show";

  }


  if (
    event.communityId ||
    searchable.includes(
      "startup"
    ) ||
    searchable.includes(
      "founder"
    ) ||
    searchable.includes(
      "community"
    ) ||
    searchable.includes(
      "ecosystem"
    ) ||
    searchable.includes(
      "mixer"
    )
  ) {

    return "community";

  }


  if (
    searchable.includes(
      "hardware"
    ) ||
    searchable.includes(
      "engineering"
    ) ||
    searchable.includes(
      "technical"
    ) ||
    searchable.includes(
      "embedded"
    ) ||
    searchable.includes(
      "electronics"
    ) ||
    searchable.includes(
      "manufacturing"
    ) ||
    searchable.includes(
      "sensors"
    ) ||
    searchable.includes(
      "medtech"
    )
  ) {

    return "technical";

  }


  return "professional";

}


/* =========================================================
   TRADE SHOW HELPERS

   LOGO + EVENT LINK AUTOMATION

   Primary rule:
   - logo filename = event.id + image extension

   Example:
   event.id: "isc-west-2026"
   file:     public/tradeshows/isc-west-2026.png

   The logo's clickable link ALWAYS comes directly from
   event.url in events.ts. No URL is inferred from filenames.

   Fallback name matching is kept only for older logo files.
   ========================================================= */

function isTradeShowEvent(
  event
) {

  return eventCategory(
    event
  ) ===
    "trade-show";

}


function stripExtension(
  value: string
) {

  return value.replace(
    /\.[^.]+$/,
    ""
  );

}


function normalizeTradeShowKey(
  value: string
) {

  return stripExtension(
    value
  )
    .replace(
      /\b20\d{2}\b/g,
      ""
    )
    .toLowerCase()
    .replace(
      /[^a-z0-9]/g,
      ""
    );

}


function tradeShowAcronym(
  value: string
) {

  return value
    .replace(
      /\b20\d{2}\b/g,
      ""
    )
    .replace(
      /&/g,
      " "
    )
    .split(
      /[^A-Za-z0-9]+/
    )
    .filter(
      Boolean
    )
    .map(
      (word) =>
        word[0]
          ?.toLowerCase() ??
        ""
    )
    .join(
      ""
    );

}


function findLogoForEvent(
  event
) {

  /*
   * 1. Exact event-id match.
   *
   * This is the preferred and fully predictable workflow.
   */
  const exactFile =
    tradeShowLogoFiles.find(
      (file) =>
        stripExtension(
          file
        ).toLowerCase() ===
        event.id.toLowerCase()
    );


  if (
    exactFile
  ) {

    return exactFile;

  }


  /*
   * 2. Backward-compatible fallback for existing logos whose
   * filenames predate the event-id naming convention.
   */
  const titleKey =
    normalizeTradeShowKey(
      event.title ??
      ""
    );


  const idKey =
    normalizeTradeShowKey(
      event.id ??
      ""
    );


  const acronym =
    tradeShowAcronym(
      event.title ??
      ""
    );


  return tradeShowLogoFiles.find(
    (file) => {

      const logoKey =
        normalizeTradeShowKey(
          file
        );


      return (
        logoKey ===
          titleKey ||
        logoKey ===
          idKey ||
        logoKey ===
          acronym ||
        (
          logoKey.length >= 4 &&
          titleKey.includes(
            logoKey
          )
        ) ||
        (
          titleKey.length >= 4 &&
          logoKey.includes(
            titleKey
          )
        ) ||
        (
          logoKey.length >= 4 &&
          idKey.includes(
            logoKey
          )
        ) ||
        (
          idKey.length >= 4 &&
          logoKey.includes(
            idKey
          )
        )
      );

    }
  );

}


const completedTradeShows =
  completedEvents
    .filter(
      isTradeShowEvent
    )
    .sort(
      (a, b) =>
        parseDate(
          b.startDate
        ).getTime() -
        parseDate(
          a.startDate
        ).getTime()
    );


/*
 * EVENT-FIRST MAPPING
 *
 * The event record is the source of truth.
 *
 * - event.id finds the logo
 * - event.title supplies accessible text
 * - event.url supplies the clickable destination
 * - event.startDate controls ordering
 *
 * This guarantees that the logo link always stays synchronized
 * with the URL stored in events.ts.
 */
/*
 * Build the featured logo list from the completed trade shows.
 *
 * completedTradeShows is already sorted newest → oldest, so when the
 * same organization / trade-show logo exists for multiple years we
 * keep the newest occurrence only.
 *
 * normalizeTradeShowKey() removes the year from the filename, which
 * means files such as:
 *
 *   ces-2025.png
 *   ces-2026.png
 *
 * are treated as the same featured logo.
 */
const seenTradeShowLogoKeys =
  new Set<string>();


const tradeShowLogos =
  completedTradeShows
    .map(
      (event) => {

        const file =
          findLogoForEvent(
            event
          );


        if (
          !file
        ) {

          return null;

        }


        return {

          file,

          src:
            `/tradeshows/${file}`,

          name:
            event.title,

          url:
            event.url,

          eventId:
            event.id

        };

      }
    )
    .filter(
      (
        logo
      ): logo is NonNullable<
        typeof logo
      > =>
        logo !== null
    )
    .filter(
      (logo) => {

        const key =
          normalizeTradeShowKey(
            logo.file
          );


        if (
          seenTradeShowLogoKeys.has(
            key
          )
        ) {

          return false;

        }


        seenTradeShowLogoKeys.add(
          key
        );


        return true;

      }
    );


const tradeShowLogoLoop =
  tradeShowLogos;
---

<BaseLayout
  title="Industry Fieldwork | Soleil & Stone"
  description="A record of trade shows, technical communities and ecosystem events shaping my view of how hardware reaches the market."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Industry Fieldwork
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          text-brand-charcoal
          mt-2
          mb-6
        "
      >
        Learning From The Field
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          font-light
          leading-relaxed
          max-w-3xl
        "
      >
        Trade shows, technical communities, founder gatherings,
        and industry programs shaping my view of how hardware
        moves from engineering decisions to commercialization
        and real-world adoption.
      </p>

    </div>

  </section>



  <!-- =====================================================
       DYNAMIC FIELDWORK METRICS
       ===================================================== -->

  <section
    class="
      border-y
      border-brand-border
      bg-brand-cream
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-10
      "
    >

      <div
        class="
          grid
          grid-cols-2
          lg:grid-cols-4
          bg-white
          border
          border-brand-border
        "
      >

        <!-- PROFESSIONAL EVENTS -->

        <div
          class="
            p-5
            sm:p-6
            border-r
            border-b
            border-brand-border
            lg:border-b-0
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.total}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Professional Events
          </div>

        </div>



        <!-- TRADE SHOWS EXHIBITED -->

        <div
          class="
            p-5
            sm:p-6
            border-b
            border-brand-border
            lg:border-b-0
            lg:border-r
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.exhibited}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Trade Shows Exhibited
          </div>

        </div>



        <!-- ORGANIZATIONS -->

        <div
          class="
            p-5
            sm:p-6
            border-r
            border-brand-border
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.organizationsEngaged}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Organizations Engaged
          </div>

        </div>



        <!-- CITIES -->

        <div
          class="
            p-5
            sm:p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
            "
          >
            {metrics.cities}
          </div>


          <div
            class="
              mt-2
              text-[9px]
              uppercase
              tracking-[0.16em]
              text-brand-slate
              leading-relaxed
            "
          >
            Cities Across Fieldwork
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       UPCOMING
       ===================================================== -->

  {
    upcomingEvents.length > 0 && (

      <section
        class="
          bg-white
          border-b
          border-brand-border
        "
      >

        <div
          class="
            max-w-6xl
            w-full
            mx-auto
            px-6
            py-14
          "
        >

          <div
            class="
              flex
              items-end
              justify-between
              gap-6
              mb-6
            "
          >

            <div>

              <span
                class="
                  text-[10px]
                  uppercase
                  tracking-[0.18em]
                  text-brand-gold
                  font-semibold
                "
              >
                Upcoming
              </span>


              <h2
                class="
                  font-serif
                  text-3xl
                  text-brand-charcoal
                  mt-2
                "
              >
                Upcoming Fieldwork
              </h2>

            </div>


            {
              upcomingEvents.length > 3 && (

                <span
                  class="
                    hidden
                    sm:block
                    text-[9px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-slate
                  "
                >
                  Scroll To Explore →
                </span>

              )
            }

          </div>



          <div
            class="
              overflow-x-auto
              pb-3
              custom-scrollbar
            "
          >

            <div
              class="
                grid
                grid-flow-col
                auto-cols-[86%]
                sm:auto-cols-[48%]
                lg:auto-cols-[calc((100%-2.5rem)/3)]
                gap-5
              "
            >

              {
                upcomingEvents.map(
                  (event) => (

                    <a
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="
                        block
                        bg-brand-cream
                        border
                        border-brand-border
                        p-6
                        hover:border-brand-gold
                        transition-colors
                      "
                    >

                      <div
                        class="
                          flex
                          items-center
                          justify-between
                          gap-4
                        "
                      >

                        <span
                          class:list={[
                            "text-[9px]",
                            "uppercase",
                            "tracking-[0.14em]",
                            "font-semibold",
                            labelClass(event)
                          ]}
                        >
                          {labelFor(event)}
                        </span>


                        <span
                          class="
                            text-[9px]
                            text-brand-slate
                          "
                        >
                          ↗
                        </span>

                      </div>


                      <h3
                        class="
                          font-serif
                          text-lg
                          sm:text-xl
                          text-brand-charcoal
                          mt-4
                          leading-snug
                        "
                      >
                        {event.title}
                      </h3>


                      <p
                        class="
                          text-xs
                          text-brand-slate
                          mt-4
                        "
                      >
                        {formatDate(event)}
                      </p>


                      {
                        event.city && (

                          <p
                            class="
                              text-xs
                              text-brand-slate
                              mt-1
                            "
                          >
                            {event.city}
                          </p>

                        )
                      }

                    </a>

                  )
                )
              }

            </div>

          </div>

        </div>

      </section>

    )
  }



  <!-- =====================================================
       FEATURED TRADE SHOWS
       ===================================================== -->

  {
    tradeShowLogos.length > 0 && (

      <section
        class="
          bg-white
          border-b
          border-brand-border
          overflow-hidden
        "
      >

        <div
          class="
            max-w-6xl
            w-full
            mx-auto
            px-6
            pt-12
            pb-4
          "
        >

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.18em]
              text-brand-gold
              font-semibold
            "
          >
            Featured Trade Shows
          </span>


          <h2
            class="
              font-serif
              text-2xl
              sm:text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Industry Events I've Attended
          </h2>


          <p
            class="
              text-sm
              text-brand-slate
              font-light
              leading-relaxed
              max-w-2xl
              mt-3
            "
          >
            A selection of trade shows and industry exhibitions
            from my fieldwork since 2025.
          </p>

        </div>


        <div
          class="
            trade-show-marquee
            relative
            overflow-hidden
            py-8
          "
        >

          <div
            class="
              trade-show-fade
              trade-show-fade-left
            "
            aria-hidden="true"
          ></div>


          <div
            class="
              trade-show-fade
              trade-show-fade-right
            "
            aria-hidden="true"
          ></div>


          <div
            class="
              trade-show-track
              flex
              w-max
            "
