---
import {
  getCollection,
  render
} from "astro:content";

import BaseLayout
  from "../../layouts/BaseLayout.astro";

import {
  events
} from "../../data/events.cms";


export async function getStaticPaths() {

  const posts =
    await getCollection(
      "eventRecaps"
    );


  return posts.map(
    (post) => ({

      params:
        {
          slug:
            post.id
        },

      props:
        {
          post
        }

    })
  );

}


const {
  post
} =
  Astro.props;


const {
  Content
} =
  await render(
    post
  );


const recap = {

  slug:
    post.id,

  eventId:
    post.data.eventId,

  title:
    post.data.title,

  eyebrow:
    post.data.eyebrow,

  published:
    post.data.published
      .toISOString()
      .slice(0, 10),

  excerpt:
    post.data.excerpt,

  readingMinutes:
    post.data.readingMinutes,

  tags:
    post.data.tags,

  stats:
    post.data.stats,

  photoCredit:
    post.data.photoCredit,

  heroImage:
    post.data.heroImage

};


const event =
  events.find(
    (item) =>
      item.id ===
        recap.eventId
  );


const relatedCommunityUrl =
  event?.communityId
    ? `/community/#${event.communityId}`
    : null;


const images = {
  cover:
    recap.heroImage ||
    null
};


const hasImages =
  Boolean(
    images.cover ||
    /!\[[^\]]*\]\([^\)]+\)/
      .test(
        post.body ||
        ""
      )
  );


const publishedTime =
  post.data.published
    .toISOString();


const socialImage =
  images.cover ??
  "/brand/social-default.png";


const socialImageAlt =
  images.cover
    ? `${recap.title} — Event Recap`
    : "Soleil & Stone";


const photoCreditWebsite =
  recap.photoCredit?.url
    ? (() => {

        try {

          return new URL(
            recap.photoCredit.url
          )
            .hostname
            .replace(
              /^www\./,
              ""
            );

        } catch {

          return recap.photoCredit.url;

        }

      })()
    : null;


function formatDate(
  value: string
) {

  return new Date(
    `${value}T12:00:00`
  )
    .toLocaleDateString(
      "en-US",
      {
        month:
          "long",

        day:
          "numeric",

        year:
          "numeric"
      }
    );

}

---

<BaseLayout
  title={post.data.seoTitle || `${recap.title} | Event Recap | Soleil & Stone`}
  description={post.data.seoDescription || recap.excerpt}
  type="article"
  publishedTime={publishedTime}
  articleSection="Event Recap"
  image={socialImage}
  imageAlt={socialImageAlt}
>

  <article>

    <!-- =====================================================
         ARTICLE HEADER
         ===================================================== -->

    <header
      class="
        bg-white
        border-b
        border-brand-border
      "
    >

      <div
        class="
          max-w-4xl
          w-full
          mx-auto
          px-6
          pt-16
          pb-12
        "
      >

        <a
          href="/event-recaps/"
          class="
            inline-flex
            items-center
            gap-2
            text-[9px]
            uppercase
            tracking-[0.16em]
            text-brand-slate
            hover:text-brand-gold
            transition-colors
          "
        >
          ← All Event Recaps
        </a>


        <div
          class="
            mt-9
            flex
            flex-wrap
            items-center
            gap-3
            text-[10px]
            text-brand-slate
          "
        >

          <span
            class="
              px-3
              py-1.5
              bg-brand-gold/10
              text-brand-gold
              uppercase
              tracking-[0.14em]
              font-semibold
            "
          >
            {
              recap.eyebrow ??
              "Event Recap"
            }
          </span>


          <span>
            {
              formatDate(
                recap.published
              )
            }
          </span>


          <span>
            ·
          </span>


          <span>
            {recap.readingMinutes}
            {" "}
            min read
          </span>

        </div>


        <h1
          class="
            font-serif
            text-4xl
            sm:text-5xl
            text-brand-charcoal
            leading-[1.12]
            mt-6
          "
        >
          {recap.title}
        </h1>


        <p
          class="
            text-base
            sm:text-lg
            text-brand-slate
            font-light
            leading-relaxed
            mt-6
            max-w-3xl
          "
        >
          {recap.excerpt}
        </p>


        {
          event && (

            <div
              class="
                mt-8
                pt-6
                border-t
                border-brand-border
                flex
                flex-wrap
                items-center
                gap-x-6
                gap-y-3
                text-xs
                text-brand-slate
              "
            >

              {
                event.city && (

                  <span>
                    {event.city}
                  </span>

                )
              }


              <span>
                {
                  formatDate(
                    event.startDate
                  )
                }
              </span>


              {
                relatedCommunityUrl && (

                  <a
                    href={relatedCommunityUrl}
                    class="
                      inline-flex
                      items-center
                      gap-2
                      text-brand-charcoal
                      font-semibold
                      hover:text-brand-gold
                      transition-colors
                    "
                  >
                    View The Startup Mixer
                    <span>→</span>
                  </a>

                )
              }

            </div>

          )
        }

      </div>

    </header>



    <!-- =====================================================
         COVER IMAGE
         ===================================================== -->

    {
      images.cover && (

        <div
          class="
            max-w-5xl
            w-full
            mx-auto
            px-6
            pt-10
          "
        >

          <figure>

            <img
              src={images.cover}
              alt={`${recap.title} — Event Recap`}
              class="
                w-full
                h-auto
                max-h-[620px]
                object-cover
                border
                border-brand-border
              "
            />

          </figure>

        </div>

      )
    }



    <!-- =====================================================
         STATS
         ===================================================== -->

    {
      recap.stats &&
      recap.stats.length > 0 && (

        <section
          class="
            max-w-4xl
            w-full
            mx-auto
            px-6
            pt-12
          "
        >

          <div
            class="
              grid
              sm:grid-cols-3
              bg-brand-cream
              border
              border-brand-border
            "
          >

            {
              recap.stats.map(
                (stat) => (

                  <div
                    class="
                      px-6
                      py-5
                      border-b
                      last:border-b-0
                      sm:border-b-0
                      sm:border-r
                      sm:last:border-r-0
                      border-brand-border
                    "
                  >

                    <div
                      class="
                        font-serif
                        text-3xl
                        text-brand-charcoal
                      "
                    >
                      {stat.value}
                    </div>


                    <div
                      class="
                        mt-1
                        text-[9px]
                        uppercase
                        tracking-[0.14em]
                        text-brand-slate
                      "
                    >
                      {stat.label}
                    </div>

                  </div>

                )
              )
            }

          </div>

        </section>

      )
    }



    <!-- =====================================================
         BODY
         ===================================================== -->

    <section
      class="
        max-w-3xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <div
        class="event-recap-body"
      >
        <Content />
      </div>


      <!-- ===================================================
           TAGS
           =================================================== -->

      {
        recap.tags &&
        recap.tags.length > 0 && (

          <div
            class="
              mt-14
              pt-8
              border-t
              border-brand-border
              flex
              flex-wrap
              gap-2
            "
          >

            {
              recap.tags.map(
                (tag) => (

                  <span
                    class="
                      border
                      border-brand-border
                      rounded-full
                      px-3
                      py-1
                      text-[10px]
                      text-brand-slate
                    "
                  >
                    {tag}
                  </span>

                )
              )
            }

          </div>

        )
      }

    </section>



    <!-- =====================================================
         PHOTOGRAPHER SHOUTOUT
         ===================================================== -->

    {
      hasImages &&
      recap.photoCredit && (

        <section
          class="
            max-w-3xl
            w-full
            mx-auto
            px-6
            pb-14
          "
        >

          <div
            class="
              border-t
              border-brand-border
              pt-7
              flex
              flex-col
              sm:flex-row
              sm:items-center
              sm:justify-between
              gap-3
            "
          >

            <div>

              <span
                class="
                  block
                  text-[9px]
                  uppercase
                  tracking-[0.16em]
                  text-brand-gold
                  font-semibold
                "
              >
                {
                  recap.photoCredit.label ??
                  "Photography"
                }
              </span>


              <p
                class="
                  text-sm
                  text-brand-slate
                  font-light
                  mt-2
                "
              >
                Shoutout to
                {" "}

                {
                  recap.photoCredit.url
                    ? (

                      <a
                        href={recap.photoCredit.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="
                          text-brand-charcoal
                          font-semibold
                          hover:text-brand-gold
                          transition-colors
                        "
                      >
                        {recap.photoCredit.name}
                      </a>

                    )
                    : (

                      <span
                        class="
                          text-brand-charcoal
                          font-semibold
                        "
                      >
                        {recap.photoCredit.name}
                      </span>

                    )
                }

                {" "}
                for capturing the night.
              </p>

            </div>


            {
              recap.photoCredit.url &&
              photoCreditWebsite && (

                <a
                  href={recap.photoCredit.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="
                    inline-flex
                    items-center
                    gap-2
                    text-[10px]
                    uppercase
                    tracking-[0.14em]
                    text-brand-charcoal
                    font-semibold
                    hover:text-brand-gold
                    transition-colors
                  "
                >
                  {photoCreditWebsite}
                  <span>↗</span>
                </a>

              )
            }

          </div>

        </section>

      )
    }



    <!-- =====================================================
         BACK TO RECAPS
         ===================================================== -->

    <section
      class="
        bg-brand-cream
        border-t
        border-brand-border
      "
    >

      <div
        class="
          max-w-3xl
          w-full
          mx-auto
          px-6
          py-10
        "
      >

        <a
          href="/event-recaps/"
          class="
            inline-flex
            items-center
            gap-2
            text-[10px]
            uppercase
            tracking-[0.15em]
            font-semibold
            text-brand-charcoal
            hover:text-brand-gold
            transition-colors
          "
        >
          ← All Event Recaps
        </a>

      </div>

    </section>

  </article>

</BaseLayout>


<style is:global>
  .event-recap-body {
    color: #4A505A;
  }

  .event-recap-body > *:first-child {
    margin-top: 0;
  }

  .event-recap-body p {
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.85;
    font-weight: 300;
  }

  .event-recap-body h2 {
    margin-top: 3.5rem;
    margin-bottom: 1.15rem;
    font-family: "Cinzel", Georgia, serif;
    font-size: 1.75rem;
    line-height: 1.3;
    color: #22252A;
  }

  .event-recap-body h3 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: "Cinzel", Georgia, serif;
    font-size: 1.3rem;
    line-height: 1.4;
    color: #22252A;
  }

  .event-recap-body strong {
    color: #22252A;
    font-weight: 600;
  }

  .event-recap-body a {
    color: #9F7D3D;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-recap-body a:hover {
    color: #C5A059;
  }

  .event-recap-body ul,
  .event-recap-body ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .event-recap-body li {
    margin-top: 0.65rem;
    line-height: 1.75;
    font-weight: 300;
  }

  .event-recap-body blockquote {
    margin: 2rem 0;
    border-left: 2px solid #C5A059;
    padding: 0.3rem 0 0.3rem 1.25rem;
    color: #363A40;
    font-style: italic;
  }

  .event-recap-body img {
    display: block;
    width: 100%;
    height: auto;
    margin: 2rem 0 0;
    border: 1px solid #DDD8CB;
  }

  @media (min-width: 640px) {
    .event-recap-body h2 {
      font-size: 2rem;
    }
  }
</style>
