---
import fs
  from "node:fs/promises";

import path
  from "node:path";

import BaseLayout
  from "../layouts/BaseLayout.astro";

import CommunityCard
  from "../components/CommunityCard.astro";

import {
  communities
} from "../data/communities";

import {
  events
} from "../data/events";

import {
  getCommunityMetrics
} from "../utils/eventMetrics";


/* =========================================================
   COMMUNITY MEMBERSHIPS

   Membership figures may represent a growing community
   size / lower-bound estimate, so the UI can still show "+".
   ========================================================= */

const communityMemberships =
  communities.reduce(
    (
      total,
      community
    ) =>
      total +
      (
        community.members ??
        0
      ),
    0
  );


/* =========================================================
   AUTOMATED COMMUNITY METRICS
   ========================================================= */

const communityMetrics =
  getCommunityMetrics(
    events
  );


const communityEvents =
  communityMetrics.events;


const communityRegistrations =
  communityMetrics.registrations;


const communitySpeakerCount =
  communityMetrics.speakerCount;


/* =========================================================
   HARDWARE MEETUP LOGOS

   Folder:
   public/hw-meetups-logos/

   Recommended filename format:

   Company Name__domain.com.png

   Examples:
   SEACOMP__seacomp.com.png
   Dip Studio__dip.studio.svg
   Velavu__velavu.com.webp

   Everything before "__" becomes the company name.
   Everything after "__" becomes the website domain.

   Adding/removing a file from the folder automatically
   updates the Community page on the next build.
   ========================================================= */

const hardwareLogoDirectory =
  path.resolve(
    "public/hw-meetups-logos"
  );


const supportedLogoExtensions =
  new Set(
    [
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".svg",
      ".avif"
    ]
  );


type HardwareLogo = {
  name: string;
  image: string;
  url?: string;
};


function parseHardwareLogo(
  filename: string
):
  HardwareLogo | null {

  const extension =
    path
      .extname(
        filename
      )
      .toLowerCase();


  if (
    !supportedLogoExtensions.has(
      extension
    )
  ) {
    return null;
  }


  const basename =
    path.basename(
      filename,
      extension
    );


  const [
    rawName,
    rawDomain
  ] =
    basename.split(
      "__"
    );


  const name =
    rawName
      ?.replace(
        /[-_]+/g,
        " "
      )
      .replace(
        /\s+/g,
        " "
      )
      .trim();


  if (!name) {
    return null;
  }


  const domain =
    rawDomain
      ?.trim()
      .replace(
        /^https?:\/\//i,
        ""
      )
      .replace(
        /\/+$/,
        ""
      );


  const url =
    domain
      ? `https://${domain}`
      : undefined;


  return {
    name,
    image:
      `/hw-meetups-logos/${encodeURIComponent(filename)}`,
    url
  };

}


let hardwareLogos:
  HardwareLogo[] = [];


try {

  const files =
    await fs.readdir(
      hardwareLogoDirectory
    );


  hardwareLogos =
    files
      .map(
        parseHardwareLogo
      )
      .filter(
        (
          logo
        ): logo is HardwareLogo =>
          logo !== null
      )
      .sort(
        (
          a,
          b
        ) =>
          a.name.localeCompare(
            b.name
          )
      );

} catch {

  /*
   * Keep the page build-safe if the directory
   * has not been created yet.
   */

  hardwareLogos =
    [];

}
---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Community initiatives connecting founders, engineers, builders and investors across San Diego and Southern California."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Ecosystem Leadership
      </span>


      <h1
        class="
          font-serif
          text-3xl
          sm:text-4xl
          lg:text-5xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.2]
          mb-6
        "
      >
        Building Connections
        That Compound
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          leading-relaxed
          font-light
          max-w-4xl
        "
      >
        Building and participating in communities where
        founders, engineers, investors and operators can
        exchange knowledge, build relationships and move
        technical ideas toward real-world execution.
      </p>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY TRACK RECORD — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-y
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-12
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          mb-8
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community Track Record
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          Growing Through Consistent Programming
        </h2>

      </div>



      <!-- =================================================
           COMMUNITY METRICS
           ================================================= -->

      <div
        class="
          grid
          grid-cols-2
          md:grid-cols-4
          gap-px
          bg-brand-border
          border
          border-brand-border
        "
      >

        <!-- COMMUNITY MEMBERSHIPS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityMemberships}+
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Memberships
          </div>

        </div>



        <!-- COMMUNITY EVENTS LED -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityEvents.length}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Events Led
          </div>

        </div>



        <!-- COMMUNITY REGISTRATIONS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityRegistrations}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Registrations
          </div>

        </div>



        <!-- INDUSTRY SPEAKERS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communitySpeakerCount}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Speakers
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITIES
       ===================================================== -->

  {
    communities.map(
      (community) => (

        <>

          <CommunityCard
            community={community}
          />


          {
            community.id ===
              "hardware-meetup" &&
            hardwareLogos.length >
              0 && (

              <!-- =========================================
                   HARDWARE MEETUP ORGANIZATIONS
                   ========================================= -->

              <section
                class="
                  bg-brand-cream
                  border-b
                  border-brand-border
                "
              >

                <div
                  class="
                    max-w-6xl
                    w-full
                    mx-auto
                    px-6
                    pt-2
                    pb-16
                  "
                >

                  <!-- HEADER -->

                  <div
                    class="
                      max-w-3xl
                      mb-8
                    "
                  >

                    <span
                      class="
                        text-[10px]
                        uppercase
                        tracking-[0.2em]
                        text-brand-gold
                        font-semibold
                      "
                    >
                      Community Contributors
                    </span>


                    <h3
                      class="
                        font-serif
                        text-2xl
                        sm:text-3xl
                        font-normal
                        text-brand-charcoal
                        mt-2
                        mb-3
                      "
                    >
                      Speakers & Sponsors
                    </h3>


                    <p
                      class="
                        text-sm
                        text-brand-slate
                        leading-relaxed
                        font-light
                        max-w-2xl
                      "
                    >
                      Organizations represented by speakers
                      and sponsors supporting San Diego's
                      hardware community.
                    </p>

                  </div>


                  <!-- LOGO GRID -->

                  <div
                    class="
                      grid
                      grid-cols-2
                      sm:grid-cols-3
                      md:grid-cols-4
                      lg:grid-cols-5
                      gap-px
                      bg-brand-border
                      border
                      border-brand-border
                    "
                  >

                    {
                      hardwareLogos.map(
                        (logo) => (

                          logo.url ? (

                            <a
                              href={logo.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`Visit ${logo.name}`}
                              title={logo.name}
                              class="
                                group
                                relative
                                flex
                                items-center
                                justify-center
                                min-h-[118px]
                                bg-white
                                px-6
                                py-7
                                transition-colors
                                duration-200
                                hover:bg-brand-cream
                                focus:outline-none
                                focus-visible:ring-2
                                focus-visible:ring-brand-gold
                                focus-visible:ring-inset
                              "
                            >

                              <img
                                src={logo.image}
                                alt={`${logo.name} logo`}
                                loading="lazy"
                                decoding="async"
                                class="
                                  block
                                  max-w-full
                                  max-h-12
                                  w-auto
                                  h-auto
                                  object-contain
                                  grayscale
                                  opacity-70
                                  transition-all
                                  duration-300
                                  group-hover:grayscale-0
                                  group-hover:opacity-100
                                  group-hover:scale-[1.03]
                                "
                              />


                              <span
                                class="
                                  absolute
                                  top-3
                                  right-3
                                  text-[10px]
                                  text-brand-gold
                                  opacity-0
                                  transition-opacity
                                  duration-200
                                  group-hover:opacity-100
                                "
                                aria-hidden="true"
                              >
                                ↗
                              </span>

                            </a>

                          ) : (

                            <div
                              title={logo.name}
                              class="
                                flex
                                items-center
                                justify-center
                                min-h-[118px]
                                bg-white
                                px-6
                                py-7
                              "
                            >

                              <img
                                src={logo.image}
                                alt={`${logo.name} logo`}
                                loading="lazy"
                                decoding="async"
                                class="
                                  block
                                  max-w-full
                                  max-h-12
                                  w-auto
                                  h-auto
                                  object-contain
                                  grayscale
                                  opacity-70
                                "
                              />

                            </div>

                          )

                        )
                      )
                    }

                  </div>


                  <!-- SMALL NOTE -->

                  <p
                    class="
                      mt-4
                      text-[10px]
                      uppercase
                      tracking-[0.14em]
                      text-brand-slate/70
                    "
                  >
                    Select a logo to visit the organization's website.
                  </p>

                </div>

              </section>

            )
          }

        </>

      )
    )
  }



  <!-- =====================================================
       CTA — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
        text-center
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Get Involved
      </span>


      <h2
        class="
          font-serif
          text-3xl
          sm:text-4xl
          font-normal
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        Building Something in San Diego?
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          sm:text-base
          leading-relaxed
          font-light
          max-w-2xl
          mx-auto
          mb-8
        "
      >
        Whether you're a founder, engineer, investor,
        venue partner or simply curious about the community,
        I'd like to hear from you.
      </p>


      <a
        href="/contact/?reason=startup-community"
        class="
          inline-flex
          items-center
          gap-2
          px-6
          py-3
          bg-brand-charcoal
          text-white
          text-[11px]
          uppercase
          tracking-[0.2em]
          hover:bg-brand-gold
          transition-colors
        "
      >
        Connect With Me

        <span>
          →
        </span>
      </a>

    </div>

  </section>

</BaseLayout>
