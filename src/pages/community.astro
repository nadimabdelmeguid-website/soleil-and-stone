---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import CommunityCard
  from "../components/CommunityCard.astro";

import {
  communities
} from "../data/communities";
---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Founder, hardware and startup communities across Southern California."
>

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
      border-b
      border-brand-border
    "
  >

    <span
      class="
        inline-block
        px-3
        py-1
        bg-brand-gold/10
        border
        border-brand-gold/30
        text-brand-gold
        text-[10px]
        uppercase
        tracking-[0.2em]
        font-semibold
        mb-4
      "
    >
      Ecosystem Leadership
    </span>


    <h1
      class="
        font-serif
        text-3xl
        sm:text-4xl
        lg:text-5xl
        mb-6
      "
    >
      Building Communities
    </h1>


    <p
      class="
        text-base
        text-brand-slate
        leading-relaxed
        font-light
        max-w-3xl
      "
    >
      Creating low-pressure,
      high-value spaces where founders,
      engineers, builders and investors
      can meet, exchange ideas and build
      lasting relationships across
      Southern California.
    </p>

  </section>


  {
    communities.map(
      community => (

        <CommunityCard
          community={community}
        />

      )
    )
  }


  <section
    class="
      max-w-6xl
      mx-auto
      px-6
      py-20
      text-center
    "
  >

    <h2
      class="
        font-serif
        text-3xl
        mb-4
      "
    >
      Building Something in San Diego?
    </h2>


    <p
      class="
        text-brand-slate
        max-w-xl
        mx-auto
        mb-8
      "
    >
      Whether you're a founder,
      engineer, investor,
      venue partner or simply curious
      about the community,
      we'd like to hear from you.
    </p>


    <a
      href="/#contact"
      class="
        px-6
        py-3
        bg-brand-charcoal
        text-white
        text-xs
        uppercase
        tracking-widest
      "
    >
      Connect With Us
    </a>

  </section>

</BaseLayout>
