---
import fs
  from "node:fs/promises";

import path
  from "node:path";

import BaseLayout
  from "../layouts/BaseLayout.astro";

import CommunityCard
  from "../components/CommunityCard.astro";

import {
  communities
} from "../data/communities";

import {
  events
} from "../data/events";

import {
  getCommunityMetrics
} from "../utils/eventMetrics";


/* =========================================================
   COMMUNITY MEMBERSHIPS
   ========================================================= */

const communityMemberships =
  communities.reduce(
    (
      total,
      community
    ) =>
      total +
      (
        community.members ??
        0
      ),
    0
  );


/* =========================================================
   AUTOMATED COMMUNITY METRICS
   ========================================================= */

const communityMetrics =
  getCommunityMetrics(
    events
  );


const communityEvents =
  communityMetrics.events;


const communityRegistrations =
  communityMetrics.registrations;


const communitySpeakerCount =
  communityMetrics.speakerCount;


/* =========================================================
   HARDWARE MEETUP LOGOS

   Logos live in:

   public/hw-meetups-logos/

   Simple filenames are supported:

   seacomp.png
   velavu.png
   dexcom.png

   You can also add future logos using:

   Company Name__domain.com.png

   Example:

   New Company__newcompany.com.png

   In that case the website link is created automatically.
   ========================================================= */

const hardwareLogoDirectory =
  path.resolve(
    "public/hw-meetups-logos"
  );


const supportedLogoExtensions =
  new Set(
    [
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".svg",
      ".avif"
    ]
  );


type HardwareLogo = {
  name: string;
  image: string;
  url?: string;
};


/* =========================================================
   WEBSITE LINKS

   Keys correspond to normalized filenames.

   Example:

   expertise-engineering.png
   becomes
   "expertise engineering"
   ========================================================= */

const hardwareLogoWebsites:
  Record<
    string,
    string
  > = {

  "seacomp":
    "https://www.seacomp.com/",

  "velavu":
    "https://www.velavu.com/",

  "downtown works":
    "https://www.downtownworks.com/",

  "qhr":
    "https://goqhr.com/",

  "flyband":
    "https://flyband.com/",

  "informal":
    "https://www.informal.com/",

  "expertise engineering":
    "https://expertiseengineering.com/",

  "the disabled soloist":
    "https://www.disabledsoloist.com/",

  "dexcom":
    "https://www.dexcom.com/",

  "element biosciences":
    "https://www.elementbiosciences.com/",

  "dip":
    "https://www.dip.studio/",

  "dronekyll":
    "https://www.dronekyll.com/"
};


/* =========================================================
   NORMALIZE LOGO NAME
   ========================================================= */

function normalizeLogoName(
  value: string
) {

  return value
    .toLowerCase()
    .replace(
      /[-_]+/g,
      " "
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim();

}


/* =========================================================
   PARSE LOGO FILE
   ========================================================= */

function parseHardwareLogo(
  filename: string
):
  HardwareLogo | null {

  const extension =
    path
      .extname(
        filename
      )
      .toLowerCase();


  if (
    !supportedLogoExtensions.has(
      extension
    )
  ) {

    return null;

  }


  const basename =
    path.basename(
      filename,
      extension
    );


  /*
   * Supports:
   *
   * seacomp.png
   *
   * and:
   *
   * SEACOMP__seacomp.com.png
   */

  const [
    rawName,
    rawDomain
  ] =
    basename.split(
      "__"
    );


  const name =
    rawName
      ?.replace(
        /[-_]+/g,
        " "
      )
      .replace(
        /\s+/g,
        " "
      )
      .trim();


  if (!name) {

    return null;

  }


  const normalizedName =
    normalizeLogoName(
      name
    );


  /*
   * If the filename includes a domain,
   * that domain takes priority.
   */

  const filenameDomain =
    rawDomain
      ?.trim()
      .replace(
        /^https?:\/\//i,
        ""
      )
      .replace(
        /\/+$/,
        ""
      );


  const url =
    filenameDomain
      ? `https://${filenameDomain}`
      : hardwareLogoWebsites[
          normalizedName
        ];


  return {

    name,

    image:
      `/hw-meetups-logos/${encodeURIComponent(filename)}`,

    url

  };

}


/* =========================================================
   READ LOGOS FROM PUBLIC FOLDER
   ========================================================= */

let hardwareLogos:
  HardwareLogo[] = [];


try {

  const files =
    await fs.readdir(
      hardwareLogoDirectory
    );


  hardwareLogos =
    files
      .map(
        parseHardwareLogo
      )
      .filter(
        (
          logo
        ): logo is HardwareLogo =>
          logo !== null
      )
      .sort(
        (
          a,
          b
        ) =>
          a.name.localeCompare(
            b.name
          )
      );

} catch {

  /*
   * The Community page still builds if the
   * logo directory doesn't exist yet.
   */

  hardwareLogos =
    [];

}


/* =========================================================
   TWO IDENTICAL GROUPS

   Required to create the seamless continuous marquee.
   ========================================================= */

const hardwareLogoGroups =
  [
    hardwareLogos,
    hardwareLogos
  ];
---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Community initiatives connecting founders, engineers, builders and investors across San Diego and Southern California."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Ecosystem Leadership
      </span>


      <h1
        class="
          font-serif
          text-3xl
          sm:text-4xl
          lg:text-5xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.2]
          mb-6
        "
      >
        Building Connections
        That Compound
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          leading-relaxed
          font-light
          max-w-4xl
        "
      >
        Building and participating in communities where
        founders, engineers, investors and operators can
        exchange knowledge, build relationships and move
        technical ideas toward real-world execution.
      </p>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY TRACK RECORD — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-y
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-12
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          mb-8
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community Track Record
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          Growing Through Consistent Programming
        </h2>

      </div>



      <!-- =================================================
           COMMUNITY METRICS
           ================================================= -->

      <div
        class="
          grid
          grid-cols-2
          md:grid-cols-4
          gap-px
          bg-brand-border
          border
          border-brand-border
        "
      >

        <!-- COMMUNITY MEMBERSHIPS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityMemberships}+
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Memberships
          </div>

        </div>



        <!-- COMMUNITY EVENTS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityEvents.length}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Events Led
          </div>

        </div>



        <!-- REGISTRATIONS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityRegistrations}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Registrations
          </div>

        </div>



        <!-- SPEAKERS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communitySpeakerCount}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Speakers
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITIES
       ===================================================== -->

  {
    communities.map(
      (community) => (

        <>

          <CommunityCard
            community={community}
          />


          {
            community.id ===
              "hardware-meetup" &&
            hardwareLogos.length >
              0 && (

              <!-- =========================================
                   HARDWARE MEETUP
                   SPEAKERS & SPONSORS
                   ========================================= -->

              <section
                class="
                  bg-brand-cream
                  border-b
                  border-brand-border
                  overflow-hidden
                "
              >

                <div
                  class="
                    max-w-6xl
                    w-full
                    mx-auto
                    px-6
                    pt-5
                    pb-16
                  "
                >

                  <!-- HEADER -->

                  <div
                    class="
                      mb-9
                    "
                  >

                    <span
                      class="
                        text-[10px]
                        uppercase
                        tracking-[0.2em]
                        text-brand-gold
                        font-semibold
                      "
                    >
                      Community Contributors
                    </span>


                    <h3
                      class="
                        font-serif
                        text-2xl
                        sm:text-3xl
                        font-normal
                        text-brand-charcoal
                        mt-2
                        mb-3
                      "
                    >
                      Speakers & Sponsors
                    </h3>


                    <p
                      class="
                        text-sm
                        sm:text-base
                        text-brand-slate
                        leading-relaxed
                        font-light
                        max-w-3xl
                      "
                    >
                      Organizations represented by speakers
                      and sponsors supporting San Diego's
                      hardware community.
                    </p>

                  </div>



                  <!-- =====================================
                       CONTINUOUS LOGO MARQUEE
                       ===================================== -->

                  <div
                    class="
                      hw-logo-marquee
                      relative
                      overflow-hidden
                      border-y
                      border-brand-border
                    "
                  >

                    <!-- LEFT FADE -->

                    <div
                      class="
                        hw-logo-fade
                        hw-logo-fade-left
                      "
                    >
                    </div>


                    <!-- RIGHT FADE -->

                    <div
                      class="
                        hw-logo-fade
                        hw-logo-fade-right
                      "
                    >
                    </div>



                    <!-- MOVING TRACK -->

                    <div
                      class="
                        hw-logo-track
                      "
                    >

                      {
                        hardwareLogoGroups.map(
                          (
                            group,
                            groupIndex
                          ) => (

                            <div
                              class="
                                hw-logo-group
                              "
                              aria-hidden={
                                groupIndex === 1
                                  ? "true"
                                  : undefined
                              }
                            >

                              {
                                group.map(
                                  (logo) => (

                                    logo.url ? (

                                      <a
                                        href={logo.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={
                                          groupIndex === 0
                                            ? `Visit ${logo.name}`
                                            : undefined
                                        }
                                        title={
                                          groupIndex === 0
                                            ? `Visit ${logo.name}`
                                            : undefined
                                        }
                                        tabindex={
                                          groupIndex === 1
                                            ? "-1"
                                            : undefined
                                        }
                                        class="
                                          hw-logo-link
                                        "
                                      >

                                        <img
                                          src={logo.image}
                                          alt={
                                            groupIndex === 0
                                              ? `${logo.name} logo`
                                              : ""
                                          }
                                          loading="lazy"
                                          decoding="async"
                                          class="
                                            hw-logo-image
                                          "
                                        />

                                      </a>

                                    ) : (

                                      <div
                                        title={logo.name}
                                        class="
                                          hw-logo-link
                                        "
                                      >

                                        <img
                                          src={logo.image}
                                          alt={
                                            groupIndex === 0
                                              ? `${logo.name} logo`
                                              : ""
                                          }
                                          loading="lazy"
                                          decoding="async"
                                          class="
                                            hw-logo-image
                                          "
                                        />

                                      </div>

                                    )

                                  )
                                )
                              }

                            </div>

                          )
                        )
                      }

                    </div>

                  </div>



                  <p
                    class="
                      mt-4
                      text-[10px]
                      uppercase
                      tracking-[0.15em]
                      text-brand-slate
                    "
                  >
                    Select a logo to visit the organization's website.
                  </p>

                </div>

              </section>

            )
          }

        </>

      )
    )
  }



  <!-- =====================================================
       CTA — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
        text-center
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Get Involved
      </span>


      <h2
        class="
          font-serif
          text-3xl
          sm:text-4xl
          font-normal
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        Building Something in San Diego?
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          sm:text-base
          leading-relaxed
          font-light
          max-w-2xl
          mx-auto
          mb-8
        "
      >
        Whether you're a founder, engineer, investor,
        venue partner or simply curious about the community,
        I'd like to hear from you.
      </p>


      <a
        href="/contact/?reason=startup-community"
        class="
          inline-flex
          items-center
          gap-2
          px-6
          py-3
          bg-brand-charcoal
          text-white
          text-[11px]
          uppercase
          tracking-[0.2em]
          hover:bg-brand-gold
          transition-colors
        "
      >
        Connect With Me

        <span>
          →
        </span>
      </a>

    </div>

  </section>



  <!-- =====================================================
       HARDWARE MEETUP LOGO STYLES
       ===================================================== -->

  <style>

    /* =====================================================
       MARQUEE CONTAINER
       ===================================================== */

    .hw-logo-marquee {
      width:
        100%;

      padding-top:
        28px;

      padding-bottom:
        28px;
    }



    /* =====================================================
       MOVING TRACK

       Moves from RIGHT → LEFT.
       ===================================================== */

    .hw-logo-track {
      display:
        flex;

      align-items:
        center;

      width:
        max-content;

      will-change:
        transform;

      animation:
        hw-logo-scroll
        36s
        linear
        infinite;
    }


    /*
     * Pause movement when the visitor wants
     * to interact with one of the logos.
     */

    .hw-logo-marquee:hover
    .hw-logo-track {
      animation-play-state:
        paused;
    }



    /* =====================================================
       LOGO GROUP
       ===================================================== */

    .hw-logo-group {
      display:
        flex;

      align-items:
        center;

      flex-shrink:
        0;

      gap:
        46px;

      padding-right:
        46px;
    }



    /* =====================================================
       INDIVIDUAL LOGO AREA

       Every logo receives the same footprint.

       NO CARD.
       NO WHITE SQUARE.
       NO BORDER.
       NO BACKGROUND.
       ===================================================== */

    .hw-logo-link {
      width:
        170px;

      height:
        72px;

      flex:
        0 0 170px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      padding:
        8px 10px;

      background:
        transparent;

      border:
        none;

      text-decoration:
        none;

      outline-offset:
        5px;
    }


    .hw-logo-link:focus-visible {
      outline:
        1px solid
        var(--brand-gold);
    }



    /* =====================================================
       LOGO IMAGE

       Same visual footprint regardless of source dimensions.
       ===================================================== */

    .hw-logo-image {
      display:
        block;

      width:
        100%;

      height:
        100%;

      max-width:
        150px;

      max-height:
        54px;

      object-fit:
        contain;

      object-position:
        center;


      /*
       * SAME FILTER AS FIELDWORK.
       *
       * This normalizes all source logos to the same
       * warm muted Soleil & Stone tone.
       */

      filter:
        brightness(0)
        saturate(100%)
        invert(69%)
        sepia(18%)
        saturate(560%)
        hue-rotate(4deg)
        brightness(88%)
        contrast(88%);


      opacity:
        1;


      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }



    /* =====================================================
       HOVER
       ===================================================== */

    .hw-logo-link:hover
    .hw-logo-image {
      opacity:
        0.78;

      transform:
        scale(1.04);
    }



    /* =====================================================
       EDGE FADES
       ===================================================== */

    .hw-logo-fade {
      position:
        absolute;

      top:
        0;

      bottom:
        0;

      width:
        72px;

      z-index:
        3;

      pointer-events:
        none;
    }


    .hw-logo-fade-left {
      left:
        0;

      background:
        linear-gradient(
          to right,
          var(--brand-cream),
          rgba(244, 241, 232, 0)
        );
    }


    .hw-logo-fade-right {
      right:
        0;

      background:
        linear-gradient(
          to left,
          var(--brand-cream),
          rgba(244, 241, 232, 0)
        );
    }



    /* =====================================================
       MARQUEE ANIMATION
       ===================================================== */

    @keyframes hw-logo-scroll {

      from {

        transform:
          translate3d(
            0,
            0,
            0
          );

      }


      to {

        transform:
          translate3d(
            -50%,
            0,
            0
          );

      }

    }



    /* =====================================================
       MOBILE
       ===================================================== */

    @media (
      max-width: 640px
    ) {

      .hw-logo-marquee {
        padding-top:
          22px;

        padding-bottom:
          22px;
      }


      .hw-logo-track {
        animation-duration:
          28s;
      }


      .hw-logo-group {
        gap:
          28px;

        padding-right:
          28px;
      }


      .hw-logo-link {
        width:
          135px;

        height:
          62px;

        flex-basis:
          135px;

        padding:
          7px;
      }


      .hw-logo-image {
        max-width:
          120px;

        max-height:
          46px;
      }


      .hw-logo-fade {
        width:
          32px;
      }

    }



    /* =====================================================
       REDUCED MOTION
       ===================================================== */

    @media (
      prefers-reduced-motion:
        reduce
    ) {

      .hw-logo-track {
        animation:
          none;

        transform:
          none;
      }


      .hw-logo-marquee {
        overflow-x:
          auto;
      }


      .hw-logo-group:nth-child(2) {
        display:
          none;
      }

    }

  </style>

</BaseLayout>
