---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import CommunityCard
  from "../components/CommunityCard.astro";

import ContributorLogoStrip
  from "../components/ContributorLogoStrip.astro";

import OtherHostedEvents
  from "../components/OtherHostedEvents.astro";

import {
  communities
} from "../data/communities.cms";

import {
  events
} from "../data/events.cms";

import {
  communityLogos
} from "../data/logos.cms";

import {
  getCommunityMetrics,
  getCompletedLedEvents,
  getUniqueSpeakers,
  isCompletedEvent
} from "../utils/eventMetrics";


/* =========================================================
   COMMUNITY MEMBERSHIPS
   ========================================================= */

const communityMemberships =
  communities.reduce(
    (
      total,
      community
    ) =>
      total +
      (
        community.members ??
        0
      ),
    0
  );


/* =========================================================
   AUTOMATED COMMUNITY METRICS
   ========================================================= */

const communityMetrics =
  getCommunityMetrics(
    events
  );


const communityEvents =
  communityMetrics.events;


const communityRegistrations =
  communityMetrics.registrations;


const completedLedEvents =
  getCompletedLedEvents(
    events
  );


const allLedRegistrations =
  completedLedEvents.reduce(
    (
      total,
      event
    ) =>
      total +
      (
        event.registrations ??
        0
      ),
    0
  );


const allLedSpeakerCount =
  getUniqueSpeakers(
    completedLedEvents
  ).length;


/* =========================================================
   STARTUP MIXER CONTRIBUTORS
   ========================================================= */

const startupMixerLogos =
  communityLogos
    .filter(
      (logo) =>
        logo.communityId ===
          "startup-mixer" &&
        logo.sourceType ===
          "sponsor"
    )
    .map(
      (logo) => ({
        name:
          logo.name,

        image:
          logo.image,

        url:
          logo.url
      })
    );


/* =========================================================
   OTHER HOSTED / CO-ORGANIZED EVENTS

   Any completed event led outside the two recurring
   communities appears here automatically.
   ========================================================= */

const otherHostedEvents =
  events
    .filter(
      (event) =>
        (
          event.participation ===
            "hosted" ||
          event.participation ===
            "co-organized"
        ) &&
        ![
          "startup-mixer",
          "hardware-meetup"
        ].includes(
          event.communityId ||
          ""
        ) &&
        isCompletedEvent(
          event
        )
    )
    .sort(
      (
        a,
        b
      ) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime()
    );


const otherHostedLogoMap =
  new Map();


otherHostedEvents
  .flatMap(
    (event) =>
      event.sponsorDetails ??
      []
  )
  .forEach(
    (sponsor) => {

      if (
        !sponsor?.name ||
        !sponsor?.logo
      ) {
        return;
      }


      const key =
        sponsor.name
          .trim()
          .toLowerCase();


      if (
        !otherHostedLogoMap.has(
          key
        )
      ) {
        otherHostedLogoMap.set(
          key,
          {
            name:
              sponsor.name,

            image:
              sponsor.logo,

            url:
              sponsor.website
          }
        );
      }

    }
  );


const otherHostedLogos =
  Array.from(
    otherHostedLogoMap.values()
  );


/* =========================================================
   HARDWARE MEETUP LOGOS
   CMS-generated from published Hardware Meetup
   speakers + sponsors, already deduplicated.
   ========================================================= */

const hardwareLogos =
  communityLogos
    .filter(
      (logo) =>
        logo.communityId ===
        "hardware-meetup"
    )
    .map(
      (logo) => ({
        name:
          logo.name,

        image:
          logo.image,

        url:
          logo.url
      })
    );


---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Community initiatives connecting founders, engineers, builders and investors across San Diego and Southern California."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Ecosystem Leadership
      </span>


      <h1
        class="
          font-serif
          text-3xl
          sm:text-4xl
          lg:text-5xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.2]
          mb-6
        "
      >
        Building Connections
        That Compound
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          leading-relaxed
          font-light
          max-w-4xl
        "
      >
        Building and participating in communities where
        founders, engineers, investors and operators can
        exchange knowledge, build relationships and move
        technical ideas toward real-world execution.
      </p>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY TRACK RECORD — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-y
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-12
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          mb-8
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community Track Record
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          Growing Through Consistent Programming
        </h2>

      </div>



      <!-- =================================================
           COMMUNITY METRICS
           ================================================= -->

      <div
        class="
          grid
          grid-cols-2
          md:grid-cols-4
          gap-px
          bg-brand-border
          border
          border-brand-border
        "
      >

        <!-- COMMUNITY MEMBERSHIPS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityMemberships}+
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Memberships
          </div>

        </div>



        <!-- COMMUNITY EVENTS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {completedLedEvents.length}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Events Led
          </div>

        </div>



        <!-- REGISTRATIONS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {allLedRegistrations}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Registrations
          </div>

        </div>



        <!-- SPEAKERS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {allLedSpeakerCount}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Speakers
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITIES
       ===================================================== -->

  {
    communities.map(
      (community) => (

        <>

          <CommunityCard
            community={community}
          />


          {
            community.id ===
              "startup-mixer" && (

              <ContributorLogoStrip
                eyebrow="Event Partners"
                title="Sponsors"
                description="Organizations supporting the Startup Mixer through sponsorship."
                logos={startupMixerLogos}
                emptyMessage="Sponsor logos will appear here automatically as sponsors are linked to Startup Mixer events in the CMS."
                background="white"
              />

            )
          }


          {
            community.id ===
              "hardware-meetup" && (

              <ContributorLogoStrip
                eyebrow="Community Contributors"
                title="Speakers & Sponsors"
                description="Organizations represented by speakers and sponsors supporting San Diego's hardware community."
                logos={hardwareLogos}
                emptyMessage="Speaker-company and sponsor logos will appear here automatically as contributors are linked to Hardware Meetup events in the CMS."
                background="cream"
              />

            )
          }


        </>

      )
    )
  }



  {
    otherHostedEvents.length > 0 && (

      <OtherHostedEvents
        events={otherHostedEvents}
        logos={otherHostedLogos}
      />

    )
  }



  <!-- =====================================================
       CTA — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
        text-center
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Get Involved
      </span>


      <h2
        class="
          font-serif
          text-3xl
          sm:text-4xl
          font-normal
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        Building Something in San Diego?
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          sm:text-base
          leading-relaxed
          font-light
          max-w-2xl
          mx-auto
          mb-8
        "
      >
        Whether you're a founder, engineer, investor,
        venue partner or simply curious about the community,
        I'd like to hear from you.
      </p>


      <a
        href="/contact/?reason=startup-community"
        class="
          inline-flex
          items-center
          gap-2
          px-6
          py-3
          bg-brand-charcoal
          text-white
          text-[11px]
          uppercase
          tracking-[0.2em]
          hover:bg-brand-gold
          transition-colors
        "
      >
        Connect With Me

        <span>
          →
        </span>
      </a>

    </div>

  </section>



</BaseLayout>
