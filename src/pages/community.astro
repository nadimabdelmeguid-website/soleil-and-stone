---
import BaseLayout from "../layouts/BaseLayout.astro";

import CommunityCard from "../components/CommunityCard.astro";

import {
  communities
} from "../data/communities";

import {
  events
} from "../data/events";

import {
  getCommunityMetrics
} from "../utils/eventMetrics";


/* =========================================================
   COMMUNITY MEMBERSHIPS

   Membership figures may represent a growing community
   size / lower-bound estimate, so the UI can still show "+".
   ========================================================= */

const communityMemberships =
  communities.reduce(
    (
      total,
      community
    ) =>
      total +
      (
        community.members ??
        0
      ),
    0
  );


/* =========================================================
   AUTOMATED COMMUNITY METRICS

   Single source of truth:
   events.ts → eventMetrics.ts → UI

   Automatically includes only completed hosted /
   co-organized community events.
   ========================================================= */

const communityMetrics =
  getCommunityMetrics(
    events
  );


const communityEvents =
  communityMetrics.events;


const communityRegistrations =
  communityMetrics.registrations;


const communitySpeakerCount =
  communityMetrics.speakerCount;
---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Community initiatives connecting founders, engineers, builders and investors across San Diego and Southern California."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Ecosystem Leadership
      </span>


      <h1
        class="
          font-serif
          text-3xl
          sm:text-4xl
          lg:text-5xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.2]
          mb-6
        "
      >
        Building Connections
        That Compound
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          leading-relaxed
          font-light
          max-w-4xl
        "
      >
        Building and participating in communities where
        founders, engineers, investors and operators can
        exchange knowledge, build relationships and move
        technical ideas toward real-world execution.
      </p>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY TRACK RECORD — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-y
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-12
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          mb-8
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community Track Record
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          Growing Through Consistent Programming
        </h2>

      </div>



      <!-- =================================================
           COMMUNITY METRICS
           ================================================= -->

      <div
        class="
          grid
          grid-cols-2
          md:grid-cols-4
          gap-px
          bg-brand-border
          border
          border-brand-border
        "
      >

        <!-- COMMUNITY MEMBERSHIPS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityMemberships}+
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Memberships
          </div>

        </div>



        <!-- COMMUNITY EVENTS LED -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityEvents.length}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Events Led
          </div>

        </div>



        <!-- COMMUNITY REGISTRATIONS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityRegistrations}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Registrations
          </div>

        </div>



        <!-- INDUSTRY SPEAKERS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communitySpeakerCount}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Speakers
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITIES
       ===================================================== -->

  {
    communities.map(
      (community) => (

        <CommunityCard
          community={community}
        />

      )
    )
  }



  <!-- =====================================================
       CTA — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
        text-center
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Get Involved
      </span>


      <h2
        class="
          font-serif
          text-3xl
          sm:text-4xl
          font-normal
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        Building Something in San Diego?
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          sm:text-base
          leading-relaxed
          font-light
          max-w-2xl
          mx-auto
          mb-8
        "
      >
        Whether you're a founder, engineer, investor,
        venue partner or simply curious about the community,
        I'd like to hear from you.
      </p>


      <a
        href="/?type=community#contact"
        class="
          inline-flex
          items-center
          gap-2
          px-6
          py-3
          bg-brand-charcoal
          text-white
          text-[11px]
          uppercase
          tracking-[0.2em]
          hover:bg-brand-gold
          transition-colors
        "
      >
        Connect With Me

        <span>
          →
        </span>
      </a>

    </div>

  </section>

</BaseLayout>
