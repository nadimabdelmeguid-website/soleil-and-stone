---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import CommunityCard
  from "../components/CommunityCard.astro";

import ContributorLogoStrip
  from "../components/ContributorLogoStrip.astro";

import OtherHostedEvents
  from "../components/OtherHostedEvents.astro";

import {
  communities
} from "../data/communities.cms";

import {
  events
} from "../data/events.cms";

import {
  communityLogos
} from "../data/logos.cms";

import {
  getCommunityMetrics,
  isCompletedEvent
} from "../utils/eventMetrics";


/* =========================================================
   COMMUNITY MEMBERSHIPS
   ========================================================= */

const communityMemberships =
  communities.reduce(
    (
      total,
      community
    ) =>
      total +
      (
        community.members ??
        0
      ),
    0
  );


/* =========================================================
   AUTOMATED COMMUNITY METRICS
   ========================================================= */

const communityMetrics =
  getCommunityMetrics(
    events
  );


const communityEvents =
  communityMetrics.events;


const communityRegistrations =
  communityMetrics.registrations;


const communitySpeakerCount =
  communityMetrics.speakerCount;


/* =========================================================
   STARTUP MIXER CONTRIBUTORS
   ========================================================= */

const startupMixerLogos =
  communityLogos
    .filter(
      (logo) =>
        logo.communityId ===
          "startup-mixer" &&
        logo.sourceType ===
          "sponsor"
    )
    .map(
      (logo) => ({
        name:
          logo.name,

        image:
          logo.image,

        url:
          logo.url
      })
    );


/* =========================================================
   OTHER HOSTED / CO-ORGANIZED EVENTS

   Any completed event led outside the two recurring
   communities appears here automatically.
   ========================================================= */

const otherHostedEvents =
  events
    .filter(
      (event) =>
        (
          event.participation ===
            "hosted" ||
          event.participation ===
            "co-organized"
        ) &&
        ![
          "startup-mixer",
          "hardware-meetup"
        ].includes(
          event.communityId ||
          ""
        ) &&
        isCompletedEvent(
          event
        )
    )
    .sort(
      (
        a,
        b
      ) =>
        new Date(
          `${b.startDate}T12:00:00`
        ).getTime() -
        new Date(
          `${a.startDate}T12:00:00`
        ).getTime()
    );


const otherHostedLogoMap =
  new Map();


otherHostedEvents
  .flatMap(
    (event) =>
      event.sponsorDetails ??
      []
  )
  .forEach(
    (sponsor) => {

      if (
        !sponsor?.name ||
        !sponsor?.logo
      ) {
        return;
      }


      const key =
        sponsor.name
          .trim()
          .toLowerCase();


      if (
        !otherHostedLogoMap.has(
          key
        )
      ) {
        otherHostedLogoMap.set(
          key,
          {
            name:
              sponsor.name,

            image:
              sponsor.logo,

            url:
              sponsor.website
          }
        );
      }

    }
  );


const otherHostedLogos =
  Array.from(
    otherHostedLogoMap.values()
  );


/* =========================================================
   HARDWARE MEETUP LOGOS
   CMS-generated from published Hardware Meetup
   speakers + sponsors, already deduplicated.
   ========================================================= */

const hardwareLogos =
  communityLogos
    .filter(
      (logo) =>
        logo.communityId ===
        "hardware-meetup"
    )
    .map(
      (logo) => ({
        name:
          logo.name,

        image:
          logo.image,

        url:
          logo.url
      })
    );


const hardwareLogoGroups =
  [
    hardwareLogos,
    hardwareLogos
  ];

---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Community initiatives connecting founders, engineers, builders and investors across San Diego and Southern California."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Ecosystem Leadership
      </span>


      <h1
        class="
          font-serif
          text-3xl
          sm:text-4xl
          lg:text-5xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.2]
          mb-6
        "
      >
        Building Connections
        That Compound
      </h1>


      <p
        class="
          text-base
          text-brand-slate
          leading-relaxed
          font-light
          max-w-4xl
        "
      >
        Building and participating in communities where
        founders, engineers, investors and operators can
        exchange knowledge, build relationships and move
        technical ideas toward real-world execution.
      </p>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY TRACK RECORD — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-y
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-12
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          mb-8
        "
      >

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Community Track Record
        </span>


        <h2
          class="
            font-serif
            text-2xl
            sm:text-3xl
            text-brand-charcoal
            mt-2
          "
        >
          Growing Through Consistent Programming
        </h2>

      </div>



      <!-- =================================================
           COMMUNITY METRICS
           ================================================= -->

      <div
        class="
          grid
          grid-cols-2
          md:grid-cols-4
          gap-px
          bg-brand-border
          border
          border-brand-border
        "
      >

        <!-- COMMUNITY MEMBERSHIPS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityMemberships}+
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Memberships
          </div>

        </div>



        <!-- COMMUNITY EVENTS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityEvents.length}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Events Led
          </div>

        </div>



        <!-- REGISTRATIONS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communityRegistrations}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Community Registrations
          </div>

        </div>



        <!-- SPEAKERS -->

        <div
          class="
            bg-white
            p-6
          "
        >

          <div
            class="
              font-serif
              text-3xl
              text-brand-gold
              mb-2
            "
          >
            {communitySpeakerCount}
          </div>


          <div
            class="
              text-[10px]
              uppercase
              tracking-[0.15em]
              text-brand-slate
              leading-relaxed
            "
          >
            Industry Speakers
          </div>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITIES
       ===================================================== -->

  {
    communities.map(
      (community) => (

        <>

          <CommunityCard
            community={community}
          />


          {
            community.id ===
              "startup-mixer" && (

              <ContributorLogoStrip
                eyebrow="Event Partners"
                title="Sponsors"
                description="Organizations supporting the Startup Mixer through sponsorship."
                logos={startupMixerLogos}
                emptyMessage="Sponsor logos will appear here automatically as sponsors are linked to Startup Mixer events in the CMS."
                background="cream"
              />

            )
          }


          {
            community.id ===
              "hardware-meetup" &&
            hardwareLogos.length >
              0 && (

              <!-- =========================================
                   HARDWARE MEETUP
                   SPEAKERS & SPONSORS
                   ========================================= -->

              <section
                class="
                  bg-brand-cream
                  border-b
                  border-brand-border
                  overflow-hidden
                "
              >

                <div
                  class="
                    max-w-6xl
                    w-full
                    mx-auto
                    px-6
                    pt-5
                    pb-16
                  "
                >

                  <!-- HEADER -->

                  <div
                    class="
                      mb-9
                    "
                  >

                    <span
                      class="
                        text-[10px]
                        uppercase
                        tracking-[0.2em]
                        text-brand-gold
                        font-semibold
                      "
                    >
                      Community Contributors
                    </span>


                    <h3
                      class="
                        font-serif
                        text-2xl
                        sm:text-3xl
                        font-normal
                        text-brand-charcoal
                        mt-2
                        mb-3
                      "
                    >
                      Speakers & Sponsors
                    </h3>


                    <p
                      class="
                        text-sm
                        sm:text-base
                        text-brand-slate
                        leading-relaxed
                        font-light
                        max-w-3xl
                      "
                    >
                      Organizations represented by speakers
                      and sponsors supporting San Diego's
                      hardware community.
                    </p>

                  </div>



                  <!-- =====================================
                       CONTINUOUS LOGO MARQUEE
                       ===================================== -->

                  <div
                    class="
                      hw-logo-marquee
                      relative
                      overflow-hidden
                      border-y
                      border-brand-border
                    "
                  >

                    <!-- LEFT FADE -->

                    <div
                      class="
                        hw-logo-fade
                        hw-logo-fade-left
                      "
                    >
                    </div>


                    <!-- RIGHT FADE -->

                    <div
                      class="
                        hw-logo-fade
                        hw-logo-fade-right
                      "
                    >
                    </div>



                    <!-- MOVING TRACK -->

                    <div
                      class="
                        hw-logo-track
                      "
                    >

                      {
                        hardwareLogoGroups.map(
                          (
                            group,
                            groupIndex
                          ) => (

                            <div
                              class="
                                hw-logo-group
                              "
                              aria-hidden={
                                groupIndex === 1
                                  ? "true"
                                  : undefined
                              }
                            >

                              {
                                group.map(
                                  (logo) => (

                                    logo.url ? (

                                      <a
                                        href={logo.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={
                                          groupIndex === 0
                                            ? `Visit ${logo.name}`
                                            : undefined
                                        }
                                        title={
                                          groupIndex === 0
                                            ? `Visit ${logo.name}`
                                            : undefined
                                        }
                                        tabindex={
                                          groupIndex === 1
                                            ? "-1"
                                            : undefined
                                        }
                                        class="
                                          hw-logo-link
                                        "
                                      >

                                        <img
                                          src={logo.image}
                                          alt={
                                            groupIndex === 0
                                              ? `${logo.name} logo`
                                              : ""
                                          }
                                          loading="lazy"
                                          decoding="async"
                                          class="
                                            hw-logo-image
                                          "
                                        />

                                      </a>

                                    ) : (

                                      <div
                                        title={logo.name}
                                        class="
                                          hw-logo-link
                                        "
                                      >

                                        <img
                                          src={logo.image}
                                          alt={
                                            groupIndex === 0
                                              ? `${logo.name} logo`
                                              : ""
                                          }
                                          loading="lazy"
                                          decoding="async"
                                          class="
                                            hw-logo-image
                                          "
                                        />

                                      </div>

                                    )

                                  )
                                )
                              }

                            </div>

                          )
                        )
                      }

                    </div>

                  </div>



                  <p
                    class="
                      mt-4
                      text-[10px]
                      uppercase
                      tracking-[0.15em]
                      text-brand-slate
                    "
                  >
                    Select a logo to visit the organization's website.
                  </p>

                </div>

              </section>

            )
          }

        </>

      )
    )
  }



  {
    otherHostedEvents.length > 0 && (

      <OtherHostedEvents
        events={otherHostedEvents}
        logos={otherHostedLogos}
      />

    )
  }



  <!-- =====================================================
       CTA — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
        text-center
      "
    >

      <span
        class="
          text-[10px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Get Involved
      </span>


      <h2
        class="
          font-serif
          text-3xl
          sm:text-4xl
          font-normal
          text-brand-charcoal
          mt-2
          mb-5
        "
      >
        Building Something in San Diego?
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          sm:text-base
          leading-relaxed
          font-light
          max-w-2xl
          mx-auto
          mb-8
        "
      >
        Whether you're a founder, engineer, investor,
        venue partner or simply curious about the community,
        I'd like to hear from you.
      </p>


      <a
        href="/contact/?reason=startup-community"
        class="
          inline-flex
          items-center
          gap-2
          px-6
          py-3
          bg-brand-charcoal
          text-white
          text-[11px]
          uppercase
          tracking-[0.2em]
          hover:bg-brand-gold
          transition-colors
        "
      >
        Connect With Me

        <span>
          →
        </span>
      </a>

    </div>

  </section>



  <!-- =====================================================
       HARDWARE MEETUP LOGO STYLES
       ===================================================== -->

  <style>

    /* =====================================================
       MARQUEE CONTAINER
       ===================================================== */

    .hw-logo-marquee {
      width:
        100%;

      padding-top:
        28px;

      padding-bottom:
        28px;
    }



    /* =====================================================
       MOVING TRACK

       Moves from RIGHT → LEFT.
       ===================================================== */

    .hw-logo-track {
      display:
        flex;

      align-items:
        center;

      width:
        max-content;

      will-change:
        transform;

      animation:
        hw-logo-scroll
        36s
        linear
        infinite;
    }


    /*
     * Pause movement when the visitor wants
     * to interact with one of the logos.
     */

    .hw-logo-marquee:hover
    .hw-logo-track {
      animation-play-state:
        paused;
    }



    /* =====================================================
       LOGO GROUP
       ===================================================== */

    .hw-logo-group {
      display:
        flex;

      align-items:
        center;

      flex-shrink:
        0;

      gap:
        46px;

      padding-right:
        46px;
    }



    /* =====================================================
       INDIVIDUAL LOGO AREA

       Every logo receives the exact same footprint.
       ===================================================== */

    .hw-logo-link {
      width:
        180px;

      height:
        78px;

      flex:
        0 0 180px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      padding:
        10px;

      background:
        transparent;

      border:
        none;

      text-decoration:
        none;

      outline-offset:
        5px;

      overflow:
        hidden;
    }


    .hw-logo-link:focus-visible {
      outline:
        1px solid
        var(--brand-gold);
    }



    /* =====================================================
       LOGO IMAGE

       All source images are rendered inside the exact
       same 150 × 52 pixel visual area.

       object-fit: contain keeps the complete logo visible
       without stretching or cropping it.
       ===================================================== */

    .hw-logo-image {
      display:
        block;

      width:
        150px;

      height:
        52px;

      object-fit:
        contain;

      object-position:
        center;

      flex-shrink:
        0;


      /*
       * SAME FILTER AS FIELDWORK.
       *
       * This normalizes all source logos to the same
       * warm muted Soleil & Stone tone.
       */

      filter:
        brightness(0)
        saturate(100%)
        invert(69%)
        sepia(18%)
        saturate(560%)
        hue-rotate(4deg)
        brightness(88%)
        contrast(88%);


      opacity:
        1;


      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }



    /* =====================================================
       HOVER
       ===================================================== */

    .hw-logo-link:hover
    .hw-logo-image {
      opacity:
        0.78;

      transform:
        scale(1.04);
    }



    /* =====================================================
       EDGE FADES
       ===================================================== */

    .hw-logo-fade {
      position:
        absolute;

      top:
        0;

      bottom:
        0;

      width:
        72px;

      z-index:
        3;

      pointer-events:
        none;
    }


    .hw-logo-fade-left {
      left:
        0;

      background:
        linear-gradient(
          to right,
          var(--brand-cream),
          rgba(244, 241, 232, 0)
        );
    }


    .hw-logo-fade-right {
      right:
        0;

      background:
        linear-gradient(
          to left,
          var(--brand-cream),
          rgba(244, 241, 232, 0)
        );
    }



    /* =====================================================
       MARQUEE ANIMATION
       ===================================================== */

    @keyframes hw-logo-scroll {

      from {

        transform:
          translate3d(
            0,
            0,
            0
          );

      }


      to {

        transform:
          translate3d(
            -50%,
            0,
            0
          );

      }

    }



    /* =====================================================
       MOBILE
       ===================================================== */

    @media (
      max-width: 640px
    ) {

      .hw-logo-marquee {
        padding-top:
          22px;

        padding-bottom:
          22px;
      }


      .hw-logo-track {
        animation-duration:
          28s;
      }


      .hw-logo-group {
        gap:
          28px;

        padding-right:
          28px;
      }


      .hw-logo-link {
        width:
          150px;

        height:
          68px;

        flex:
          0 0 150px;

        padding:
          8px;
      }


      .hw-logo-image {
        width:
          125px;

        height:
          44px;
      }


      .hw-logo-fade {
        width:
          32px;
      }

    }



    /* =====================================================
       REDUCED MOTION
       ===================================================== */

    @media (
      prefers-reduced-motion:
        reduce
    ) {

      .hw-logo-track {
        animation:
          none;

        transform:
          none;
      }


      .hw-logo-marquee {
        overflow-x:
          auto;
      }


      .hw-logo-group:nth-child(2) {
        display:
          none;
      }

    }

  </style>

</BaseLayout>
