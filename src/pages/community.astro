---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommunityCard from "../components/CommunityCard.astro";
import { communities } from "../data/communities";
---

<BaseLayout
  title="SOLEIL & STONE | Community"
  description="Community initiatives connecting founders, engineers, builders and investors across San Diego and Southern California."
>

  <!-- =====================================================
       COMMUNITY HERO
       ===================================================== -->

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
      border-b
      border-brand-border
    "
  >

    <span
      class="
        inline-block
        px-3
        py-1
        bg-brand-gold/10
        border
        border-brand-gold/30
        text-brand-gold
        text-[10px]
        uppercase
        tracking-[0.2em]
        font-semibold
        mb-6
      "
    >
      Ecosystem Leadership
    </span>


    <h1
      class="
        font-serif
        text-3xl
        sm:text-4xl
        lg:text-5xl
        font-normal
        tracking-wide
        text-brand-charcoal
        leading-[1.2]
        mb-6
      "
    >
      Leading Communities & Groups
    </h1>


    <p
      class="
        text-base
        text-brand-slate
        leading-relaxed
        font-light
        max-w-4xl
      "
    >
      Creating low-pressure, high-value spaces where founders,
      engineers, builders and investors can meet, exchange ideas
      and build lasting relationships across Southern California.
    </p>

  </section>



  <!-- =====================================================
       COMMUNITY SECTIONS
       ===================================================== -->

  {
    communities.map(
      (community) => (
        <CommunityCard
          community={community}
        />
      )
    )
  }



  <!-- =====================================================
       CLOSING CTA
       ===================================================== -->

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-20
      text-center
    "
  >

    <span
      class="
        text-xs
        uppercase
        tracking-[0.2em]
        text-brand-gold
        font-semibold
      "
    >
      Get Involved
    </span>


    <h2
      class="
        font-serif
        text-3xl
        sm:text-4xl
        font-normal
        text-brand-charcoal
        mt-2
        mb-5
      "
    >
      Building Something in San Diego?
    </h2>


    <p
      class="
        text-brand-slate
        text-sm
        sm:text-base
        leading-relaxed
        font-light
        max-w-2xl
        mx-auto
        mb-8
      "
    >
      Whether you're a founder, engineer, investor,
      venue partner or simply curious about the community,
      I'd like to hear from you.
    </p>


    <a
      href="/?type=community#contact"
      class="
        inline-flex
        items-center
        gap-2
        px-6
        py-3
        bg-brand-charcoal
        text-white
        text-xs
        uppercase
        tracking-[0.2em]
        hover:bg-brand-gold
        transition-colors
      "
    >
      Connect With Me
      <span>→</span>
    </a>

  </section>

</BaseLayout>
