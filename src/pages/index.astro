---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ArticleCard from "../components/ArticleCard.astro";
import HomeEvents from "../components/HomeEvents.astro";

import {
  site
} from "../data/site";


/* =========================================================
   FIELD NOTES
   ========================================================= */

const now =
  new Date();


const fieldNotes =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    )
    .sort(
      (a, b) =>
        b.data.published.getTime() -
        a.data.published.getTime()
    );


/*
 * Homepage:
 * show the two newest published notes
 * that are marked as featured.
 */

const featuredNotes =
  fieldNotes
    .filter(
      (post) =>
        post.data.featured
    )
    .slice(
      0,
      2
    );
---

<BaseLayout
  title="SOLEIL & STONE | Hardware, Commercialization & Innovation Ecosystems"
  description="Field observations, communities and projects at the intersection of hardware commercialization, industry fieldwork and innovation ecosystems."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-20
        pb-16
      "
    >

      <!-- =================================================
           HERO INTRO
           ================================================= -->

      <div
        class="
          max-w-4xl
          mx-auto
          text-center
        "
      >

        <span
          class="
            inline-block
            text-[10px]
            uppercase
            tracking-[0.22em]
            text-brand-gold
            font-semibold
            mb-6
          "
        >
          {site.author.tagline}
        </span>


        <h1
          class="
            font-serif
            text-4xl
            sm:text-5xl
            lg:text-6xl
            text-brand-charcoal
            leading-[1.12]
            font-normal
            tracking-wide
            mb-7
          "
        >
          Global Perspective.
          <br />

          Technical Mindset.
          <br />

          Local Impact.
        </h1>


        <p
          class="
            text-base
            sm:text-lg
            text-brand-slate
            leading-relaxed
            font-light
            max-w-3xl
            mx-auto
          "
        >
          I have spent most of my career around hardware and new technologies, 
          helping bring products to market. Today, I’m also building projects 
          of my own and getting more involved in San Diego’s startup community.
        </p>

      </div>



      <!-- =================================================
           THREE PILLARS
           ================================================= -->

      <div
        class="
          max-w-5xl
          mx-auto
          mt-14
          pt-10
          border-t
          border-brand-border
        "
      >

        <!--
          MOBILE:
          Free horizontal swipe.
          No forced snapping.

          DESKTOP:
          Returns to the existing 3-column grid.
        -->

        <div
          class="
            home-pillars-scroll
            md:grid
            md:grid-cols-3
            md:gap-0
          "
        >

          <!-- HARDWARE COMMERCIALIZATION -->

          <div
            class="
              home-pillar
              md:pr-8
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                01
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Hardware Commercialization
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                I work with technical products from development to market, 
                connecting engineering, manufacturing, sales and what customers 
                actually need.
              </p>

            </div>

          </div>



          <!-- INDUSTRY FIELDWORK -->

          <div
            class="
              home-pillar
              md:px-8
              md:border-l
              md:border-brand-border
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                02
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Industry Fieldwork
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                I spend a lot of time at trade shows, visiting companies 
                and talking with engineers, founders and manufacturers. 
                This is where I learn the most about what is actually 
                happening in the industry.
              </p>

            </div>

          </div>



          <!-- INNOVATION ECOSYSTEMS -->

          <div
            class="
              home-pillar
              md:pl-8
              md:border-l
              md:border-brand-border
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                03
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Innovation Ecosystems
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                When I moved to San Diego, I wanted to meet more people 
                who were building things. I started going to events, 
                then hosting my own. What started as a way to meet people 
                is slowly becoming a community.
              </p>

            </div>

          </div>

        </div>



        <!-- =================================================
             MOBILE PILLAR HINT
             ================================================= -->

        <p
          class="
            md:hidden
            mt-5
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
            text-center
          "
        >
          Swipe to explore

          <span
            class="
              ml-1
            "
          >
            →
          </span>
        </p>



        <!-- =================================================
             HERO CTAS
             ================================================= -->

        <div
          class="
            flex
            flex-wrap
            justify-center
            gap-x-7
            gap-y-3
            mt-10
          "
        >

          <a
            href="/community/"
            class="
              inline-flex
              items-center
              gap-2
              text-[11px]
              uppercase
              tracking-[0.16em]
              font-semibold
              text-brand-charcoal
              hover:text-brand-gold
              transition-colors
            "
          >
            Explore Community
            <span>→</span>
          </a>


          <a
            href="/about/"
            class="
              inline-flex
              items-center
              gap-2
              text-[11px]
              uppercase
              tracking-[0.16em]
              font-semibold
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            More About Me
            <span>→</span>
          </a>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY HUB & CALENDAR
       ===================================================== -->

  <HomeEvents />



  <!-- =====================================================
       FIELD NOTES
       ===================================================== -->

  <section
    class="
      bg-white
      border-t
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-16
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          flex
          flex-col
          sm:flex-row
          sm:items-end
          justify-between
          gap-5
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Field Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
            "
          >
            Observations From The Field
          </h2>

        </div>


        <a
          href="/field-notes/"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            font-semibold
            text-brand-charcoal
            hover:text-brand-gold
            transition-colors
          "
        >
          All Field Notes
          <span>→</span>
        </a>

      </div>



      <!-- =================================================
           FEATURED NOTES

           MOBILE:
           exactly one full card at a time.
           hard snap to the next card.

           DESKTOP:
           existing 2-column layout.
           ================================================= -->

      <div
        class="
          home-field-notes-scroll
          md:grid
          md:grid-cols-2
          md:gap-5
        "
        aria-label="Featured field notes"
      >

        {
          featuredNotes.map(
            (post) => (

              <div
                class="
                  home-field-note-slide
                "
              >

                <ArticleCard
                  post={post}
                />

              </div>

            )
          )
        }

      </div>



      <!-- MOBILE SWIPE HINT -->

      {
        featuredNotes.length > 1 && (

          <p
            class="
              md:hidden
              mt-5
              text-[9px]
              uppercase
              tracking-[0.14em]
              text-brand-slate
              text-center
            "
          >
            Swipe for next note

            <span
              class="
                ml-1
              "
            >
              →
            </span>
          </p>

        )
      }

    </div>

  </section>



  <!-- =====================================================
       HOMEPAGE MOBILE INTERACTION STYLES
       ===================================================== -->

  <style>

    /* =====================================================
       THREE VALUES / PILLARS

       MOBILE:
       - natural swipe
       - deliberately no snap
       - next pillar remains partially visible
       - user controls exactly where the row stops

       DESKTOP:
       - standard 3-column grid
       ===================================================== */

    .home-pillars-scroll {
      display:
        flex;

      flex-wrap:
        nowrap;

      gap:
        18px;

      overflow-x:
        auto;

      overflow-y:
        visible;

      padding-bottom:
        8px;

      overscroll-behavior-inline:
        contain;

      scroll-behavior:
        smooth;

      -webkit-overflow-scrolling:
        touch;

      touch-action:
        pan-x pan-y;

      scrollbar-width:
        none;
    }


    .home-pillars-scroll::-webkit-scrollbar {
      display:
        none;
    }


    .home-pillar {
      flex:
        0 0 86%;

      min-width:
        0;
    }



    /* =====================================================
       FEATURED FIELD NOTES

       MOBILE:
       - 1 complete card per viewport
       - mandatory snap
       - scroll-snap-stop prevents a normal swipe from
         casually passing over multiple cards

       DESKTOP:
       - returns to the existing two-column grid
       ===================================================== */

    .home-field-notes-scroll {
      display:
        flex;

      flex-wrap:
        nowrap;

      gap:
        0;

      width:
        100%;

      overflow-x:
        auto;

      overflow-y:
        visible;

      overscroll-behavior-inline:
        contain;

      scroll-behavior:
        smooth;

      scroll-snap-type:
        x mandatory;

      -webkit-overflow-scrolling:
        touch;

      touch-action:
        pan-x pan-y;

      scrollbar-width:
        none;
    }


    .home-field-notes-scroll::-webkit-scrollbar {
      display:
        none;
    }


    .home-field-note-slide {
      width:
        100%;

      min-width:
        100%;

      flex:
        0 0 100%;

      scroll-snap-align:
        start;

      scroll-snap-stop:
        always;
    }



    /* =====================================================
       DESKTOP RESTORATION

       From md upward, the existing homepage layout is
       restored exactly:
       - 3 pillars
       - 2 featured Field Notes
       ===================================================== */

    @media (
      min-width: 768px
    ) {

      .home-pillars-scroll {
        display:
          grid;

        grid-template-columns:
          repeat(
            3,
            minmax(
              0,
              1fr
            )
          );

        gap:
          0;

        overflow:
          visible;

        padding-bottom:
          0;

        scroll-behavior:
          auto;

        touch-action:
          auto;
      }


      .home-pillar {
        flex:
          initial;

        min-width:
          0;
      }


      .home-field-notes-scroll {
        display:
          grid;

        grid-template-columns:
          repeat(
            2,
            minmax(
              0,
              1fr
            )
          );

        gap:
          1.25rem;

        overflow:
          visible;

        scroll-snap-type:
          none;

        scroll-behavior:
          auto;

        touch-action:
          auto;
      }


      .home-field-note-slide {
        width:
          auto;

        min-width:
          0;

        flex:
          initial;

        scroll-snap-align:
          none;

        scroll-snap-stop:
          normal;
      }

    }



    /* =====================================================
       REDUCED MOTION
       ===================================================== */

    @media (
      prefers-reduced-motion:
        reduce
    ) {

      .home-pillars-scroll,
      .home-field-notes-scroll {
        scroll-behavior:
          auto;
      }

    }

  </style>

</BaseLayout>
