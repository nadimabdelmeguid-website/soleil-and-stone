---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ArticleCard from "../components/ArticleCard.astro";
import HomeEvents from "../components/HomeEvents.astro";

import {
  site
} from "../data/site";


const now =
  new Date();


const fieldNotes =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    )
    .sort(
      (a, b) =>
        b.data.published.getTime() -
        a.data.published.getTime()
    );


const featuredNotes =
  fieldNotes
    .filter(
      (post) =>
        post.data.featured
    )
    .slice(
      0,
      3
    );
---

<BaseLayout
  title="SOLEIL & STONE | Hardware, Commercialization & Innovation Ecosystems"
  description="Field observations, communities and projects at the intersection of hardware, commercialization and innovation ecosystems."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      pt-20
      pb-20
    "
  >

    <div
      class="
        max-w-4xl
      "
    >

      <span
        class="
          inline-block
          text-[10px]
          uppercase
          tracking-[0.22em]
          text-brand-gold
          font-semibold
          mb-6
        "
      >
        {site.author.tagline}
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-6xl
          text-brand-charcoal
          leading-[1.12]
          font-normal
          tracking-wide
          mb-8
        "
      >
        Global Perspective.
        <br />

        Technical Mindset.
        <br />

        Local Impact.
      </h1>


      <p
        class="
          text-base
          sm:text-lg
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
        "
      >
        Raised in Cairo, trained as an Industrial Engineer
        in France, and shaped by the Bay Area technology
        ecosystem. Now based in San Diego, I work at the
        intersection of hardware, commercialization, and
        community—connecting engineers, founders,
        manufacturers, investors, and operators to help
        technical ideas move toward real-world adoption.
      </p>


      <div
        class="
          flex
          flex-wrap
          gap-x-7
          gap-y-3
          mt-8
        "
      >

        <a
          href="/community/"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            font-semibold
            text-brand-charcoal
            hover:text-brand-gold
            transition-colors
          "
        >
          Explore Community

          <span>
            →
          </span>
        </a>


        <a
          href="/about/"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            font-semibold
            text-brand-slate
            hover:text-brand-gold
            transition-colors
          "
        >
          More About Me

          <span>
            →
          </span>
        </a>

      </div>

    </div>

  </section>



  <!-- =====================================================
       EVENTS / FIELDWORK
       ===================================================== -->

  <HomeEvents />



  <!-- =====================================================
       FIELD NOTES
       ===================================================== -->

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-20
    "
  >

    <div
      class="
        flex
        flex-col
        sm:flex-row
        sm:items-end
        justify-between
        gap-5
        mb-10
      "
    >

      <div>

        <span
          class="
            text-[10px]
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Field Notes
        </span>


        <h2
          class="
            font-serif
            text-3xl
            sm:text-4xl
            text-brand-charcoal
            mt-2
          "
        >
          Observations From The Field
        </h2>

      </div>


      <a
        href="/field-notes/"
        class="
          inline-flex
          items-center
          gap-2
          text-[11px]
          uppercase
          tracking-[0.16em]
          font-semibold
          text-brand-charcoal
          hover:text-brand-gold
          transition-colors
        "
      >
        All Field Notes

        <span>
          →
        </span>
      </a>

    </div>


    <div
      class="
        grid
        md:grid-cols-2
        lg:grid-cols-3
        gap-6
      "
    >

      {
        featuredNotes.map(
          (post) => (
            <ArticleCard
              post={post}
            />
          )
        )
      }

    </div>

  </section>



  <!-- =====================================================
       CONTACT
       ===================================================== -->

  <section
    id="contact"
    class="
      bg-brand-cream
      border-t
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
      "
    >

      <div
        class="
          grid
          lg:grid-cols-12
          gap-12
        "
      >

        <div
          class="
            lg:col-span-5
          "
        >

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Connect
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
              mb-5
            "
          >
            Start A Conversation
          </h2>


          <p
            class="
              text-sm
              sm:text-base
              text-brand-slate
              leading-relaxed
              font-light
            "
          >
            Whether you're building a hardware product,
            working on an ecosystem initiative, interested
            in a community partnership, or simply want to
            exchange ideas, feel free to reach out.
          </p>

        </div>



        <div
          class="
            lg:col-span-7
          "
        >

          <form
            action="https://script.google.com/macros/s/AKfycbxKtCKaU1D2tbC-np9R-a_R4A-CMgJuaNnGH3TPyBCK4whhThTE6t7u35yWoym4eXZN/exec"
            method="POST"
            class="
              grid
              gap-5
            "
          >

            <div
              class="
                grid
                sm:grid-cols-2
                gap-5
              "
            >

              <div>

                <label
                  for="name"
                  class="
                    block
                    text-[10px]
                    uppercase
                    tracking-[0.15em]
                    text-brand-slate
                    mb-2
                  "
                >
                  Name
                </label>


                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  class="
                    w-full
                    border
                    border-brand-border
                    bg-white
                    px-4
                    py-3
                    text-sm
                    text-brand-charcoal
                    outline-none
                    focus:border-brand-gold
                  "
                />

              </div>


              <div>

                <label
                  for="email"
                  class="
                    block
                    text-[10px]
                    uppercase
                    tracking-[0.15em]
                    text-brand-slate
                    mb-2
                  "
                >
                  Email
                </label>


                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="
                    w-full
                    border
                    border-brand-border
                    bg-white
                    px-4
                    py-3
                    text-sm
                    text-brand-charcoal
                    outline-none
                    focus:border-brand-gold
                  "
                />

              </div>

            </div>


            <div>

              <label
                for="type"
                class="
                  block
                  text-[10px]
                  uppercase
                  tracking-[0.15em]
                  text-brand-slate
                  mb-2
                "
              >
                Inquiry
              </label>


              <select
                id="type"
                name="type"
                class="
                  w-full
                  border
                  border-brand-border
                  bg-white
                  px-4
                  py-3
                  text-sm
                  text-brand-charcoal
                  outline-none
                  focus:border-brand-gold
                "
              >

                <option value="hello">
                  General / Hello
                </option>

                <option value="community">
                  Community
                </option>

                <option value="partnership">
                  Partnership
                </option>

                <option value="speaking">
                  Speaking
                </option>

                <option value="other">
                  Other
                </option>

              </select>

            </div>


            <div>

              <label
                for="message"
                class="
                  block
                  text-[10px]
                  uppercase
                  tracking-[0.15em]
                  text-brand-slate
                  mb-2
                "
              >
                Message
              </label>


              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="
                  w-full
                  border
                  border-brand-border
                  bg-white
                  px-4
                  py-3
                  text-sm
                  text-brand-charcoal
                  outline-none
                  focus:border-brand-gold
                  resize-y
                "
              ></textarea>

            </div>


            <div>

              <button
                type="submit"
                class="
                  inline-flex
                  items-center
                  gap-2
                  px-6
                  py-3
                  bg-brand-charcoal
                  text-white
                  text-[11px]
                  uppercase
                  tracking-[0.18em]
                  font-semibold
                  hover:bg-brand-gold
                  transition-colors
                "
              >
                Send Message

                <span>
                  →
                </span>
              </button>

            </div>

          </form>

        </div>

      </div>

    </div>

  </section>


  <script is:inline>
    (() => {

      const params =
        new URLSearchParams(
          window.location.search
        );


      const type =
        params.get(
          "type"
        );


      const select =
        document.getElementById(
          "type"
        );


      if (
        type &&
        select
      ) {

        const option =
          Array.from(
            select.options
          ).find(
            (item) =>
              item.value === type
          );


        if (
          option
        ) {
          select.value =
            type;
        }

      }

    })();
  </script>

</BaseLayout>
