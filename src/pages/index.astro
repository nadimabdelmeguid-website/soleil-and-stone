---
import {
  getCollection
} from "astro:content";

import BaseLayout
  from "../layouts/BaseLayout.astro";

import ArticleCard
  from "../components/ArticleCard.astro";


const now =
  new Date();


const featuredPosts =
  (
    await getCollection(
      "fieldNotes"
    )
  )

  .filter(
    post =>
      !post.data.draft &&
      post.data.featured &&
      post.data.published <= now
  )

  .sort(
    (a, b) =>
      b.data.published.getTime() -
      a.data.published.getTime()
  )

  .slice(
    0,
    2
  );
---

<BaseLayout
  title="SOLEIL & STONE"
  description="Entrepreneurship, hardware, ecosystem building and community across the West Coast innovation ecosystem."
>

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
      border-b
      border-brand-border
    "
  >

    <div
      class="
        flex
        flex-col
        md:flex-row
        items-center
        gap-10
        md:gap-14
      "
    >

      <div
        class="
          w-48
          sm:w-56
          md:w-64
          flex-shrink-0
        "
      >

        <div
          class="
            p-1
            bg-brand-card
            border
            border-brand-border
            shadow-sm
          "
        >

          <img
            src="/profile.png"
            alt="Nadim Abdel Meguid"
            class="
              w-full
              grayscale
            "
          />

        </div>

      </div>


      <div class="flex-1">

        <span
          class="
            inline-block
            px-3
            py-1
            bg-brand-gold/10
            border
            border-brand-gold/30
            text-brand-gold
            text-[10px]
            uppercase
            tracking-[0.2em]
            font-semibold
            mb-6
          "
        >
          Ecosystem Building & Community Initiatives
        </span>


        <h1
          class="
            font-serif
            text-3xl
            sm:text-4xl
            lg:text-5xl
            leading-[1.2]
            mb-6
          "
        >
          Global Perspective.
          Technical Mindset.
          Local Impact.
        </h1>


        <p
          class="
            text-base
            text-brand-slate
            leading-relaxed
            font-light
            mb-6
          "
        >
          Raised in Cairo,
          trained as an Industrial Engineer
          in France, and shaped by San Francisco's
          tech ecosystem. Now based in San Diego,
          I'm building founder networks,
          hardware communities, and spaces where
          ideas and people can connect.
        </p>


        <a
          href="/community/"
          class="
            px-5
            py-2.5
            bg-brand-charcoal
            text-white
            text-xs
            uppercase
            tracking-widest
            inline-block
          "
        >
          Explore the Community →
        </a>

      </div>

    </div>

  </section>


  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-20
      border-b
      border-brand-border
    "
  >

    <div
      class="
        flex
        justify-between
        items-end
        mb-10
      "
    >

      <div>

        <span
          class="
            text-xs
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Perspectives
        </span>


        <h2
          class="
            font-serif
            text-3xl
            mt-1
          "
        >
          Featured Field Notes
        </h2>

      </div>


      <a
        href="/field-notes/"
        class="
          text-xs
          uppercase
          tracking-widest
          text-brand-gold
        "
      >
        View All Field Notes →
      </a>

    </div>


    <div
      class="
        grid
        md:grid-cols-2
        gap-8
      "
    >

      {
        featuredPosts.map(
          post => (

            <ArticleCard
              post={post}
            />

          )
        )
      }

    </div>

  </section>


  <section
    id="contact"
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-20
    "
  >

    <div
      class="
        max-w-2xl
      "
    >

      <span
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Direct Engagement
      </span>


      <h2
        class="
          font-serif
          text-3xl
          mt-1
          mb-4
        "
      >
        Connect or Get in Touch
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          font-light
          mb-8
        "
      >
        Reach out to connect around startups,
        hardware, community events,
        speaking opportunities,
        partnerships, or ideas worth exploring.
      </p>


      <!-- Keep your current contact form here -->

    </div>

  </section>

</BaseLayout>
