---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import HomeEvents from "../components/HomeEvents.astro";


const now = new Date();


const featuredPosts =
  (
    await getCollection("fieldNotes")
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.featured &&
        post.data.published <= now
    )
    .sort(
      (a, b) =>
        b.data.published.getTime() -
        a.data.published.getTime()
    )
    .slice(0, 2);
---

<BaseLayout
  title="SOLEIL & STONE"
  description="Entrepreneurship, hardware, ecosystem building and community across the West Coast innovation ecosystem."
>

  <!-- =========================================================
       1. HERO
       ========================================================= -->

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
      border-b
      border-brand-border
    "
  >

    <div
      class="
        flex
        flex-col
        md:flex-row
        items-center
        gap-10
        md:gap-14
      "
    >

      <!-- Portrait -->

      <div
        class="
          w-48
          sm:w-56
          md:w-64
          flex-shrink-0
        "
      >

        <div
          class="
            p-1
            bg-brand-card
            border
            border-brand-border
            shadow-sm
          "
        >

          <img
            src="/profile.png"
            alt="Nadim Abdel Meguid"
            class="
              w-full
              h-auto
              grayscale
              hover:grayscale-0
              transition-all
              duration-500
              object-cover
            "
          />

        </div>

      </div>


      <!-- Hero copy -->

      <div class="flex-1">

        <span
          class="
            inline-block
            px-3
            py-1
            bg-brand-gold/10
            border
            border-brand-gold/30
            text-brand-gold
            text-[10px]
            uppercase
            tracking-[0.2em]
            font-semibold
            mb-6
          "
        >
          Ecosystem Building & Community Initiatives
        </span>


        <h1
          class="
            font-serif
            text-3xl
            sm:text-4xl
            lg:text-5xl
            font-normal
            tracking-wide
            text-brand-charcoal
            leading-[1.2]
            mb-6
          "
        >
          Global Perspective.
          Technical Mindset.
          Local Impact.
        </h1>


        <p
          class="
            text-base
            text-brand-slate
            leading-relaxed
            font-light
            mb-6
            max-w-3xl
          "
        >
          Raised in Cairo, trained as an Industrial Engineer in France,
          and shaped by San Francisco's tech ecosystem.
          Now based in San Diego, I'm building founder networks,
          hardware communities, and spaces where ideas and people can connect.
        </p>


        <a
          href="/community/"
          class="
            px-5
            py-2.5
            bg-brand-charcoal
            text-white
            text-xs
            uppercase
            tracking-widest
            hover:bg-brand-gold
            transition-colors
            inline-flex
            items-center
            gap-2
          "
        >
          <span>Explore the Community</span>
          <span>→</span>
        </a>

      </div>

    </div>

  </section>



  <!-- =========================================================
       2. COMMUNITY HUB + CALENDAR
       Powered by src/data/events.ts
       ========================================================= -->

  <HomeEvents />



  <!-- =========================================================
       3. FEATURED FIELD NOTES
       Powered automatically by Markdown content collection
       ========================================================= -->

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-20
      border-b
      border-brand-border
    "
  >

    <div
      class="
        flex
        flex-col
        sm:flex-row
        sm:items-end
        justify-between
        mb-10
        gap-4
      "
    >

      <div>

        <span
          class="
            text-xs
            uppercase
            tracking-[0.2em]
            text-brand-gold
            font-semibold
          "
        >
          Perspectives
        </span>


        <h2
          class="
            font-serif
            text-3xl
            font-normal
            text-brand-charcoal
            mt-1
          "
        >
          Featured Field Notes
        </h2>

      </div>


      <a
        href="/field-notes/"
        class="
          text-xs
          uppercase
          tracking-widest
          font-medium
          text-brand-gold
          hover:underline
          whitespace-nowrap
        "
      >
        View All Field Notes →
      </a>

    </div>


    {
      featuredPosts.length > 0 ? (

        <div
          class="
            grid
            md:grid-cols-2
            gap-8
          "
        >

          {
            featuredPosts.map(
              (post) => (
                <ArticleCard post={post} />
              )
            )
          }

        </div>

      ) : (

        <div
          class="
            p-8
            bg-brand-card
            border
            border-brand-border
            text-brand-slate
            text-sm
            font-light
          "
        >
          New Field Notes are coming soon.
        </div>

      )
    }

  </section>



  <!-- =========================================================
       4. CONTACT
       ========================================================= -->

  <section
    id="contact"
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-20
    "
  >

    <div class="max-w-2xl">

      <span
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Direct Engagement
      </span>


      <h2
        class="
          font-serif
          text-3xl
          font-normal
          text-brand-charcoal
          mt-1
          mb-4
        "
      >
        Connect or Get in Touch
      </h2>


      <p
        class="
          text-brand-slate
          text-sm
          font-light
          mb-8
          leading-relaxed
        "
      >
        Reach out to connect around startups, hardware,
        community events, speaking opportunities,
        partnerships, or ideas worth exploring.
      </p>


      <form
        id="contact-form"
        action="https://script.google.com/macros/s/AKfycbxKtCKaU1D2tbC-np9R-a_R4A-CMgJuaNnGH3TPyBCK4whhThTE6t7u35yWoym4eXZN/exec"
        method="POST"
        class="space-y-5"
      >

        <!-- Name -->

        <div>

          <label
            for="contact-name"
            class="
              block
              text-xs
              uppercase
              tracking-wider
              text-brand-slate
              mb-2
            "
          >
            Your Name
          </label>


          <input
            id="contact-name"
            type="text"
            name="name"
            required
            autocomplete="name"
            class="
              w-full
              px-4
              py-3
              bg-brand-card
              border
              border-brand-border
              text-sm
              text-brand-charcoal
              focus:outline-none
              focus:border-brand-gold
              transition-colors
            "
          />

        </div>


        <!-- Email -->

        <div>

          <label
            for="contact-email"
            class="
              block
              text-xs
              uppercase
              tracking-wider
              text-brand-slate
              mb-2
            "
          >
            Email Address
          </label>


          <input
            id="contact-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            class="
              w-full
              px-4
              py-3
              bg-brand-card
              border
              border-brand-border
              text-sm
              text-brand-charcoal
              focus:outline-none
              focus:border-brand-gold
              transition-colors
            "
          />

        </div>


        <!-- Inquiry type -->

        <div>

          <label
            for="contact-type"
            class="
              block
              text-xs
              uppercase
              tracking-wider
              text-brand-slate
              mb-2
            "
          >
            Inquiry Type
          </label>


          <select
            id="contact-type"
            name="type"
            class="
              w-full
              px-4
              py-3
              bg-brand-card
              border
              border-brand-border
              text-sm
              text-brand-charcoal
              focus:outline-none
              focus:border-brand-gold
              transition-colors
            "
          >

            <option value="hello">
              Say Hello
            </option>

            <option value="community">
              Community / Event
            </option>

            <option value="speaking">
              Speaking
            </option>

            <option value="partnership">
              Partnership
            </option>

            <option value="other">
              Other
            </option>

          </select>

        </div>


        <!-- Message -->

        <div>

          <label
            for="contact-message"
            class="
              block
              text-xs
              uppercase
              tracking-wider
              text-brand-slate
              mb-2
            "
          >
            Message
          </label>


          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="
              w-full
              px-4
              py-3
              bg-brand-card
              border
              border-brand-border
              text-sm
              text-brand-charcoal
              focus:outline-none
              focus:border-brand-gold
              transition-colors
              resize-y
            "
          ></textarea>

        </div>


        <!-- Submit -->

        <div>

          <button
            type="submit"
            id="submit-btn"
            class="
              px-6
              py-3
              bg-brand-charcoal
              text-white
              text-xs
              uppercase
              tracking-[0.2em]
              hover:bg-brand-gold
              transition-colors
              disabled:opacity-50
              disabled:cursor-not-allowed
            "
          >
            Send Message
          </button>


          <p
            id="form-status"
            class="
              text-xs
              mt-4
              hidden
              font-medium
            "
          ></p>

        </div>

      </form>

    </div>

  </section>



  <!-- =========================================================
       CONTACT FORM JAVASCRIPT
       ========================================================= -->

  <script is:inline>

    const contactForm =
      document.getElementById("contact-form");


    if (contactForm) {

      /*
       * Allows links such as:
       * /?type=partnership#contact
       *
       * to automatically select Partnership.
       */

      const params =
        new URLSearchParams(
          window.location.search
        );


      const requestedType =
        params.get("type");


      const inquirySelect =
        document.getElementById(
          "contact-type"
        );


      if (
        requestedType &&
        inquirySelect
      ) {

        const optionExists =
          Array.from(
            inquirySelect.options
          ).some(
            (option) =>
              option.value === requestedType
          );


        if (optionExists) {

          inquirySelect.value =
            requestedType;

        }

      }



      contactForm.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();


          const submitButton =
            document.getElementById(
              "submit-btn"
            );


          const statusElement =
            document.getElementById(
              "form-status"
            );


          submitButton.disabled =
            true;


          submitButton.textContent =
            "Sending...";


          statusElement.classList.add(
            "hidden"
          );


          try {

            const response =
              await fetch(
                contactForm.action,
                {
                  method: "POST",

                  body:
                    new FormData(
                      contactForm
                    )
                }
              );


            const result =
              await response.json();


            if (
              result.result !==
              "success"
            ) {

              throw new Error(
                result.error ||
                "Submission failed"
              );

            }


            statusElement.textContent =
              "Thank you! Your message has been sent successfully.";


            statusElement.className =
              "text-xs mt-4 font-medium text-green-600";


            contactForm.reset();

          }

          catch (error) {

            console.error(
              "Contact form error:",
              error
            );


            statusElement.textContent =
              "Something went wrong. Please try again or email directly.";


            statusElement.className =
              "text-xs mt-4 font-medium text-red-600";

          }

          finally {

            submitButton.disabled =
              false;


            submitButton.textContent =
              "Send Message";


            statusElement.classList.remove(
              "hidden"
            );

          }

        }
      );

    }

  </script>

</BaseLayout>
