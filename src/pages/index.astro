---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ArticleCard from "../components/ArticleCard.astro";
import HomeEvents from "../components/HomeEvents.astro";

import {
  site
} from "../data/site";


/* =========================================================
   FIELD NOTES
   ========================================================= */

const now =
  new Date();


const fieldNotes =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    )
    .sort(
      (a, b) =>
        b.data.published.getTime() -
        a.data.published.getTime()
    );


/*
 * Homepage:
 * show the two newest published notes
 * that are marked as featured.
 */

const featuredNotes =
  fieldNotes
    .filter(
      (post) =>
        post.data.featured
    )
    .slice(
      0,
      2
    );
---

<BaseLayout
  title="SOLEIL & STONE | Hardware, Commercialization & Innovation Ecosystems"
  description="Field observations, communities and projects at the intersection of hardware commercialization, industry fieldwork and innovation ecosystems."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-20
        pb-16
      "
    >

      <!-- =================================================
           HERO INTRO
           ================================================= -->

      <div
        class="
          max-w-4xl
          mx-auto
          text-center
        "
      >

        <span
          class="
            inline-block
            text-[10px]
            uppercase
            tracking-[0.22em]
            text-brand-gold
            font-semibold
            mb-6
          "
        >
          {site.author.tagline}
        </span>


        <h1
          class="
            font-serif
            text-4xl
            sm:text-5xl
            lg:text-6xl
            text-brand-charcoal
            leading-[1.12]
            font-normal
            tracking-wide
            mb-7
          "
        >
          Global Perspective.
          <br />

          Technical Mindset.
          <br />

          Local Impact.
        </h1>


        <p
          class="
            text-base
            sm:text-lg
            text-brand-slate
            leading-relaxed
            font-light
            max-w-3xl
            mx-auto
          "
        >
          I work at the intersection of hardware commercialization
          and innovation ecosystems, connecting technical product
          development, manufacturing resources, market intelligence,
          and regional networks to help technologies move toward
          real-world adoption.
        </p>

      </div>



      <!-- =================================================
           THREE PILLARS
           ================================================= -->

      <div
        class="
          max-w-5xl
          mx-auto
          mt-14
          pt-10
          border-t
          border-brand-border
        "
      >

        <div
          class="
            grid
            md:grid-cols-3
            gap-8
            md:gap-0
          "
        >

          <!-- HARDWARE COMMERCIALIZATION -->

          <div
            class="
              md:pr-8
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                01
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Hardware Commercialization
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                Connecting engineering decisions, product
                development, manufacturing resources and market
                needs to help technical products move toward
                adoption.
              </p>

            </div>

          </div>



          <!-- INDUSTRY FIELDWORK -->

          <div
            class="
              md:px-8
              md:border-l
              md:border-brand-border
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                02
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Industry Fieldwork
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                Learning directly from trade shows, manufacturers,
                founders and technical teams to understand how
                technologies, markets and industries are evolving.
              </p>

            </div>

          </div>



          <!-- INNOVATION ECOSYSTEMS -->

          <div
            class="
              md:pl-8
              md:border-l
              md:border-brand-border
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                03
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Innovation Ecosystems
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                Building connections among engineers, founders,
                manufacturers, investors and operators to strengthen
                regional innovation networks.
              </p>

            </div>

          </div>

        </div>



        <!-- =================================================
             HERO CTAS
             ================================================= -->

        <div
          class="
            flex
            flex-wrap
            justify-center
            gap-x-7
            gap-y-3
            mt-10
          "
        >

          <a
            href="/community/"
            class="
              inline-flex
              items-center
              gap-2
              text-[11px]
              uppercase
              tracking-[0.16em]
              font-semibold
              text-brand-charcoal
              hover:text-brand-gold
              transition-colors
            "
          >
            Explore Community
            <span>→</span>
          </a>


          <a
            href="/about/"
            class="
              inline-flex
              items-center
              gap-2
              text-[11px]
              uppercase
              tracking-[0.16em]
              font-semibold
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            More About Me
            <span>→</span>
          </a>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY HUB & CALENDAR
       ===================================================== -->

  <HomeEvents />



  <!-- =====================================================
       FIELD NOTES
       ===================================================== -->

  <section
    class="
      bg-white
      border-t
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-16
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          flex
          flex-col
          sm:flex-row
          sm:items-end
          justify-between
          gap-5
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Field Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
            "
          >
            Observations From The Field
          </h2>

        </div>


        <a
          href="/field-notes/"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            font-semibold
            text-brand-charcoal
            hover:text-brand-gold
            transition-colors
          "
        >
          All Field Notes
          <span>→</span>
        </a>

      </div>



      <!-- FEATURED NOTES -->

      <div
        class="
          grid
          md:grid-cols-2
          gap-5
        "
      >

        {
          featuredNotes.map(
            (post) => (

              <ArticleCard
                post={post}
              />

            )
          )
        }

      </div>

    </div>

  </section>



  <!-- =====================================================
       CONTACT
       ===================================================== -->

  <section
    id="contact"
    class="
      bg-brand-cream
      border-t
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-20
      "
    >

      <div
        class="
          grid
          lg:grid-cols-12
          gap-12
        "
      >

        <!-- CONTACT INTRO -->

        <div
          class="
            lg:col-span-5
          "
        >

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Connect
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
              mb-5
            "
          >
            Start A Conversation
          </h2>


          <p
            class="
              text-sm
              sm:text-base
              text-brand-slate
              leading-relaxed
              font-light
            "
          >
            Whether you're building a hardware product,
            working on an ecosystem initiative, interested
            in a community partnership, or simply want to
            exchange ideas, feel free to reach out.
          </p>

        </div>



        <!-- =================================================
             CONTACT FORM
             ================================================= -->

        <div
          class="
            lg:col-span-7
          "
        >

          <form
            id="contact-form"
            action="https://script.google.com/macros/s/AKfycbxKtCKaU1D2tbC-np9R-a_R4A-CMgJuaNnGH3TPyBCK4whhThTE6t7u35yWoym4eXZN/exec"
            method="POST"
            class="
              grid
              gap-5
            "
          >

            <!-- NAME + EMAIL -->

            <div
              class="
                grid
                sm:grid-cols-2
                gap-5
              "
            >

              <!-- NAME -->

              <div>

                <label
                  for="name"
                  class="
                    block
                    text-[10px]
                    uppercase
                    tracking-[0.15em]
                    text-brand-slate
                    mb-2
                  "
                >
                  Name
                </label>


                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  class="
                    w-full
                    border
                    border-brand-border
                    bg-white
                    px-4
                    py-3
                    text-sm
                    text-brand-charcoal
                    outline-none
                    focus:border-brand-gold
                  "
                />

              </div>



              <!-- EMAIL -->

              <div>

                <label
                  for="email"
                  class="
                    block
                    text-[10px]
                    uppercase
                    tracking-[0.15em]
                    text-brand-slate
                    mb-2
                  "
                >
                  Email
                </label>


                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  class="
                    w-full
                    border
                    border-brand-border
                    bg-white
                    px-4
                    py-3
                    text-sm
                    text-brand-charcoal
                    outline-none
                    focus:border-brand-gold
                  "
                />

              </div>

            </div>



            <!-- INQUIRY TYPE -->

            <div>

              <label
                for="type"
                class="
                  block
                  text-[10px]
                  uppercase
                  tracking-[0.15em]
                  text-brand-slate
                  mb-2
                "
              >
                Inquiry
              </label>


              <select
                id="type"
                name="type"
                class="
                  w-full
                  border
                  border-brand-border
                  bg-white
                  px-4
                  py-3
                  text-sm
                  text-brand-charcoal
                  outline-none
                  focus:border-brand-gold
                "
              >

                <option
                  value="hello"
                >
                  General / Hello
                </option>


                <option
                  value="community"
                >
                  Community
                </option>


                <option
                  value="partnership"
                >
                  Partnership
                </option>


                <option
                  value="speaking"
                >
                  Speaking
                </option>


                <option
                  value="other"
                >
                  Other
                </option>

              </select>

            </div>



            <!-- MESSAGE -->

            <div>

              <label
                for="message"
                class="
                  block
                  text-[10px]
                  uppercase
                  tracking-[0.15em]
                  text-brand-slate
                  mb-2
                "
              >
                Message
              </label>


              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="
                  w-full
                  border
                  border-brand-border
                  bg-white
                  px-4
                  py-3
                  text-sm
                  text-brand-charcoal
                  outline-none
                  focus:border-brand-gold
                  resize-y
                "
              ></textarea>

            </div>



            <!-- SUBMIT + STATUS -->

            <div
              class="
                flex
                flex-col
                sm:flex-row
                sm:items-center
                gap-4
              "
            >

              <button
                id="contact-submit"
                type="submit"
                class="
                  inline-flex
                  w-fit
                  items-center
                  justify-center
                  gap-2
                  px-6
                  py-3
                  bg-brand-charcoal
                  text-white
                  text-[11px]
                  uppercase
                  tracking-[0.18em]
                  font-semibold
                  hover:bg-brand-gold
                  disabled:opacity-50
                  disabled:cursor-not-allowed
                  transition-colors
                "
              >

                <span
                  id="contact-submit-label"
                >
                  Send Message
                </span>

                <span>
                  →
                </span>

              </button>


              <p
                id="contact-status"
                aria-live="polite"
                class="
                  hidden
                  text-xs
                  leading-relaxed
                "
              ></p>

            </div>

          </form>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       CONTACT FORM BEHAVIOR

       1. Preselect inquiry type from URL
       2. Submit to Google Sheets in the background
       3. Keep visitor on Soleil & Stone

       Examples:
       /?type=community#contact
       /?type=partnership#contact
       ===================================================== -->

  <script is:inline>
    (() => {

      /* ===================================================
         ELEMENTS
         =================================================== */

      const form =
        document.getElementById(
          "contact-form"
        );


      const select =
        document.getElementById(
          "type"
        );


      const submitButton =
        document.getElementById(
          "contact-submit"
        );


      const submitLabel =
        document.getElementById(
          "contact-submit-label"
        );


      const status =
        document.getElementById(
          "contact-status"
        );



      /* ===================================================
         URL INQUIRY PRESELECTION
         =================================================== */

      const params =
        new URLSearchParams(
          window.location.search
        );


      const requestedType =
        params.get(
          "type"
        );


      if (
        requestedType &&
        select
      ) {

        const option =
          Array.from(
            select.options
          ).find(
            (item) =>
              item.value ===
              requestedType
          );


        if (
          option
        ) {

          select.value =
            requestedType;

        }

      }



      /* ===================================================
         SUBMISSION
         =================================================== */

      if (
        !form
      ) {

        return;

      }


      form.addEventListener(
        "submit",
        async (
          event
        ) => {

          /*
           * Prevent the browser from navigating to the
           * Google Apps Script JSON response.
           */

          event.preventDefault();



          /* -----------------------------------------------
             LOADING STATE
             ----------------------------------------------- */

          if (
            submitButton
          ) {

            submitButton.disabled =
              true;

          }


          if (
            submitLabel
          ) {

            submitLabel.textContent =
              "Sending...";

          }


          if (
            status
          ) {

            status.textContent =
              "";


            status.classList.add(
              "hidden"
            );


            status.classList.remove(
              "text-brand-gold",
              "text-red-600"
            );

          }



          try {

            /* ---------------------------------------------
               BUILD FORM DATA
               --------------------------------------------- */

            const formData =
              new FormData(
                form
              );



            /* ---------------------------------------------
               SEND TO GOOGLE APPS SCRIPT

               Google Apps Script Web Apps often do not
               expose their cross-origin response to the
               browser.

               `no-cors` lets the POST complete without
               redirecting the visitor away from the site.
               --------------------------------------------- */

            await fetch(
              form.action,
              {
                method:
                  "POST",

                body:
                  formData,

                mode:
                  "no-cors"
              }
            );



            /* ---------------------------------------------
               SUCCESS
               --------------------------------------------- */

            form.reset();



            /*
             * If the visitor arrived from one of the
             * preselected CTA links, preserve the selected
             * inquiry after resetting the form.
             */

            if (
              requestedType &&
              select
            ) {

              const option =
                Array.from(
                  select.options
                ).find(
                  (item) =>
                    item.value ===
                    requestedType
                );


              if (
                option
              ) {

                select.value =
                  requestedType;

              }

            }



            if (
              status
            ) {

              status.textContent =
                "Message sent. Thank you — I'll be in touch.";


              status.classList.remove(
                "hidden"
              );


              status.classList.add(
                "text-brand-gold"
              );

            }



            if (
              submitLabel
            ) {

              submitLabel.textContent =
                "Message Sent";

            }



            /*
             * Restore the normal button label after
             * three seconds while leaving the success
             * confirmation visible.
             */

            window.setTimeout(
              () => {

                if (
                  submitLabel
                ) {

                  submitLabel.textContent =
                    "Send Message";

                }

              },
              3000
            );

          } catch (
            error
          ) {

            /* ---------------------------------------------
               ERROR
               --------------------------------------------- */

            console.error(
              "Contact form submission failed:",
              error
            );


            if (
              status
            ) {

              status.textContent =
                "Something went wrong. Please try again.";


              status.classList.remove(
                "hidden"
              );


              status.classList.add(
                "text-red-600"
              );

            }


            if (
              submitLabel
            ) {

              submitLabel.textContent =
                "Send Message";

            }

          } finally {

            /* ---------------------------------------------
               RE-ENABLE BUTTON
               --------------------------------------------- */

            if (
              submitButton
            ) {

              submitButton.disabled =
                false;

            }

          }

        }
      );

    })();
  </script>

</BaseLayout>
