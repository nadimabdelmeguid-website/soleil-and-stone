---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ArticleCard from "../components/ArticleCard.astro";
import HomeEvents from "../components/HomeEvents.astro";

import {
  site
} from "../data/site";


/* =========================================================
   FIELD NOTES
   ========================================================= */

const now =
  new Date();


const fieldNotes =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    )
    .sort(
      (a, b) =>
        b.data.published.getTime() -
        a.data.published.getTime()
    );


/*
 * Homepage:
 * show the two newest published notes
 * that are marked as featured.
 */

const featuredNotes =
  fieldNotes
    .filter(
      (post) =>
        post.data.featured
    )
    .slice(
      0,
      2
    );
---

<BaseLayout
  title="SOLEIL & STONE | Hardware, Commercialization & Innovation Ecosystems"
  description="Field observations, communities and projects at the intersection of hardware commercialization, industry fieldwork and innovation ecosystems."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-20
        pb-16
      "
    >

      <!-- =================================================
           HERO INTRO
           ================================================= -->

      <div
        class="
          max-w-4xl
          mx-auto
          text-center
        "
      >

        <span
          class="
            inline-block
            text-[10px]
            uppercase
            tracking-[0.22em]
            text-brand-gold
            font-semibold
            mb-6
          "
        >
          {site.author.tagline}
        </span>


        <h1
          class="
            font-serif
            text-4xl
            sm:text-5xl
            lg:text-6xl
            text-brand-charcoal
            leading-[1.12]
            font-normal
            tracking-wide
            mb-7
          "
        >
          Global Perspective.
          <br />

          Technical Mindset.
          <br />

          Local Impact.
        </h1>


        <p
          class="
            text-base
            sm:text-lg
            text-brand-slate
            leading-relaxed
            font-light
            max-w-3xl
            mx-auto
          "
        >
          I work at the intersection of hardware commercialization
          and innovation ecosystems, connecting technical product
          development, manufacturing resources, market intelligence,
          and regional networks to help technologies move toward
          real-world adoption.
        </p>

      </div>



      <!-- =================================================
           THREE PILLARS
           ================================================= -->

      <div
        class="
          max-w-5xl
          mx-auto
          mt-14
          pt-10
          border-t
          border-brand-border
        "
      >

        <div
          class="
            grid
            md:grid-cols-3
            gap-8
            md:gap-0
          "
        >

          <!-- HARDWARE COMMERCIALIZATION -->

          <div
            class="
              md:pr-8
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                01
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Hardware Commercialization
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                Connecting engineering decisions, product
                development, manufacturing resources and market
                needs to help technical products move toward
                adoption.
              </p>

            </div>

          </div>



          <!-- INDUSTRY FIELDWORK -->

          <div
            class="
              md:px-8
              md:border-l
              md:border-brand-border
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                02
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Industry Fieldwork
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                Learning directly from trade shows, manufacturers,
                founders and technical teams to understand how
                technologies, markets and industries are evolving.
              </p>

            </div>

          </div>



          <!-- INNOVATION ECOSYSTEMS -->

          <div
            class="
              md:pl-8
              md:border-l
              md:border-brand-border
            "
          >

            <div
              class="
                border-t
                border-brand-gold
                pt-5
              "
            >

              <span
                class="
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-brand-gold
                  font-semibold
                "
              >
                03
              </span>


              <h2
                class="
                  font-serif
                  text-xl
                  text-brand-charcoal
                  mt-2
                  mb-3
                "
              >
                Innovation Ecosystems
              </h2>


              <p
                class="
                  text-sm
                  text-brand-slate
                  leading-relaxed
                  font-light
                "
              >
                Building connections among engineers, founders,
                manufacturers, investors and operators to strengthen
                regional innovation networks.
              </p>

            </div>

          </div>

        </div>



        <!-- =================================================
             HERO CTAS
             ================================================= -->

        <div
          class="
            flex
            flex-wrap
            justify-center
            gap-x-7
            gap-y-3
            mt-10
          "
        >

          <a
            href="/community/"
            class="
              inline-flex
              items-center
              gap-2
              text-[11px]
              uppercase
              tracking-[0.16em]
              font-semibold
              text-brand-charcoal
              hover:text-brand-gold
              transition-colors
            "
          >
            Explore Community
            <span>→</span>
          </a>


          <a
            href="/about/"
            class="
              inline-flex
              items-center
              gap-2
              text-[11px]
              uppercase
              tracking-[0.16em]
              font-semibold
              text-brand-slate
              hover:text-brand-gold
              transition-colors
            "
          >
            More About Me
            <span>→</span>
          </a>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       COMMUNITY HUB & CALENDAR
       ===================================================== -->

  <HomeEvents />



  <!-- =====================================================
       FIELD NOTES
       ===================================================== -->

  <section
    class="
      bg-white
      border-t
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-16
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          flex
          flex-col
          sm:flex-row
          sm:items-end
          justify-between
          gap-5
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[10px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Field Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
            "
          >
            Observations From The Field
          </h2>

        </div>


        <a
          href="/field-notes/"
          class="
            inline-flex
            items-center
            gap-2
            text-[11px]
            uppercase
            tracking-[0.16em]
            font-semibold
            text-brand-charcoal
            hover:text-brand-gold
            transition-colors
          "
        >
          All Field Notes
          <span>→</span>
        </a>

      </div>



      <!-- FEATURED NOTES -->

      <div
        class="
          grid
          md:grid-cols-2
          gap-5
        "
      >

        {
          featuredNotes.map(
            (post) => (

              <ArticleCard
                post={post}
              />

            )
          )
        }

      </div>

    </div>

  </section>

</BaseLayout>
