---
import {
  getCollection,
  render
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import FieldNoteLayout from "../../layouts/FieldNoteLayout.astro";


export async function getStaticPaths() {

  const now =
    new Date();


  const posts =
    (
      await getCollection(
        "fieldNotes"
      )
    )
      .filter(
        (post) =>
          !post.data.draft &&
          post.data.published <= now
      )
      .sort(
        (a, b) =>
          b.data.published.getTime() -
          a.data.published.getTime()
      );


  return posts.map(
    (post) => {

      const otherPosts =
        posts.filter(
          (candidate) =>
            candidate.id !== post.id
        );


      const sameCategory =
        otherPosts.filter(
          (candidate) =>
            candidate.data.categorySlug ===
            post.data.categorySlug
        );


      const recommendedPost =
        sameCategory[0] ??
        otherPosts[0] ??
        null;


      return {

        params: {
          slug: post.id
        },

        props: {
          post,
          recommendedPost
        }

      };

    }
  );

}


const {
  post,
  recommendedPost
} = Astro.props;


const {
  Content
} = await render(post);


/* =====================================================
   SEO
   ===================================================== */

const siteOrigin =
  Astro.site?.origin ??
  "https://soleilandstone.co";


const seoTitle =
  `${post.data.title} | Soleil & Stone`;


const publishedTime =
  post.data.published.toISOString();


const canonicalURL =
  `/field-notes/${post.id}/`;


const articleURL =
  new URL(
    canonicalURL,
    siteOrigin
  ).href;


const socialImage =
  new URL(
    "/brand/social-default.png",
    siteOrigin
  ).href;


const publisherLogo =
  new URL(
    "/brand/logo-primary.png",
    siteOrigin
  ).href;


/* =====================================================
   STRUCTURED DATA
   ===================================================== */

const articleSchema = {

  "@context":
    "https://schema.org",

  "@type":
    "Article",

  headline:
    post.data.title,

  description:
    post.data.description,

  datePublished:
    publishedTime,

  mainEntityOfPage: {
    "@type":
      "WebPage",

    "@id":
      articleURL
  },

  author: {
    "@type":
      "Person",

    name:
      post.data.author,

    url:
      "https://soleilandstone.co/"
  },

  publisher: {
    "@type":
      "Organization",

    name:
      "Soleil & Stone",

    url:
      "https://soleilandstone.co/",

    logo: {
      "@type":
        "ImageObject",

      url:
        publisherLogo
    }
  },

  image: [
    socialImage
  ]

};
---

<BaseLayout
  title={seoTitle}
  description={post.data.description}
  type="article"
  publishedTime={publishedTime}
  canonicalURL={canonicalURL}
>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />


  <FieldNoteLayout
    post={post}
    recommendedPost={recommendedPost}
  >

    <Content />

  </FieldNoteLayout>

</BaseLayout>
