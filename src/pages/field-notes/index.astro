---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";


const notes =
  (
    await getCollection(
      "field-notes"
    )
  )
    .filter(
      (note) => {
        const date =
          new Date(
            note.data.date
          );

        return date <=
          new Date();
      }
    )
    .sort(
      (a, b) =>
        new Date(
          b.data.date
        ).getTime() -
        new Date(
          a.data.date
        ).getTime()
    );


const categories =
  [
    {
      label:
        "All Notes",
      value:
        "all"
    },
    {
      label:
        "Ecosystems & Community",
      value:
        "ecosystems"
    },
    {
      label:
        "Trade Shows",
      value:
        "tradeshows"
    },
    {
      label:
        "Hardware & Manufacturing",
      value:
        "hardware"
    }
  ];


function formatDate(
  value
) {

  return new Date(
    value
  ).toLocaleDateString(
    "en-US",
    {
      month:
        "long",
      day:
        "numeric",
      year:
        "numeric"
    }
  );

}


function getCategoryLabel(
  category
) {

  const labels = {
    ecosystems:
      "Ecosystems & Community",

    tradeshows:
      "Trade Shows",

    hardware:
      "Hardware & Manufacturing"
  };


  return (
    labels[
      category
    ] ??
    category
  );

}
---

<BaseLayout
  title="SOLEIL & STONE | Field Notes"
  description="Notes and observations on hardware, commercialization, trade shows, community building and innovation ecosystems."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Notes From The Field
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-6xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.12]
          mb-6
        "
      >
        Field Notes
      </h1>


      <p
        class="
          text-base
          sm:text-lg
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
        "
      >
        Observations from the field on hardware,
        commercialization, innovation ecosystems,
        trade shows and community building.
      </p>

    </div>

  </section>



  <!-- =====================================================
       INTRO + FILTERS — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-12
      "
    >

      <div
        class="
          grid
          lg:grid-cols-12
          gap-8
          items-end
        "
      >

        <!-- INTRO -->

        <div
          class="
            lg:col-span-7
          "
        >

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Articles & Field Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              sm:text-4xl
              text-brand-charcoal
              mt-2
              mb-4
            "
          >
            Ideas, observations,
            and lessons from the field.
          </h2>


          <p
            class="
              text-sm
              text-brand-slate
              leading-relaxed
              font-light
              max-w-2xl
            "
          >
            Notes on building communities,
            attending industry events,
            working across hardware ecosystems,
            and understanding how technical
            products move toward real-world adoption.
          </p>

        </div>



        <!-- FILTER LABEL -->

        <div
          class="
            lg:col-span-5
            lg:text-right
          "
        >

          <div
            class="
              text-[9px]
              uppercase
              tracking-[0.18em]
              text-brand-slate
              mb-3
            "
          >
            Browse By Topic
          </div>

        </div>

      </div>



      <!-- FILTERS -->

      <div
        class="
          flex
          flex-wrap
          gap-2
          mt-8
        "
      >

        {
          categories.map(
            (
              category,
              index
            ) => (

              <button
                type="button"
                data-filter={
                  category.value
                }
                class:list={[
                  "field-filter",
                  "inline-flex",
                  "items-center",
                  "px-4",
                  "py-2.5",
                  "border",
                  "text-[9px]",
                  "uppercase",
                  "tracking-[0.15em]",
                  "font-semibold",
                  "transition-colors",

                  index === 0
                    ? "is-active bg-brand-charcoal text-white border-brand-charcoal"
                    : "bg-white text-brand-slate border-brand-border hover:border-brand-gold hover:text-brand-gold"
                ]}
              >
                {category.label}
              </button>

            )
          )
        }

      </div>

    </div>

  </section>



  <!-- =====================================================
       NOTES LISTING — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-16
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          flex
          flex-col
          sm:flex-row
          sm:items-end
          justify-between
          gap-4
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Published Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Explore The Notes
          </h2>

        </div>


        <div
          class="
            text-[10px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >
          <span
            id="visible-note-count"
          >
            {notes.length}
          </span>

          {" "}
          published
        </div>

      </div>



      <!-- =================================================
           ARTICLE GRID
           ================================================= -->

      <div
        id="field-notes-grid"
        class="
          grid
          md:grid-cols-2
          gap-5
        "
      >

        {
          notes.map(
            (
              note,
              index
            ) => (

              <article
                data-note-card
                data-category={
                  note.data.category
                }
                class="
                  group
                  border
                  border-brand-border
                  bg-white
                  min-h-[285px]
                  flex
                  flex-col
                  transition-all
                  hover:border-brand-gold
                  hover:bg-brand-cream
                "
              >

                <a
                  href={`/field-notes/${note.id.replace(".md", "")}/`}
                  class="
                    flex
                    flex-col
                    h-full
                    p-6
                    sm:p-7
                  "
                >

                  <!-- TOP META -->

                  <div
                    class="
                      flex
                      items-start
                      justify-between
                      gap-4
                      mb-7
                    "
                  >

                    <div>

                      <span
                        class="
                          inline-flex
                          px-2.5
                          py-1
                          bg-brand-gold/10
                          text-[8px]
                          uppercase
                          tracking-[0.15em]
                          text-brand-gold
                          font-semibold
                        "
                      >
                        {
                          getCategoryLabel(
                            note.data.category
                          )
                        }
                      </span>


                      <div
                        class="
                          text-[9px]
                          uppercase
                          tracking-[0.14em]
                          text-brand-slate
                          mt-3
                        "
                      >
                        {
                          formatDate(
                            note.data.date
                          )
                        }
                      </div>

                    </div>



                    <!-- EDITORIAL NUMBER -->

                    <span
                      class="
                        font-serif
                        text-2xl
                        text-brand-border
                        group-hover:text-brand-gold
                        transition-colors
                      "
                    >
                      {
                        String(
                          index + 1
                        ).padStart(
                          2,
                          "0"
                        )
                      }
                    </span>

                  </div>



                  <!-- TITLE -->

                  <h3
                    class="
                      font-serif
                      text-2xl
                      sm:text-[1.7rem]
                      text-brand-charcoal
                      leading-snug
                      group-hover:text-brand-gold
                      transition-colors
                    "
                  >
                    {note.data.title}
                  </h3>



                  <!-- DESCRIPTION -->

                  {
                    note.data.description && (

                      <p
                        class="
                          text-xs
                          sm:text-sm
                          text-brand-slate
                          leading-relaxed
                          font-light
                          mt-4
                          max-w-xl
                        "
                      >
                        {
                          note.data.description
                        }
                      </p>

                    )
                  }



                  <!-- BOTTOM -->

                  <div
                    class="
                      mt-auto
                      pt-7
                    "
                  >

                    <div
                      class="
                        border-t
                        border-brand-border
                        pt-4
                        flex
                        items-center
                        justify-between
                        gap-4
                      "
                    >

                      <span
                        class="
                          text-[9px]
                          uppercase
                          tracking-[0.16em]
                          text-brand-charcoal
                          font-semibold
                          group-hover:text-brand-gold
                          transition-colors
                        "
                      >
                        Read Field Note
                      </span>


                      <span
                        class="
                          text-brand-slate
                          group-hover:text-brand-gold
                          group-hover:translate-x-1
                          transition-all
                        "
                      >
                        →
                      </span>

                    </div>

                  </div>

                </a>

              </article>

            )
          )
        }

      </div>



      <!-- EMPTY STATE -->

      <div
        id="field-notes-empty"
        class="
          hidden
          border
          border-brand-border
          bg-brand-cream
          px-6
          py-12
          text-center
        "
      >

        <p
          class="
            text-sm
            text-brand-slate
            font-light
          "
        >
          No Field Notes are published
          in this category yet.
        </p>

      </div>

    </div>

  </section>

</BaseLayout>



<!-- =====================================================
     FILTER SCRIPT
     ===================================================== -->

<script is:inline>
  (() => {

    const buttons =
      Array.from(
        document.querySelectorAll(
          ".field-filter"
        )
      );


    const cards =
      Array.from(
        document.querySelectorAll(
          "[data-note-card]"
        )
      );


    const count =
      document.getElementById(
        "visible-note-count"
      );


    const emptyState =
      document.getElementById(
        "field-notes-empty"
      );


    const setActiveButton =
      (activeButton) => {

        buttons.forEach(
          (button) => {

            const isActive =
              button ===
              activeButton;


            button.classList.toggle(
              "is-active",
              isActive
            );


            button.classList.toggle(
              "bg-brand-charcoal",
              isActive
            );


            button.classList.toggle(
              "text-white",
              isActive
            );


            button.classList.toggle(
              "border-brand-charcoal",
              isActive
            );


            button.classList.toggle(
              "bg-white",
              !isActive
            );


            button.classList.toggle(
              "text-brand-slate",
              !isActive
            );


            button.classList.toggle(
              "border-brand-border",
              !isActive
            );

          }
        );

      };


    buttons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const filter =
              button.dataset.filter;


            setActiveButton(
              button
            );


            let visible =
              0;


            cards.forEach(
              (card) => {

                const category =
                  card.dataset.category;


                const shouldShow =
                  filter ===
                    "all" ||
                  category ===
                    filter;


                card.classList.toggle(
                  "hidden",
                  !shouldShow
                );


                if (
                  shouldShow
                ) {
                  visible +=
                    1;
                }

              }
            );


            if (
              count
            ) {
              count.textContent =
                String(
                  visible
                );
            }


            if (
              emptyState
            ) {
              emptyState.classList.toggle(
                "hidden",
                visible !== 0
              );
            }

          }
        );

      }
    );

  })();
</script>
