---
import {
  getCollection
} from "astro:content";

import BaseLayout
  from "../../layouts/BaseLayout.astro";

import ArticleCard
  from "../../components/ArticleCard.astro";


/* =========================================================
   LOAD PUBLISHED FIELD NOTES
   ========================================================= */

const now =
  new Date();


const posts =
  (
    await getCollection(
      "fieldNotes"
    )
  )
    .filter(
      (post) =>
        !post.data.draft &&
        post.data.published <= now
    )
    .sort(
      (a, b) =>
        b.data.published.getTime() -
        a.data.published.getTime()
    );


/* =========================================================
   FILTERS
   ========================================================= */

const filters = [
  {
    label:
      "All Notes",

    value:
      "all"
  },

  {
    label:
      "Ecosystems & Community",

    value:
      "ecosystem"
  },

  {
    label:
      "Trade Shows",

    value:
      "tradeshows"
  },

  {
    label:
      "Hardware & Manufacturing",

    value:
      "hardware"
  }
];
---

<BaseLayout
  title="SOLEIL & STONE | Field Notes"
  description="Observations from the field on hardware, commercialization, innovation ecosystems, trade shows and community building."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Notes From The Field
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-6xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.12]
          mb-6
        "
      >
        Field Notes
      </h1>


      <p
        class="
          text-base
          sm:text-lg
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
        "
      >
        Observations from the field on hardware,
        commercialization, innovation ecosystems,
        trade shows and community building.
      </p>

    </div>

  </section>



  <!-- =====================================================
       FILTER AREA
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-8
      "
    >

      <span
        class="
          text-[9px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Articles & Field Notes
      </span>


      <p
        class="
          text-sm
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
          mt-2
        "
      >
        Notes on communities, industry events,
        hardware ecosystems and technical commercialization.
      </p>



      <div
        id="filters"
        class="
          flex
          flex-wrap
          items-center
          gap-2
          mt-5
        "
        aria-label="Filter field notes"
      >

        {
          filters.map(
            (
              filter,
              index
            ) => (

              <button
                type="button"
                data-filter={
                  filter.value
                }
                class:list={[
                  "field-note-filter",
                  "px-4",
                  "py-2.5",
                  "border",
                  "text-[9px]",
                  "uppercase",
                  "tracking-[0.15em]",
                  "font-semibold",
                  "transition-colors",

                  index === 0
                    ? "active border-brand-charcoal bg-brand-charcoal text-white"
                    : "border-brand-border bg-white text-brand-slate hover:border-brand-gold hover:text-brand-gold"
                ]}
              >
                {filter.label}
              </button>

            )
          )
        }

      </div>

    </div>

  </section>



  <!-- =====================================================
       PUBLISHED NOTES
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          flex
          items-end
          justify-between
          gap-6
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Published Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Explore The Notes
          </h2>

        </div>


        <span
          id="article-count"
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >
          {posts.length}
          {posts.length === 1 ? " Note" : " Notes"}
        </span>

      </div>



      <!-- =================================================
           ARTICLE GRID
           ================================================= -->

      <div
        id="field-notes-grid"
        class="
          grid
          md:grid-cols-2
          gap-5
        "
      >

        {
          posts.map(
            (post) => (

              <div
                class="field-note-item"
                data-category={
                  post.data.categorySlug
                }
              >

                <ArticleCard
                  post={post}
                />

              </div>

            )
          )
        }

      </div>



      <!-- =================================================
           EMPTY FILTER STATE
           ================================================= -->

      <div
        id="field-notes-empty"
        class="
          hidden
          py-12
          text-center
          border
          border-brand-border
          bg-brand-cream
        "
      >

        <p
          class="
            font-serif
            text-xl
            text-brand-charcoal
            mb-2
          "
        >
          No field notes in this category yet.
        </p>


        <p
          class="
            text-sm
            text-brand-slate
            font-light
          "
        >
          More notes are coming soon.
        </p>

      </div>

    </div>

  </section>

</BaseLayout>



<!-- =====================================================
     FILTER LOGIC
     ===================================================== -->

<script is:inline>

  const filterButtons =
    Array.from(
      document.querySelectorAll(
        ".field-note-filter"
      )
    );


  const items =
    Array.from(
      document.querySelectorAll(
        ".field-note-item"
      )
    );


  const countElement =
    document.getElementById(
      "article-count"
    );


  const emptyState =
    document.getElementById(
      "field-notes-empty"
    );


  const updateCount =
    (count) => {

      if (
        !countElement
      ) {
        return;
      }


      countElement.textContent =
        `${count} ${
          count === 1
            ? "Note"
            : "Notes"
        }`;

    };


  const setActiveButton =
    (
      activeButton
    ) => {

      filterButtons.forEach(
        (button) => {

          button.classList.remove(
            "active",
            "border-brand-charcoal",
            "bg-brand-charcoal",
            "text-white"
          );


          button.classList.add(
            "border-brand-border",
            "bg-white",
            "text-brand-slate"
          );

        }
      );


      activeButton.classList.remove(
        "border-brand-border",
        "bg-white",
        "text-brand-slate"
      );


      activeButton.classList.add(
        "active",
        "border-brand-charcoal",
        "bg-brand-charcoal",
        "text-white"
      );

    };


  const filterNotes =
    (
      category
    ) => {

      let visibleCount =
        0;


      items.forEach(
        (item) => {

          const itemCategory =
            item.dataset.category;


          const visible =
            category === "all" ||
            itemCategory === category;


          item.classList.toggle(
            "hidden",
            !visible
          );


          if (
            visible
          ) {
            visibleCount++;
          }

        }
      );


      updateCount(
        visibleCount
      );


      if (
        emptyState
      ) {

        emptyState.classList.toggle(
          "hidden",
          visibleCount !== 0
        );

      }

    };


  filterButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          const category =
            button.dataset.filter;


          if (
            !category
          ) {
            return;
          }


          setActiveButton(
            button
          );


          filterNotes(
            category
          );

        }
      );

    }
  );

</script>
