---
import {
  getCollection
} from "astro:content";

import BaseLayout
  from "../../layouts/BaseLayout.astro";

import ArticleCard
  from "../../components/ArticleCard.astro";


const now =
  new Date();


const posts =
  (
    await getCollection(
      "fieldNotes"
    )
  )

  .filter(
    post =>
      !post.data.draft &&
      post.data.published <= now
  )

  .sort(
    (a, b) =>
      b.data.published.getTime() -
      a.data.published.getTime()
  );
---

<BaseLayout
  title="SOLEIL & STONE | Field Notes"
  description="Field notes on entrepreneurship, hardware, community building, trade shows and the West Coast innovation ecosystem."
>

  <section
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
      border-b
      border-brand-border
    "
  >

    <span
      class="
        inline-block
        px-3
        py-1
        bg-brand-gold/10
        border
        border-brand-gold/30
        text-brand-gold
        text-[10px]
        uppercase
        tracking-[0.2em]
        font-semibold
        mb-4
      "
    >
      Field Notes & Perspectives
    </span>


    <h1
      class="
        font-serif
        text-3xl
        sm:text-4xl
        lg:text-5xl
        text-brand-charcoal
        mb-6
      "
    >
      Articles & Field Notes
    </h1>


    <p
      class="
        text-base
        text-brand-slate
        leading-relaxed
        font-light
        max-w-3xl
        mb-8
      "
    >
      Field notes on entrepreneurship,
      hardware, community building,
      trade shows, and the people and ideas
      shaping the West Coast innovation ecosystem.
    </p>


    <div
      id="filters"
      class="
        flex
        flex-wrap
        gap-3
      "
    >

      <button
        data-filter="all"
        class="
          filter-button
          active
        "
      >
        All Notes
      </button>


      <button
        data-filter="ecosystem"
        class="filter-button"
      >
        Ecosystems & Community
      </button>


      <button
        data-filter="tradeshows"
        class="filter-button"
      >
        Trade Shows
      </button>


      <button
        data-filter="hardware"
        class="filter-button"
      >
        Hardware & Manufacturing
      </button>

    </div>

  </section>


  <section
    id="article-grid"
    class="
      max-w-6xl
      w-full
      mx-auto
      px-6
      py-16
      grid
      md:grid-cols-2
      gap-10
    "
  >

    {
      posts.map(
        post => (

          <div
            class="article-wrapper"
            data-category={post.data.categorySlug}
          >

            <ArticleCard
              post={post}
            />

          </div>

        )
      )
    }

  </section>


  <script>

    const buttons =
      document.querySelectorAll(
        "[data-filter]"
      );


    const articles =
      document.querySelectorAll(
        ".article-wrapper"
      );


    buttons.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const filter =
              button.dataset.filter;


            buttons.forEach(
              item =>
                item.classList.remove(
                  "active"
                )
            );


            button.classList.add(
              "active"
            );


            articles.forEach(
              article => {

                article.hidden =
                  filter !== "all" &&
                  article.dataset.category !== filter;

              }
            );

          }
        );

      }
    );

  </script>


  <style>

    .filter-button {
      padding:
        0.55rem 1rem;

      border:
        1px solid #E8E5DA;

      background:
        #FFFFFF;

      color:
        #4A505A;

      font-size:
        0.75rem;

      font-weight:
        600;

      letter-spacing:
        0.08em;

      text-transform:
        uppercase;
    }


    .filter-button:hover {
      border-color:
        #C5A059;
    }


    .filter-button.active {
      background:
        #22252A;

      color:
        white;

      border-color:
        #22252A;
    }

  </style>

</BaseLayout>
