---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";


/* =========================================================
   LOAD FIELD NOTES
   ========================================================= */

const allNotes =
  await getCollection(
    "field-notes"
  );


/* =========================================================
   HELPERS
   ========================================================= */

function getNoteDate(
  note
) {

  const value =
    note.data.published ??
    note.data.date ??
    note.data.publishDate ??
    note.data.publishedAt;


  if (!value) {
    return null;
  }


  const date =
    value instanceof Date
      ? value
      : new Date(
          `${value}T12:00:00`
        );


  return Number.isNaN(
    date.getTime()
  )
    ? null
    : date;

}


function normalizeCategory(
  value
) {

  const category =
    String(
      value ?? ""
    )
      .trim()
      .toLowerCase();


  if (
    category === "ecosystem" ||
    category === "ecosystems" ||
    category === "ecosystems & community" ||
    category === "ecosystem & community"
  ) {
    return "ecosystem";
  }


  if (
    category === "tradeshows" ||
    category === "trade shows" ||
    category === "trade-show" ||
    category === "trade-shows"
  ) {
    return "tradeshows";
  }


  if (
    category === "hardware" ||
    category === "hardware & manufacturing" ||
    category === "hardware and manufacturing"
  ) {
    return "hardware";
  }


  return category || "ecosystem";

}


function getCategory(
  note
) {

  return normalizeCategory(
    note.data.categorySlug ??
    note.data.category ??
    note.data.categoryName
  );

}


function getCategoryLabel(
  note
) {

  if (
    note.data.categoryName
  ) {
    return note.data.categoryName;
  }


  const category =
    getCategory(
      note
    );


  const labels = {
    ecosystem:
      "Ecosystems & Community",

    tradeshows:
      "Trade Shows",

    hardware:
      "Hardware & Manufacturing"
  };


  return (
    labels[category] ??
    "Field Notes"
  );

}


function formatDate(
  date
) {

  if (!date) {
    return "";
  }


  return date.toLocaleDateString(
    "en-US",
    {
      month:
        "long",

      day:
        "numeric",

      year:
        "numeric"
    }
  );

}


function getDescription(
  note
) {

  return (
    note.data.description ??
    note.data.excerpt ??
    ""
  );

}


function getReadMinutes(
  note
) {

  return (
    note.data.readMinutes ??
    note.data.readingTime ??
    null
  );

}


function getSlug(
  note
) {

  return note.id
    .replace(
      /\.md$/,
      ""
    )
    .replace(
      /\.mdx$/,
      ""
    );

}


function getNoteUrl(
  note
) {

  /*
   * If an explicit URL exists in the metadata,
   * use it.
   *
   * Otherwise use the Astro dynamic route.
   */

  if (
    note.data.url
  ) {
    return note.data.url;
  }


  return `/field-notes/${getSlug(
    note
  )}/`;

}


/* =========================================================
   PUBLISHED NOTES
   ========================================================= */

const now =
  new Date();


const notes =
  allNotes
    .filter(
      (note) => {

        /*
         * Respect draft metadata if present.
         */

        if (
          note.data.draft === true
        ) {
          return false;
        }


        const date =
          getNoteDate(
            note
          );


        /*
         * Don't silently remove an article just because
         * its date field is missing.
         */

        if (!date) {
          return true;
        }


        return (
          date <= now
        );

      }
    )
    .sort(
      (a, b) => {

        const dateA =
          getNoteDate(
            a
          );

        const dateB =
          getNoteDate(
            b
          );


        if (
          !dateA &&
          !dateB
        ) {
          return 0;
        }


        if (!dateA) {
          return 1;
        }


        if (!dateB) {
          return -1;
        }


        return (
          dateB.getTime() -
          dateA.getTime()
        );

      }
    );


const categories = [
  {
    label:
      "All Notes",

    value:
      "all"
  },

  {
    label:
      "Ecosystems & Community",

    value:
      "ecosystem"
  },

  {
    label:
      "Trade Shows",

    value:
      "tradeshows"
  },

  {
    label:
      "Hardware & Manufacturing",

    value:
      "hardware"
  }
];
---

<BaseLayout
  title="SOLEIL & STONE | Field Notes"
  description="Notes and observations on hardware, commercialization, trade shows, community building and innovation ecosystems."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <!-- BRAND LABEL -->

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Notes From The Field
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-6xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.12]
          mb-6
        "
      >
        Field Notes
      </h1>


      <p
        class="
          text-base
          sm:text-lg
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
        "
      >
        Observations from the field on hardware,
        commercialization, innovation ecosystems,
        trade shows and community building.
      </p>

    </div>

  </section>



  <!-- =====================================================
       FILTER AREA — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-8
      "
    >

      <span
        class="
          text-[9px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Articles & Field Notes
      </span>


      <p
        class="
          text-sm
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
          mt-2
        "
      >
        Notes on communities, industry events,
        hardware ecosystems and technical commercialization.
      </p>



      <!-- FILTER BUTTONS -->

      <div
        class="
          flex
          flex-wrap
          gap-2
          mt-5
        "
      >

        {
          categories.map(
            (
              category,
              index
            ) => (

              <button
                type="button"
                data-filter={
                  category.value
                }
                class:list={[
                  "field-filter",
                  "inline-flex",
                  "items-center",
                  "px-4",
                  "py-2.5",
                  "border",
                  "text-[9px]",
                  "uppercase",
                  "tracking-[0.15em]",
                  "font-semibold",
                  "transition-colors",

                  index === 0
                    ? "bg-brand-charcoal text-white border-brand-charcoal"
                    : "bg-white text-brand-slate border-brand-border hover:border-brand-gold hover:text-brand-gold"
                ]}
              >
                {category.label}
              </button>

            )
          )
        }

      </div>

    </div>

  </section>



  <!-- =====================================================
       PUBLISHED NOTES — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <!-- SECTION HEADING -->

      <div
        class="
          flex
          items-end
          justify-between
          gap-6
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Published Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Explore The Notes
          </h2>

        </div>


        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >

          <span
            id="visible-note-count"
          >
            {notes.length}
          </span>

          {" "}

          <span
            id="visible-note-label"
          >
            {notes.length === 1
              ? "note"
              : "notes"}
          </span>

        </div>

      </div>



      <!-- =================================================
           NOTES GRID
           ================================================= -->

      {
        notes.length > 0 && (

          <div
            id="field-notes-grid"
            class="
              grid
              md:grid-cols-2
              gap-5
            "
          >

            {
              notes.map(
                (
                  note,
                  index
                ) => {

                  const noteDate =
                    getNoteDate(
                      note
                    );


                  const noteUrl =
                    getNoteUrl(
                      note
                    );


                  const readMinutes =
                    getReadMinutes(
                      note
                    );


                  return (

                    <article
                      data-note-card
                      data-category={
                        getCategory(
                          note
                        )
                      }
                      class="
                        group
                        border
                        border-brand-border
                        bg-white
                        flex
                        flex-col
                        min-h-[260px]
                        transition-all
                        duration-200
                        hover:border-brand-gold
                        hover:bg-brand-cream
                      "
                    >

                      <!--
                        Entire card is clickable.
                      -->

                      <a
                        href={noteUrl}
                        class="
                          flex
                          flex-col
                          h-full
                          p-6
                          sm:p-7
                        "
                        aria-label={`Read ${note.data.title}`}
                      >

                        <!-- TOP META -->

                        <div
                          class="
                            flex
                            items-start
                            justify-between
                            gap-5
                            mb-6
                          "
                        >

                          <div>

                            <!-- CATEGORY -->

                            <span
                              class="
                                inline-flex
                                px-2.5
                                py-1
                                bg-brand-gold/10
                                text-[8px]
                                uppercase
                                tracking-[0.15em]
                                text-brand-gold
                                font-semibold
                              "
                            >
                              {
                                getCategoryLabel(
                                  note
                                )
                              }
                            </span>


                            <!-- DATE -->

                            {
                              noteDate && (

                                <div
                                  class="
                                    text-[9px]
                                    uppercase
                                    tracking-[0.14em]
                                    text-brand-slate
                                    mt-3
                                  "
                                >
                                  {
                                    formatDate(
                                      noteDate
                                    )
                                  }
                                </div>

                              )
                            }

                          </div>



                          <!-- EDITORIAL NUMBER -->

                          <span
                            class="
                              font-serif
                              text-xl
                              text-brand-border
                              group-hover:text-brand-gold
                              transition-colors
                            "
                          >
                            {
                              String(
                                index + 1
                              ).padStart(
                                2,
                                "0"
                              )
                            }
                          </span>

                        </div>



                        <!-- TITLE -->

                        <h3
                          class="
                            font-serif
                            text-2xl
                            text-brand-charcoal
                            leading-snug
                            group-hover:text-brand-gold
                            transition-colors
                          "
                        >
                          {note.data.title}
                        </h3>



                        <!-- DESCRIPTION -->

                        {
                          getDescription(
                            note
                          ) && (

                            <p
                              class="
                                text-xs
                                sm:text-sm
                                text-brand-slate
                                leading-relaxed
                                font-light
                                mt-4
                                max-w-xl
                              "
                            >
                              {
                                getDescription(
                                  note
                                )
                              }
                            </p>

                          )
                        }



                        <!-- CARD FOOTER -->

                        <div
                          class="
                            mt-auto
                            pt-6
                          "
                        >

                          <div
                            class="
                              border-t
                              border-brand-border
                              pt-4
                              flex
                              items-center
                              justify-between
                              gap-5
                            "
                          >

                            <div
                              class="
                                flex
                                items-center
                                gap-3
                              "
                            >

                              <span
                                class="
                                  text-[9px]
                                  uppercase
                                  tracking-[0.16em]
                                  text-brand-charcoal
                                  font-semibold
                                  group-hover:text-brand-gold
                                  transition-colors
                                "
                              >
                                Read Field Note
                              </span>


                              {
                                readMinutes && (

                                  <>
                                    <span
                                      class="
                                        text-brand-border
                                      "
                                    >
                                      •
                                    </span>


                                    <span
                                      class="
                                        text-[9px]
                                        text-brand-slate
                                      "
                                    >
                                      {readMinutes} min read
                                    </span>
                                  </>

                                )
                              }

                            </div>


                            <span
                              class="
                                text-brand-slate
                                group-hover:text-brand-gold
                                group-hover:translate-x-1
                                transition-all
                              "
                            >
                              →
                            </span>

                          </div>

                        </div>

                      </a>

                    </article>

                  );

                }
              )
            }

          </div>

        )
      }



      <!-- =================================================
           NO PUBLISHED ARTICLES
           ================================================= -->

      {
        notes.length === 0 && (

          <div
            id="no-notes-initial"
            class="
              border
              border-brand-border
              bg-brand-cream
              px-6
              py-10
              text-center
            "
          >

            <p
              class="
                text-sm
                text-brand-slate
                font-light
              "
            >
              No Field Notes are currently published.
            </p>

          </div>

        )
      }



      <!-- FILTER EMPTY STATE -->

      <div
        id="field-notes-empty"
        class="
          hidden
          border
          border-brand-border
          bg-brand-cream
          px-6
          py-10
          text-center
        "
      >

        <p
          class="
            text-sm
            text-brand-slate
            font-light
          "
        >
          No Field Notes are published
          in this category yet.
        </p>

      </div>

    </div>

  </section>

</BaseLayout>



<!-- =====================================================
     FILTER SCRIPT
     ===================================================== -->

<script is:inline>
  (() => {

    const buttons =
      Array.from(
        document.querySelectorAll(
          ".field-filter"
        )
      );


    const cards =
      Array.from(
        document.querySelectorAll(
          "[data-note-card]"
        )
      );


    const count =
      document.getElementById(
        "visible-note-count"
      );


    const label =
      document.getElementById(
        "visible-note-label"
      );


    const emptyState =
      document.getElementById(
        "field-notes-empty"
      );


    function updateActiveButton(
      activeButton
    ) {

      buttons.forEach(
        (button) => {

          const isActive =
            button === activeButton;


          button.classList.toggle(
            "bg-brand-charcoal",
            isActive
          );


          button.classList.toggle(
            "text-white",
            isActive
          );


          button.classList.toggle(
            "border-brand-charcoal",
            isActive
          );


          button.classList.toggle(
            "bg-white",
            !isActive
          );


          button.classList.toggle(
            "text-brand-slate",
            !isActive
          );


          button.classList.toggle(
            "border-brand-border",
            !isActive
          );

        }
      );

    }


    buttons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const filter =
              button.dataset.filter;


            updateActiveButton(
              button
            );


            let visible =
              0;


            cards.forEach(
              (card) => {

                const category =
                  card.dataset.category;


                const shouldShow =
                  filter === "all" ||
                  category === filter;


                card.classList.toggle(
                  "hidden",
                  !shouldShow
                );


                if (
                  shouldShow
                ) {
                  visible += 1;
                }

              }
            );


            if (count) {
              count.textContent =
                String(
                  visible
                );
            }


            if (label) {

              label.textContent =
                visible === 1
                  ? "note"
                  : "notes";

            }


            if (emptyState) {

              emptyState.classList.toggle(
                "hidden",
                visible !== 0
              );

            }

          }
        );

      }
    );

  })();
</script>
