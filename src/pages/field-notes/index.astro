---
import BaseLayout from "../../layouts/BaseLayout.astro";


/* =========================================================
   LOAD FIELD NOTES DIRECTLY
   ========================================================= */

const noteModules =
  import.meta.glob(
    "../../content/field-notes/*.{md,mdx}",
    {
      eager: true
    }
  );


/* =========================================================
   HELPERS
   ========================================================= */

function getFileSlug(
  path: string
) {
  return (
    path
      .split("/")
      .pop()
      ?.replace(
        /\.(md|mdx)$/,
        ""
      ) ?? ""
  );
}


function getData(
  module: any
) {
  return (
    module.frontmatter ??
    module.data ??
    {}
  );
}


function parseNoteDate(
  data: any
) {

  const value =
    data.date ??
    data.published ??
    data.publishDate ??
    data.publishedAt;


  if (!value) {
    return null;
  }


  if (
    value instanceof Date
  ) {
    return value;
  }


  /*
   * Noon avoids timezone movement to the
   * previous calendar day.
   */

  const date =
    new Date(
      `${value}T12:00:00`
    );


  return Number.isNaN(
    date.getTime()
  )
    ? null
    : date;

}


function normalizeCategory(
  value: any
) {

  const category =
    String(
      value ?? ""
    )
      .trim()
      .toLowerCase();


  if (
    category === "ecosystem" ||
    category === "ecosystems" ||
    category === "ecosystems & community" ||
    category === "ecosystem & community"
  ) {
    return "ecosystem";
  }


  if (
    category === "tradeshow" ||
    category === "tradeshows" ||
    category === "trade show" ||
    category === "trade shows" ||
    category === "trade-show" ||
    category === "trade-shows"
  ) {
    return "tradeshows";
  }


  if (
    category === "hardware" ||
    category === "hardware & manufacturing" ||
    category === "hardware and manufacturing"
  ) {
    return "hardware";
  }


  return (
    category ||
    "ecosystem"
  );

}


function getCategory(
  data: any
) {

  return normalizeCategory(
    data.categorySlug ??
    data.category ??
    data.categoryName
  );

}


function getCategoryLabel(
  data: any
) {

  if (
    data.categoryName
  ) {
    return data.categoryName;
  }


  const category =
    getCategory(
      data
    );


  const labels: Record<
    string,
    string
  > = {

    ecosystem:
      "Ecosystems & Community",

    tradeshows:
      "Trade Shows",

    hardware:
      "Hardware & Manufacturing"

  };


  return (
    labels[category] ??
    "Field Notes"
  );

}


function formatDate(
  date: Date | null
) {

  if (!date) {
    return "";
  }


  return date
    .toLocaleDateString(
      "en-US",
      {
        month:
          "short",

        day:
          "numeric",

        year:
          "numeric"
      }
    )
    .toUpperCase();

}


function getDescription(
  data: any
) {

  return (
    data.description ??
    data.excerpt ??
    ""
  );

}


function getReadMinutes(
  data: any
) {

  return (
    data.readMinutes ??
    data.readingTime ??
    null
  );

}


function getNoteUrl(
  data: any,
  slug: string
) {

  if (
    data.url
  ) {
    return data.url;
  }


  return (
    `/field-notes/${slug}/`
  );

}


/* =========================================================
   TODAY

   Normalize today to end-of-day so a note dated today
   appears throughout its publication day.
   ========================================================= */

const today =
  new Date();

today.setHours(
  23,
  59,
  59,
  999
);


/* =========================================================
   BUILD NOTES

   IMPORTANT:
   Future-dated notes are excluded here.
   ========================================================= */

const notes =
  Object.entries(
    noteModules
  )
    .map(
      (
        [
          path,
          module
        ]
      ) => {

        const data =
          getData(
            module
          );


        const slug =
          getFileSlug(
            path
          );


        const date =
          parseNoteDate(
            data
          );


        return {

          slug,

          data,

          date,

          category:
            getCategory(
              data
            ),

          categoryLabel:
            getCategoryLabel(
              data
            ),

          url:
            getNoteUrl(
              data,
              slug
            )

        };

      }
    )

    /*
     * PUBLICATION RULES
     */

    .filter(
      (
        note
      ) => {

        /*
         * Never publish drafts.
         */

        if (
          note.data.draft === true
        ) {
          return false;
        }


        /*
         * Require a valid publication date.
         *
         * This prevents an accidentally unfinished
         * note from appearing publicly.
         */

        if (
          !note.date
        ) {
          return false;
        }


        /*
         * Future date = hidden.
         */

        if (
          note.date > today
        ) {
          return false;
        }


        return true;

      }
    )

    /*
     * NEWEST → OLDEST
     */

    .sort(
      (
        a,
        b
      ) =>
        b.date!.getTime() -
        a.date!.getTime()
    );


const categories = [

  {
    label:
      "All Notes",

    value:
      "all"
  },

  {
    label:
      "Ecosystems & Community",

    value:
      "ecosystem"
  },

  {
    label:
      "Trade Shows",

    value:
      "tradeshows"
  },

  {
    label:
      "Hardware & Manufacturing",

    value:
      "hardware"
  }

];
---

<BaseLayout
  title="SOLEIL & STONE | Field Notes"
  description="Notes and observations on hardware, commercialization, trade shows, community building and innovation ecosystems."
>

  <!-- =====================================================
       HERO — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Notes From The Field
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-6xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.12]
          mb-6
        "
      >
        Field Notes
      </h1>


      <p
        class="
          text-base
          sm:text-lg
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
        "
      >
        Observations from the field on hardware,
        commercialization, innovation ecosystems,
        trade shows and community building.
      </p>

    </div>

  </section>



  <!-- =====================================================
       FILTER AREA — CREAM
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-8
      "
    >

      <span
        class="
          text-[9px]
          uppercase
          tracking-[0.2em]
          text-brand-gold
          font-semibold
        "
      >
        Articles & Field Notes
      </span>


      <p
        class="
          text-sm
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
          mt-2
        "
      >
        Notes on communities, industry events,
        hardware ecosystems and technical commercialization.
      </p>



      <!-- FILTERS -->

      <div
        class="
          flex
          flex-wrap
          gap-2
          mt-5
        "
      >

        {
          categories.map(
            (
              category,
              index
            ) => (

              <button
                type="button"
                data-filter={
                  category.value
                }
                class:list={[
                  "field-filter",
                  "inline-flex",
                  "items-center",
                  "px-4",
                  "py-2.5",
                  "border",
                  "text-[9px]",
                  "uppercase",
                  "tracking-[0.15em]",
                  "font-semibold",
                  "transition-colors",

                  index === 0
                    ? "bg-brand-charcoal text-white border-brand-charcoal"
                    : "bg-white text-brand-slate border-brand-border hover:border-brand-gold hover:text-brand-gold"
                ]}
              >
                {category.label}
              </button>

            )
          )
        }

      </div>

    </div>

  </section>



  <!-- =====================================================
       NOTES — WHITE
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <!-- SECTION HEADER -->

      <div
        class="
          flex
          items-end
          justify-between
          gap-6
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Published Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Explore The Notes
          </h2>

        </div>


        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >

          <span
            id="visible-note-count"
          >
            {notes.length}
          </span>

          {" "}

          <span
            id="visible-note-label"
          >
            {
              notes.length === 1
                ? "note"
                : "notes"
            }
          </span>

        </div>

      </div>



      <!-- =================================================
           FIELD NOTE CARDS
           ================================================= -->

      {
        notes.length > 0 && (

          <div
            id="field-notes-grid"
            class="
              grid
              md:grid-cols-2
              gap-5
            "
          >

            {
              notes.map(
                (
                  note
                ) => (

                  <article
                    data-note-card
                    data-category={
                      note.category
                    }
                    class="
                      group
                      bg-white
                      border
                      border-brand-border
                      transition-colors
                      duration-200
                      hover:border-brand-gold
                    "
                  >

                    <a
                      href={
                        note.url
                      }
                      class="
                        block
                        h-full
                        p-5
                      "
                      aria-label={`Read ${note.data.title}`}
                    >

                      <!-- =================================
                           META
                           ================================= -->

                      <div
                        class="
                          flex
                          flex-wrap
                          items-center
                          gap-2
                          text-[9px]
                          uppercase
                          tracking-[0.14em]
                          mb-4
                        "
                      >

                        <span
                          class="
                            text-brand-gold
                            font-semibold
                          "
                        >
                          {
                            note.categoryLabel
                          }
                        </span>


                        <span
                          class="
                            text-brand-border
                          "
                        >
                          •
                        </span>


                        <span
                          class="
                            text-brand-slate
                          "
                        >
                          {
                            formatDate(
                              note.date
                            )
                          }
                        </span>

                      </div>



                      <!-- =================================
                           TITLE
                           ================================= -->

                      <h3
                        class="
                          font-serif
                          text-xl
                          sm:text-[1.35rem]
                          text-brand-charcoal
                          leading-snug
                          group-hover:text-brand-gold
                          transition-colors
                        "
                      >
                        {note.data.title}
                      </h3>



                      <!-- =================================
                           DESCRIPTION
                           ================================= -->

                      {
                        getDescription(
                          note.data
                        ) && (

                          <p
                            class="
                              text-xs
                              sm:text-sm
                              text-brand-slate
                              leading-relaxed
                              font-light
                              mt-3
                            "
                          >
                            {
                              getDescription(
                                note.data
                              )
                            }
                          </p>

                        )
                      }



                      <!-- =================================
                           FOOTER
                           ================================= -->

                      <div
                        class="
                          border-t
                          border-brand-border
                          mt-4
                          pt-3
                          flex
                          items-center
                          justify-between
                          gap-4
                        "
                      >

                        <span
                          class="
                            text-[9px]
                            uppercase
                            tracking-[0.14em]
                            text-brand-slate
                          "
                        >
                          {
                            getReadMinutes(
                              note.data
                            )
                              ? `${getReadMinutes(
                                  note.data
                                )} min read`
                              : "Field Note"
                          }
                        </span>


                        <span
                          class="
                            text-[9px]
                            uppercase
                            tracking-[0.16em]
                            text-brand-charcoal
                            font-semibold
                            group-hover:text-brand-gold
                            transition-colors
                          "
                        >
                          Read →

                        </span>

                      </div>

                    </a>

                  </article>

                )
              )
            }

          </div>

        )
      }



      <!-- =================================================
           NO NOTES
           ================================================= -->

      {
        notes.length === 0 && (

          <div
            class="
              border
              border-brand-border
              bg-brand-cream
              px-6
              py-10
              text-center
            "
          >

            <p
              class="
                text-sm
                text-brand-slate
                font-light
              "
            >
              No Field Notes are currently published.
            </p>

          </div>

        )
      }



      <!-- FILTER EMPTY STATE -->

      <div
        id="field-notes-empty"
        class="
          hidden
          border
          border-brand-border
          bg-brand-cream
          px-6
          py-10
          text-center
        "
      >

        <p
          class="
            text-sm
            text-brand-slate
            font-light
          "
        >
          No Field Notes are published
          in this category yet.
        </p>

      </div>

    </div>

  </section>

</BaseLayout>



<!-- =====================================================
     FILTER SCRIPT
     ===================================================== -->

<script is:inline>
  (() => {

    const buttons =
      Array.from(
        document.querySelectorAll(
          ".field-filter"
        )
      );


    const cards =
      Array.from(
        document.querySelectorAll(
          "[data-note-card]"
        )
      );


    const count =
      document.getElementById(
        "visible-note-count"
      );


    const label =
      document.getElementById(
        "visible-note-label"
      );


    const emptyState =
      document.getElementById(
        "field-notes-empty"
      );


    function setActiveButton(
      activeButton
    ) {

      buttons.forEach(
        (button) => {

          const active =
            button ===
            activeButton;


          button.classList.toggle(
            "bg-brand-charcoal",
            active
          );


          button.classList.toggle(
            "text-white",
            active
          );


          button.classList.toggle(
            "border-brand-charcoal",
            active
          );


          button.classList.toggle(
            "bg-white",
            !active
          );


          button.classList.toggle(
            "text-brand-slate",
            !active
          );


          button.classList.toggle(
            "border-brand-border",
            !active
          );

        }
      );

    }


    buttons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const filter =
              button.dataset.filter;


            setActiveButton(
              button
            );


            let visible =
              0;


            cards.forEach(
              (card) => {

                const shouldShow =
                  filter === "all" ||
                  card.dataset.category ===
                    filter;


                card.classList.toggle(
                  "hidden",
                  !shouldShow
                );


                if (
                  shouldShow
                ) {
                  visible += 1;
                }

              }
            );


            if (
              count
            ) {
              count.textContent =
                String(
                  visible
                );
            }


            if (
              label
            ) {
              label.textContent =
                visible === 1
                  ? "note"
                  : "notes";
            }


            if (
              emptyState
            ) {
              emptyState.classList.toggle(
                "hidden",
                visible !== 0
              );
            }

          }
        );

      }
    );

  })();
</script>
