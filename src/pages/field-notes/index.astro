---
import {
  getCollection
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";


const allNotes =
  await getCollection(
    "field-notes"
  );


function getNoteDate(
  note
) {
  return new Date(
    note.data.date ??
    note.data.publishDate ??
    note.data.publishedAt
  );
}


function getCategory(
  note
) {
  return (
    note.data.category ??
    "ecosystems"
  );
}


function getCategoryLabel(
  category
) {

  const labels = {
    ecosystems:
      "Ecosystems & Community",

    tradeshows:
      "Trade Shows",

    hardware:
      "Hardware & Manufacturing"
  };


  return (
    labels[category] ??
    category
  );

}


function formatDate(
  value
) {

  return new Date(
    value
  ).toLocaleDateString(
    "en-US",
    {
      month:
        "long",

      day:
        "numeric",

      year:
        "numeric"
    }
  );

}


const now =
  new Date();


const notes =
  allNotes
    .filter(
      (note) => {
        const date =
          getNoteDate(
            note
          );

        return (
          !Number.isNaN(
            date.getTime()
          ) &&
          date <= now
        );
      }
    )
    .sort(
      (a, b) =>
        getNoteDate(
          b
        ).getTime() -
        getNoteDate(
          a
        ).getTime()
    );


const categories = [
  {
    label:
      "All Notes",

    value:
      "all"
  },
  {
    label:
      "Ecosystems & Community",

    value:
      "ecosystems"
  },
  {
    label:
      "Trade Shows",

    value:
      "tradeshows"
  },
  {
    label:
      "Hardware & Manufacturing",

    value:
      "hardware"
  }
];
---

<BaseLayout
  title="SOLEIL & STONE | Field Notes"
  description="Notes and observations on hardware, commercialization, trade shows, community building and innovation ecosystems."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="
      bg-white
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        pt-16
        pb-14
      "
    >

      <span
        class="
          inline-block
          px-3
          py-1
          bg-brand-gold/10
          border
          border-brand-gold/30
          text-brand-gold
          text-[10px]
          uppercase
          tracking-[0.2em]
          font-semibold
          mb-6
        "
      >
        Notes From The Field
      </span>


      <h1
        class="
          font-serif
          text-4xl
          sm:text-5xl
          lg:text-6xl
          font-normal
          tracking-wide
          text-brand-charcoal
          leading-[1.12]
          mb-6
        "
      >
        Field Notes
      </h1>


      <p
        class="
          text-base
          sm:text-lg
          text-brand-slate
          leading-relaxed
          font-light
          max-w-3xl
        "
      >
        Observations from the field on hardware,
        commercialization, innovation ecosystems,
        trade shows and community building.
      </p>

    </div>

  </section>



  <!-- =====================================================
       FILTER BAR
       ===================================================== -->

  <section
    class="
      bg-brand-cream
      border-b
      border-brand-border
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-8
      "
    >

      <div
        class="
          flex
          flex-col
          gap-5
        "
      >

        <!-- INTRO -->

        <div>

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Articles & Field Notes
          </span>


          <p
            class="
              text-sm
              text-brand-slate
              leading-relaxed
              font-light
              max-w-3xl
              mt-2
            "
          >
            Notes on communities, industry events,
            hardware ecosystems and technical
            commercialization.
          </p>

        </div>



        <!-- FILTERS -->

        <div
          class="
            flex
            flex-wrap
            gap-2
          "
        >

          {
            categories.map(
              (
                category,
                index
              ) => (

                <button
                  type="button"
                  data-filter={
                    category.value
                  }
                  class:list={[
                    "field-filter",
                    "inline-flex",
                    "items-center",
                    "px-4",
                    "py-2.5",
                    "border",
                    "text-[9px]",
                    "uppercase",
                    "tracking-[0.15em]",
                    "font-semibold",
                    "transition-colors",

                    index === 0
                      ? "is-active bg-brand-charcoal text-white border-brand-charcoal"
                      : "bg-white text-brand-slate border-brand-border hover:border-brand-gold hover:text-brand-gold"
                  ]}
                >
                  {category.label}
                </button>

              )
            )
          }

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       NOTES
       ===================================================== -->

  <section
    class="
      bg-white
    "
  >

    <div
      class="
        max-w-6xl
        w-full
        mx-auto
        px-6
        py-14
      "
    >

      <!-- HEADER -->

      <div
        class="
          flex
          items-end
          justify-between
          gap-6
          mb-8
        "
      >

        <div>

          <span
            class="
              text-[9px]
              uppercase
              tracking-[0.2em]
              text-brand-gold
              font-semibold
            "
          >
            Published Notes
          </span>


          <h2
            class="
              font-serif
              text-3xl
              text-brand-charcoal
              mt-2
            "
          >
            Explore The Notes
          </h2>

        </div>


        <div
          class="
            text-[9px]
            uppercase
            tracking-[0.14em]
            text-brand-slate
          "
        >
          <span
            id="visible-note-count"
          >
            {notes.length}
          </span>

          {" "}
          notes
        </div>

      </div>



      <!-- =================================================
           NOTES GRID
           ================================================= -->

      <div
        id="field-notes-grid"
        class="
          grid
          md:grid-cols-2
          gap-5
        "
      >

        {
          notes.map(
            (
              note,
              index
            ) => (

              <article
                data-note-card
                data-category={
                  getCategory(
                    note
                  )
                }
                class="
                  group
                  border
                  border-brand-border
                  bg-white
                  min-h-[250px]
                  flex
                  flex-col
                  transition-colors
                  hover:border-brand-gold
                  hover:bg-brand-cream
                "
              >

                <a
                  href={`/field-notes/${note.id.replace(".md", "")}/`}
                  class="
                    flex
                    flex-col
                    h-full
                    p-6
                  "
                >

                  <!-- META -->

                  <div
                    class="
                      flex
                      items-start
                      justify-between
                      gap-4
                      mb-6
                    "
                  >

                    <div>

                      <span
                        class="
                          inline-flex
                          px-2.5
                          py-1
                          bg-brand-gold/10
                          text-[8px]
                          uppercase
                          tracking-[0.15em]
                          text-brand-gold
                          font-semibold
                        "
                      >
                        {
                          getCategoryLabel(
                            getCategory(
                              note
                            )
                          )
                        }
                      </span>


                      <div
                        class="
                          text-[9px]
                          uppercase
                          tracking-[0.14em]
                          text-brand-slate
                          mt-3
                        "
                      >
                        {
                          formatDate(
                            getNoteDate(
                              note
                            )
                          )
                        }
                      </div>

                    </div>


                    <span
                      class="
                        font-serif
                        text-xl
                        text-brand-border
                        group-hover:text-brand-gold
                        transition-colors
                      "
                    >
                      {
                        String(
                          index + 1
                        ).padStart(
                          2,
                          "0"
                        )
                      }
                    </span>

                  </div>



                  <!-- TITLE -->

                  <h3
                    class="
                      font-serif
                      text-2xl
                      text-brand-charcoal
                      leading-snug
                      group-hover:text-brand-gold
                      transition-colors
                    "
                  >
                    {note.data.title}
                  </h3>



                  <!-- DESCRIPTION -->

                  {
                    note.data.description && (

                      <p
                        class="
                          text-xs
                          sm:text-sm
                          text-brand-slate
                          leading-relaxed
                          font-light
                          mt-4
                          max-w-xl
                        "
                      >
                        {
                          note.data.description
                        }
                      </p>

                    )
                  }



                  <!-- FOOTER -->

                  <div
                    class="
                      mt-auto
                      pt-6
                    "
                  >

                    <div
                      class="
                        border-t
                        border-brand-border
                        pt-4
                        flex
                        items-center
                        justify-between
                      "
                    >

                      <span
                        class="
                          text-[9px]
                          uppercase
                          tracking-[0.16em]
                          text-brand-charcoal
                          font-semibold
                          group-hover:text-brand-gold
                          transition-colors
                        "
                      >
                        Read Note
                      </span>


                      <span
                        class="
                          text-brand-slate
                          group-hover:text-brand-gold
                          group-hover:translate-x-1
                          transition-all
                        "
                      >
                        →
                      </span>

                    </div>

                  </div>

                </a>

              </article>

            )
          )
        }

      </div>



      <!-- EMPTY STATE -->

      <div
        id="field-notes-empty"
        class="
          hidden
          border
          border-brand-border
          bg-brand-cream
          px-6
          py-10
          text-center
        "
      >

        <p
          class="
            text-sm
            text-brand-slate
            font-light
          "
        >
          No Field Notes are published
          in this category yet.
        </p>

      </div>

    </div>

  </section>

</BaseLayout>



<!-- =====================================================
     FILTER SCRIPT
     ===================================================== -->

<script is:inline>
  (() => {

    const buttons =
      Array.from(
        document.querySelectorAll(
          ".field-filter"
        )
      );


    const cards =
      Array.from(
        document.querySelectorAll(
          "[data-note-card]"
        )
      );


    const count =
      document.getElementById(
        "visible-note-count"
      );


    const emptyState =
      document.getElementById(
        "field-notes-empty"
      );


    const setActiveButton =
      (activeButton) => {

        buttons.forEach(
          (button) => {

            const isActive =
              button ===
              activeButton;


            button.classList.toggle(
              "bg-brand-charcoal",
              isActive
            );


            button.classList.toggle(
              "text-white",
              isActive
            );


            button.classList.toggle(
              "border-brand-charcoal",
              isActive
            );


            button.classList.toggle(
              "bg-white",
              !isActive
            );


            button.classList.toggle(
              "text-brand-slate",
              !isActive
            );


            button.classList.toggle(
              "border-brand-border",
              !isActive
            );

          }
        );

      };


    buttons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const filter =
              button.dataset.filter;


            setActiveButton(
              button
            );


            let visible =
              0;


            cards.forEach(
              (card) => {

                const category =
                  card.dataset.category;


                const shouldShow =
                  filter ===
                    "all" ||
                  category ===
                    filter;


                card.classList.toggle(
                  "hidden",
                  !shouldShow
                );


                if (
                  shouldShow
                ) {
                  visible += 1;
                }

              }
            );


            if (
              count
            ) {
              count.textContent =
                String(
                  visible
                );
            }


            if (
              emptyState
            ) {
              emptyState.classList.toggle(
                "hidden",
                visible !== 0
              );
            }

          }
        );

      }
    );

  })();
</script>
