---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { events } from "../data/events.cms";
import { getEventRecapUrl } from "../utils/eventRecaps";

const now = new Date();
const fieldNotes = (await getCollection("fieldNotes"))
  .filter((post) => !post.data.draft && post.data.published <= now)
  .map((post) => ({
    type: "Field Note",
    title: post.data.title,
    description: post.data.description,
    meta: post.data.category,
    url: `/field-notes/${post.id.replace(/\.md$/, "")}/`,
    search: [post.data.title, post.data.description, post.data.category].join(" ").toLowerCase()
  }));

const eventRecaps = (await getCollection("eventRecaps"))
  .filter((post) => !post.data.draft && post.data.published <= now)
  .map((post) => ({
    type: "Event Recap",
    title: post.data.title,
    description: post.data.excerpt,
    meta: post.data.tags.join(" · "),
    url: getEventRecapUrl(post.data.eventId) || `/event-recaps/${post.id.replace(/\.md$/, "")}/`,
    search: [post.data.title, post.data.excerpt, ...post.data.tags].join(" ").toLowerCase()
  }));

const eventItems = events.map((event) => ({
  type: "Event",
  title: event.title,
  description: event.description || "",
  meta: [event.city, event.typeLabel].filter(Boolean).join(" · "),
  url: `/fieldwork/?event=${encodeURIComponent(event.id)}`,
  search: [event.title, event.description, event.city, event.venue, event.typeLabel, ...(event.sponsors || []), ...(event.partners || [])].filter(Boolean).join(" ").toLowerCase()
}));

const searchItems = [...fieldNotes, ...eventRecaps, ...eventItems];
---

<BaseLayout title="SOLEIL & STONE | Search" description="Search Field Notes, Event Recaps and Fieldwork across Soleil & Stone.">
  <section class="bg-white border-b border-brand-border">
    <div class="max-w-6xl w-full mx-auto px-6 py-16">
      <span class="text-[10px] uppercase tracking-[0.2em] text-brand-gold font-semibold">Explore</span>
      <h1 class="font-serif text-4xl sm:text-5xl text-brand-charcoal mt-2">Search Soleil & Stone</h1>
      <p class="text-brand-slate font-light mt-4 max-w-2xl">Search across Field Notes, Event Recaps and Fieldwork.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 max-w-4xl">
        <input id="site-search" type="search" autocomplete="off" placeholder="Search topics, events, cities, organizations..." class="flex-1 border border-brand-border bg-white px-5 py-4 text-sm text-brand-charcoal outline-none focus:border-brand-gold" />
        <select id="site-search-type" class="border border-brand-border bg-white px-4 py-4 text-xs text-brand-charcoal outline-none focus:border-brand-gold">
          <option value="all">All content</option><option value="Field Note">Field Notes</option><option value="Event Recap">Event Recaps</option><option value="Event">Fieldwork</option>
        </select>
      </div>
    </div>
  </section>
  <section class="bg-brand-cream">
    <div class="max-w-6xl w-full mx-auto px-6 py-12">
      <p id="search-count" class="text-[10px] uppercase tracking-[0.15em] text-brand-slate mb-5">Start typing to search</p>
      <div id="search-results" class="grid md:grid-cols-2 gap-4"></div>
    </div>
  </section>

  <script is:inline define:vars={{ searchItems }}>
    (() => {
      const input = document.getElementById("site-search");
      const typeSelect = document.getElementById("site-search-type");
      const results = document.getElementById("search-results");
      const count = document.getElementById("search-count");
      if (!input || !results || !count) return;
      const escapeHtml = (value) => String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");
      const render = () => {
        const query = input.value.trim().toLowerCase();
        if (!query) { results.innerHTML = ""; count.textContent = "Start typing to search"; return; }
        const terms = query.split(/\s+/).filter(Boolean);
        const selectedType = typeSelect?.value || "all";
        const score = (item) => {
          const title = item.title.toLowerCase();
          let value = 0;
          terms.forEach((term) => { if (title === term) value += 20; else if (title.includes(term)) value += 10; if (item.search.includes(term)) value += 1; });
          return value;
        };
        const matches = searchItems
          .filter((item) => (selectedType === "all" || item.type === selectedType) && terms.every((term) => item.search.includes(term)))
          .sort((a,b) => score(b)-score(a))
          .slice(0, 50);
        count.textContent = `${matches.length} ${matches.length === 1 ? "result" : "results"}`;
        results.innerHTML = matches.length ? matches.map((item) => `
          <a href="${escapeHtml(item.url)}" class="block bg-white border border-brand-border p-6 hover:border-brand-gold transition-colors">
            <span class="text-[9px] uppercase tracking-[0.16em] text-brand-gold font-semibold">${escapeHtml(item.type)}</span>
            <h2 class="font-serif text-xl text-brand-charcoal mt-2">${escapeHtml(item.title)}</h2>
            ${item.meta ? `<p class="text-[10px] text-brand-slate mt-2">${escapeHtml(item.meta)}</p>` : ""}
            ${item.description ? `<p class="text-sm text-brand-slate font-light leading-relaxed mt-3">${escapeHtml(item.description)}</p>` : ""}
          </a>`).join("") : `<div class="md:col-span-2 py-12 text-brand-slate">No matching content found.</div>`;
      };
      input.addEventListener("input", render);
      typeSelect?.addEventListener("change", () => { const params=new URLSearchParams(window.location.search); if(typeSelect.value==="all") params.delete("type"); else params.set("type",typeSelect.value); history.replaceState(null,"",`${window.location.pathname}?${params.toString()}`); render(); });
      const params = new URLSearchParams(window.location.search);
      const q = params.get("q");
      const type = params.get("type");
      if (type && typeSelect && Array.from(typeSelect.options).some((option) => option.value === type)) typeSelect.value = type;
      if (q) { input.value = q; render(); }
      input.addEventListener("input", () => { const p=new URLSearchParams(window.location.search); if(input.value.trim()) p.set("q",input.value.trim()); else p.delete("q"); history.replaceState(null,"",`${window.location.pathname}?${p.toString()}`); });
      input.focus();
    })();
  </script>
</BaseLayout>
